blue"],["red"],null,null,null,null,null,null,null,null,null,["blue"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["blue"],["blue"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["blue"],null,null,["blue"],null,null,null,["blue"]],"parameters":[null,[{"headerIndex":1,"headerParam":["spiritualists",0,0,0]},{"headerIndex":1,"headerParam":["spiritualists",0,0,0]}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":5,"headerParam":["---------------------------------------"]}],[{"headerIndex":23,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":29,"headerParam":["---------------------------------------------"]}],null,[{"headerIndex":66,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":72,"headerParam":["N2",0,1,1]}],[{"headerIndex":75,"headerParam":["N2",0,1,1]}],[{"headerIndex":81,"headerParam":["N2",0,0,0]}],[{"headerIndex":86,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":89,"headerParam":["spiritualists",0,0,0]}],null,[{"headerIndex":7,"headerParam":["spiritualists",0,0,0]}],null,[{"headerIndex":8,"headerParam":["----------------------------------"]}],[{"headerIndex":25,"headerParam":["N2",0,0,0]}],[{"headerIndex":28,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":31,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":35,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":37,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":40,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":43,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":47,"headerParam":["N2",0,0,0]}],[{"headerIndex":50,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":53,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":56,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":76,"headerParam":["spiritualists",0,0,0]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}],null,null,null,null,[{"headerIndex":7,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":9,"headerParam":["N2",0,0,0]}],[{"headerIndex":33,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":43,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":52,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":54,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":60,"headerParam":["N2",0,0,0]}],[{"headerIndex":64,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":66,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":70,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":74,"headerParam":["N2",0,0,0]}],[{"headerIndex":78,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":0,"headerParam":["--------------------------------------"]}],null,null,[{"headerIndex":4,"headerParam":["----------------------------------------------"]},{"headerIndex":4,"headerParam":["----------------------------------------------"]},{"headerIndex":4,"headerParam":["----------------------------------------------"]}],[{"headerIndex":5,"headerParam":["",0,1,2]}],[{"headerIndex":10,"headerParam":["",0,1,2]}],[{"headerIndex":14,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":22,"headerParam":["------------------------------------------"]}],[{"headerIndex":26,"headerParam":["N2",0,0,2]},{"headerIndex":52,"headerParam":["N2",0,0,2]}],[{"headerIndex":29,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":31,"headerParam":["N2",0,0,2]}],[{"headerIndex":34,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":37,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":41,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":44,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":55,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":58,"headerParam":["N2",0,0,2]}],null,null,[{"headerIndex":5,"headerParam":["",0,1,2]}],[{"headerIndex":9,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":15,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":20,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":24,"headerParam":["spiritualists",1,0,2]}],null,null,[{"headerIndex":5,"headerParam":["",0,1,2]}],[{"headerIndex":9,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":17,"headerParam":["N2",0,0,2]}],[{"headerIndex":24,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":28,"headerParam":["spiritualists",0,0,2]}]],"indexIds":{"EV001":0,"\\n<経蔵>外から見た限りだが、\n伽椰子の家の２階はそう広くない。\\!\n\\C[1]ここを調べてから１階側を調べよう。":1,"OuterSelfSwitch on 2 A":2,"AooniKayakoHouseProcess preload":3,"OuterSelfSwitch off 2 A":4,"EV002":5,"OuterSelfSwitch on 1 A":6,"OuterSelfSwitch off 1 A":7,"パディング":8,"血のり":9,"寝室開く":10,"AooniKayakoHouseProcess hide 2":11,"AooniKayakoHouseProcess appear 3":12,"寝室開く２":13,"寝室閉じる１":14,"AooniKayakoHouseProcess appear 2":15,"AooniKayakoHouseProcess hide 3":16,"寝室閉じる２":17,"俊雄部屋開く":18,"俊雄部屋閉じる":19,"物置開く":20,"AooniKayakoHouseProcess hide 1":21,"---------------------------------------\n珠緒が伽椰子邸１Ｆへ":22,"\\n<経蔵>ついさっきまで\nここに珠緒の気配があったような感じが\nしたんだが……":23,"---------------------------------------------":24,"AooniKayakoHouseProcess appear 1":25,"\\n<経蔵>あいつ、急に引き返して\nなんのつもりだ……？\\!\nまあいい、さっさとここを出よう。":26,"ところが、玄関のドアの先に\n青鬼が待ち構えていたことがわかった。":27,"お互い話し合いのうえ、\n床に記されているらしい矢印の指示通り、\n伽椰子邸２階を調査することになった。":28,"\\n<\\N[2]>青鬼は私たちをここへ誘導するのが\n目的だったのでは。\\!\nなんとなくですが、ほかに理由も……":29,"\\n<経蔵>どうだろうな？\\.\\.\nあいつの考えは読みようがない。":30,"\\n<経蔵>お前の言う通りだとしたら、\nここでどうして欲しいってんだろうな？\\.\\.\n……ったく。":31,"物置閉じる":32,"\\n<経蔵>こっちはもう\nさすがに危険すぎるだろうな。":33,"天井裏へ":34,"----------------------------------\nここから本棚をハシゴがわりにして登る":35,"\\n<\\N[2]>天井に穴があいていますね。\nこの本棚をハシゴがわりにして、上に行けそうですが……":36,"\\n<珠緒>この上、ここより伽椰子の気配が濃いね……。\n本人がいる感じじゃなさそうだけど。":37,"\\n<経蔵>伽椰子の家の図面通りだと、\nこの上はちょうどあいつが殺されて投げ込まれた\n屋根裏にあたるからな。":38,"\\n<珠緒>……………………。":39,"\\n<経蔵>ここから出られない以上、\n進展がありそうなのはここだけだ。":40,"\\n<経蔵>引き返せないなら、\n前だと思う方に進むしかない。":41,"\\n<珠緒>\\N[2]、先に行って。\nあたしはあんたが触れたところの気配を\n手がかりにして登るから。":42,"\\n<\\N[2]>なるほど……。\nでは、上で何かお手伝いを":43,"\\n<経蔵>\\N[2]、心配はいらない。\nそこんとこ、珠緒はタフだ。":44,"\\n<経蔵>万一、足をすべらせたら\n俺がお姫様抱っこでフォローすればいいしな。":45,"\\n<珠緒>経蔵、キモい。":46,"\\n<経蔵>\\N[2]、長居は無用だ。\n\\C[1]玄関\\C[0]から表に出て最後の仕上げをやるぞ。":47,"貞子":48,"伽椰子":49,"珠緒":50,"青":51,"青位置設定":52,"--------------------\n■デバッグモード":53,"--------------------":54,"EV019":55,"EV020":56,"EV021":57,"伽椰子邸初ＥＶ":58,"\\n<経蔵>この気配は……。":59,"\\n<\\N[2]>（以前来たときと構造が違う……！？）":60,"\\n<経蔵>この間取り……！！":61,"\\n<経蔵>……\\N[2]、もう１度階段を降りてみるぞ。":62,"\\n<経蔵>なるほど……さっきの場所に出た。":63,"\\n<経蔵>どうやら階段を下りるたびに\n青鬼の屋敷の２階と伽椰子の家の１階に、\n交互に出られるみたいだな。":64,"\\n<\\N[2]>“伽椰子の家”というのは？":65,"\\n<経蔵>『入れば伽椰子に呪われて死ぬ家』だ。":66,"\\n<経蔵>俺たちが下見に行ったときは呪われないよう、\n玄関のドアを開けて表から１階の間取りと気配を\n確かめただけにとどめたが。":67,"\\n<経蔵>伽椰子のやつ、ここに移り住んだだけでなく、\n元いた家の間取りまで、この屋敷の素材を使って\n再現しているようだ。":68,"\\n<\\N[2]>よほど元の家に未練があったのでしょうか……。":69,"\\n<経蔵>まずはこの上、\n\\C[1]伽椰子の家の２階から探すぞ。":70,"--------------------------------------\n終盤になったら階段先を青鬼邸にする":71,"青ルート補正":72,"俊雄の趣味？":73,"----------------------------------------------":74,"引き出しの中に\n青鬼と似た色の携帯型ゲーム機が入っている。\n\n":75,"ゲーム機には『ＲＰＧツクールフェス』という\nカートリッジが差してある。":76,"\\n<経蔵>この気配は……\\.\\.俊雄のものが２種類。\\!\nいつものやつと、\n普通の子供の霊のような感じのものがあるな。":77,"------------------------------------------\nここに来るのは\n経蔵＋ひろし、経蔵＋珠緒、全員の３パターン":78,"\\n<\\N[2]>このソフトで制作したゲームは\n配信できるそうです。":79,"\\n<珠緒>ゲームの配信……\\.\\.新しい呪い方だね。":80,"\\n<\\N[2]>そこまで言わなくても……。\\.\\.\n単純にゲームを制作してみたいだけでは？":81,"\\n<経蔵>ふっ。\\.\\.知らない、てのは優しいな。\\!\nそろそろ俺らも発想の清めどき、\\.\\.かもな？":82,"\\n<珠緒>ガラじゃないクセに……。":83,"\\n<珠緒>ゲーム機をよく使ってるのは、\n化け物じゃない方の俊雄みたいだね。":84,"\\n<珠緒>……化け物の方も、となりで興味深そうに\nのぞき込んでる様子が見えてくる……":85,"\\n<経蔵>ガラじゃなさそうに見えたが、\n普通にゲームするんだな。":86,"\\n<\\N[2]>このソフトを使っている友人がいますので……。":87,"表俊雄":88,"EV026":89,"引き出しの中にノートが入っている。\\!\nゲームのアイデアをまとめているもののようだ。":90,"\\n<経蔵>この気配は……\\.\\.俊雄のノートか。\nだけど、普通の子供の霊のような感じだな。":91,"\\n<経蔵>俊雄お前も、\n普通にゲーム楽しむんだな……。\\!\nそれも作る方かよ。":92,"\\n<珠緒>ノートの内容はわからないけど、\nノートの気配はざっと９：１ぐらいで\n普通の俊雄、化け物の俊雄だね。":93,"\\n<珠緒>ノートの中身がそのまま実現すると、\nその１割ぶん、何かの呪いにかかるかもね？":94,"俊雄":95,"EV028":96,"本棚にスケッチブックがある。\\!\n絵の半分ぐらいは黒い猫をモチーフにしたものだ。":97,"\\n<経蔵>絵の気配は……\\.\\.俊雄のものだな。\\!\nいつものやつと、\n普通の子供の霊のような感じのものと、２種類。":98,"\\n<\\N[2]>絵柄が２系統ありますね。\\!\n片方は普通の子供の絵ですが、もう片方は……\\!\n何か鬼気迫る雰囲気を感じます。":99,"\\n<珠緒>絵は直接見えないけど、化け物の方の絵から……\n俊雄を先頭にして、たくさんの子供の無念が\nにじみ出てくる。\\!なんでだろう？":100,"\\n<経蔵>俊雄に黒幕でもいるのかよ……？":101},"extension":"json","dataType":"map","filename":"Map113","basename":"Map113.json","path":"data/Map113.json","relPath":"data/Map113.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":102,"length":102,"percent":100},"cellInfo":[]},"data/Map114.json":{"data":[["EV001","","EV001"],["AooniKayakoHouseProcess preload","","AooniKayakoHouseProcess preload"],["AooniKayakoHouseProcess hide 1","","AooniKayakoHouseProcess hide 1"],["伽椰子の封印箱","","Kayako Seal Box"],["金庫の底に\n\\C[10]Birthday\n\\C[0]と、記されている。","","at the bottom of the safe\n\\C[10]Birthday\nIt is written as \\C[0]."],["\\n<経蔵>伽椰子（あいつ）のノートなんか入れて\nどうする気だ？","","\\n<経蔵> Put Kayako's (that guy's) notebook in there.\nWhat are you going to do?"],["\\n<\\N[2]>自分でも分からないのですが、なんとなく……\nあとは暗証番号を設定すれば、\\.\\.\\.いいような気が……","","\\n<\\N[2]> I don't even understand it myself, but somehow...\nI feel like all I have to do is set the PIN number and it will be \\.\\.\\...."],["---------------------------------------\n●画像読込み準備","","---------------------------------------\n●Preparation for loading images"],["---------------------------------------","","---------------------------------------"],["\\n<\\N[2]>金庫の底には、\n\\C[10]Birthday\\C[0] と、記されていたはずですが……","","\\n<\\N[2]> At the bottom of the safe is\nIt should have been written as \\C[10]Birthday\\C[0]..."],["----------------------------------------\n・伽椰子の生年(19660408)を入力する\n　伽椰子のノートの狂い書き（終わりの始まり準拠）が\n　パスワードの一部になっている。","","----------------------------------------\n・Enter Kayako's year of birth (19660408)\nKayako's scribbled notes (based on the beginning of the end)\nIt is part of the password."],["\\n<経蔵>伽椰子の気配が薄くなった……！？","","\\n<経蔵> Kayako's presence has faded...! ?"],["\\n<珠緒>あたしたちを呪い殺すぐらいの力は\nじゅうぶん残ってはいると思うけど……。","","\\n<珠緒>The power to curse us to death is\nI think there's enough left..."],["\\n<経蔵>\\N[2]、お前もけっこう\\.\\.“懸かりやすい”な。\\!\nしかし、いったい誰が懸かった……？？","","\\n<経蔵>\\N[2], you're also quite \\.\\. \"easy to get carried away.\" \\!\nBut who was in charge...? ?"],["----------------------------------\nここで現れる魂は表伽椰子・表俊雄、\nという設定（生前の普通の人としての意識）","","----------------------------------\nThe souls that appear here are Omote Kayako, Omote Toshio,\nSetting (consciousness as a normal person before death)"],["\\n<\\N[2]>………………………………","","\\n<\\N[2]>………………………………"],["-----------------------------------\n一度間違えるとヒントが出る","","-----------------------------------\nIf you make a mistake once, you will receive a hint."],["\\n<\\N[2]>どうやら、正しい番号を入力しないと\n鍵がかからない仕組みのようです。","","\\n<\\N[2]> Apparently, if I don't enter the correct number\nIt seems to be a lockless mechanism."],["\\n<経蔵>普通の金庫と逆かよ。","","\\n<経蔵> Is it the opposite of a normal safe?"],["\\n<経蔵>入力するとすれば、\n金庫が屋根裏部屋にあるのと\"Birthday\"からして、\n\\C[1]伽椰子の生年月日\\C[0]だろうな。","","If you enter \\n<経蔵>,\nConsidering that the safe is in the attic and \"Birthday\",\n\\C[1] Kayako's date of birth is probably \\C[0]."],["\\n<珠緒>伽椰子が夫に殺されて、\n遺体になった身体を隠された場所だもんね……。","","\\n<珠緒> Kayako was killed by her husband,\nIt's a place where dead bodies are hidden..."],["\\n<\\N[2]>生年の月日の方は\n\\C[1]『0408』\\C[0]でまちがいないかと。\\!\n彼女のノートにそう取れる記述がありました。","","\\n<\\N[2]>If your date of birth is\n\\C[1] \"0408\" \\C[0] is correct. \\!\nThere was a description in her notebook that could be taken as such."],["\\n<\\N[2]>生年の方は、古い時代の方ではないので\n\\C[1]『19**』\\C[0]と思われますが……","","\\n<\\N[2]> The person born in the year is not from an old era.\n\\C[1] \"19**\" It seems to be \\C[0]..."],["ふと、日記の最後の方の内容を確かめようと思った。","","Suddenly, I decided to check the contents of the last part of the diary."],["\\n<\\N[2]>暗証番号が生年月日でよければ、おそらく\n\\C[1]『19**0408』\\C[0]で、まちがいないはず。\\!\n残り２ケタは……","","\\n<\\N[2]>If your date of birth is fine as your PIN, probably\n\\C[1] \"19**0408\" \\C[0], there should be no mistake. \\!\nThe remaining two digits are..."],["青","","blue"],["EV004","","EV004"],["\\n<経蔵>バケモンどもの思惑通りなら、\nこの先に進むとおそらく\\C[2]後戻りできなくなる。\\C[0]\\!\n\\N[2]、\\.\\.調べ忘れたと思うものはないか？","","\\n<経蔵>If the monsters have their way,\n\\C[2] If you go beyond this point, you will probably not be able to go back. \\C[0]\\!\n\\N[2], \\.\\. Is there anything you think I forgot to check?"],["\\n<\\N[2]>そうですね……","","\\n<\\N[2]> That's right..."],["特にありません","","Nothing in particular"],["心当たりが……","","I have an idea..."],["\\n<珠緒>経蔵、この先は……！！","","\\n<珠緒>Kyozo, what's next...! !"],["\\n<経蔵>珠緒、覚悟を決めろ。\nやれるだけのことをやるだけだ。","","\\n<経蔵> Tamao, prepare yourself.\nJust do what you can."],["\\n<経蔵>それと、意識をつぶっておけ。\nもろに呪いの邪気を浴びると参っちまうぞ。\\!\n毒を食らわば、もとい……","","\\n<経蔵>Also, keep your mind shut.\nIf you are exposed to the evil energy of the curse, you will die. \\!\nIf you eat poison, then..."],["\\n<経蔵>うかうかしてるとバケモンどもに先手を取られる。\\!\n手早くな？","","\\n<経蔵> If you're lazy, the monsters will take the initiative. \\!\nIsn't it quick?"],["\\n<経蔵>カヤを食らわばサダまで、だ……！","","\\n<経蔵> If you eat Kaya, you'll be sad...!"],["DiscardTilesets 2","","DiscardTilesets 2"],["DiscardTilesets 9","","DiscardTilesets 9"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["-------------------------------\nハッカドール編イベント用","","-------------------------------\nFor Hacka Doll event"],["--------------------","","--------------------"]],"context":[["Map114/events/1/name"],["Map114/events/1/pages/0/list/4/Plugin Command"],["Map114/events/1/pages/0/list/7/Plugin Command"],["Map114/events/2/name"],["Map114/events/2/pages/0/list/0/message/hasPicture/bottom"],["Map114/events/2/pages/0/list/9/message/hasPicture/bottom"],["Map114/events/2/pages/0/list/12/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/0/comment"],["Map114/events/2/pages/1/list/10/comment"],["Map114/events/2/pages/1/list/11/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/16/comment"],["Map114/events/2/pages/1/list/60/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/62/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/65/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/68/comment"],["Map114/events/2/pages/1/list/83/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/91/comment"],["Map114/events/2/pages/1/list/94/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/97/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/99/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/103/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/106/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/110/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/113/message/hasPicture/bottom"],["Map114/events/2/pages/1/list/119/message/hasPicture/bottom"],["Map114/events/3/name"],["Map114/events/4/name"],["Map114/events/4/pages/0/list/0/message/hasPicture/top"],["Map114/events/4/pages/0/list/4/message/hasPicture/top"],["Map114/events/4/pages/0/list/6/Show Choices/6/1from2"],["Map114/events/4/pages/0/list/6/Show Choices/6/2from2"],["Map114/events/4/pages/0/list/8/message/hasPicture/top"],["Map114/events/4/pages/0/list/10/message/hasPicture/top"],["Map114/events/4/pages/0/list/13/message/hasPicture/top"],["Map114/events/4/pages/0/list/20/message/hasPicture/top"],["Map114/events/4/pages/0/list/31/message/hasPicture/top"],["Map114/events/4/pages/0/list/34/Plugin Command"],["Map114/events/4/pages/0/list/35/Plugin Command"],["Map114/events/15/name"],["Map114/events/15/pages/0/list/0/comment"],["Map114/events/15/pages/0/list/7/comment"],["Map114/events/15/pages/0/list/25/comment"]],"tags":[null,["red"],["red"],null,null,null,null,["blue"],["blue"],null,["blue"],null,null,null,["blue"],null,["blue"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["red"],["red"],null,["blue"],["blue"],["blue"]],"parameters":[null,null,null,null,[{"headerIndex":0,"headerParam":["N2",0,1,2]}],[{"headerIndex":9,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":12,"headerParam":["N2",0,0,2]}],[{"headerIndex":0,"headerParam":["---------------------------------------"]}],[{"headerIndex":10,"headerParam":["---------------------------------------"]}],[{"headerIndex":11,"headerParam":["N2",0,0,2]}],[{"headerIndex":16,"headerParam":["----------------------------------------"]}],[{"headerIndex":60,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":62,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":65,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":68,"headerParam":["----------------------------------"]}],[{"headerIndex":83,"headerParam":["N2",0,0,2]}],[{"headerIndex":91,"headerParam":["-----------------------------------"]}],[{"headerIndex":94,"headerParam":["N2",0,0,2]}],[{"headerIndex":97,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":99,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":103,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":106,"headerParam":["N2",0,0,2]}],[{"headerIndex":110,"headerParam":["N2",0,0,2]}],[{"headerIndex":113,"headerParam":["N2",0,1,2]}],[{"headerIndex":119,"headerParam":["N2",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":4,"headerParam":["N2",0,0,0]}],null,null,[{"headerIndex":8,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":10,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":13,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":20,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":31,"headerParam":["spiritualists",0,0,0]}],null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["-------------------------------"]}],[{"headerIndex":25,"headerParam":["--------------------"]}]],"indexIds":{"EV001":0,"AooniKayakoHouseProcess preload":1,"AooniKayakoHouseProcess hide 1":2,"伽椰子の封印箱":3,"金庫の底に\n\\C[10]Birthday\n\\C[0]と、記されている。":4,"\\n<経蔵>伽椰子（あいつ）のノートなんか入れて\nどうする気だ？":5,"\\n<\\N[2]>自分でも分からないのですが、なんとなく……\nあとは暗証番号を設定すれば、\\.\\.\\.いいような気が……":6,"---------------------------------------\n●画像読込み準備":7,"---------------------------------------":8,"\\n<\\N[2]>金庫の底には、\n\\C[10]Birthday\\C[0] と、記されていたはずですが……":9,"----------------------------------------\n・伽椰子の生年(19660408)を入力する\n　伽椰子のノートの狂い書き（終わりの始まり準拠）が\n　パスワードの一部になっている。":10,"\\n<経蔵>伽椰子の気配が薄くなった……！？":11,"\\n<珠緒>あたしたちを呪い殺すぐらいの力は\nじゅうぶん残ってはいると思うけど……。":12,"\\n<経蔵>\\N[2]、お前もけっこう\\.\\.“懸かりやすい”な。\\!\nしかし、いったい誰が懸かった……？？":13,"----------------------------------\nここで現れる魂は表伽椰子・表俊雄、\nという設定（生前の普通の人としての意識）":14,"\\n<\\N[2]>………………………………":15,"-----------------------------------\n一度間違えるとヒントが出る":16,"\\n<\\N[2]>どうやら、正しい番号を入力しないと\n鍵がかからない仕組みのようです。":17,"\\n<経蔵>普通の金庫と逆かよ。":18,"\\n<経蔵>入力するとすれば、\n金庫が屋根裏部屋にあるのと\"Birthday\"からして、\n\\C[1]伽椰子の生年月日\\C[0]だろうな。":19,"\\n<珠緒>伽椰子が夫に殺されて、\n遺体になった身体を隠された場所だもんね……。":20,"\\n<\\N[2]>生年の月日の方は\n\\C[1]『0408』\\C[0]でまちがいないかと。\\!\n彼女のノートにそう取れる記述がありました。":21,"\\n<\\N[2]>生年の方は、古い時代の方ではないので\n\\C[1]『19**』\\C[0]と思われますが……":22,"ふと、日記の最後の方の内容を確かめようと思った。":23,"\\n<\\N[2]>暗証番号が生年月日でよければ、おそらく\n\\C[1]『19**0408』\\C[0]で、まちがいないはず。\\!\n残り２ケタは……":24,"青":25,"EV004":26,"\\n<経蔵>バケモンどもの思惑通りなら、\nこの先に進むとおそらく\\C[2]後戻りできなくなる。\\C[0]\\!\n\\N[2]、\\.\\.調べ忘れたと思うものはないか？":27,"\\n<\\N[2]>そうですね……":28,"特にありません":29,"心当たりが……":30,"\\n<珠緒>経蔵、この先は……！！":31,"\\n<経蔵>珠緒、覚悟を決めろ。\nやれるだけのことをやるだけだ。":32,"\\n<経蔵>それと、意識をつぶっておけ。\nもろに呪いの邪気を浴びると参っちまうぞ。\\!\n毒を食らわば、もとい……":33,"\\n<経蔵>うかうかしてるとバケモンどもに先手を取られる。\\!\n手早くな？":34,"\\n<経蔵>カヤを食らわばサダまで、だ……！":35,"DiscardTilesets 2":36,"DiscardTilesets 9":37,"青位置設定":38,"--------------------\n■デバッグモード":39,"-------------------------------\nハッカドール編イベント用":40,"--------------------":41},"extension":"json","dataType":"map","filename":"Map114","basename":"Map114.json","path":"data/Map114.json","relPath":"data/Map114.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":42,"length":42,"percent":100},"cellInfo":[]},"data/Map115.json":{"data":[["EV001","","EV001"],["\\n<経蔵>今までで一番強い力で閉じられてるな。","","\\n<経蔵> It's closed with the strongest force ever."],["EV002","","EV002"],["\\n<珠緒>経蔵、かすかだけど依頼人の気配がする。","","\\n<珠緒> Keizo, it's faint, but I feel the presence of the client."],["\\n<珠緒>\\C[1]左側の棚のどこか。","","\\n<珠緒>\\C[1] Somewhere on the left shelf."],["\\n<経蔵>依頼人の息子を連れてこないとな。","","\\n<経蔵> I have to bring the client's son."],["\\n<珠緒>\\C[1]右側の棚のどこか。","","\\n<珠緒>\\C[1] Somewhere on the right shelf."],["-------------------------------------------\n用事を済ませて出ようとすると伽椰子が現れる\n先ほどきた出入り口から貞子、\n上から青鬼が現れる\n３者の決戦が始まる？","","-------------------------------------------\nKayako appears when you finish your errands and are about to leave.\nSadako from the doorway we just came from,\nA blue demon appears from above.\nWill the decisive battle between the three begin?"],["\\n<経蔵>意外だな。\nこっち側は開いているみたいだな？","","\\n<経蔵>That's surprising.\nIt looks like this side is open?"],["\\n<珠緒>この先は……青鬼じゃなくて伽椰子の家の\nどこかにつながっているみたい。","","\\n<珠緒> From here on...not Aooni's, but Kayako's house.\nIt seems like it's connected somewhere."],["\\n<経蔵>本人さえ来なきゃさっさと出るだけだ。\n行こうぜ？","","If \\n<経蔵> himself doesn't come, he'll just leave quickly.\nLet's go?"],["先へ進む","","move on"],["一呼吸おく","","take a breather"],["\\n<経蔵>……伽椰子に出くわしたときの、\n心の準備はしておくか。","","\\n<経蔵>...When I came across Kayako,\nAre you mentally prepared?"],["-------------------------------------------\nＢＧＳも先読み","","-------------------------------------------\nBGS also read ahead"],["AltBgs play Darkness 0 0","","AltBgs play Darkness 0 0"],["\\n<経蔵>あとにしろよ伽椰子！？","","\\n<経蔵> Leave it later Kayako! ?"],["\\n<珠緒>経蔵、上！！","","\\n<珠緒> Kyozo, top! !"],["\\n<経蔵>お前もかよ……！？","","\\n<経蔵> You too...! ?"],["\\n<珠緒>伽椰子がこっちに\nあまり殺気を向けてこない……？？","","\\n<珠緒> Kayako is here\nHe doesn't show much murderous intent...? ?"],["-------------------------------------------\n化け物球体現る。\n元ネタはロマサガ３の「破壊するもの」\n実際、貞子らの黒幕はその親戚と考える。","","-------------------------------------------\nA monster sphere appears.\nThe original story is \"The Destroyer\" from Romance Saga 3\nIn fact, the mastermind behind Sadako and others is thought to be her relative."],["AltBgs fadeIn Darkness 0 4 90","","AltBgs fadeIn Darkness 0 4 90"],["\\n<珠緒>貞子、伽椰子、青鬼……\n混ざり合ってひとつになってる……！！","","\\n<珠緒> Sadako, Kayako, Aooni...\nThey are mixed together and become one...! !"],["\\n<経蔵>それ以上に、バケモンどうしがぶつかった\nショックで貞子たちの後援会（黒幕）も\nまとめて姿を現したような感じだな。","","\\n<経蔵> More than that, the monsters collided with each other.\nShocked, Sadako and others' support group (mastermind)\nIt's like they showed up all together."],["\\n<経蔵>この様子じゃ、\n『バケモンにバケモンをぶつけて消滅』は、\\.\\.ないな。\\!\n俺の見過ごし、読み違いだ。","","\\n<経蔵>Looking like this,\nThere is no \\.\\. for ``hitting a monster with a monster and making it disappear''. \\!\nIt was my oversight and misreading."],["CastCommonEventName 珠緒 身震い","","CastCommonEventName Tamao Shiver"],["\\n<珠緒>あらゆる生き物が発した呪い……\\.\\.\nというよりは……","","\\n<珠緒> A curse issued by all living things...\\.\\.\nRather than..."],["\\n<珠緒>呪い『そのもの』のような……","","\\n<珠緒> Like the curse “itself”…"],["\\n<珠緒>“呪い滅ぼす存在（もの）”……！","","\\n<珠緒> “Cursed and destructive existence”…!"],["\\n<経蔵>いいたとえだ。\\!\n誰彼なくウィルスのように取り憑いて、\nそいつが呪う以上に呪わせ、恨む以上に恨ませる。","","\\n<経蔵>That's a good analogy. \\!\nIt haunts everyone like a virus,\nIt makes him curse more than he curses, and makes him hate him more than he hates."],["\\n<経蔵>元の人格を失った、顔なしの意識の塊。\nそんな存在だな。","","\\n<経蔵>A faceless mass of consciousness that has lost its original personality.\nThat's what it is."],["\\n<経蔵>貞子の呪い＝ウィルス説、てのがあったが、\n遠い説じゃなかったな。","","\\n<経蔵> There was a theory that Sadako's curse was a virus, but\nIt wasn't a far-fetched theory."],["\\n<経蔵>こいつの気配は以前から薄々は感じていたが。\\!\n呪いのド真ん中に来てはっきりしたな。","","\\n<経蔵>I've been sensing this guy's presence for some time now. \\!\nIt became clear when I was in the middle of the curse."],["\\n<\\N[2]>ブラックホールを思わせますね。\\!\n危険なものでなければゆっくり鑑賞したい\nところですが。","","\\n<\\N[2]> It reminds me of a black hole. \\!\nAs long as it's not dangerous, I'd like to take my time to appreciate it.\nBy the way."],["\\n<経蔵>もしこいつが直接追ってくるなら……","","\\n<経蔵> If this guy comes after me directly..."],["\\n<\\N[2]>……まさか、戦うんですか？","","\\n<\\N[2]>...Are you sure you're going to fight?"],["\\n<経蔵>バカいえ。\\.\\.ここで最終決戦が挑めるほど\n俺たちがファンタジーにできていたら苦労はねえ。","","\\n<経蔵> No idiot. \\.\\.I can challenge the final battle here.\nIf we could make it into a fantasy, we wouldn't have any trouble."],["\\n<経蔵>そのかわりさっきも言った、\n最終結界と呼べるモンのある表に行くぞ。","","\\n<経蔵>Instead, as I said earlier,\nLet's go to the front where there is a mon that can be called the final barrier."],["AltBgs fadeOut 0 4","","AltBgs fadeOut 0 4"],["\\n<経蔵>逃げるべきところまで逃げ切るのが、\n俺たちにとっての決戦みてえなモンだ！","","\\n<経蔵> Escape to the point where you should escape.\nIt's great to see a decisive battle for us!"],["AooniKayakoHouseProcess preload","","AooniKayakoHouseProcess preload"],["AooniKayakoHouseProcess hide 5","","AooniKayakoHouseProcess hide 5"],["DiscardPicture sdky_cursehole1","","DiscardPicture sdky_cursehole1"],["DiscardPicture sdky_cursehole2","","DiscardPicture sdky_cursehole2"],["DiscardTilesets 9","","DiscardTilesets 9"],["\\n<経蔵>出口がテレビか。\\.\\.ふっ。なるほど。","","Is the \\n<経蔵> exit the TV? \\.\\. Huh. I see."],["\\n<経蔵>もしかして、\n伽椰子が出入りしようとしていたおかげで、\nあの部屋から出られたのか……？","","\\n<経蔵>Maybe,\nThanks to Kayako trying to come in and out,\nWere you able to get out of that room...?"],["\\n<珠緒>化け物たち、どうしたんだろう。\nまだ追ってこないみたい。","","\\n<珠緒> Monsters, I wonder what's going on.\nIt seems like he hasn't followed me yet."],["\\n<\\N[2]>いまのうちですね。","","\\n<\\N[2]> Right now."],["自動イベント","","automatic event"],["AltBgs play sdky_sadako2_short","","AltBgs play sdky_sadako2_short"],["DiscardPicture sdky_blue0b","","DiscardPicture sdky_blue0b"],["DiscardPicture sdky_kaisou","","DiscardPicture sdky_kaisou"],["---------------------------------------\n座敷牢へ戻る","","---------------------------------------\nReturn to the prison"],["------------------------------------------\nひろしは、「先日偶然見た変な動画の景色だ」と告白する","","------------------------------------------\nHiroshi confesses, ``This is the scene from a weird video I happened to see the other day.''"],["\\n<経蔵>ここが、貞子の呪いの中心か。","","\\n<経蔵>Is this the center of Sadako's curse?"],["\\n<珠緒>まちがいない。\n呪いのビデオと同じ気配がこの部屋を満たしてる。\\!\nでも、ものすごく濃い……。","","\\n<珠緒> No doubt.\nThe same presence as in the cursed video fills this room. \\!\nBut it's very dark..."],["\\n<経蔵>呪いのビデオには、この部屋が映ってるのかもな。","","\\n<経蔵>Maybe this room is shown in the cursed video."],["\\n<\\N[2]>この部屋……\\.\\.昨晩私がネットの動画で見たものと\n特徴が極めて似ています。","","\\n<\\N[2]>This room...\\.\\.What I saw on the internet video last night\nThe characteristics are very similar."],["\\n<経蔵>おいおい……。\\N[2]お前も、\n別の動画を見ようとして呪いの動画を見ちまったクチか？","","\\n<経蔵> Hey hey... \\N[2] You too,\nDid you end up watching the cursed video while trying to watch another video?"],["\\n<\\N[2]>はい。おっしゃる通り、\nこの部屋の動画が急に流れまして……。","","\\n<\\N[2]> Yes. As you said,\nA video of this room suddenly came out..."],["\\n<\\N[2]>なんのＣＭ動画かと妙に思いましたが、\n流行りの怪奇現象だったのでしょうか。","","\\n<\\N[2]>I thought it was some kind of commercial video,\nWas it a popular mysterious phenomenon?"],["\\n<経蔵>しれっと呪われてんじゃねえよ……。","","\\n<経蔵> I'm sure you're not cursed..."],["\\n<珠緒>やっぱりね。そんな気がしてたよ。","","\\n<珠緒> As expected. That's how I felt."],["\\n<珠緒>昨晩なら、貞子が呪い殺しにくる、\n映像を見てからまる２日後よりまだ時間があるね？","","\\n<珠緒> Last night, Sadako came to kill me with a curse.\nThere's still more time than two days after watching the video, right?"],["\\n<経蔵>……そうか。さっき２階の部屋で\n貞子が現れたのは、獲物である\\N[2]を青鬼に\n奪われないようにするため、だろうな。","","\\n<経蔵>...I see. In the room on the second floor earlier\nSadako appeared and took her prey, \\N[2], to the Blue Demon.\nI guess it's to prevent it from being stolen."],["\\n<経蔵>もっとも、\nここは青鬼や伽椰子がホームとしているから、\n貞子でも駆けつけるのが遅れるかもしれねえが。","","\\n<経蔵>However,\nThis is the home of Ao Oni and Kayako,\nEven Sadako might be late in rushing over."],["\\n<\\N[2]>あと……そのときは、ビデオやＤＶＤの棚ばかりで\nこんなに本棚はありませんでしたが。","","\\n<\\N[2]>Also...at that time, the shelves were filled with videos and DVDs.\nThere weren't that many bookshelves."],["\\n<経蔵>本棚にはノートしかないな。","","\\n<経蔵>There's only a notebook on the bookshelf."],["\\n<珠緒>ノートなら、伽椰子の影響かもね？","","If it's a \\n<珠緒> note, maybe it's Kayako's influence?"],["\\n<経蔵>せっかくここまで来たんだ。\nバケモンどもに対抗するヒントとかが\n見つかればいいけどな……","","\\n<経蔵>We've come this far.\nTips on how to fight against monsters\nI wish I could find it..."],["\\n<珠緒>経蔵、かすかだけど依頼人の気配がする。\\!\n\\C[1]左側の棚のどこか。","","\\n<珠緒> Keizo, it's faint, but I feel the presence of the client. \\!\n\\C[1] Somewhere on the left shelf."],["\\n<経蔵>マジかよ……！？","","\\n<経蔵> Seriously...! ?"],["貞子","","Sadako"],["隅の処理","","corner treatment"],["ビデオテープやＤＶＤ、様々なノートを収めた棚が\n目視も及ばないほど彼方まで続いている。","","There are shelves containing video tapes, DVDs, and various notebooks.\nIt continues so far that it can't even be seen with the naked eye."],["はるかに続く棚の列の彼方は、\nゆるやかにカーブしている。","","Beyond the rows of shelves,\nIt is gently curved."],["ふと、この部屋がリング構造になっていて、\n向こうへ歩いていくと１周して同じところに\n戻ってくるのではないか、という考えが脳裏をよぎった。","","Suddenly, this room has a ring structure,\nIf you walk in the other direction, you will go around the same place\nA thought crossed my mind that he might come back."],["被害者のいる棚１","","Victim shelf 1"],["\\n<珠緒>経蔵！！","","\\n<珠緒> Kyozo! !"],["\\n<経蔵>これは……。\\.\\.伽椰子のやつ、殺した連中の魂を\n別のノートにスクラップにして閉じ込めてやがったか。\\!\nさながらヘソクリだな。","","\\n<経蔵>This is... \\.\\. Kayako, the souls of the people I killed.\nDid you scrap it up and lock it up in another notebook? \\!\nIt's just like a belly button."],["\\n<珠緒>こっちのＤＶＤには貞子の被害者の魂が\nまとめられてるみたい。","","\\n<珠緒> This DVD contains the souls of Sadako's victims.\nLooks like it's all together."],["\\n<珠緒>このあたり、貞子や伽椰子に殺されてから\nあまり時間が経っていない人間の魂ばかり……","","\\n<珠緒> Around here, after being killed by Sadako and Kayako.\nAll the souls of humans who haven't spent much time..."],["\\n<経蔵>おいおい。依頼人のあんたもここに来てたか。","","\\n<経蔵> Hey hey. Did you, the client, come here too?"],["\\n<経蔵>余計なマネして死にやがって、俺らへの残りの報酬は\nどうしてくれんだよ。\\!成仏させてやんねえぞ？","","\\n<経蔵>If we die doing unnecessary things, the remaining reward for us is\nWhat can you do for me? \\! I won't let you attain Buddhahood, will you?"],["\\n<経蔵>……そうか。引き継ぎはすませてあるか。\\.\\.ならいい。","","\\n<経蔵>...I see. Have you completed the handover? \\.\\. is fine."],["\\n<経蔵>息子が近くの別の棚に？　わかった。\nとりあえずこの鏡に移ってくれ。","","\\n<経蔵> Is your son on another shelf nearby? Understood.\nFor now, please move to this mirror."],["経蔵さんは印を切りながら、\n懐から出した鏡でスキャナーのように棚をなぞった。","","Mr. Keizo cut the seal and said,\nI traced the shelves like a scanner with a mirror I took out of my pocket."],["\\n<経蔵>よし、目的の棚を探すか。\\!","","\\n<経蔵>Okay, let's find the desired shelf. \\!"],["\\n<経蔵>珠緒、手がかりは依頼人に見せてもらった\n遺品の気配だけだが、いけるな？","","\\n<経蔵> Tamao, the client showed me the clues.\nThere's only a sign of the belongings left behind, but can we go?"],["\\n<珠緒>息子の方の気配は……\\!\n\\C[1]反対側の棚のどこか。","","\\n<珠緒> Is there any sign of my son... \\!\nSomewhere on the shelf opposite \\C[1]."],["\\n<珠緒>依頼人の息子の方の気配は……\\!\n\\C[1]反対側の棚のどこか。","","\\n<珠緒> Is there any sign of the client's son...\\!\nSomewhere on the shelf opposite \\C[1]."],["\\n<経蔵>成仏なら親子いっしょでないとな。","","\\n<経蔵>If we want to attain Buddhahood, we must do it together."],["被害者のいる棚２","","Victim shelf 2"],["\\n<珠緒>ここ。青鬼に最近殺された人の魂がまとまってる。","","\\n<珠緒> here. The souls of those recently killed by the blue demon are gathered together."],["\\n<経蔵>\\N[2]、この屋敷で死んだお前の友達３人も\nこの鏡に回収した。","","\\n<経蔵>\\N[2], three of your friends died in this mansion too.\nI collected it in this mirror."],["\\n<経蔵>さっきまで屋敷の中にいたが、\n途中でバケモンに捕まってここに封じられたらしい。\\!\nあとで成仏の手配をするからな。","","\\n<経蔵>I was inside the mansion until just now,\nApparently he was captured by a monster on the way and sealed here. \\!\nI'll make arrangements for Buddhahood later."],["\\n<\\N[2]>ありがとうございます。","","\\n<\\N[2]> Thank you."],["\\n<経蔵>礼なら俺らに除霊の依頼をしたやつに言いな。\\!\nもう仏壇越しになるだろうが。","","\\n<経蔵> If you're grateful, tell the person who asked us to exorcise them. \\!\nIt will probably be over the Buddhist altar."],["\\n<経蔵>報酬に見合う仕事をしているだけだ。","","\\n<経蔵> I'm just doing the job I'm being paid to do."],["\\n<珠緒>経蔵、あたしたちが今まで調べた限りの\n犠牲者の魂はだいたい集められたと思う。","","\\n<珠緒>Kyozo, as far as we have investigated so far.\nI think most of the victims' souls have been collected."],["\\n<経蔵>ああ。小林のカミさんと娘の魂も\n回収できたしな。","","\\n<経蔵> Oh. The souls of Kobayashi's kami and her daughter too.\nI was able to recover it."],["\\n<経蔵>バケモンどもが青鬼の屋敷に集合してくれた\nおかげかもな。手間がはぶけたぜ。","","\\n<経蔵> The monsters gathered at Ao Oni's mansion.\nMaybe it's thanks to you. It cost me a lot of time."],["\\n<経蔵>この部屋の連中全員連れていきたいが、\nこの鏡ではあと、「これは」というやつを数人入れて\n満員てとこだな……。","","\\n<経蔵> I want to take everyone in this room with me, but...\nIn this mirror, I added a few people who said, ``This is it.''\nIt's packed..."],["\\n<経蔵>思わぬ収穫を済ませたところで\n\\C[1]↓の方から出られるか試そう。\\!\n\\C[0]表でひと仕事あるからな。","","\\n<経蔵> After finishing the unexpected harvest\nLet's see if we can exit from \\C[1]↓. \\!\nI have some work to do on the \\C[0] table."],["\\n<経蔵>屋敷の外に仕掛けた結界を発動させる。\\!\nそれで、屋敷に取り憑いてる異空間ごと\nバケモンどもを封印して、呪いも封印だ。","","\\n<経蔵> Activate the barrier set up outside the mansion. \\!\nSo, the different space that haunts the mansion.\nThe monsters are sealed, and the curse is also sealed."],["\\n<珠緒>ありとあらゆる生き物が発した恨みつらみの思いが\nビデオテープやＤＶＤ、あるいはノートになって\nここに具現化しているね……。","","\\n<珠緒>The feelings of resentment emitted by all kinds of living things\nBecome a videotape, DVD, or notebook.\nIt's materialized here..."],["\\n<経蔵>ふっ。いまはネット動画の時代だから、\nそのうちＵＳＢメモリやＳＤカード、\nポータブルハードディスク、もっとすると……","","\\n<経蔵> Huh. This is the age of online video, so\nAmong them, USB memory, SD card,\nPortable hard disk, more..."],["\\n<経蔵>でかいネットワークサーバーの機械なんかが\nここに記録メディアとして並ぶようになるかもしれないな。","","\\n<経蔵> There's a huge network server machine.\nMaybe it will become available here as a recording medium."],["\\n<珠緒>そんなモノが貞子や伽椰子、青鬼に\n力を与えているとしたら……。","","\\n<珠緒> Things like that happen to Sadako, Kayako, and Aooni.\nIf you are giving power..."],["\\n<珠緒>できる限りの強力な結界を用意したけど、\nダメモト感しかないね。","","\\n<珠緒> I prepared the strongest barrier possible, but\nIt just feels like crap."],["\\n<経蔵>ああ。\\.\\.一介の霊能者が除霊、\nなんてできるシロモノじゃねえ……。\nここに来て、はっきりとそれがわかった。","","\\n<経蔵>Oh. \\.\\.A single psychic exorcised a spirit.\nIt's not something I can do...\nNow that I'm here, I can clearly see that."],["\\n<経蔵>並々ならねえ手段をもってしないと、\nカスリ傷ひとつ負わせられないだろうな。","","\\n<経蔵>If you don't use extraordinary means,\nI don't think I'll be able to inflict even a single scratch."],["\\n<経蔵>あの結界は足止めと割り切る。\n次の作戦のために、今日は生きて帰ろう。\\!\nいいな？","","\\n<経蔵>That barrier is a hindrance.\nLet's go home alive today for the next operation. \\!\nNice?"],["ひろし","","Hiroshi"],["経蔵","","Sutra"],["珠緒","","Tamao"],["伽椰子","","Kayako"],["青鬼","","Ao Oni"],["呪い滅ぼすもの","","curse destroyer"],["EV014","","EV014"],["『天然痘の変遷』というＤＶＤがある。\\!\n井戸の底で力なく佇む、貞子らしき人物が\nパッケージにある。","","There is a DVD called ``The Evolution of Smallpox.'' \\!\nA person who looks like Sadako stands helplessly at the bottom of the well.\nIt's in the package."],["\\n<珠緒>……これが、撲滅されたっていう\nウィルス自身の呪いの気配……？？\\!\n貞子っぽいけど基本的にノイズ……みたいな。","","\\n<珠緒>...This means it has been eradicated.\nSigns of the virus's own curse...? ? \\!\nIt looks like Sadako, but it's basically noise... or something like that."],["\\n<経蔵>なるほど。\\.\\.ウィルスだけに呪うときも\n人間の呪う気持ちと合体する必要があるのかもな。","","\\n<経蔵> I see. \\.\\. Even when I curse only the virus\nMaybe it needs to be combined with the human feeling of cursing."],["\\n<経蔵>ウィルスが貞子の気配を帯びているのは、\n貞子に憑依したからかもしれない。","","The reason why the \\n<経蔵> virus has the presence of Sadako is because\nIt might be because he possessed Sadako."],["EV015","","EV015"],["『実録ＤＶ』というＤＶＤがある。\\!\nホラー映画のようなパッケージだ。","","There is a DVD called ``True Record DV''. \\!\nIt's packaged like a horror movie."],["主に「夫→妻」「父→子供」のＤＶの\n実態を扱っているようだ。\\!\nパッケージ裏の一部に、伽椰子らしき女性の姿がある。","","Mainly DV of “husband → wife” and “father → child”\nIt seems like you're dealing with reality. \\!\nOn the back of the package, there is a figure of a woman who looks like Kayako."],["\\n<珠緒>伽椰子のように傷つけられたり\n殺されたりした……\\.\\.ざっと数百人ぶんの無念が\n込められてるね。","","\\n<珠緒> Hurt like a Kaya palm tree\nI was killed... \\.\\. I feel the regret of roughly hundreds of people.\nIt's packed in."],["\\n<経蔵>まさか伽椰子、こんなとこでそのスジの\n編集長にでもなってんのかよ？","","\\n<経蔵> Kayako, that streak in a place like this.\nHave you become the editor-in-chief?"],["EV016","","EV016"],["『大自然紀行』というＤＶＤがある。\\!\n触れるだけで走馬灯のように景色が胸の内を\n流れていく。","","There is a DVD called ``Natural Journey''. \\!\nJust by touching it, the scenery moves through my heart like a running lantern.\nIt flows."],["\\n<\\N[2]>デッキが不要とは。","","\\n<\\N[2]> There is no need for a deck."],["\\n<経蔵>ここにあるのは、\n霊力で具現化されたものばかりだからな。\\!\n誰の力によるかは特定できないが。","","\\n<経蔵> What we have here is\nBecause they are all materialized by spiritual power. \\!\nAlthough it is not possible to specify whose power it is."],["\\n<\\N[2]>しかし、浮かぶ景色は私の知る限り、\n現在では開発などで失われた場所ばかり……？？","","\\n<\\N[2]>However, as far as I know, the floating scenery is\nNowadays, there are only places that have been lost due to development etc...? ?"],["\\n<珠緒>……その地域そのものの、無念かもね。","","\\n<珠緒>...Maybe it's the regret of the area itself."],["EV017","","EV017"],["『反駁（はんばく）の実録ＤＶ』というＤＶＤがある。\\!\nホラー映画のようなパッケージだ。","","There is a DVD called ``Rebuttal DVD''. \\!\nIt's packaged like a horror movie."],["主に「妻→夫」「子供→父」のＤＶの\n実態を扱っているようだ。","","Mainly DV of “wife → husband” and “child → father”\nIt seems like you're dealing with reality."],["\\n<珠緒>！！　\\.\\.気配の一部に\n佐伯剛雄（伽椰子の夫）がいる。","","\\n<珠緒>! ! Part of the \\.\\. sign\nThere is Takeo Saeki (Kayako's husband)."],["\\n<経蔵>俊雄のオヤジよお……。\\!\n女房に負けねえ片恨みっぷりだな？\nある意味お似合いの夫婦だぜ？","","\\n<経蔵> Toshio's old man... \\!\nHe has a grudge against his wife, doesn't he?\nIn a sense, they are a well-matched couple, aren't they?"],["\\n<珠緒>剛雄、伽椰子に憑いている悪意と同じ気配が\n霊体に残ってるね。","","\\n<珠緒> Takeo feels the same presence of malice possessing Kayako.\nIt remains in the spirit body."],["\\n<経蔵>……あんたも、頭に血が上りやすいところを\n利用されて女房殺しをさせられたクチか。","","\\n<経蔵>...You also have a place where blood tends to rush to your head.\nWas it Kuchi who was used and forced to kill his wife?"],["\\n<経蔵>これで必要以上に腹を立てることもないだろう。\\!\nあらためて懺悔するなら成仏の手配をしてやるが。","","\\n<経蔵> This won't make you any more angry than necessary. \\!\nIf you repent again, I will arrange for you to become a Buddha."],["\\n<経蔵>……いいだろう。","","\\n<経蔵>...That's fine."],["伽椰子の夫らしき人物の魂が\n経蔵さんの鏡に回収されたようだ。","","The soul of a person who seems to be Kayako's husband\nIt seems that it was recovered by Keizo-san's mirror."],["となりで経蔵さんとのやりとりを聞く\n（電話で通話中の様子に似ている）\n限りでは、","","Listen to the exchange with Keizo-san next door.\n(Similar to being on a phone call)\nAs far as"],["彼は死後も今日まで立腹したままで、\n胸では分かっていながら反省することも思い直すことも\nできずに内心困っていたらしい。","","Even after his death, he remains angry to this day.\nEven though I know it in my heart, I can reflect on it and reconsider it.\nIt seems like he was in deep trouble because he couldn't do it."],["\\n<経蔵>自分が怒る以上に怒らされ、\n恨む以上に恨まされているもんだな。意外と。\\!\n黒幕のような悪意に……。","","\\n<経蔵> I was even more angry than I was,\nI guess I'm hated more than I hate him. Surprisingly. \\!\nWith malicious intent like a mastermind..."],["\\n<経蔵>自分もとことん怒り、恨んでるから\n自分で気づくことも、思い改めることも難しい……。","","\\n<経蔵> I'm also extremely angry and hateful.\nIt's difficult to realize this on your own or change your mind..."],["EV018","","EV018"],["『ふるさとの水源』というＤＶＤがある。\\!\n井戸の傍らで、貞子らしき人物が静かに\n腰掛けている様子がパッケージにある。","","There is a DVD called ``Hometown Water Source''. \\!\nA person who appears to be Sadako is standing quietly next to the well.\nThe package shows him sitting."],["\\n<珠緒>……別の意志のカタマリが貞子の仮面を\nかぶってるような感じがする。","","\\n<珠緒>...A Katamari of another will wears Sadako's mask.\nIt feels like I'm wearing a hat."],["\\n<経蔵>貞子、肖像権のレンタルでも\nはじめたのか……？","","\\n<経蔵> Sadako, even renting portrait rights\nHave you started...?"],["内容は、地域に愛されてきた\n井戸、池、温泉などが次第に忘れ去られ……","","The content has been loved by the local community.\nWells, ponds, hot springs, etc. were gradually forgotten..."],["あるものは埋められ、破壊されて\nなくなっていく変遷が……\\.\\.胸に流れ込んでくる。","","Some are buried and destroyed\nThe changes that are disappearing... \\.\\. flows into my heart."],["EV019","","EV019"],["『ある森の最期』というＤＶＤがある。\\!\n人々の手によって次々と失われる森林の様子が\n幾重にも胸に流れ込んでくる。","","There is a DVD called ``The End of a Forest''. \\!\nThe state of forests being lost one after another due to the hands of people\nIt flows into my chest over and over again."],["最後にこう締めくくられる……。","","In the end, it concludes like this..."],["もっとも罪深い一族のひとりは、\nいつか我らの代弁者となるだろう。","","One of the most sinful families\nOne day he will be our advocate."],["無慈悲に伐り倒された我らのように\n足腰の自由を奪われ、死後なおそれは続く。\\!\n永遠に我らと一体となって苦悩を世に訴え続けるのだ。","","Like us who were cut down without mercy.\nThe freedom of the legs and hips is taken away, and the fear continues even after death. \\!\nThey will forever be one with us and continue to express their suffering to the world."],["\\n<経蔵>足腰の自由を奪われる……\\!\n伽椰子のことか……？","","\\n<経蔵> Freedom of legs and hips is taken away...\\!\nAre you talking about Kayako...?"],["\\n<珠緒>どうかな……","","\\n<珠緒> I wonder..."],["EV020","","EV020"],["『輝く田園風景』というＤＶＤがある。\\!\n胸に流れてくるのは、美しい実りの田畑の様子だ。","","There is a DVD called ``Shining Countryside''. \\!\nWhat comes to my mind is the image of a beautiful, fruitful field."],["しかし、時代を経るごとにさびれていったり、\n宅地や工場になったり、そこもまた……\\.\\.すさんでゆく\n様子で締めくくられていた。","","However, as time passed, it became deserted,\nIt becomes a residential area or a factory, and those places are also becoming... \\.\\.\nIt was concluded by the situation."],["\\n<珠緒>……田んぼの祟り、みたい。","","\\n<珠緒>...It looks like the curse of the rice fields."],["EV021","","EV021"],["『どうぶつの気持ち』というＤＶＤがある。\\!\n犬や猫、ハトやカラスなどの生き物の視点と立場で、\n人々から虐待を受ける様子が胸に流れ込んでくる。","","There is a DVD called ``Animal Feelings''. \\!\nFrom the viewpoint and position of living things such as dogs, cats, pigeons and crows,\nThe images of being abused by people flow into my heart."],["実際に身体のあちこちが痛みを感じる。\\!\nすぐれたＶＲ（バーチャルリアリティ）だが……\n内容が内容だけに、気分はすぐれない。","","I actually feel pain all over my body. \\!\nExcellent VR (virtual reality), but...\nI'm not feeling well, just because of the content."],["\\n<経蔵>ごめんな……。\\.\\.\n今の俺たちの力じゃ、凝り固まってでかい妖怪になった\nお前らを成仏させてやれねえ……。","","\\n<経蔵> I'm sorry.... \\.\\.\nWith our current power, we have hardened into a huge monster.\nI can't let you attain Buddhahood..."],["EV022","","EV022"],["\\n<珠緒>ささってるノート、\nみんな伽椰子の気配がする……。","","\\n<珠緒> Note that is stuck,\nEveryone feels like Kayako..."],["\\n<経蔵>だが、内容は別人のものばかりだ。\n開いたらそれぞれ違う人間の気配が出てくる。","","\\n<経蔵>, but the contents are all from other people.\nWhen opened, each sign of a different person appears."],["\\n<経蔵>見てみろよ。伽椰子のノートに負けず劣らずの\nブッとんだ手記や落書きが満載だ。\\!\n意味の通じる字と文章で読めるのはまだいい方だ……","","Look at \\n<経蔵>. As good as Kayako's notebook\nIt's full of vague notes and doodles. \\!\nIt's still better to be able to read words and sentences that make sense..."],["\\n<経蔵>こいつらが伽椰子に力を与えているのか、\n\\.\\.それとも……？","","\\n<経蔵>Are these guys giving power to Kayako?\n\\.\\. Or...?"],["EV023","","EV023"],["\\n<経蔵>貞子が趣味で聞いていたＣＤでもありゃ、\nおもしろいんだけどな。","","\\n<経蔵>If it's a CD that Sadako listens to as a hobby,\nIt's interesting though."],["\\n<珠緒>焼け石に水。\nスズメの涙にもならないね。\\!\n貞子相手じゃ、そのぐらいじゃ揺さぶれない。","","\\n<珠緒> Water on a hot stone.\nIt's not even a sparrow's tear. \\!\nAgainst Sadako, I can't shake her like that."],["\\n<経蔵>だろうけどな……。\\!\nワラでもいいから欲しくなるな。\n決め手の足しになるものが。","","It's probably \\n<経蔵> though... \\!\nEven if it's just straw, I don't want it.\nSomething that will help you decide."],["黒い表紙のノートがある。\\!\n手に取ると、頭の中に声が流れ込んできた。","","There is a notebook with a black cover. \\!\nWhen I picked it up, a voice came into my head."],["\\C[7]選ばれた人間の論理なんて、もうまっぴらだ……\\!\n俺（こちら）の論理……\\.\\.\n世の中のあらゆる連中に思い知らせて……","","\\C[7] The logic of the chosen people is completely useless... \\!\nMy (this) logic...\\.\\.\nLet everyone in the world know..."],["思わずノートを戻した。","","I instinctively put the notebook back."],["\\n<経蔵>呪う気だけなら\n貞子や伽椰子に劣らない連中がゴロゴロいるぜ。\\.\\.\n気をつけな。","","\\n<経蔵>If you just want to curse\nThere are a lot of people who are no worse than Sadako and Kayako. \\.\\.\nBe careful."],["EV024","","EV024"],["\\n<経蔵>俺らが呪いの部屋に来れたのは、\n貞子が青鬼の屋敷に来た影響で……","","\\n<経蔵>We came to the cursed room because\nDue to the influence of Sadako coming to Ao Oni's mansion..."],["\\n<経蔵>呪いの部屋に本棚ができたのは、\n伽椰子が青鬼の屋敷に来た影響だろうな。","","\\n<経蔵>The bookshelf was created in the cursed room because\nI guess it was the influence of Kayako coming to Ao Oni's mansion."],["EV025","","EV025"],["『校内犯罪被害の記録』という手記がある。\\!\n大小のいじめ被害の記録が克明に……","","There is a memo called ``Record of School Crime Victims''. \\!\nA clear record of victims of bullying, big and small..."],["\\n<経蔵>だいじょうぶか。\\!ノートに化けた連中、\n無念が強すぎて……、幻覚でだろうが、\n読んでたお前を同じ目に遭わせて殺そうとしていた。","","\\n<経蔵> Are you okay? \\!People disguised as notes,\nMy regret was so strong...it was probably just a hallucination, but...\nHe was about to kill you by making you suffer the same fate as you read it."],["\\n<珠緒>すっかり化け物になってるね……","","\\n<珠緒> You've completely turned into a monster..."],["『校内犯罪被害の記録』という手記がある。\\!\n大小のいじめ被害の記録が克明に記されているが、\n読むと幻覚ながら、同じ被害に遭わされてしまうらしい。","","There is a memo called ``Record of School Crime Victims''. \\!\nThere are clear records of victims of bullying, both large and small.\nIt seems that if you read it, you will be subjected to the same damage, albeit a hallucination."],["\\n<経蔵>こいつらの成仏は、出直してこないと無理だ。\nいまは３大バケモンの相手で手いっぱいだからな……","","\\n<経蔵> It will be impossible for these guys to attain Buddhahood unless they come back.\nRight now, I have my hands full with the three major monsters..."],["EV026","","EV026"],["--------------------------------------","","--------------------------------------"],["\\n<\\N[2]>それにしても、人の気配や魂の区別というものが\nそんなに細かくわかるものなのですか？","","\\n<\\N[2]>Anyway, there is no such thing as distinguishing between people's signs and souls.\nIs it really that detailed?"],["\\n<経蔵>ああ。特に珠緒は一度覚えた人間や妖怪の気配は\n細かいところまでよく覚えてくれる。","","\\n<経蔵> Oh. In particular, Tamao once remembered the signs of humans and monsters.\nHe remembers details well."],["\\n<経蔵>遺品からでも、\n魂の居場所を探ることができるんだ。","","\\n<経蔵> Even from the belongings,\nYou can find where your soul is."],["\\n<\\N[2]>麻薬捜査犬のようですね。","","\\n<\\N[2]> Looks like a drug detection dog."],["\\n<経蔵>ふっ。俺もそう思う！","","\\n<経蔵> Huh. I think so too!"],["\\n<経蔵>ホメてんだよ♪","","\\n<経蔵> I'm home♪"],["\\n<\\N[2]>（私も、けなしたつもりはなかったのですが……）","","\\n<\\N[2]> (I didn't mean to belittle either...)"],["EV027","","EV027"],["古びたノートがある。\\!\nしかし、異様な存在感を放っている。","","I have an old notebook. \\!\nHowever, it gives off a strange presence."],["\\C[8]しにたいしに死にたい死にたいしに死死死にたいしにたい死にたいしにたいし\nにたい死死死にたい死死死たいし死に死に死にたい死死死にたいしにたいしに\nたい死に死にたいしし死死死たいしにた死にたい死に死にたいしにたいしに\nしにたい死にたいいしし死にたい死死死にたいしにた死にたいしにたいしに","","\\C[8] I want to die, I want to die, I want to die, I want to die, I want to die, I want to die.\nI want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die\nI want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die\nI want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die, I want to die."],["誰でもいいからこの気持ちを\n\\C[7]身をもって\\C[0]思い知ってほしい。","","Anyone can feel this way\n\\C[7]I want you to know \\C[0] firsthand."],["\nだれでもいいから………………","","\nIt doesn't matter who you are..."],["\\n<珠緒>……死にたいのか生きたいのか、\nはっきりしない気配。\\!\n敵意なのか懇願なのかも分からない。","","\\n<珠緒>...Do you want to die or live?\nAn unclear sign. \\!\nI don't know if it's hostility or pleading."],["\\n<経蔵>そうか、「呪い」というのは\n「生きたい」という意欲がこじれたもの\nなのかもしれない。","","\\n<経蔵> I see, \"curse\" is\nThe desire to live is strained\nIt might be."],["\\n<経蔵>ふっかけられる方は\nたまったもんじゃねえけどな。","","\\n<経蔵>For those who get hooked on\nIt's not something I've accumulated."],["\\n<経蔵>無差別に訴えたいところ悪いが、\nお手柔らかにな。\\!\n助ける方も、できることに限りがあるからな……","","\\n<経蔵> It's bad that I want to sue indiscriminately, but\nBe gentle. \\!\nEven those who can help are limited in what they can do..."],["\\n<経蔵>あいにく今は、いままで依頼されたぶんの\n３大バケモンの被害者の魂を回収するので\n精一杯だ……。","","\\n<経蔵>Unfortunately, I am currently unable to do anything that I have been asked to do.\nBecause we collect the souls of the victims of the three major monsters.\nI'm doing my best...."],["EV028","","EV028"],["ラベルも基材も漆黒のＣＤがある。\\!\n手に取ると、どこからか声が聞こえてきた。","","Some CDs have jet black labels and base material. \\!\nWhen I picked it up, I heard a voice coming from somewhere."],["\\C[7]ただの人間に憑いても、\n食べ物に縫い針を入れたり、病院で点滴に毒物を入れたりと、\nセコいことしかできない。","","\\C[7] Even if it possesses a mere human,\nThings like putting sewing needles in food and putting poison into intravenous drips at hospitals.\nI can only do stupid things."],["\\C[7]貞子は神だ……。\\!\nあらゆる呪いの代弁をしてくれる……。","","\\C[7] Sadako is a god... \\!\nHe speaks for all kinds of curses..."],["\\C[7]貞子と力を合わせれば、殺処分し返してやれる……。\\!\n俺を（社会的に）殺害した、あらゆる連中に……。\\!\n私をハブり殺した、あいつらに……。","","\\C[7] If we join forces with Sadako, we can kill him and get him back... \\!\nTo all the people who murdered me (socially)... \\!\nTo those guys who killed me..."],["\\n<\\N[2]>世を騒がす猟奇事件は\n彼らからのメッセージなのでしょうか……。","","\\n<\\N[2]>The bizarre incident that caused a stir in the world\nIs it a message from them?"],["ラベルも基材も漆黒のＣＤがある。\\!\n手に取ると、老若男女の恨みごとが何重にも折り重なって\n聞こえてくる。","","Some CDs have jet black labels and base material. \\!\nWhen I picked it up, I saw many layers of grudges between men and women of all ages.\nI can hear it."],["ただ、全体の雰囲気はなぜか……、\\!\n彼らが「ＳＯＳ」を発しているようにも感じとれた。","","However, for some reason the overall atmosphere is... \\!\nIt also felt like they were sending out an \"SOS\"."],["\\n<経蔵>てめえら、俺たちの前に立ちはだかるなら\nコミュ力（りょく）ブチ込んでやる。\\!\n覚悟しとけ。","","\\n<経蔵>, if you stand in our way\nI'll use my communication skills. \\!\nBe prepared."],["\\n<珠緒>一瞬だけ気配が笑顔になった。","","\\n<珠緒>For a moment, the presence smiled."],["\\n<珠緒>だめだよ期待しちゃ。\\!\n呪ってる方がまだ幸せだと思い知るから……。","","\\n<珠緒> Don't get your hopes up. \\!\nBecause I realize that those who curse are still happy..."]],"context":[["Map115/events/1/name"],["Map115/events/1/pages/0/list/3/message/hasPicture/bottom"],["Map115/events/2/name"],["Map115/events/2/pages/0/list/1/message/hasPicture/top"],["Map115/events/2/pages/0/list/5/message/hasPicture/top"],["Map115/