nd"],["Map002/events/14/pages/0/list/6/Plugin Command"]],"tags":[null,null,null,null,null,null,null,null,null,["blue"],["blue"],null,null,null,null,null,["red"],["red"],["red"],["red"],["red"],["red"],["red"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"青":5,"EV007":6,"青ルート補正":7,"青位置設定":8,"--------------------\n■デバッグモード":9,"--------------------":10,"ランダム青出現設定":11,"EV011":12,"EV012":13,"EV013":14,"絵本ピクチャdiscard":15,"DiscardPicture book0":16,"DiscardPicture book1":17,"DiscardPicture book2":18,"DiscardPicture book3":19,"DiscardPicture book4":20,"DiscardPicture book5":21,"DiscardPicture book6":22},"extension":"json","dataType":"map","filename":"Map002","basename":"Map002.json","path":"data/Map002.json","relPath":"data/Map002.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":23,"length":23,"percent":100},"cellInfo":[[null,{"t":"HU","v":1}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[0,1]},"data/Map003.json":{"data":[["青","blue","blue"],["EV002","EV002","EV002"],["EV003","EV003","EV003"],["EV004","EV004","EV004"],["EV005","EV005","EV005"],["EV006","EV006","EV006"],["入口","entrance","entrance"],["EV008","EV008","EV008"],["ＯＰ卓郎","OP Takuro","OP Takuro"],["ＯＰひろし","OP Hiroshi","OP Hiroshi"],["ＯＰ美香","OP Mika","OP Mika"],["ＯＰたけし","OP Takeshi","OP Takeshi"],["ＯＰデモ・サダカヤＥＶ","OP demo Sadakaya EV","OP demo Sadakaya EV"],["--------------------\n■ここからプレイ時間計測開始","--------------------\n■Start measuring play time from here","--------------------\n■Start measuring play time from here"],["--------------------\n■鳥が飛んでいくアニメーション","--------------------\n■Animation of birds flying","--------------------\n■Animation of birds flying"],["--------------------","--------------------","--------------------"],["--------------------\n■ナレーション、場所移動\n（通常編・コミカル編）","--------------------\n■Narration, location movement\n(Normal edition/Comical edition)","--------------------\n■Narration, location movement\n(Normal edition/Comical edition)"],["町外れにある無人の館\\!\nそこにはお化けが出るという噂があった","An uninhabited mansion on the outskirts of town \\!\nThere were rumors that there were ghosts there.","We heard a rumor about a mansion\non the outskirts of town... \\!\nThey say there is a monster that lives there..."],["DiscardCharacter !$165-Small07","DiscardCharacter !$165-Small07","DiscardCharacter !$165-Small07"],["DiscardCharacter !$166-Small08","DiscardCharacter !$166-Small08","DiscardCharacter !$166-Small08"],["DiscardTilesets 3","DiscardTilesets 3","DiscardTilesets 3"],["------------------------------------\n■以下ハッカドール編用ＯＰデモ","------------------------------------\n■The following OP demo for Hacka Doll edition","------------------------------------\n■The following OP demo for Hacka Doll edition"],["------------------------------\nハッカドール一同、\nカメラ目線へ挨拶\n------------------------------","------------------------------\nAll the hackadors,\nGreetings to the camera\n------------------------------","------------------------------\nAll the hackadors,\nGreetings to the camera\n------------------------------"],["\\n<\\I[\\V[83]] \\C[6]１号>君にシンクロするパーソナルエンタメＡＩ、\nハッカドールに、お化け屋敷の探索も\nおまかせですっ！！","\\n<\\I[\\V[83]] \\C[6]１号> Personal entertainment AI that synchronizes with you,\nExplore a haunted house with Hacka Doll\nIt's up to you! !","\\n<\\I[\\V[83]] \\C[6]Unit 1>Leave the haunted mansion exploration\nto Hacka Doll-\nThe personal entertainment AI that syncs with you!!"],["------------------------------\nでも、乗り気でないメンバー\n２名（汗）\n------------------------------","------------------------------\nHowever, members are reluctant\n2 people (sweat)\n------------------------------","------------------------------\nHowever, members are reluctant\n2 people (sweat)\n------------------------------"],["-----------------------------------\n◆サダカヤ編ではピクチャ１５番を\n　暗転用に使用。","-----------------------------------\n◆Picture number 15 in Sadakaya edition\nUsed for dark conversion.","-----------------------------------\n◆Picture number 15 in Sadakaya edition\nUsed for dark conversion."],["--------------------\n■ナレーション、場所移動\n（サダカヤ編）","--------------------\n■Narration, location movement\n(Sadakaya edition)","--------------------\n■Narration, location movement\n(Sadakaya edition)"],["　　　　住宅街からほんの１５分ほど歩いた山の中にある空き家\\!\n　　　　いつからそこにあるのか、\\!\n　　　　誰が住んでいたのかも分からないその館には、","An empty house in the mountains just 15 minutes walk from the residential area \\!\n　　　　Since when is it there? \\!\n　　　It is unknown who lived in that mansion,","An abandoned house nestled in the mountains,\njust a 15 minute walk from town.\\!\nNo one knows how long it's been there, or who used to live there."],["\n　　　　　　　　　お化けが出るという噂があった。","\nThere were rumors that a ghost would appear.","\n        There were rumors that a ghost appeared there."],["-----------------------------------------\n伽耶子邸のカバーはＩＤ固定とする。\nなお、１Ｆ部はあと２つ部屋が設定上あるので、\n念のためＩＤを空けておく(12,13,14)\nID:4 は、２Ｆ廊下用。念のため","-----------------------------------------\nThe cover of Kayako's residence will have a fixed ID.\nIn addition, there are two more rooms on the 1st floor, so\nJust in case, leave your ID blank (12, 13, 14)\nID:4 is for the 2nd floor hallway. just in case","-----------------------------------------\nThe cover of Kayako's residence will have a fixed ID.\nIn addition, there are two more rooms on the 1st floor, so\nJust in case, leave your ID blank (12, 13, 14)\nID:4 is for the 2nd floor hallway. just in case"],["------------------------------------","------------------------------------","------------------------------------"],["-------------------------------------\n経蔵と珠緒が館に入るシーン","-------------------------------------\nScene where Keizo and Tamao enter the mansion","-------------------------------------\nScene where Keizo and Tamao enter the mansion"],["-------------------------------------\n経蔵、霊術で解錠","-------------------------------------\nUnlocked through sutras and spiritual techniques","-------------------------------------\nUnlocked through sutras and spiritual techniques"],["\\n<男>おおい。\\.\\.お前、そこで何ぼさっと突っ立ってんだ。\nとりあえず出てこいよ？","\\n<男> Hey. \\.\\. Why are you just standing there?\nWhy don't you come out for now?","\\n<Man> Hey. \\.\\. Why are you just standing there?\nJust come on out, will you?"],["-------------------------------------\nひろし、経蔵に応じて出てくる","-------------------------------------\nHiroshi appears depending on the sutra.","-------------------------------------\nHiroshi appears depending on the sutra."],["\\n<男>ここは肝試しをしていいような場所じゃねえんだぞ？","\\n<男>This isn't the place to test your mettle, is it?","\\n<Man>This is a place you shouldn't even go on a dare, you know?"],["\\n<\\N[2]>確かにその通りだったと思います。\\.\\.\nですが、２度目は自分の意志ではなくて……","\\n<\\N[2]> I think that's certainly true. \\.\\.\nHowever, the second time was not my will...","\\n<\\N[2]> I understand that. \\.\\.\nHowever, this second time is not of my own free will..."],["\\n<男>ぁあ？？","\\n<男> Ah? ?","\\n<Man>Eh?"],["--------------------------------------\n俊雄、フワッティー、待機","--------------------------------------\nToshio, Fuwatty, wait","--------------------------------------\nToshio, Fuwatty, wait"],["　　ふいに現れた男性らと事情を交換した。","I exchanged information with the men who suddenly appeared.","I exchanged information with the men who suddenly appeared."],["\\n<男>……一度とはいえ、\nよく、こんなバケモン屋敷で生き延びられたもんだな。","\\n<男>...Although it was once,\nWell, I guess I was able to survive in a monster mansion like this.","\\n<Man>...Even if it was just the once,\nit's a wonder you survived in a place with such monsters."],["\\n<\\N[2]>私も科学的な力の及ばない化け物への対処で\n苦慮していたところです。\n\n","\\n<\\N[2]> I am also dealing with monsters that are beyond the reach of scientific power.\nThis is what I was thinking about.","\\n<\\N[2]>I've also been struggling with how to deal with\nmonsters that defy scientific explanation."],["\\n<\\N[2]>経蔵（けいぞう）さんに\n珠緒（たまお）さん、でしたね。","\\n<\\N[2]> To Mr. Keizo\nIt was Tamao-san.","\\n<\\N[2]>You are Mr. Keizo, and Ms. Tamao...\nCorrect?"],["\\n<\\N[2]>よろしければ化け物退治のお手伝いに、\nここをご案内させて頂ければと思うのですが。","\\n<\\N[2]>If you'd like, I'd like to help you exterminate the monsters.\nI would like to guide you here.","\\n<\\N[2]>If it's okay with you, I'd like to guide you here,\nto help you kill the monsters."],["\\n<\\N[2]>前回訪れた際に\n間取りはだいたい把握しておりますので。","\\n<\\N[2]>When I visited last time\nI have a rough idea of the floor plan.","\\n<\\N[2]>Since I've been here before,\nI have a rough idea of the floor plan."],["\\n<経蔵>それには及ばねえから帰れ。\\!\n……て言いたいところだが、頼もうか。\n\n","\\n<経蔵> You can't beat that, so go home. \\!\nThat's what I want to say, but let me ask you something.","\\n<Keizo>I won't need that, so go on home. \\!\nAt least, that's what I'd like to say, but I suppose I should\ntake you up on that offer."],["\\n<経蔵>この屋敷の呪いの力で、\nまたここにお前が連れ戻されたら同じことだしな。","\\n<経蔵>With the power of this mansion's curse,\nIf you were brought back here again, the same thing would happen.","\\n<Keizo>If the curse of the mansion brings you back,\nit'll likely go the same, over and over again."],["\\n<\\N[2]>では、案内を務めさせて頂きますが。\\!\n確認ですが、本当に玄関のドアは\nあなたの力で開けることができるのですね？","\\n<\\N[2]> I will be your guide. \\!\nJust to confirm, the front door is really\nYou can open it with your help, right?","\\n<\\N[2]>I will be your guide, then.\\!\nBut just to confirm,\nyou really can open the front door on your own?"],["\\n<経蔵>ああ。さっきもそれで開けた。\\.\\.\n試しに中に入ってみろ。","\\n<経蔵> Oh. I opened it just now. \\.\\.\nTry going inside.","\\n<Keizo>Ah. I was able to open it just the same. \\.\\.\nTry going inside."],["-------------------------------------\nひろし、再び館の中へ\nカギがかかる","-------------------------------------\nHiroshi enters the mansion again.\nIt's locked","-------------------------------------\nHiroshi enters the mansion again.\nIt's locked"],["\\n<珠緒>かわいくないオートロックだね。\\.\\.つくづく。","\\n<珠緒>That's not a cute auto-lock. \\.\\. I'm sorry.","\\n<Tamao>That automatic lock is anything but friendly.\\.\\. I tell you h'what.\n"],["\\n<珠緒>でも経蔵……本当に入るつもり？\\.\\.\n下見に来たときとは……","\\n<珠緒> But Keizo...Are you really planning to enter? \\.\\.\nWhen I came to preview...","\\n<Tamao>But Keizo... Do you really intend to go inside?\\.\\.\nIt's not like it was when we came to scout it out..."],["\\n<経蔵>伽椰子（かやこ）のことだろ？\\!\n俺も強い気配をさっき中から感じた。","\\n<経蔵> You're talking about Kayako, right? \\!\nI also felt a strong presence from inside earlier.","\\n<Keizo>You're talking about Kayako, right?\\!\nI also felt that strong presence from inside a moment ago."],["\\n<経蔵>なぜあいつがここにいるのかは知らねえが、\n結論を言えば……","\\n<経蔵> I don't know why he's here, but...\nIn conclusion...","\\n<Keizo>I don't know why he's here,\nbut the bottom line is..."],["\\n<経蔵>俺たちもすでに伽椰子に“呪われている”\\!\nこの屋敷の呪いを通して、だろうがな。","\\n<経蔵>We are already “cursed” by Kayako\\!\nPerhaps through the curse of this mansion.","\\n<Keizo>We, too, are already “cursed” by Kayako.\\!\nThrough the curse of this house, that is."],["\\n<経蔵>そこで俊雄（伽椰子の息子）と、\nお友だちのバケモンが覗き見してるのが、\nなによりの証明だろう。","\\n<経蔵> There, Toshio (Kayako's son) and\nMy friend's monster is spying on me,\nThat's the best proof of all.","\\n<Keizo>The fact that Toshio (Kayako's son)\nand his monster friend are peaking in,\nis surely the ultimate proof of that."],["\\n<珠緒>うん……","\\n<珠緒>Yeah...","\\n<Tamao>Unh..."],["\\n<経蔵>伽椰子がここを自分の家としているなら、\nすでに下見で足を踏み入れていた俺たちのことも\nターゲットとして殺しにかかってくるだろう。","\\n<経蔵>If Kayako makes this her home,\nAs for those of us who had already stepped foot in the preview,\nThey will try to kill you as a target.","\\n<Keizo>If Kayako considers this place her home,\nshe will likely target, and try to kill us too- since we've\nalready set foot inside during our initial scouting visit."],["\\n<経蔵>だが幸い、周囲にも準備は済ませてある。\\!\n決着をつけるときが来たんだよ。","\\n<経蔵> But fortunately, the people around me had already prepared. \\!\nThe time has come to settle things.","\\n<Keizo>Fortunately, however, the necessary preparations have already\nbeen made.\\!The time has come to settle this once and for all."],["\\n<経蔵>それも、ここを含めて３つの呪いといっぺんに、\\.\\.な……","\\n<経蔵> Also, along with three curses including this one, \\.\\....","\\n<Keizo>And to think, including this one, there are 3 curses at once\\.\\...."],["-------------------------------------","-------------------------------------","-------------------------------------"],["(4,15)を起動","Start (4,15)","Start (4,15)"],["EV014","EV014","EV014"],["画像先読み用です。","This is for image pre-reading.","This is for image pre-reading."],["青位置設定","blue position setting","blue position setting"],["イベント用フワッティー","Fuwatty for events","Fuwatty for events"],["ＯＰ１号","OP No.1","OP No.1"],["ＯＰ２号","OP No.2","OP No.2"],["ＯＰ３号","OP issue 3","OP issue 3"],["ＯＰ４号","OP No.4","OP No.4"],["イベント用俊雄","Toshio for events","Toshio for events"],["イベント用経蔵","Sutra for events","Sutra for events"],["イベント用珠緒","Tamao for events","Tamao for events"],["サダカヤ自動EV","Sadakaya automatic EV","Sadakaya automatic EV"],["コモンイベント(いなくなる)より引き継ぎ","Inherited from common event (disappears)","Inherited from common event (disappears)"],["----------------------------------------------\nおぶっていた珠緒がいなくなっている！\n代わりに俊雄が！\n俊雄は火の玉を消して上の階へ行った。","----------------------------------------------\nTamao, who was carrying me, is gone!\nToshio instead!\nToshio extinguished the fireball and went upstairs.","----------------------------------------------\nTamao, who was carrying me, is gone!\nToshio instead!\nToshio extinguished the fireball and went upstairs."],["\\n<経蔵>青鬼のやつ、思ったより芸達者だな。\n輪切りにされた頭で追ってくるとは……","\\n<経蔵>Ao Oni's guy is more skilled than I expected.\nTo think that he would chase me with a head cut into rings...","\\n<Keizo>That blue monster is more versatile than I expected.\nTo think that it would chase me with its head cut into rings..."],["\\n<経蔵>よし、ここらでいいだろう。\n珠緒、降りろ。","\\n<経蔵> Okay, this is fine.\nTamao, get off.","\\n<Keizo>Alright, this spot should do.\nTamao, get down."],["---------------------------------------------","---------------------------------------------","---------------------------------------------"],["\\n<経蔵>……たしかに、逃げるのに必死で自分の背中までは\n気がまわらなかったな。\\!\nそのスキに珠緒と位置を交換……。\\.\\.\\.やるじゃねえか。","\\n<経蔵>...Certainly, she was so desperate to escape that she even ended up on her own back.\nIt didn't bother me. \\!\nTaking advantage of that, I swapped positions with Tamao... \\.\\.\\. You should do it.","\\n<Keizo>...I ran so desperately that I couldn't tell what was\nhappening behind me.\\!\nIn that moment, she switched places with Tamao...\\.\\.\\. Not bad at all."],["\\n<経蔵>珠緒をどこへやった…\\.…\\.…\\.…\\.…\\.\\.…\\.\\.！？","\\n<経蔵> Where did Tamao go…\\.…\\.…\\.…\\.…\\.\\.…\\.\\.! ?","\\n<Keizo>Where did you take Tamao...\\....\\....\\....\\....\\.\\....\\.\\.!?"],["\n俊雄を追いかけて屋敷の２階へ向かった。","\nI followed Toshio to the second floor of the mansion.","\nI followed Toshio to the second floor of the mansion."],[null,null,null,null,null]],"context":[["Map003/events/1/name"],["Map003/events/2/name"],["Map003/events/3/name"],["Map003/events/4/name"],["Map003/events/5/name"],["Map003/events/6/name"],["Map003/events/7/name"],["Map003/events/8/name"],["Map003/events/9/name"],["Map003/events/10/name"],["Map003/events/11/name"],["Map003/events/12/name"],["Map003/events/13/name"],["Map003/events/13/pages/0/list/0/comment","Map003/events/13/pages/2/list/5/comment"],["Map003/events/13/pages/0/list/4/comment","Map003/events/13/pages/2/list/9/comment"],["Map003/events/13/pages/0/list/43/comment"],["Map003/events/13/pages/0/list/48/comment"],["Map003/events/13/pages/0/list/55/message/hasPicture/middle","Map003/events/13/pages/0/list/10