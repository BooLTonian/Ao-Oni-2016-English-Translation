aderParam":["spiritualists",0,0,2]}],[{"headerIndex":16,"headerParam":["N2",0,1,2]}],[{"headerIndex":19,"headerParam":["",0,1,1]}],[{"headerIndex":23,"headerParam":["N2",0,1,2]}],[{"headerIndex":25,"headerParam":["spiritualists",0,0,2]}],null,[{"headerIndex":2,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":5,"headerParam":["spiritualists",0,0,0]}],null,[{"headerIndex":3,"headerParam":["N2",0,1,0]}],[{"headerIndex":8,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":12,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":19,"headerParam":["N2",0,1,0]}],[{"headerIndex":23,"headerParam":["spiritualists",0,0,0]}],null,[{"headerIndex":0,"headerParam":["--------------------------------------"]}],[{"headerIndex":2,"headerParam":["N2",0,0,2]}],[{"headerIndex":7,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":10,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":13,"headerParam":["N2",0,0,2]}],[{"headerIndex":16,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":20,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":22,"headerParam":["N2",0,0,2]}],null,[{"headerIndex":2,"headerParam":["N2",0,1,0]}],[{"headerIndex":5,"headerParam":["",0,1,1]}],[{"headerIndex":10,"headerParam":["",0,1,1]}],[{"headerIndex":13,"headerParam":["",0,1,1]}],[{"headerIndex":17,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":21,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":25,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":31,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":36,"headerParam":["spiritualists",0,0,0]}],null,[{"headerIndex":3,"headerParam":["N2",0,1,2]}],[{"headerIndex":6,"headerParam":["",0,1,1]}],[{"headerIndex":10,"headerParam":["",0,1,1]}],[{"headerIndex":13,"headerParam":["",0,1,1]}],[{"headerIndex":17,"headerParam":["N2",0,0,2]}],[{"headerIndex":23,"headerParam":["N2",0,1,2]}],[{"headerIndex":27,"headerParam":["N2",0,1,2]}],[{"headerIndex":31,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":38,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":40,"headerParam":["spiritualists",1,0,2]}]],"indexIds":{"EV001":0,"\\n<経蔵>今までで一番強い力で閉じられてるな。":1,"EV002":2,"\\n<珠緒>経蔵、かすかだけど依頼人の気配がする。":3,"\\n<珠緒>\\C[1]左側の棚のどこか。":4,"\\n<経蔵>依頼人の息子を連れてこないとな。":5,"\\n<珠緒>\\C[1]右側の棚のどこか。":6,"-------------------------------------------\n用事を済ませて出ようとすると伽椰子が現れる\n先ほどきた出入り口から貞子、\n上から青鬼が現れる\n３者の決戦が始まる？":7,"\\n<経蔵>意外だな。\nこっち側は開いているみたいだな？":8,"\\n<珠緒>この先は……青鬼じゃなくて伽椰子の家の\nどこかにつながっているみたい。":9,"\\n<経蔵>本人さえ来なきゃさっさと出るだけだ。\n行こうぜ？":10,"先へ進む":11,"一呼吸おく":12,"\\n<経蔵>……伽椰子に出くわしたときの、\n心の準備はしておくか。":13,"-------------------------------------------\nＢＧＳも先読み":14,"AltBgs play Darkness 0 0":15,"\\n<経蔵>あとにしろよ伽椰子！？":16,"\\n<珠緒>経蔵、上！！":17,"\\n<経蔵>お前もかよ……！？":18,"\\n<珠緒>伽椰子がこっちに\nあまり殺気を向けてこない……？？":19,"-------------------------------------------\n化け物球体現る。\n元ネタはロマサガ３の「破壊するもの」\n実際、貞子らの黒幕はその親戚と考える。":20,"AltBgs fadeIn Darkness 0 4 90":21,"\\n<珠緒>貞子、伽椰子、青鬼……\n混ざり合ってひとつになってる……！！":22,"\\n<経蔵>それ以上に、バケモンどうしがぶつかった\nショックで貞子たちの後援会（黒幕）も\nまとめて姿を現したような感じだな。":23,"\\n<経蔵>この様子じゃ、\n『バケモンにバケモンをぶつけて消滅』は、\\.\\.ないな。\\!\n俺の見過ごし、読み違いだ。":24,"CastCommonEventName 珠緒 身震い":25,"\\n<珠緒>あらゆる生き物が発した呪い……\\.\\.\nというよりは……":26,"\\n<珠緒>呪い『そのもの』のような……":27,"\\n<珠緒>“呪い滅ぼす存在（もの）”……！":28,"\\n<経蔵>いいたとえだ。\\!\n誰彼なくウィルスのように取り憑いて、\nそいつが呪う以上に呪わせ、恨む以上に恨ませる。":29,"\\n<経蔵>元の人格を失った、顔なしの意識の塊。\nそんな存在だな。":30,"\\n<経蔵>貞子の呪い＝ウィルス説、てのがあったが、\n遠い説じゃなかったな。":31,"\\n<経蔵>こいつの気配は以前から薄々は感じていたが。\\!\n呪いのド真ん中に来てはっきりしたな。":32,"\\n<\\N[2]>ブラックホールを思わせますね。\\!\n危険なものでなければゆっくり鑑賞したい\nところですが。":33,"\\n<経蔵>もしこいつが直接追ってくるなら……":34,"\\n<\\N[2]>……まさか、戦うんですか？":35,"\\n<経蔵>バカいえ。\\.\\.ここで最終決戦が挑めるほど\n俺たちがファンタジーにできていたら苦労はねえ。":36,"\\n<経蔵>そのかわりさっきも言った、\n最終結界と呼べるモンのある表に行くぞ。":37,"AltBgs fadeOut 0 4":38,"\\n<経蔵>逃げるべきところまで逃げ切るのが、\n俺たちにとっての決戦みてえなモンだ！":39,"AooniKayakoHouseProcess preload":40,"AooniKayakoHouseProcess hide 5":41,"DiscardPicture sdky_cursehole1":42,"DiscardPicture sdky_cursehole2":43,"DiscardTilesets 9":44,"\\n<経蔵>出口がテレビか。\\.\\.ふっ。なるほど。":45,"\\n<経蔵>もしかして、\n伽椰子が出入りしようとしていたおかげで、\nあの部屋から出られたのか……？":46,"\\n<珠緒>化け物たち、どうしたんだろう。\nまだ追ってこないみたい。":47,"\\n<\\N[2]>いまのうちですね。":48,"自動イベント":49,"AltBgs play sdky_sadako2_short":50,"DiscardPicture sdky_blue0b":51,"DiscardPicture sdky_kaisou":52,"---------------------------------------\n座敷牢へ戻る":53,"------------------------------------------\nひろしは、「先日偶然見た変な動画の景色だ」と告白する":54,"\\n<経蔵>ここが、貞子の呪いの中心か。":55,"\\n<珠緒>まちがいない。\n呪いのビデオと同じ気配がこの部屋を満たしてる。\\!\nでも、ものすごく濃い……。":56,"\\n<経蔵>呪いのビデオには、この部屋が映ってるのかもな。":57,"\\n<\\N[2]>この部屋……\\.\\.昨晩私がネットの動画で見たものと\n特徴が極めて似ています。":58,"\\n<経蔵>おいおい……。\\N[2]お前も、\n別の動画を見ようとして呪いの動画を見ちまったクチか？":59,"\\n<\\N[2]>はい。おっしゃる通り、\nこの部屋の動画が急に流れまして……。":60,"\\n<\\N[2]>なんのＣＭ動画かと妙に思いましたが、\n流行りの怪奇現象だったのでしょうか。":61,"\\n<経蔵>しれっと呪われてんじゃねえよ……。":62,"\\n<珠緒>やっぱりね。そんな気がしてたよ。":63,"\\n<珠緒>昨晩なら、貞子が呪い殺しにくる、\n映像を見てからまる２日後よりまだ時間があるね？":64,"\\n<経蔵>……そうか。さっき２階の部屋で\n貞子が現れたのは、獲物である\\N[2]を青鬼に\n奪われないようにするため、だろうな。":65,"\\n<経蔵>もっとも、\nここは青鬼や伽椰子がホームとしているから、\n貞子でも駆けつけるのが遅れるかもしれねえが。":66,"\\n<\\N[2]>あと……そのときは、ビデオやＤＶＤの棚ばかりで\nこんなに本棚はありませんでしたが。":67,"\\n<経蔵>本棚にはノートしかないな。":68,"\\n<珠緒>ノートなら、伽椰子の影響かもね？":69,"\\n<経蔵>せっかくここまで来たんだ。\nバケモンどもに対抗するヒントとかが\n見つかればいいけどな……":70,"\\n<珠緒>経蔵、かすかだけど依頼人の気配がする。\\!\n\\C[1]左側の棚のどこか。":71,"\\n<経蔵>マジかよ……！？":72,"貞子":73,"隅の処理":74,"ビデオテープやＤＶＤ、様々なノートを収めた棚が\n目視も及ばないほど彼方まで続いている。":75,"はるかに続く棚の列の彼方は、\nゆるやかにカーブしている。":76,"ふと、この部屋がリング構造になっていて、\n向こうへ歩いていくと１周して同じところに\n戻ってくるのではないか、という考えが脳裏をよぎった。":77,"被害者のいる棚１":78,"\\n<珠緒>経蔵！！":79,"\\n<経蔵>これは……。\\.\\.伽椰子のやつ、殺した連中の魂を\n別のノートにスクラップにして閉じ込めてやがったか。\\!\nさながらヘソクリだな。":80,"\\n<珠緒>こっちのＤＶＤには貞子の被害者の魂が\nまとめられてるみたい。":81,"\\n<珠緒>このあたり、貞子や伽椰子に殺されてから\nあまり時間が経っていない人間の魂ばかり……":82,"\\n<経蔵>おいおい。依頼人のあんたもここに来てたか。":83,"\\n<経蔵>余計なマネして死にやがって、俺らへの残りの報酬は\nどうしてくれんだよ。\\!成仏させてやんねえぞ？":84,"\\n<経蔵>……そうか。引き継ぎはすませてあるか。\\.\\.ならいい。":85,"\\n<経蔵>息子が近くの別の棚に？　わかった。\nとりあえずこの鏡に移ってくれ。":86,"経蔵さんは印を切りながら、\n懐から出した鏡でスキャナーのように棚をなぞった。":87,"\\n<経蔵>よし、目的の棚を探すか。\\!":88,"\\n<経蔵>珠緒、手がかりは依頼人に見せてもらった\n遺品の気配だけだが、いけるな？":89,"\\n<珠緒>息子の方の気配は……\\!\n\\C[1]反対側の棚のどこか。":90,"\\n<珠緒>依頼人の息子の方の気配は……\\!\n\\C[1]反対側の棚のどこか。":91,"\\n<経蔵>成仏なら親子いっしょでないとな。":92,"被害者のいる棚２":93,"\\n<珠緒>ここ。青鬼に最近殺された人の魂がまとまってる。":94,"\\n<経蔵>\\N[2]、この屋敷で死んだお前の友達３人も\nこの鏡に回収した。":95,"\\n<経蔵>さっきまで屋敷の中にいたが、\n途中でバケモンに捕まってここに封じられたらしい。\\!\nあとで成仏の手配をするからな。":96,"\\n<\\N[2]>ありがとうございます。":97,"\\n<経蔵>礼なら俺らに除霊の依頼をしたやつに言いな。\\!\nもう仏壇越しになるだろうが。":98,"\\n<経蔵>報酬に見合う仕事をしているだけだ。":99,"\\n<珠緒>経蔵、あたしたちが今まで調べた限りの\n犠牲者の魂はだいたい集められたと思う。":100,"\\n<経蔵>ああ。小林のカミさんと娘の魂も\n回収できたしな。":101,"\\n<経蔵>バケモンどもが青鬼の屋敷に集合してくれた\nおかげかもな。手間がはぶけたぜ。":102,"\\n<経蔵>この部屋の連中全員連れていきたいが、\nこの鏡ではあと、「これは」というやつを数人入れて\n満員てとこだな……。":103,"\\n<経蔵>思わぬ収穫を済ませたところで\n\\C[1]↓の方から出られるか試そう。\\!\n\\C[0]表でひと仕事あるからな。":104,"\\n<経蔵>屋敷の外に仕掛けた結界を発動させる。\\!\nそれで、屋敷に取り憑いてる異空間ごと\nバケモンどもを封印して、呪いも封印だ。":105,"\\n<珠緒>ありとあらゆる生き物が発した恨みつらみの思いが\nビデオテープやＤＶＤ、あるいはノートになって\nここに具現化しているね……。":106,"\\n<経蔵>ふっ。いまはネット動画の時代だから、\nそのうちＵＳＢメモリやＳＤカード、\nポータブルハードディスク、もっとすると……":107,"\\n<経蔵>でかいネットワークサーバーの機械なんかが\nここに記録メディアとして並ぶようになるかもしれないな。":108,"\\n<珠緒>そんなモノが貞子や伽椰子、青鬼に\n力を与えているとしたら……。":109,"\\n<珠緒>できる限りの強力な結界を用意したけど、\nダメモト感しかないね。":110,"\\n<経蔵>ああ。\\.\\.一介の霊能者が除霊、\nなんてできるシロモノじゃねえ……。\nここに来て、はっきりとそれがわかった。":111,"\\n<経蔵>並々ならねえ手段をもってしないと、\nカスリ傷ひとつ負わせられないだろうな。":112,"\\n<経蔵>あの結界は足止めと割り切る。\n次の作戦のために、今日は生きて帰ろう。\\!\nいいな？":113,"ひろし":114,"経蔵":115,"珠緒":116,"伽椰子":117,"青鬼":118,"呪い滅ぼすもの":119,"EV014":120,"『天然痘の変遷』というＤＶＤがある。\\!\n井戸の底で力なく佇む、貞子らしき人物が\nパッケージにある。":121,"\\n<珠緒>……これが、撲滅されたっていう\nウィルス自身の呪いの気配……？？\\!\n貞子っぽいけど基本的にノイズ……みたいな。":122,"\\n<経蔵>なるほど。\\.\\.ウィルスだけに呪うときも\n人間の呪う気持ちと合体する必要があるのかもな。":123,"\\n<経蔵>ウィルスが貞子の気配を帯びているのは、\n貞子に憑依したからかもしれない。":124,"EV015":125,"『実録ＤＶ』というＤＶＤがある。\\!\nホラー映画のようなパッケージだ。":126,"主に「夫→妻」「父→子供」のＤＶの\n実態を扱っているようだ。\\!\nパッケージ裏の一部に、伽椰子らしき女性の姿がある。":127,"\\n<珠緒>伽椰子のように傷つけられたり\n殺されたりした……\\.\\.ざっと数百人ぶんの無念が\n込められてるね。":128,"\\n<経蔵>まさか伽椰子、こんなとこでそのスジの\n編集長にでもなってんのかよ？":129,"EV016":130,"『大自然紀行』というＤＶＤがある。\\!\n触れるだけで走馬灯のように景色が胸の内を\n流れていく。":131,"\\n<\\N[2]>デッキが不要とは。":132,"\\n<経蔵>ここにあるのは、\n霊力で具現化されたものばかりだからな。\\!\n誰の力によるかは特定できないが。":133,"\\n<\\N[2]>しかし、浮かぶ景色は私の知る限り、\n現在では開発などで失われた場所ばかり……？？":134,"\\n<珠緒>……その地域そのものの、無念かもね。":135,"EV017":136,"『反駁（はんばく）の実録ＤＶ』というＤＶＤがある。\\!\nホラー映画のようなパッケージだ。":137,"主に「妻→夫」「子供→父」のＤＶの\n実態を扱っているようだ。":138,"\\n<珠緒>！！　\\.\\.気配の一部に\n佐伯剛雄（伽椰子の夫）がいる。":139,"\\n<経蔵>俊雄のオヤジよお……。\\!\n女房に負けねえ片恨みっぷりだな？\nある意味お似合いの夫婦だぜ？":140,"\\n<珠緒>剛雄、伽椰子に憑いている悪意と同じ気配が\n霊体に残ってるね。":141,"\\n<経蔵>……あんたも、頭に血が上りやすいところを\n利用されて女房殺しをさせられたクチか。":142,"\\n<経蔵>これで必要以上に腹を立てることもないだろう。\\!\nあらためて懺悔するなら成仏の手配をしてやるが。":143,"\\n<経蔵>……いいだろう。":144,"伽椰子の夫らしき人物の魂が\n経蔵さんの鏡に回収されたようだ。":145,"となりで経蔵さんとのやりとりを聞く\n（電話で通話中の様子に似ている）\n限りでは、":146,"彼は死後も今日まで立腹したままで、\n胸では分かっていながら反省することも思い直すことも\nできずに内心困っていたらしい。":147,"\\n<経蔵>自分が怒る以上に怒らされ、\n恨む以上に恨まされているもんだな。意外と。\\!\n黒幕のような悪意に……。":148,"\\n<経蔵>自分もとことん怒り、恨んでるから\n自分で気づくことも、思い改めることも難しい……。":149,"EV018":150,"『ふるさとの水源』というＤＶＤがある。\\!\n井戸の傍らで、貞子らしき人物が静かに\n腰掛けている様子がパッケージにある。":151,"\\n<珠緒>……別の意志のカタマリが貞子の仮面を\nかぶってるような感じがする。":152,"\\n<経蔵>貞子、肖像権のレンタルでも\nはじめたのか……？":153,"内容は、地域に愛されてきた\n井戸、池、温泉などが次第に忘れ去られ……":154,"あるものは埋められ、破壊されて\nなくなっていく変遷が……\\.\\.胸に流れ込んでくる。":155,"EV019":156,"『ある森の最期』というＤＶＤがある。\\!\n人々の手によって次々と失われる森林の様子が\n幾重にも胸に流れ込んでくる。":157,"最後にこう締めくくられる……。":158,"もっとも罪深い一族のひとりは、\nいつか我らの代弁者となるだろう。":159,"無慈悲に伐り倒された我らのように\n足腰の自由を奪われ、死後なおそれは続く。\\!\n永遠に我らと一体となって苦悩を世に訴え続けるのだ。":160,"\\n<経蔵>足腰の自由を奪われる……\\!\n伽椰子のことか……？":161,"\\n<珠緒>どうかな……":162,"EV020":163,"『輝く田園風景』というＤＶＤがある。\\!\n胸に流れてくるのは、美しい実りの田畑の様子だ。":164,"しかし、時代を経るごとにさびれていったり、\n宅地や工場になったり、そこもまた……\\.\\.すさんでゆく\n様子で締めくくられていた。":165,"\\n<珠緒>……田んぼの祟り、みたい。":166,"EV021":167,"『どうぶつの気持ち』というＤＶＤがある。\\!\n犬や猫、ハトやカラスなどの生き物の視点と立場で、\n人々から虐待を受ける様子が胸に流れ込んでくる。":168,"実際に身体のあちこちが痛みを感じる。\\!\nすぐれたＶＲ（バーチャルリアリティ）だが……\n内容が内容だけに、気分はすぐれない。":169,"\\n<経蔵>ごめんな……。\\.\\.\n今の俺たちの力じゃ、凝り固まってでかい妖怪になった\nお前らを成仏させてやれねえ……。":170,"EV022":171,"\\n<珠緒>ささってるノート、\nみんな伽椰子の気配がする……。":172,"\\n<経蔵>だが、内容は別人のものばかりだ。\n開いたらそれぞれ違う人間の気配が出てくる。":173,"\\n<経蔵>見てみろよ。伽椰子のノートに負けず劣らずの\nブッとんだ手記や落書きが満載だ。\\!\n意味の通じる字と文章で読めるのはまだいい方だ……":174,"\\n<経蔵>こいつらが伽椰子に力を与えているのか、\n\\.\\.それとも……？":175,"EV023":176,"\\n<経蔵>貞子が趣味で聞いていたＣＤでもありゃ、\nおもしろいんだけどな。":177,"\\n<珠緒>焼け石に水。\nスズメの涙にもならないね。\\!\n貞子相手じゃ、そのぐらいじゃ揺さぶれない。":178,"\\n<経蔵>だろうけどな……。\\!\nワラでもいいから欲しくなるな。\n決め手の足しになるものが。":179,"黒い表紙のノートがある。\\!\n手に取ると、頭の中に声が流れ込んできた。":180,"\\C[7]選ばれた人間の論理なんて、もうまっぴらだ……\\!\n俺（こちら）の論理……\\.\\.\n世の中のあらゆる連中に思い知らせて……":181,"思わずノートを戻した。":182,"\\n<経蔵>呪う気だけなら\n貞子や伽椰子に劣らない連中がゴロゴロいるぜ。\\.\\.\n気をつけな。":183,"EV024":184,"\\n<経蔵>俺らが呪いの部屋に来れたのは、\n貞子が青鬼の屋敷に来た影響で……":185,"\\n<経蔵>呪いの部屋に本棚ができたのは、\n伽椰子が青鬼の屋敷に来た影響だろうな。":186,"EV025":187,"『校内犯罪被害の記録』という手記がある。\\!\n大小のいじめ被害の記録が克明に……":188,"\\n<経蔵>だいじょうぶか。\\!ノートに化けた連中、\n無念が強すぎて……、幻覚でだろうが、\n読んでたお前を同じ目に遭わせて殺そうとしていた。":189,"\\n<珠緒>すっかり化け物になってるね……":190,"『校内犯罪被害の記録』という手記がある。\\!\n大小のいじめ被害の記録が克明に記されているが、\n読むと幻覚ながら、同じ被害に遭わされてしまうらしい。":191,"\\n<経蔵>こいつらの成仏は、出直してこないと無理だ。\nいまは３大バケモンの相手で手いっぱいだからな……":192,"EV026":193,"--------------------------------------":194,"\\n<\\N[2]>それにしても、人の気配や魂の区別というものが\nそんなに細かくわかるものなのですか？":195,"\\n<経蔵>ああ。特に珠緒は一度覚えた人間や妖怪の気配は\n細かいところまでよく覚えてくれる。":196,"\\n<経蔵>遺品からでも、\n魂の居場所を探ることができるんだ。":197,"\\n<\\N[2]>麻薬捜査犬のようですね。":198,"\\n<経蔵>ふっ。俺もそう思う！":199,"\\n<経蔵>ホメてんだよ♪":200,"\\n<\\N[2]>（私も、けなしたつもりはなかったのですが……）":201,"EV027":202,"古びたノートがある。\\!\nしかし、異様な存在感を放っている。":203,"\\C[8]しにたいしに死にたい死にたいしに死死死にたいしにたい死にたいしにたいし\nにたい死死死にたい死死死たいし死に死に死にたい死死死にたいしにたいしに\nたい死に死にたいしし死死死たいしにた死にたい死に死にたいしにたいしに\nしにたい死にたいいしし死にたい死死死にたいしにた死にたいしにたいしに":204,"誰でもいいからこの気持ちを\n\\C[7]身をもって\\C[0]思い知ってほしい。":205,"\nだれでもいいから………………":206,"\\n<珠緒>……死にたいのか生きたいのか、\nはっきりしない気配。\\!\n敵意なのか懇願なのかも分からない。":207,"\\n<経蔵>そうか、「呪い」というのは\n「生きたい」という意欲がこじれたもの\nなのかもしれない。":208,"\\n<経蔵>ふっかけられる方は\nたまったもんじゃねえけどな。":209,"\\n<経蔵>無差別に訴えたいところ悪いが、\nお手柔らかにな。\\!\n助ける方も、できることに限りがあるからな……":210,"\\n<経蔵>あいにく今は、いままで依頼されたぶんの\n３大バケモンの被害者の魂を回収するので\n精一杯だ……。":211,"EV028":212,"ラベルも基材も漆黒のＣＤがある。\\!\n手に取ると、どこからか声が聞こえてきた。":213,"\\C[7]ただの人間に憑いても、\n食べ物に縫い針を入れたり、病院で点滴に毒物を入れたりと、\nセコいことしかできない。":214,"\\C[7]貞子は神だ……。\\!\nあらゆる呪いの代弁をしてくれる……。":215,"\\C[7]貞子と力を合わせれば、殺処分し返してやれる……。\\!\n俺を（社会的に）殺害した、あらゆる連中に……。\\!\n私をハブり殺した、あいつらに……。":216,"\\n<\\N[2]>世を騒がす猟奇事件は\n彼らからのメッセージなのでしょうか……。":217,"ラベルも基材も漆黒のＣＤがある。\\!\n手に取ると、老若男女の恨みごとが何重にも折り重なって\n聞こえてくる。":218,"ただ、全体の雰囲気はなぜか……、\\!\n彼らが「ＳＯＳ」を発しているようにも感じとれた。":219,"\\n<経蔵>てめえら、俺たちの前に立ちはだかるなら\nコミュ力（りょく）ブチ込んでやる。\\!\n覚悟しとけ。":220,"\\n<珠緒>一瞬だけ気配が笑顔になった。":221,"\\n<珠緒>だめだよ期待しちゃ。\\!\n呪ってる方がまだ幸せだと思い知るから……。":222},"extension":"json","dataType":"map","filename":"Map115","basename":"Map115.json","path":"data/Map115.json","relPath":"data/Map115.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":223,"length":223,"percent":100},"cellInfo":[]},"data/Map116.json":{"data":[["EV001","","EV001"],["-----------------------------------------","","-----------------------------------------"],["主人公の名前を\n\\C[2]さだかやむてき\\C[0]、または\\C[2]サダカヤムテキ\\C[0]に\nすると、無敵でプレイできます。","","the name of the main character\n\\C[2] Sadakayamuteki \\C[0], or \\C[2] Sadakayamuteki \\C[0]\nThen you can play invincible."],["-----------------------------------------\nコンプリートだと、こたつでみかんが出る","","-----------------------------------------\nIf it's complete, you'll get mandarin oranges under the kotatsu."],["　　　　　　　　     Thank you for playing!!","","Thank you for playing!!"],["　　　　　　　　無敵の場合、この音の鳴るポイントを\n　　　　　　　　コンプリート可能になります。\n　　　　　　　　　　　　（今回 \\V[101]/15 カ所）","","If you are invincible, select the point where this sound sounds.\n　　　　　　　　It will be possible to complete it.\n(\\V[101]/15 locations this time)"],["　　　　　　通常時は調べるとゲームオーバーになる所が\n　　　　　　チェックポイントになっていることが多いです。","","　　　　　　通常時は調べるとゲームオーバーになる所が\n　　　　　　It is often a checkpoint."],["　　　　　　　　コンプリートの際は、ささやかながら\n　　　　　　　　エンディングでおまけ画像があります。\\!\n　　　　　　　　よろしければどうぞ。","","　　　　　　　When completing,\nThere is a bonus image at the ending. \\!\n　　　　　　　　　　　　　　　　　Please do."],["みんなでコタツ","","Kotatsu with everyone"]],"context":[["Map116/events/1/name"],["Map116/events/1/pages/0/list/4/comment","Map116/events/1/pages/0/list/7/comment"],["Map116/events/1/pages/0/list/9/message/noPicture/bottom"],["Map116/events/1/pages/0/list/15/comment"],["Map116/events/1/pages/0/list/31/message/noPicture/bottom"],["Map116/events/1/pages/0/list/36/message/noPicture/bottom"],["Map116/events/1/pages/0/list/40/message/noPicture/bottom"],["Map116/events/1/pages/0/list/43/message/noPicture/bottom"],["Map116/events/2/name"]],"tags":[null,["blue"],null,["blue"]],"parameters":[null,[{"headerIndex":4,"headerParam":["-----------------------------------------"]},{"headerIndex":7,"headerParam":["-----------------------------------------"]}],[{"headerIndex":9,"headerParam":["",0,1,2]}],[{"headerIndex":15,"headerParam":["-----------------------------------------"]}],[{"headerIndex":31,"headerParam":["",0,1,2]}],[{"headerIndex":36,"headerParam":["",0,1,2]}],[{"headerIndex":40,"headerParam":["",0,1,2]}],[{"headerIndex":43,"headerParam":["",0,1,2]}]],"indexIds":{"EV001":0,"-----------------------------------------":1,"主人公の名前を\n\\C[2]さだかやむてき\\C[0]、または\\C[2]サダカヤムテキ\\C[0]に\nすると、無敵でプレイできます。":2,"-----------------------------------------\nコンプリートだと、こたつでみかんが出る":3,"　　　　　　　　     Thank you for playing!!":4,"　　　　　　　　無敵の場合、この音の鳴るポイントを\n　　　　　　　　コンプリート可能になります。\n　　　　　　　　　　　　（今回 \\V[101]/15 カ所）":5,"　　　　　　通常時は調べるとゲームオーバーになる所が\n　　　　　　チェックポイントになっていることが多いです。":6,"　　　　　　　　コンプリートの際は、ささやかながら\n　　　　　　　　エンディングでおまけ画像があります。\\!\n　　　　　　　　よろしければどうぞ。":7,"みんなでコタツ":8},"extension":"json","dataType":"map","filename":"Map116","basename":"Map116.json","path":"data/Map116.json","relPath":"data/Map116.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":9,"length":9,"percent":100},"cellInfo":[]},"data/Map117.json":{"data":[["EV001","","EV001"],["EV002","","EV002"],["\n緑の鍵を手に入れた。\\!\nタグに「玄関」と書いてある。","","\nI got the green key. \\!\nThe tag says \"entrance\"."],["\\n<\\N[2]>以前、屋敷を脱出するのに必要な「玄関の鍵」を\n見つける直前に感じた胸騒ぎを覚えたので、\n少しだけ引き返して調べることにしたのですが、","","Before \\n<\\N[2]>, the \"entrance key\" needed to escape the mansion was\nI remembered the excitement I felt just before I found it,\nI decided to go back a little bit and investigate."],["\\n<\\N[2]>まさかこんなに早く見つかるとは。\\!\n（柄の部分が少し違うようですが……）","","\\n<\\N[2]>I never expected it to be found so quickly. \\!\n(The pattern seems to be a little different...)"],["\\n<経蔵>早くて何よりだ。鍵に好かれてるな、お前。","","\\n<経蔵> It's fast and best of all. Key likes you, you."],["\\n<珠緒>不思議な力を感じるけど、本当に開くの？　\\.\\.玄関。","","\\n<珠緒>I feel a mysterious power, but will it really open? \\.\\. Entrance."],["\\n<経蔵>アテは多い方がいいさ。","","\\n<経蔵> The more you have, the better."],["EV003","","EV003"],["EV004","","EV004"],["DiscardTilesets 18","","DiscardTilesets 18"],["DiscardParallax !floor_blue","","DiscardParallax !floor_blue"],["山鬼","","mountain demon"],[null,null,null,null,null]],"context":[["Map117/events/1/name"],["Map117/events/2/name"],["Map117/events/2/pages/0/list/3/message/hasPicture/bottom"],["Map117/events/2/pages/0/list/7/message/hasPicture/bottom"],["Map117/events/2/pages/0/list/11/message/hasPicture/bottom"],["Map117/events/2/pages/0/list/14/message/hasPicture/bottom"],["Map117/events/2/pages/0/list/16/message/hasPicture/bottom"],["Map117/events/2/pages/0/list/18/message/hasPicture/bottom"],["Map117/events/3/name"],["Map117/events/4/name"],["Map117/events/4/pages/0/list/1/Plugin Command"],["Map117/events/4/pages/0/list/2/Plugin Command"],["Map117/events/5/name"]],"tags":[null,null,null,null,null,null,null,null,null,null,["red"],["red"]],"parameters":[null,null,[{"headerIndex":3,"headerParam":["N2",0,1,2]}],[{"headerIndex":7,"headerParam":["N2",0,0,2]}],[{"headerIndex":11,"headerParam":["N2",0,0,2]}],[{"headerIndex":14,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":16,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":18,"headerParam":["spiritualists",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"\n緑の鍵を手に入れた。\\!\nタグに「玄関」と書いてある。":2,"\\n<\\N[2]>以前、屋敷を脱出するのに必要な「玄関の鍵」を\n見つける直前に感じた胸騒ぎを覚えたので、\n少しだけ引き返して調べることにしたのですが、":3,"\\n<\\N[2]>まさかこんなに早く見つかるとは。\\!\n（柄の部分が少し違うようですが……）":4,"\\n<経蔵>早くて何よりだ。鍵に好かれてるな、お前。":5,"\\n<珠緒>不思議な力を感じるけど、本当に開くの？　\\.\\.玄関。":6,"\\n<経蔵>アテは多い方がいいさ。":7,"EV003":8,"EV004":9,"DiscardTilesets 18":10,"DiscardParallax !floor_blue":11,"山鬼":12},"extension":"json","dataType":"map","filename":"Map117","basename":"Map117.json","path":"data/Map117.json","relPath":"data/Map117.json","dirname":"/data","o