-------------------------------------"]},{"headerIndex":7,"headerParam":["--------------------------------------------"]},{"headerIndex":4,"headerParam":["--------------------------------------------"]},{"headerIndex":7,"headerParam":["--------------------------------------------"]},{"headerIndex":4,"headerParam":["--------------------------------------------"]},{"headerIndex":7,"headerParam":["--------------------------------------------"]}]],"indexIds":{"EV001":0,"パズルを続ける":1,"祭壇前に戻る":2,"PlayerOverPicture unset":3,"各種初期設定":4,"PlayerOverPicture set":5,"\\n<\\N[2]>どうやら、このＩＣカードを使った仕掛けのようですね。":6,"RotatePictureEx 10 90 60 1":7,"\\n<\\N[2]>青い手帳に書いてあったのはこのことですね。\\!\n神（紙）が傍らに立って（縦）いると……":8,"\\n<\\N[2]>ほかにヒントとなるフレーズはないでしょうか……？":9,"------------------------------------------\nパズル初回時に、\nたけしが駆けつけてくるまでの時間。\nタイマー表示の設定は一時的にオフにする処理":10,"本物１":11,"--------------------------------------------":12,"本物２":13,"本物３":14,"本物４":15,"DiscardPicture kamikire2":16,"DiscardParallax saidan_puzzle":17,"DiscardCharacter !$saidan_card":18,"DiscardCharacter !$circle_s":19,"たけしの足音":20,"偽物１":21,"偽物２":22,"偽物３":23,"偽物４":24},"extension":"json","dataType":"map","filename":"Map089","basename":"Map089.json","path":"data/Map089.json","relPath":"data/Map089.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":25,"length":25,"percent":100},"cellInfo":[]},"data/Map090.json":{"data":[["EV001","","EV001"],["EV002","","EV002"],["EV003","","EV003"],["EV004","","EV004"],["EV005","","EV005"],["EV006","","EV006"],["EV007","","EV007"],["EV008","","EV008"],["EV009","","EV009"],["EV010","","EV010"],["EV011","","EV011"],["電話を元の位置に戻した。","","I put the phone back in its place."],["\\n<珠緒>リチギだね？","","\\n<珠緒>Richigi, right?"],["\\n<経蔵>ふっ。珠緒？\nいちいち小馬鹿にすんのは\nそろそろカンベンしてやれよ？","","\\n<経蔵> Huh. Tamao?\nDon't act like a fool every time\nIt's time to have some fun, okay?"],["----------------------------------------","","----------------------------------------"],["\\n<経蔵>……電話、いったん切れたか？","","\\n<経蔵>...Did the phone hang up?"],["EV012","","EV012"],["DiscardTilesets 5","","DiscardTilesets 5"],["DiscardTilesets 6","","DiscardTilesets 6"],["案内右","","Guide right"],["案内左","","Guide left"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["--------------------------------------\nイベント用","","--------------------------------------\nFor events"],["玄関","","Entrance"],["\n開かない。","","\nIt won't open."],["\\n<\\N[2]>ッ、\\.\\.\\C[1]化け物から逃れてからもう１度！","","\\n<\\N[2]>, \\.\\.\\C[1] Once again after escaping from the monster!"],["--------------------------------------\n※ここで青鬼に出くわして、伽椰子が階段上から\nおりてくる。\nなお、青鬼と伽椰子の激突はここが初めてではなく、\nひろしが戻される少し前に伽椰子は来ていたという設定\n＝青鬼の力使える＝スタート直後の暖炉伽椰子も青くなる","","--------------------------------------\n*You'll come across Ao Oni here, and Kayako will come up from the top of the stairs.\nIt's coming down.\nFurthermore, this is not the first time that Ao Oni and Kayako have clashed.\nThe setting is that Kayako came shortly before Hiroshi was brought back.\n= You can use the power of the blue demon = The fireplace Kayako will also turn blue immediately after the start."],["\\n<\\N[2]>やはり開かないようですね……。","","\\n<\\N[2]> It seems like it won't open after all..."],["------------------------------------\n伽椰子階段から登場","","------------------------------------\nAppearing from Kayako Stairs"],["-------------------------------------------","","-------------------------------------------"],["(10,8)のページ4を起動","","Launch page 4 of (10,8)"],["\\n<経蔵>まだ用事が済んでいないぜ？","","\\n<経蔵> You haven't finished your business yet?"],["\\n<珠緒>あせって出たって、\n呪いが解けるわけじゃないのにねー","","\\n<珠緒>Even if you rushed out,\nIt's not like the curse can be broken."],["\\n<珠緒>あいつ、どかないね……","","\\n<珠緒> That guy won't go away..."],["ドアの向こうに青鬼がいるようだ。","","There seems to be a blue demon on the other side of the door."],["\\n<経蔵>貞子のやつ、青鬼に対しても\n律儀に２日待ってから襲うつもりか……？","","\\n<経蔵> Sadako's one, also against Ao Oni\nAre you planning to wait two days before attacking...?"],["\\n<経蔵>伽椰子がもう一度あいつを襲ってくれれば、\n獲物を奪われまいと貞子も現れてくれるだろうが……\\!\nまいったな……。","","\\n<経蔵>If Kayako attacks him again,\nI'm sure Sadako will show up to prevent her prey from being taken away...\\!\nIt's gone..."],["\\n<\\N[2]>ですが、珠緒さんがいなければ、\n青鬼と表でバッタリ出くわしていたでしょう。\\!\n助かりましたよ。","","\\n<\\N[2]>, but if Tamao-san is not there,\nI would have run into Ao Oni in the open. \\!\nThank you for your help."],["ドアの向こうに、まだ青鬼がいるようだ。","","Looks like there's still a blue demon on the other side of the door."],["SuspendEvent 15","","SuspendEvent 15"],["\\n<経蔵>あらよっと！","","\\n<経蔵> Oh my!"],["\\n<経蔵>珠緒は俊雄が逃げていった\n\\C[1]屋敷の２階から上にいる\\C[0]かもしれない。\\!\nまずそっちを当たるぞ。","","\\n<経蔵> Toshio ran away from Tamao.\n\\C[1]It might be \\C[0] who is on the second floor of the mansion. \\!\nI'll hit that one first."],["\\n<経蔵>\\N[2]、珠緒はお前の予想通り、\n\\C[1]洗濯機のある浴室にいる\\C[0]かもしれない。\\!\nまずそっちを当たるぞ。","","\\n<経蔵>\\N[2], Tamao is just as you expected.\n\\C[1] It could be \\C[0] in the bathroom with the washing machine. \\!\nI'll hit that one first."],["\\n<経蔵>ちっ……。\\.\\.不覚を取られたせいか、\n\\C[1]電話をとる\\C[0]だけなのに身体の方は迷ってやがる。\\!\n身体にはもう少し、激励が必要みたいだな。","","\\n<経蔵> Tsk... \\.\\.Perhaps because I was unconscious,\n\\C[1]Even though it's just \\C[0] picking up the phone, the body is confused. \\!\nIt seems like my body needs a little more encouragement."],["-------------------------------------------\nアナウンスオフ","","-------------------------------------------\nannouncement off"],["------------------------------------------","","------------------------------------------"],["\\n<珠緒>くる、\\.\\.ドアから！！","","\\n<珠緒> coming, \\.\\. from the door! !"],["\\n<経蔵>うおっ！！","","\\n<経蔵>Wow! !"],["四角い化け物がドアから走ってきたらしいところを\nかわすと、玄関の戸がなくなっていた。","","A square monster seemed to come running through the door.\nWhen I dodged it, the front door was gone."],["\\n<経蔵>……ははっ。\\.\\.あの四角いバケモン、\nドアと一体になって襲おうとして逆に、\n出入り口を開けていきやがった！！","","\\n<経蔵>...Haha. \\.\\.That square monster.\nI tried to attack the door as one, but instead,\nHe opened the doorway! !"],["転がり出るように表に飛び出した。","","It rolled out onto the surface."],["DiscardTilesets 1","","DiscardTilesets 1"],["DiscardTilesets 2","","DiscardTilesets 2"],["--------------------------------\n青鬼封印時","","--------------------------------\nWhen the blue demon is sealed"],["\n緑の鍵を使った。","","\nI used the green key."],["\\n<経蔵>あっさり開いた……！？","","\\n<経蔵> It opened easily...! ?"],["(10,8)に引き継ぎ","","Takeover to (10,8)"],["\\n<経蔵>まだ青鬼がいるな。\\!\n青鬼のやつ、まさか\\C[1]伽椰子の家の２階の奥\\C[0]へ\n俺たちに行って欲しいのか……？","","\\n<経蔵> There's still Ao Oni. \\!\nThe blue demon guy, \\C[1] I went to the back of the second floor of Kayako's house \\C[0]\nDo you want us to go...?"],["\\n<経蔵>ちっ……。","","\\n<経蔵> Tsk..."],["ドアの向こうに、青鬼がいるようだ。","","There seems to be a blue demon on the other side of the door."],["\\n<経蔵>こいつは賭けだが……。\\.\\.\nこれまではアテにしていなかったが、\n床にある赤い矢印の行く先へ向かってみようと思う。","","\\n<経蔵>This is a gamble... \\.\\.\nI didn't take it seriously until now, but\nI think I'll head towards the direction of the red arrow on the floor."],["\\n<\\N[2]>そんなものがあったのですか。","","\\n<\\N[2]> Did something like that exist?"],["\\n<経蔵>\\N[2]、お前には見えていないだろうな。\\!\nちなみに、さっき青鬼から逃げるときに見た限りでは、","","\\n<経蔵>\\N[2], I don't think you can see it. \\!\nBy the way, from what I saw earlier when I was running away from the blue demon,"],["\\n<経蔵>\\C[1]伽椰子の家の２階の奥\\C[0]へ\n続いているようだった。","","\\n<経蔵>\\C[1] Go to the back of the second floor of Kayako's house \\C[0]\nIt seemed to be continuing."],["\\n<珠緒>罠じゃない？　普通に。","","\\n<珠緒> Isn't it a trap? Normally."],["\\n<経蔵>さっきはあの矢印の先でお前を見つけた。","","\\n<経蔵>I found you at the end of that arrow a while ago."],["\\n<珠緒>！！","","\\n<珠緒>! !"],["\\n<経蔵>矢印の意図はわからないが、\n出口に青鬼が居座っている以上、\nいずれ遠くないうちに青鬼か伽椰子に襲われる。","","I don't know what the \\n<経蔵> arrow means, but\nAs long as there is a blue demon sitting at the exit,\nBefore long, you'll be attacked by Ao Oni or Kayako."],["\\n<経蔵>同じ襲われるなら、先手を心がけた方がマシ、\nということだ。\\!\n行く先が罠でしかないならなおさら、な。","","\\n<経蔵>If you're going to be attacked in the same way, it's better to be proactive.\nThat's what it means. \\!\nEspecially if the destination is nothing but a trap."],["\\n<\\N[2]>先手であれば罠の解除も可能、\nとも考られるところではありますが……。","","\\n<\\N[2]> If you are on the first move, you can also release the trap.\nAlthough it can be considered..."],["\\n<経蔵>そのつもりだ。息が合うな、脱出経験者！","","\\n<経蔵> That's what I meant. We're in tune with each other, people with escape experience!"],["\\n<珠緒>………………。","","\\n<珠緒>………………."],["経蔵さんが親しげに私の肩にポンと触れる一方、\n珠緒さんは不安げな様子だった……","","While Mr. Keizo touched my shoulder in a friendly manner,\nTamao looked anxious..."],["\\n<経蔵>やはり、青鬼から逃げ切ってからだな！","","\\n<経蔵> After all, it's only after you escape from the blue demon!"],["\\n<経蔵>……迷わず、\n\\C[1]この屋敷の２階から行ける、伽椰子の家\\C[0]を探そう。","","\\n<経蔵>...without hesitation,\n\\C[1]Let's look for Kayako's house \\C[0], which can be accessed from the second floor of this mansion."],["\\n<経蔵>……よし、出入り口が使えるな。","","\\n<経蔵>...Okay, I can use the entrance/exit."],["\\n<珠緒>経蔵。\\.\\.……このままここを出ない？\\!\nあいつには……\\.\\.悪いけど……。","","\\n<珠緒>Kyozo. \\.\\....Would you like to leave here? \\!\nFor that guy... \\.\\. I'm sorry but..."],["\\n<珠緒>貞子、伽椰子、青鬼が戦いあって、\n少しだけど、互いに力を落とした今なら、\n結界が効きやすいかもしれない。","","\\n<珠緒> Sadako, Kayako, and Aooni fight each other,\nIt's only a little, but now that we've both lost our strength,\nThe barrier might be more effective."],["\\n<経蔵>たしかにな。\\!\n……非情な判断を迫られるときではある。","","\\n<経蔵> Certainly. \\!\n...This is a time when we are forced to make ruthless decisions."],["\\n<珠緒>それに……。\\.\\.\nもう、あたしでも探れない異空間か\nどこかに連れていかれたと思う。\\!だから……","","\\n<珠緒> And... \\.\\.\nIs this another space that even I can't explore?\nI think he was taken somewhere. Because it's \\!..."],["\\n<経蔵>いや、探すアテはある。\nここからお前が確かめられない異空間といえば……。","","\\n<経蔵> No, I have something to look for.\nSpeaking of different spaces that you can't see from here..."],["\\n<経蔵>\\C[1]この屋敷の２階から行ける、伽椰子の家だ。\\C[0]\nそのどこかにいる可能性が高い。","","\\n<経蔵>\\C[1] Kayako's house can be accessed from the second floor of this mansion. \\C[0]\nThere's a good chance it's somewhere in there."],["\\n<経蔵>これ以上バケモンどもが本気を出さないうちに、\n一通り見てまわる。\\!\n断念するのは、それからだ。","","\\n<経蔵> Before the monsters get any more serious,\nTake a look around. \\!\nThat's when I give up."],["\\n<珠緒>手早くね！？","","\\n<珠緒> Be quick! ?"],["\\n<経蔵>手早く、くまなくな！！","","\\n<経蔵> Quickly and thoroughly! !"],["\\n<経蔵>さすがに青鬼も本気を出してきたか！","","\\n<経蔵> As expected, Ao Oni is getting serious!"],["サダカヤ自動ＥＶ集","","Sadakaya automatic EV collection"],["オープニング(10,8)から引き継ぎ","","Takeover from opening (10,8)"],["---------------------------------------\n青鬼に呪いのビデオを見せる作戦。\n場所はひろしの提案で\n台所のテレビを書斎裏。地下牢に移すことに。","","---------------------------------------\nThe strategy is to show the cursed video to the blue demon.\nThe location was Hiroshi's suggestion.\nThe TV in the kitchen is in the back of the study. To be moved to the dungeon."],["\\n<経蔵>――作戦はいま伝えた通りだ。\\!\nバケモンどもが来る前に準備をすませよう。","","\\n<経蔵>――The strategy is as I just told you. \\!\nLet's get ready before the monsters come."],["\\n<経蔵>機材の設置場所は、お前の勧めてくれた\n\\C[1]↑から先にあった隠し部屋の座敷牢の中\\C[0]でいいだろう。\\.\\.\nいま表から機材を持ってくる。","","\\n<経蔵> You recommended the location for installing the equipment.\n\\C[0] in the prison cell in the hidden room ahead of \\C[1]↑ would be fine. \\.\\.\nI'll bring the equipment from the table now."],["\\n<経蔵>――ったく、\\.\\.めんどくせえ家だな！","","\\n<経蔵> -- \\.\\. What a troublesome house!"],["\\n<経蔵>……やられた。\\!\nバケモンどもめ。機材をどこかに持ち去りやがった。","","\\n<経蔵>...I was defeated. \\!\nYou monsters. They took the equipment somewhere."],["\\n<珠緒>目ざとい連中だね。\\.\\.思ったより。","","\\n<珠緒>They're quick-witted people. \\.\\. Better than I expected."],["\\n<\\N[2]>では、屋敷にあるテレビと\nビデオデッキを使いましょう。","","In \\n<\\N[2]>, the TV in the mansion and\nLet's use the VCR."],["\\n<経蔵>ちっ……。\\.\\.屋敷のものをアテにして\n故障してたらアウトだから、\nわざわざ問題なく動く中古品を用意したってのに。","","\\n<経蔵> Tsk... \\.\\. Use the things in the mansion as a treat\nIf it breaks down, you're out, so\nEven though I went out of my way to prepare a used item that works without any problems."],["\\n<\\N[2]>\\C[1]ここから→、→にあるリビング\\C[0]に\n一式あったと思います。","","\\n<\\N[2]>\\C[1] From here →, → to the living room \\C[0]\nI think there was one set."],["\\n<経蔵>だな。\\.\\.そこは下見のときに見ている。\\!\n……行くか。","","It's \\n<経蔵>. \\.\\. I'm looking at that during the preview. \\!\n...Are you going?"],["---------------------------------------","","---------------------------------------"],["DiscardTilesets 3","","DiscardTilesets 3"],["座敷牢(4,3)5ページから引き継ぎ\n青鬼は親機の本体を手にとり、耳に当てる。\n俊雄が受話器を耳を当てて、ミャーと応答","","Carrying over from Zashiki Gyou (4,3) page 5\nAo Oni picks up the main unit and puts it to his ear.\nToshio put the receiver to his ear and answered with a meow."],["珠緒探し中に1Fに降りてきたときにはじまる。","","It begins when you come down to the 1st floor while looking for Tamao."],["\\n<経蔵>（珠緒……\\.\\.無事でいてくれ……！）","","\\n<経蔵> (Tamao...\\.\\. Please stay safe...!)"],["----------------------------------------\n目的のプラグインがあるときは\nここで真っ暗にする","","----------------------------------------\nWhen you have the desired plug-in\nMake it dark here"],["\\n<経蔵>ちっ、真っ暗にしてきやがったか！！","","\\n<経蔵> Tsk, you made it pitch black! !"],["\\n<珠緒>あいつが\\C[20]出口↓から来てる！！","","\\n<珠緒> He's coming from \\C[20] exit ↓! !"],["\\n<経蔵>バケモンと出口の場所を探って教えろ。\n\\C[1]（決定ボタン長押しか、エリア端に接触）\\!\n\\C[0]いまはお前が目だ！！","","\\n<経蔵> Find the monster and the exit location and tell me.\n\\C[1] (Long press the decision button or touch the edge of the area) \\!\n\\C[0] You are my eyes now! !"],["AooniMoveSet 2 8 青","","AooniMoveSet 2 8 Blue"],["ResumeEvent 15","","ResumeEvent 15"],["------------------------------------------\n索敵初期化","","------------------------------------------\nEnemy search initialization"],["-----------------------------------------","","-----------------------------------------"],["電話","","telephone"],["AltBgs stop 0","","AltBgs stop 0"],["--------------------------------------\n電話を取る経蔵。卓郎の父が出る。","","--------------------------------------\nKeizo picks up the phone. Takuro's father appears."],["\\n<経蔵>……なんだ。あんただったか。\\!\n……俺の携帯がつながらなかったからここへ？\\!\n……ああ、\\.\\.いつの間にか電源が落ちていた。悪かった。","","\\n<経蔵>...What? Was it you? \\!\n...I came here because my cell phone wasn't working? \\!\n...Ah, \\.\\. The power went out before I knew it. It was bad."],["\\n<経蔵>（バッテリーは充分だったはずだが……）","","\\n<経蔵> (The battery should have been sufficient...)"],["\\n<経蔵>こっちはいま、例の屋敷の中で、\nあんたから頼まれた依頼を遂行している。","","\\n<経蔵> We are inside the mansion,\nI'm carrying out the request you asked me to do."],["\\n<経蔵>……伽椰子の家を取り壊したぁ！？","","\\n<経蔵>... Kayako's house was demolished! ?"],["\\n<電話の男>息子の訃報を知らせてくれた息子の友人の話を\n思い返しまして……。\\!\nお手数をひとつでもかけまいと、あの物件を処分したのです。","","\\n<電話の男>A story about my son's friend who informed me of his death.\nThinking back... \\!\nIn order to avoid any inconvenience, I disposed of that property."],["\\n<電話の男>トラブルをはさんで７日ほどかかりましたが、\nちょうど今日、あの家を始末し終えて更地にしたところです。","","It took about 7 days due to the \\n<電話の男> trouble, but\nJust today, I finished cleaning up that house and turned it into a vacant lot."],["\\n<電話の男>これで、あの家の呪いで亡くなった知り合いも\n浮かばれればいいのですが。","","\\n<電話の男>Now I know someone I know who died due to the curse of that house.\nI hope it floats."],["\\n<電話の男>呪いの動画で死んだ私の友人と、\n呪いの屋敷で殺された私の息子……\\.\\.\n卓郎の仇をよろしくお願いしま……","","\\n<電話の男>My friend who died in the cursed video,\nMy son was killed in a cursed mansion...\\.\\.\nPlease help Takuro's enemy..."],["\\n<経蔵>……伽椰子は家を壊したとしても、\n関わった人間と縁のある家や物件に移り住む。","","\\n<経蔵>...Even if Kayako destroyed her house,\nMove to a house or property that has connections with the people involved."],["\\n<経蔵>……説明しそびれたせいで、\n別のバケモンと同棲させちまったのか。","","\\n<経蔵>...Because I forgot to explain,\nDid you let him live with another monster?"],["依頼人が、さほど大きくもない伽椰子の家を壊すのに\n７日も、という点が妙に気にかかった。\\!\nそれと、青鬼と同じ肌の色になった貞子や俊雄……。","","The client was demolishing Kayako's not-so-large house.\nI was curious about the fact that it was on the 7th. \\!\nAlso, Sadako and Toshio now have the same skin color as Ao Oni..."],["\\n<経蔵>……いやな予感がする。\\!\n俺は何を見過ごしている……？","","\\n<経蔵>...I have a bad feeling. \\!\nWhat am I overlooking...?"],["\\n<経蔵>和室からバケモンどもの気配！？","","\\n<経蔵> There is a sign of monsters from the Japanese-style room! ?"],["\\n<珠緒>ひろしが……！\\.\\.\n起きたら……\\.\\.伽椰子と……\\.\\.入れかわってて。\\!\n押し入れから……\\.\\.青鬼、\\.\\.貞子……","","\\n<珠緒>Hiroshi...! \\.\\.\nWhen I woke up...\\.\\. Kayako and...\\.\\. had been swapped. \\!\nFrom the closet...\\.\\. Aooni, \\.\\. Sadako..."],["\\n<経蔵>貞子、新たな獲物となったお前を\n伽椰子から奪い返しにきたな。\\!\nそこに青鬼まで……","","\\n<経蔵> Sadako, you have become my new prey.\nI came to take it back from Kayako. \\!\nThere's even Ao Oni..."],["---------------------------------------------\nケガ鬼あらわる","","---------------------------------------------\nAn injured demon appears"],["\\n<経蔵>もう決着がついたのか！","","\\n<経蔵> Has it been decided yet?"],["\\n<珠緒>前より強い力で閉じられてる！","","\\n<珠緒> It's closed with a stronger force than before!"],["体勢を整える（セーブ）","","Adjust your posture (save)"],["すぐ逃げる","","run away immediately"],["\\n<経蔵>ひとまずあいつを捲くしかねえか！","","\\n<経蔵> I have no choice but to turn him over for now!"],["----------------------------------------\n青ID->青出現->進行値","","----------------------------------------\nBlue ID->Blue appearance->Progress value"],["AooniMoveSet 3.5 10 15","","AooniMoveSet 3.5 10 15"],["EV伽椰子・ひろし・青","","EV Kayako/Hiroshi/Blue"],["血だまり（イベント部）","","Blood pool (event department)"],["--------------------------------------\nひろしを沈める都合で\n横に配置させる","","--------------------------------------\nFor the sake of keeping Hiroshi down\nplace it next to"],["-----------------------------------","","-----------------------------------"],["\\n<経蔵>バケモンどもが\n殺（や）りあったところが気になるか？","","\\n<経蔵> The monsters\nAre you curious about where there was a murder?"],["\\n<\\N[2]>あれほど広がっていた血だまりが\nもうほとんどありません。\\!\n経蔵さんの言う通り、\nこの世の血ではないから、でしょうか……","","\\n<\\N[2]> The pool of blood was so spread out.\nThere aren't many anymore. \\!\nAs Keizo said,\nMaybe it's because I don't have this worldly blood..."],["気になる","","I'm curious"],["先を急ぐ","","hurry ahead"],["------------------------------\n一度イベントを見たあと","","------------------------------\nAfter watching the event once"],["\\n<経蔵>あんまり興味向けてると、\nお前も念願の別空間に連れ込まれたりしてな？","","\\n<経蔵>If you show too much interest,\nHave you also been brought into another space of your dreams?"],["----------------------------\nひろし１人で\nさらに、無敵時メッセージを見ている","","----------------------------\nHiroshi alone\nIn addition, I am looking at the message when I am invincible."],["\\n<\\N[2]>……経蔵さんたちの言う通り、\n過度な興味は危険かもしれないですね。","","\\n<\\N[2]>...As the Keizo-san and others say,\nExcessive interest can be dangerous."],["---------------------------------------\nひろし、血だまりに飲まれる","","---------------------------------------\nHiroshi is swallowed by a pool of blood."],["---------------------------------------\n無敵の際は助かる","","---------------------------------------\nHelpful when invincible"],["\\n<\\N[2]>今の感覚は……。\\!\nなんだったのでしょうか……","","\\n<\\N[2]>The feeling I have now is... \\!\nWhat was it...?"],["^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^","","^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^"],["\\n<\\N[2]>伽椰子なる化け物が、\nこの屋敷の化け物のアゴを引きちぎったのにも\n驚きましたが……\n","","\\n<\\N[2]> Kayako is a monster.\nEven though I tore off the jaws of the monsters in this mansion.\nI was surprised..."],["--------------------------------------\n巨人鬼が伽椰子を床ドンするシーン","","--------------------------------------\nThe scene where the giant demon attacks Kayako"],["\\n<\\N[2]>屋敷の化け物の方も、\n身体を大きくして対抗したことにも目を見張りました。\\!\nどのような身体の仕組みなのでしょうか。","","\\n<\\N[2]>The monster in the mansion too,\nI was also impressed by how they made their bodies bigger to fight back. \\!\nWhat kind of body system does it have?"],["--------------------------------------\n巨人鬼の床ドン回想のあと","","--------------------------------------\nAfter the giant demon tokodon flashback"],["\\n<\\N[2]>彼女の血だまりは、\n別の空間への入口になっているのでしょうか。 \\!\n興味は尽きません。","","\\n<\\N[2]> Her blood pool is\nCould it be an entrance to another space? \\!\nMy interest is endless."],["\\n<経蔵>研究熱心なことで。\\!\nお前が生き延びた理由が、わかったような気がするぜ。","","\\n<経蔵> Being passionate about research. \\!\nI think I understand why you survived."],["\\n<珠緒>でも、深入りは命取り。\\!\n伽椰子は、この屋敷の化け物よりも容赦がないと思う。","","Even with \\n<珠緒>, going too deep can be fatal. \\!\nI think Kayako is more merciless than the monsters in this mansion."],["\\n<\\N[2]>用心しておきます。","","\\n<\\N[2]> Be careful."],["\\n<珠緒>せいぜいその用心を興味から守り抜くんだね。","","\\n<珠緒>At best, that caution protects you from curiosity."],["\\n<\\N[2]>……………………。","","\\n<\\N[2]>……………………."],["イベント用経蔵","","Sutra for events"],["イベント用珠緒","","Tamao for events"],["血だまり（グラ）","","Blood pool (gra)"],["転がった電話","","fallen phone"],["珠緒さんが床に落ちた電話機を\n杖で触れて調べた。","","Tamao picked up the phone that had fallen on the floor.\nI touched it with my cane and examined it."],["\\n<珠緒>……なにこれ。\\!\nこっち（親機の本体）から青鬼の気配、\nこっち（受話器）から俊雄の気配がする。","","\\n<珠緒>...What is this? \\!\nThere is a sign of Ao Oni from here (the main body of the main unit),\nI feel Toshio's presence over here (on the receiver)."],["\\n<経蔵>ふっ。青鬼のやつ……。\\!\n珠緒、お前の目が見えないのが惜しいところだな。","","\\n<経蔵> Huh. The one from Ao Oni... \\!\nTamao, it's a shame that you can't see."],["\\n<珠緒>経蔵、なにウケてんの……？","","\\n<珠緒>Kyozo, what are you so excited about...?"],["\\n<経蔵>ふっ。青鬼のでかい身体にとっては、\n受話器より本体の方が持ちやすかったみたいだな？","","\\n<経蔵> Huh. For Ao Oni's big body,\nIt seems like the phone itself was easier to hold than the receiver."],["\\n<珠緒>（まだウケてる……）","","\\n<珠緒> (Still popular...)"],["洗濯機・電話音","","Washing machine/telephone sound"],["AltBgs vol 0 5 2","","AltBgs vol 0 5 2"],["AltBgs vol 0 90 1","","AltBgs vol 0 90 1"],["地響き","","Earthquake"],["ラスト消灯＋決定Ｂｱﾅｳﾝｽ","","Last lights out + decision B announcement"],["バリケード2","","barricade 2"],["バリケード1","","barricade 1"]],"context":[["Map090/events/1/name"],["Map090/events/2/name"],["Map090/events/3/name"],["Map090/events/4/name"],["Map090/events/5/name"],["Map090/events/6/name"],["Map090/events/7/name"],["Map090/events/8/name"],["Map090/events/9/name"],["Map090/events/10/name"],["Map090/events/11/name"],["Map090/events/11/pages/0/list/8/message/hasPicture/middle","Map090/events/12/pages/0/list/8/message/hasPicture/middle"],["Map090/events/1