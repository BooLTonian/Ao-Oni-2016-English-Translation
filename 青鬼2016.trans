iritualists",1,0,2]}],[{"headerIndex":26,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":32,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":39,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":43,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":47,"headerParam":["N2",0,0,2]}],[{"headerIndex":71,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":91,"headerParam":["------------------------------"]}],[{"headerIndex":107,"headerParam":["N2",0,0,2]}],[{"headerIndex":119,"headerParam":["------------------------------"]}],[{"headerIndex":123,"headerParam":["N2",0,0,2]}],null,null,null,[{"headerIndex":6,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":10,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":12,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":21,"headerParam":["--------------------------------------------"]}],[{"headerIndex":31,"headerParam":["-------------------------------------"]}],[{"headerIndex":56,"headerParam":["N2",0,0,2]}]],"indexIds":{"EV001":0,"\\n<\\N[2]>ビデオデッキを持ってこないと……":1,"EV002":2,"青":3,"青位置設定":4,"--------------------\n■デバッグモード":5,"--------------------":6,"テレビ（イベント）":7,"\\n<経蔵>……俺が用意したテレビとビデオデッキだ。\\!\nご丁寧に配線まで整えてやがる。":8,"\\n<\\N[2]>以前見かけた機種よりは新しそうでしたので、\nなぜかとは思っていました。\\!\n化け物でもテレビを買い替えたいと考えるのでしょうか。":9,"\\n<経蔵>さあな。\\.\\.俺はテレビを持つ。\\.\\.\n珠緒、\\.\\.リモコンぐらいは持てるな？":10,"\\n<珠緒>盲人使いが荒いんだから。\\!\n……テレビを盗んだ犯人は、\n確かにこの屋敷の化け物かもね。":11,"\\n<珠緒>このリモコンにも\nそれらしい気配が少し残ってる。":12,"\\n<経蔵>\\N[2]、ビデオデッキをたのむ。":13,"\\n<\\N[2]>座敷牢は\\C[1]玄関ロビーから↑、→の\n突き当たりの部屋の中の、本棚の裏\\C[0]ですよ。":14,"\\n<経蔵>さっき見せてもらったから分かるっての！\\.\\.\nったく、とんだ隠し部屋だったな？":15,"\\n<珠緒>さっさと来ないと死ぬよ？":16,"ビデオデッキを手に入れた。\\!\nテスト再生用のビデオテープも適当なものを\nここから持ち出すことにした。":17,"\\n<\\N[2]>テープの挿入口に何か引っかかっていますね。\\!\n……髪？":18,"\\n<\\N[2]>それと、このノートは……？":19,"\\n<\\N[2]>日記のようですが、なぜデッキの上に……":20,"イベント：マー":21,"イベント：経蔵":22,"イベント：珠緒":23,"イベント：貞子":24,"イベント：伽椰子":25,"テレビ（グラ）":26,"レンジのイベント":27,"-----------------------------------------\nこのイベントは珠緒がさらわれるまで有効":28,"\\n<\\N[2]>経蔵さん、レンジが何か？":29,"\\n<経蔵>俊雄のオヤジ（佐伯剛雄）が、\n女房の伽椰子と息子の俊雄を殺した後……":30,"\\n<経蔵>俊雄がかわいがっていた猫（マー）まで\nレンジに入れて殺した、\\.\\.って話はしたっけか。":31,"\\n<経蔵>その顛末がネットでイジられていたのを\n思い出してな。":32,"\\n<珠緒>『佐伯剛雄は腹いせにレンジで\nマーからマー油をこしらえようとした』って、\\.\\.あれ？":33,"\\n<珠緒>好きだよね～\\.\\.経蔵。\\.\\.\nその手のブラックジョーク。":34,"\\n<経蔵>だからといって、\nマーをからかう気はないけどな。":35,"\\n<珠緒>ウワサをすれば。":36,"\\n<経蔵>よう。\\.\\.悪かったな、話題にして。\\!\n最初に振ったのはこいつ（\\N[2]）だから\n先に引っ掻いてやれ。":37,"\\n<\\N[2]>！！？？":38,"\\n<経蔵>俊雄によろしくな。":39,"------------------------------\n経蔵がいないときは\n背後の棚から映画のように伽椰子に襲われる":40,"\\n<\\N[2]>足元に人の気配が……？？":41,"------------------------------\n伽椰子をしのいだあと":42,"\\n<\\N[2]>これまでと違う襲い方をする\n化け物がいるようですね……":43,"せまる伽椰子の手":44,"冷蔵庫":45,"冷蔵庫ＥＶ":46,"\\n<経蔵>飲めそうなモンが入っていたら、\n逆に警戒すべきだろうな。":47,"\\n<珠緒>その割に飲みたそうだね？":48,"\\n<経蔵>生きて帰れたときのお楽しみ、\\.\\.だな。":49,"--------------------------------------------\nひろし１人だと伽椰子に襲われる":50,"-------------------------------------\n無敵で難を逃れたとき":51,"\\n<\\N[2]>冷蔵庫から人の気配が……？？":52,"EV016":53,"<high>":54,"EV017":55,"EV018":56,"EV019":57},"extension":"json","dataType":"map","filename":"Map102","basename":"Map102.json","path":"data/Map102.json","relPath":"data/Map102.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":58,"length":58,"percent":100},"cellInfo":[]},"data/Map103.json":{"data":[["EV001","","EV001"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["伽椰子（美香化け）","","Kayako (mika disguise)"],["------------------------------------\n画像読込み処理","","------------------------------------\nImage loading process"],["---------------------------------------","","---------------------------------------"],["\\n<美香>あっ、\\N[2]君？\\!\nここでこんなの見つけたんだけど……。","","\\n<美香> Ah, \\N[2] You? \\!\nI found this here..."],["\\n<\\N[2]>日記……というよりは、\n小林という男の観察記録のようですね。","","\\n<\\N[2]> Diary...or rather,\nIt seems to be a record of observations by a man named Kobayashi."],["\\n<\\N[2]>（同じものを先ほどリビングで……）","","\\n<\\N[2]> (The same thing was in the living room earlier...)"],["\\n<美香>誰が書いたんだろう？","","\\n<美香> Who wrote it?"],["\\n<\\N[2]>裏に名前がありますね。ええと……。\\!\n川又……\\|伽椰子。\\|\\^","","There is a name behind \\n<\\N[2]>. you know……. \\!\nKawamata...\\| Kayako. \\|\\^"],["---------------------------------------\nこの時点で伽椰子は青鬼の化ける力を入手済み。\n美香の情報も青鬼の力とともに入手…という設定。\n伽椰子の顔が青いのはそれを象徴している。","","---------------------------------------\nAt this point, Kayako has already obtained the power of Ao Oni to transform.\nThe setting is that Mika's information is also obtained along with Ao Oni's power.\nKayako's blue face symbolizes this."],["------------------------------------\n無敵時イベントは、\n美香の魂と表伽椰子が助けに来て追い払う","","------------------------------------\nThe invincible event is\nMika's spirit and Omote Kayako come to her rescue and chase her away."],["化け物とともに、手にしていたはずのノートも\nなくなっていた。","","Along with the monster, there was also the notebook that was supposed to be in his hand.\nIt was gone."],["\\n<\\N[2]>やはり、美香さんは亡くなられたのでしょうか……。","","\\n<\\N[2]> I guess Mika passed away after all..."],["オバサン（化け物）には\nオバサン（本人）をぶつけんのよ！","","For old ladies (monsters)\nDon't hit the old man (himself)!"],["\\n<\\N[2]>いま、美香さんの声が聞こえたような……？\\!\n空耳でしょうか……。","","\\n<\\N[2]> I think I heard Mika's voice just now...? \\!\nIs this just me...?"],["-----------------------------\n経蔵がいるときも出ない","","-----------------------------\nIt doesn't come out even when the sutra is present."],["表伽椰子","","Omote Gaya Coconut"],["美香の魂","","Mika's soul"]],"context":[["Map103/events/1/name"],["Map103/events/2/name"],["Map103/events/3/name"],["Map103/events/3/pages/0/list/0/comment"],["Map103/events/3/pages/0/list/7/comment"],["Map103/events/4/name"],["Map103/events/4/pages/0/list/0/comment"],["Map103/events/4/pages/0/list/4/comment"],["Map103/events/4/pages/0/list/6/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/21/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/27/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/29/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/32/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/35/comment"],["Map103/events/4/pages/0/list/44/comment"],["Map103/events/4/pages/0/list/61/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/65/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/73/message/hasPicture/bottom"],["Map103/events/4/pages/0/list/88/message/hasPicture/bottom"],["Map103/events/4/pages/3/list/0/comment"],["Map103/events/5/name"],["Map103/events/6/name"]],"tags":[null,null,null,["blue"],["blue"],null,["blue"],["blue"],null,null,null,null,null,["blue"],["blue"],null,null,null,null,["blue"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}],null,[{"headerIndex":0,"headerParam":["------------------------------------"]}],[{"headerIndex":4,"headerParam":["---------------------------------------"]}],[{"headerIndex":6,"headerParam":["N2",1,0,2]}],[{"headerIndex":21,"headerParam":["N2",0,0,2]}],[{"headerIndex":27,"headerParam":["N2",0,0,2]}],[{"headerIndex":29,"headerParam":["N2",1,0,2]}],[{"headerIndex":32,"headerParam":["N2",0,0,2]}],[{"headerIndex":35,"headerParam":["---------------------------------------"]}],[{"headerIndex":44,"headerParam":["------------------------------------"]}],[{"headerIndex":61,"headerParam":["N2",0,1,2]}],[{"headerIndex":65,"headerParam":["N2",0,0,2]}],[{"headerIndex":73,"headerParam":["spiritualists",3,1,2]}],[{"headerIndex":88,"headerParam":["N2",0,0,2]}],[{"headerIndex":0,"headerParam":["-----------------------------"]}]],"indexIds":{"EV001":0,"青":1,"青位置設定":2,"--------------------\n■デバッグモード":3,"--------------------":4,"伽椰子（美香化け）":5,"------------------------------------\n画像読込み処理":6,"---------------------------------------":7,"\\n<美香>あっ、\\N[2]君？\\!\nここでこんなの見つけたんだけど……。":8,"\\n<\\N[2]>日記……というよりは、\n小林という男の観察記録のようですね。":9,"\\n<\\N[2]>（同じものを先ほどリビングで……）":10,"\\n<美香>誰が書いたんだろう？":11,"\\n<\\N[2]>裏に名前がありますね。ええと……。\\!\n川又……\\|伽椰子。\\|\\^":12,"---------------------------------------\nこの時点で伽椰子は青鬼の化ける力を入手済み。\n美香の情報も青鬼の力とともに入手…という設定。\n伽椰子の顔が青いのはそれを象徴している。":13,"------------------------------------\n無敵時イベントは、\n美香の魂と表伽椰子が助けに来て追い払う":14,"化け物とともに、手にしていたはずのノートも\nなくなっていた。":15,"\\n<\\N[2]>やはり、美香さんは亡くなられたのでしょうか……。":16,"オバサン（化け物）には\nオバサン（本人）をぶつけんのよ！":17,"\\n<\\N[2]>いま、美香さんの声が聞こえたような……？\\!\n空耳でしょうか……。":18,"-----------------------------\n経蔵がいるときも出ない":19,"表伽椰子":20,"美香の魂":21},"extension":"json","dataType":"map","filename":"Map103","basename":"Map103.json","path":"data/Map103.json","relPath":"data/Map103.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":22,"length":22,"percent":100},"cellInfo":[]},"data/Map104.json":{"data":[["EV001","","EV001"],["EV002","","EV002"],["EV003","","EV003"],["EV004","","EV004"],["EV005","","EV005"],["EV006","","EV006"],["EV007","","EV007"],["EV008","","EV008"],["EV009","","EV009"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["----------------------------------------\nサダカヤ鬼のときはウェイト長めにとる","","----------------------------------------\nWhen you are a sadakaya demon, take a longer weight."],["EV012","","EV012"],["AooniKayakoHouseProcess preload","","AooniKayakoHouseProcess preload"],["\\n<経蔵>\\C[1]玄関\\C[0]へ急ごう。","","\\n<経蔵>\\C[1]Let's hurry to the entrance \\C[0]."],["-------------------------------------","","-------------------------------------"],["\\n<\\N[2]>……………………。\\!\nすみません、どうしても気になることが……！","","\\n<\\N[2]>……………………. \\!\nExcuse me, but I have something to worry about...!"],["\\n<経蔵>おい、\\N[2]！！","","\\n<経蔵> Hey, \\N[2]! !"],["\\n<経蔵>別の場所に出た……！？","","\\n<経蔵> It appeared in another place...! ?"],["EV013","","EV013"],["EV014","","EV014"],["EV015","","EV015"],["EV016","","EV016"],["EV017","","EV017"],["卓郎の魂","","Takuro's soul"],["\\n<経蔵>……そうか。お前が依頼人の息子か。","","\\n<経蔵>...I see. Are you the client's son?"],["\\n<\\N[2]>何かそこにいるのですか……？","","\\n<\\N[2]> Is there something there...?"],["\\n<珠緒>死んだ君の友達みたいだよ？\\!\n“卓郎”って言ってる。","","\\n<珠緒> Looks like your dead friend? \\!\nIt says \"Takuro\"."],["\\n<\\N[2]>……！？","","\\n<\\N[2]>...! ?"],["\\n<経蔵>……なるほど。たしかにこの上はヤバそうだ。\\!\nおい\\N[2]。いまこの上に行くのはやめとけ。\nお友達からのご忠告だ。","","\\n<経蔵>...I see. This certainly looks dangerous. \\!\nHey \\N[2]. Don't go up there now.\nThis is advice from a friend."],["\\n<珠緒>たしかにね。この上は……","","\\n<珠緒>Certainly. Above this..."],["\\n<\\N[2]>……？","","\\n<\\N[2]>...?"],["\\n<\\N[2]>気持ちが確かにそこに“いる”としても、\n本人の実体がないと戸惑うものですね……。\\!\n卓郎、わかりました。\\.\\.いま上に行くのは控えておきます。","","\\n<\\N[2]>Even if the feelings are definitely “there”,\nIt's confusing when you don't have a real person... \\!\nTakuro, I understand. \\.\\. I'll refrain from going up now."],["\\n<\\N[2]>なぜかは分かりませんが、\n先に進む気をそがれますね……？","","\\n<\\N[2]> I don't know why, but\nDoesn't that discourage you from moving forward?"],["-------------------------------\nセルフＡ：卓郎の魂と会話済み","","-------------------------------\nSelf A: Conversated with Takuro's soul"],["\\n<経蔵>……何を散歩してるんだ、俺は。\\!\n身体の方が先にヤキがまわったか……？","","\\n<経蔵>...What am I doing for a walk? \\!\nDid the body turn first...?"],["たけしの魂","","Takeshi's soul"],["\\n<珠緒>なにコイツ、もう死んでるのにビビってる。","","\\n<珠緒> This guy is already dead and he's freaking out."],["\\n<経蔵>ははっ。死んだって怖いもんは怖いだろ。\n友達のために逃げずに番をしてるだけ、\nエラいと思ってやれよ。","","\\n<経蔵> Haha. If you're scared of dying, you're scared.\nI'm just watching over my friends without running away.\nThink of it as an error."],["\\n<経蔵>ここでバケモンにやられた\nお前の友達だ。\\.\\.“たけし”、\\.\\.だそうだ。","","\\n<経蔵> I was attacked by a monster here.\nI'm your friend. Apparently \\.\\. “Takeshi” and \\.\\.."],["\\n<\\N[2]>……！！","","\\n<\\N[2]>...! !"],["\\n<経蔵>悪いことは言わない。\nこの上を確かめるのは後にしておこうな。","","\\n<経蔵> I won't say anything bad.\nLet's leave checking this for later."],["-----------------------------------------\nひろし１人のとき","","-----------------------------------------\nWhen Hiroshi is alone"],["\\n<\\N[2]>たけし、実感が不十分で申し訳ないですが\nお気遣い、ありがとうございます。\\!\nいま、この上に行くのは控えておきます。","","\\n<\\N[2]>Takeshi, I'm sorry that I don't have enough experience.\nThank you for your concern. \\!\nI'll refrain from going above this for now."],["\\n<\\N[2]>（故人に語りかけやすいように、\n仏壇や遺影が必要なのですね。\\!\nようやく理解できました……）","","\\n<\\N[2]> (To make it easier to talk to the deceased,\nA Buddhist altar and a photograph of the deceased are necessary. \\!\nI finally understood...)"],["ミッション１・４鬼ＥＶ","","Mission 1/4 Oni EV"],["-----------------------------\n●画像の準備","","-----------------------------\n●Image preparation"],["-----------------------------","","-----------------------------"],["\\n<\\N[2]>玄関のドアは、\\C[1]化け物から逃れてから\\C[0]\n調べましょう！","","\\n<\\N[2]> The front door is \\C[1] after escaping from the monster \\C[0]\nLet's find out!"],["-----------------------------\n青ID->青出現->進行値","","-----------------------------\nBlue ID->Blue appearance->Progress value"],["---------------------------------------------","","---------------------------------------------"],["\\^","","\\^"],["体勢を整える（セーブ）","","Adjust your posture (save)"],["すぐ逃げる","","run away immediately"],["\\n<珠緒>…………\\.\\.来る！！","","\\n<珠緒>…………\\.\\. is coming! !"],["-------------------------------------\n青ID->青出現->進行値","","-------------------------------------\nBlue ID->Blue appearance->Progress value"],["AooniMoveSet 5 0 10","","AooniMoveSet 5 0 10"],["--------------------------------","","--------------------------------"],["俊雄と階段イベント","","Toshio and the stairs event"],["--------------------------------------------\n表（オープニング）から引き継ぎ","","--------------------------------------------\nTake over from front (opening)"],["\\n<経蔵>お前ら、よくがんばった！\nもうどっかに隠れてろ！","","\\n<経蔵> You guys did a great job!\nHide somewhere already!"],["\\n<経蔵>俊雄なら捕まえられると思ったが、\nあの様子じゃ厳しいな。\\!まずは上を探しに行くぞ。","","\\n<経蔵>I thought Toshio would be able to catch him, but\nIt's tough looking like that. \\! First, let's go look for the top."],["洗濯機・電話音","","Washing machine/telephone sound"],["AltBgs vol 0 0 1","","AltBgs vol 0 0 1"],["AltBgs vol 0 0 0","","AltBgs vol 0 0 0"],["自動イベント","","automatic event"],["\\n<\\N[2]>経蔵さん、出口である玄関は開けられるのですか？\\!\n最強とおぼしき化け物が強固なロックを\nかけているかも……","","\\n<\\N[2]> Keizo-san, can you open the entrance, which is the exit? \\!\nA monster that seems to be the strongest has a strong lock.\nMaybe it's on..."],["\\n<経蔵>霊力をカギのある一点に集中させる。全力で。","","\\n<経蔵> Concentrate spiritual power on one key point. With all my might."],["\\n<経蔵>その瞬間に珠緒、ノブを回せ。\\!\n\\N[2]はノブが回った瞬間、ドアに体当たりだ。","","\\n<経蔵> At that moment, Tamao, turn the knob. \\!\nThe moment the knob turned, \\N[2] slammed into the door."],["\\n<経蔵>和室のときに、この発想がなくて悪かった。\\!\nぶっつけ本番だが、頼むぞ！！","","\\n<経蔵> It's a shame that I didn't have this idea when I was in the Japanese-style room. \\!\nIt's a real showdown, but I'll ask you to do it! !"],["AooniKayakoHouseProcess X","","AooniKayakoHouseProcess X"],["EV024","","EV024"],["フワ俊雄現る","","Fuwa Toshio appears"],["StandTo フワ俊雄 p 5 ","","StandTo Fuwa Toshio p 5"],["\\n<\\N[2]>猫の耳に見えるものは\n四角い化け物に由来するコブのようですね。","","\\n<\\N[2]> What looks like cat ears\nIt looks like a bump derived from a square monster."],["\\n<経蔵>コブができたのはこっちだぜ！？","","\\n<経蔵> This is where the bump appeared! ?"],["\\n<珠緒>解説うざい。","","\\n<珠緒> explanation is annoying."],["---------------------------------------------\nピクチャ準備","","---------------------------------------------\nPicture preparation"],["----------------------------------------\n青ID->青出現->進行値","","----------------------------------------\nBlue ID->Blue appearance->Progress value"],["AooniMoveSet 3 4 青","","AooniMoveSet 3 4 Blue"],["SetStandBy フワ俊雄 reach reach 2+","","SetStandBy Fuwa Toshio reach reach 2+"],["AltBgs stop 0","","AltBgs stop 0"],["フワッティー","","Fuwatty"],["フワ俊雄","","Fuwa Toshio"]],"context":[["Map104/events/1/name"],["Map104/events/2/name"],["Map104/events/3/name"],["Map104/events/4/name"],["Map104/events/5/name"],["Map104/events/6/name"],["Map10