eaderIndex":43,"headerParam":["",0,0,1]}],[{"headerIndex":48,"headerParam":["",0,0,1]}],[{"headerIndex":51,"headerParam":["--------------------"]},{"headerIndex":217,"headerParam":["--------------------"]}],[{"headerIndex":0,"headerParam":["----------------------"]}],[{"headerIndex":5,"headerParam":["---------------------------------------"]}],[{"headerIndex":58,"headerParam":["----------------------------------"]}],[{"headerIndex":42,"headerParam":["-----------------------------------------"]}],[{"headerIndex":89,"headerParam":["others",1,0,2]}],[{"headerIndex":91,"headerParam":["others",0,0,2]}],[{"headerIndex":122,"headerParam":["others",2,0,2]}],[{"headerIndex":128,"headerParam":["others",0,0,2]}],[{"headerIndex":134,"headerParam":["others",2,0,2]}],[{"headerIndex":140,"headerParam":["others",1,0,2]}],[{"headerIndex":148,"headerParam":["others",0,0,2]}],[{"headerIndex":157,"headerParam":["others",1,0,2]}],[{"headerIndex":189,"headerParam":["others",2,0,2]}],[{"headerIndex":210,"headerParam":["-----------------------------------------"]},{"headerIndex":58,"headerParam":["-----------------------------------------"]},{"headerIndex":145,"headerParam":["-----------------------------------------"]},{"headerIndex":202,"headerParam":["-----------------------------------------"]},{"headerIndex":358,"headerParam":["-----------------------------------------"]},{"headerIndex":373,"headerParam":["-----------------------------------------"]},{"headerIndex":581,"headerParam":["-----------------------------------------"]}],[{"headerIndex":211,"headerParam":["",0,1,2]}],[{"headerIndex":14,"headerParam":["---------------------------------------"]}],[{"headerIndex":92,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":95,"headerParam":["-----------------------------------------"]}],null,null,[{"headerIndex":146,"headerParam":["N2",0,1,2]}],[{"headerIndex":153,"headerParam":["N2",0,1,2]}],[{"headerIndex":179,"headerParam":["--------------------------------------------"]}],[{"headerIndex":207,"headerParam":["-----------------"]},{"headerIndex":266,"headerParam":["-----------------"]}],[{"headerIndex":224,"headerParam":["-----------------"]}],[{"headerIndex":246,"headerParam":["-----------------"]}],[{"headerIndex":299,"headerParam":["-----------------------------------------"]}],[{"headerIndex":330,"headerParam":["-----------------"]}],[{"headerIndex":367,"headerParam":["N2",0,1,2]}],[{"headerIndex":370,"headerParam":["N2",0,1,2]}],[{"headerIndex":396,"headerParam":["",0,0,1]}],[{"headerIndex":402,"headerParam":["others",1,0,2]}],[{"headerIndex":408,"headerParam":["others",1,0,2]}],[{"headerIndex":411,"headerParam":["N2",0,0,2]}],[{"headerIndex":413,"headerParam":["others",1,0,2]}],null,[{"headerIndex":422,"headerParam":["others",2,0,2]}],[{"headerIndex":450,"headerParam":["N2",0,1,2]}],[{"headerIndex":454,"headerParam":["N2",0,1,2]}],[{"headerIndex":457,"headerParam":["----------------"]}],[{"headerIndex":468,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":473,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":489,"headerParam":["N2",0,0,2]}],[{"headerIndex":492,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":495,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":499,"headerParam":["",0,1,0]}],[{"headerIndex":502,"headerParam":["",0,1,0]}],[{"headerIndex":505,"headerParam":["",0,1,0]}],[{"headerIndex":508,"headerParam":["",0,1,0]}],[{"headerIndex":511,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":518,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":522,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":527,"headerParam":["N2",0,0,2]}],[{"headerIndex":530,"headerParam":["",0,1,0]}],[{"headerIndex":534,"headerParam":["",0,1,0]}],[{"headerIndex":541,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":544,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":548,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":558,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":560,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":564,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":569,"headerParam":["N2",0,1,2]}],[{"headerIndex":574,"headerParam":["N2",0,1,2]}],[{"headerIndex":577,"headerParam":["N2",0,1,2]}],null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["画像先読み用です。"]}]],"indexIds":{"各種ＥＤデモ":0,"--------------------\n■鳥が飛んでいくアニメーション":1,"--------------------":2,"あの化け物の正体は何だったのか\\!\n私には分からない":3,"あの館から戻ってこなかった仲間は今も行方不明のままだ":4,"あなたの町にある\nその「いわくつきの館」に\n安易に足を踏み入れてはならない\\!\n先住者の怒りを買えばただでは済まないだろうから":5,"そこに人が住んでいなければ特に……":6,"--------------------\n■消える":7,"----------------------\n■この時点をクリアタイムとする":8,"---------------------------------------\n青鬼、館から去る":9,"----------------------------------\n閃光とともに青鬼消滅":10,"-----------------------------------------\nモブも生存ＥＤ":11,"ははっ、\\.\\.びっくりしたな。\\.\\.メグミ？":12,"\\n<メグミ>…………\\.\\.\\.うん。":13,"\\n<ケビン>このケビン、\\.\\.\nもう、\\.\\.たけしのことは笑えないぜ……":14,"\\n<メグミ>ショウ、そろそろ小学生のときの\nニックネーム（ケビン）は卒業しない？":15,"\\n<ケビン（ショウ）>俺は好きなんだけどなあ……\\.\\.\nなぜだか親近感あって。":16,"好きでも卒業することあるよな。\\!\n丸顔だから“コロン”だったのが、\nあんまりまわりからイジられて……":17,"\\n<メグミ>リョウタ！！":18,"\\n<リョウタ>うわっ、\\.\\.お化け出た！♪":19,"\\n<ケビン>その丸顔が、かわいいって言われてるのに。\\!\nメグミのやつ、何をコンプレックスに感じてるんだか……":20,"-----------------------------------------":21,"その後、\\N[2]たちが訪れた館は\n普通の心霊スポットとして親しまれるようになったが、\nジェイルハウスとしては鳴りを潜めていたという……。":22,"---------------------------------------\n経蔵と珠緒、結界を発動。\nハッピーエンド。":23,"\\n<経蔵>悪い子もお寝んねの時間だぜ。\\!\nゆっくり休みな……！":24,"-----------------------------------------\n結界発動":25,"AltBgs fadeIn Magic1 0 2 15 55":26,"AltBgs fadeOut 0 4":27,"化け物は、\n経蔵さんが結界と呼ぶバリアのようなものの中で\n消えていった。":28,"その後１週間ほどたったが、\n貞子、伽椰子、青鬼、３体の化け物による\nそれぞれの呪いは鳴りをひそめていた。":29,"--------------------------------------------":30,"-----------------\n青鬼攻撃":31,"-----------------\n伽椰子攻撃":32,"-----------------\n貞子攻撃":33,"-----------------------------------------\n●ここからマルチエンド":34,"-----------------\n３者合体":35,"経蔵さんたちは「結界は時間かせぎだ」と言って、\n次の手を探しにどこかへ向かっていった。":36,"化け物たちの呪いは、いまだ予断を許さない状態だ。":37,"\n　　　　　　　　　中は思ったよりきれいだったぜ。":38,"\\N[2]、お前もここに興味があるのか？":39,"自慢の脳みその刺激にはもってこいかもな。":40,"\\n<\\N[2]>たしかに、大変刺激にはなりましたが……":41,"……そっか、満足してないのか。\\!\nそれで２周目しに来た感じか？　\\.\\.がんばれよ。":42,"CastCommonEventName ケビン（ショウ） 身震い":43,"\\}ほ、\\{\\.\\.ほどほどで満足しねえと\\.\\.\n\\}あ、\\{\\.\\.あっちに連れてかれても知らねえぞ？":44,"経蔵さんの封印のおかげで、\nこの屋敷はいま、ただの廃墟になっている。":45,"美香さん、たけし、卓郎の３人は、\n私の周囲では、まだ失踪扱いのままだ。":46,"----------------\n経蔵くる":47,"\\n<経蔵>\\N[2]、お前も来てたか。":48,"\\n<経蔵>ちょうどよかった。これ、\\.\\.読んでみろ。":49,"\\n<\\N[2]>経蔵さんのところにも\n伽椰子のノートが忽然と訪れていましたか。":50,"\\n<珠緒>いまは伽椰子と貞子が\n（霊的に）書き込むノートになってる。":51,"\\n<経蔵>青鬼も書き込めるだろうが、その気はないみたいだ。":52,"……私たちだけ呪うことをやめるわけにはいかない。\\!\n自分への裏切りのように感じる。":53,"結界を破ることはたやすい。\n……しかしなぜか、破る気を起こすことができない。":54,"このまま、やきもきする気が高ぶって爆発する時を\n待つしかないのだろうか。":55,"\n怒りの矛先が……わからない。":56,"\\n<経蔵>読んでの通りだ。\\.\\.呪う気に迷いが出ている。":57,"\\n<経蔵>呪うことしかできなかった連中が、\nノートを通して対話がわりに\n「人につぶやく」ことを覚えた。":58,"\\n<経蔵>いい傾向だ。かわいくなったもんだぜ。\\!\n気が変わらないうちに、次の手を打たないとな。":59,"\\n<\\N[2]>私が読んだのは……\\.\\.\nたしか、この部分でした。":60,"あの３人は殺そうと思ったが、\nもうしばらく泳がせておくことにした。\n何か使えるかもしれない。":61,"\n初めて私たちの情報（なか）に達した人たちだから……":62,"\\n<経蔵>俺たちを陰で操るつもりか。\\!\nふっ、\\.\\.上等だ。":63,"\\n<珠緒>……言葉は脅し文句みたいだけど、\n気配は「頼みごと」に近いね。":64,"\\n<経蔵>「頼みごと」かよ。":65,"\\n<経蔵>おい貞子、伽椰子。\\.\\.……青鬼はどうか知らねえが。":66,"\\n<経蔵>これは果たし状という名の\n「依頼状」と、みなしていいんだな？":67,"\\n<経蔵>目ン玉えぐり出されるような額の\n依頼料（ファイトマネー）ふっかけてやるからな。\\!\nふっ、\\.\\.覚悟してリングに上がってこいよ？":68,"経蔵さんは化け物たちに法外な請求（呪い）を\nかける気構えでいるようだ。":69,"……ファイティングメンバーには、\n普通に私も入っているような雰囲気だった。":70,"今日もあの屋敷は、「あえて」沈黙を守っている。":71,"EV002":72,"EV003":73,"EV004":74,"EV005":75,"EV006":76,"EV007":77,"画像先読み用です。":78,"ケビン（ショウ）":79,"メグミ":80,"リョウタ":81,"ED３デモ青":82,"サダカヤ用ドア":83,"経蔵":84,"結界点滅":85,"青鬼":86,"貞子":87,"伽椰子":88,"俊雄":89,"フワッティー":90,"ひろし":91,"珠緒":92},"extension":"json","dataType":"map","filename":"Map036","basename":"Map036.json","path":"data/Map036.json","relPath":"data/Map036.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":93,"length":93,"percent":100},"cellInfo":[]},"data/Map037.json":{"data":[["青鬼に37番マップが\n存在しないため\n","","Map 37 in Ao Oni\nBecause it doesn't exist"],["EV001","","EV001"],["AltBgs play A5_16491 0 20","","AltBgs play A5_16491 0 20"],["AltBgs save 0","","AltBgs save 0"],["AltBgs stop 0","","AltBgs stop 0"],["AltBgs replay 0","","AltBgs replay 0"],["----------------------------------------","","----------------------------------------"],["テーブルをすり抜ける処理","","Process of passing through a table"],["\\n<経蔵>……なんだよ、このメモは？","","\\n<経蔵>...What is this memo?"],["\\n<経蔵>『“解く力”を込める』って、どういうことだ、おい！！\\!\n……勝手に消えやがって。\\.\\.……ったく。","","\\n<経蔵> What do you mean by ``putting in the power to solve'', hey! ! \\!\n...It just disappeared on its own. \\.\\....Taku."],["\\n<経蔵>……要は、このメモのナゾナゾを\n解いてくれ、ってことか。\\!\n面倒ばかりよこしやがって。\\!どいつもこいつも……","","\\n<経蔵>...The bottom line is this memo's riddle.\nDo you mean, please explain? \\!\nYou're just causing trouble. \\! Who is this guy..."],["デバッグ用マップに飛びますか？","","Do you want to jump to the debug map?"],["伽椰子邸マップ","","Kayaji Residence Map"],["青鬼３．０マップ","","Aooni 3.0 map"],["いいえ","","No"],["-----------------------------------------\n暗転用マスクはＩＤ固定\nよく使うので、可能なら消去せず（メモリに常駐）、\n透明度ゼロで消去扱いを試みる","","-----------------------------------------\nID is fixed for darkening mask\nI use it often, so if possible, don't delete it (reside in memory),\nTry erasing with zero transparency"],["イベント保管庫","","event storage"],["テスト鬼","","test demon"],["化け物背後に出現","","Appears behind the monster"],["伽椰子","","Kayako"],["化け物動くと消える","","When the monster moves, it disappears."],["StandBy バリケードX p -1 0","","StandBy Barricade X p -1 0"],["StandBy バリケードX p 1 0","","StandBy Barricade X p 1 0"],["StandBy バリケードY p 0 -1","","StandBy Barricade Y p 0 -1"],["\\n<経蔵>ふっ。\\.\\.いいカードになるといいな。\n伽椰子と向き合うときの。","","\\n<経蔵> Huh. \\.\\.I hope it becomes a good card.\nWhen facing Kayako."],["\\n<経蔵>成仏させてやりたいところ悪いが、\n伽椰子が成仏に応じるまで働いてもらいたい気もするな？","","\\n<経蔵> It's bad that I want to make him become a Buddha, but\nDon't you feel like Kayako wants you to work until she agrees to attain Buddhahood?"],["\\n<珠緒>そうだね。","","\\n<珠緒>That's right."],["本棚におられる魂の方々は、\n二人の様子に複雑な思いを抱いたのか、\n私の胸にもそれが流れ込んできた……。","","The souls on the bookshelf,\nDid he have mixed feelings about the situation between the two of them?\nIt also flowed into my chest..."],["EV003","","EV003"],["浴室から引き継ぎ","","taken over from the bathroom"],["\\>お互いに情報交換しあった。","","\\> We exchanged information with each other."],["\\>その時、館の電話が鳴った。\n\\>経蔵が一人で取りに行くことに。","","\\>At that moment, the mansion's phone rang.\n\\>Kyozo decides to go get it by himself."],["玄関ホールから引き継ぎ","","Take over from entrance hall"],["\\>珠緒起きる。ひろしの気配がない\n\\>それどころか伽椰子の気配が間近に！\n\\>ふすまからは青鬼と貞子もあらわれ、３者で激突する。","","\\> Tamao wakes up. There's no sign of Hiroshi.\n\\>In fact, there is a sign of Kayako nearby!\n\\> Ao Oni and Sadako also appear from the sliding door, and the three clash."],["\\>珠緒、経蔵と合流\n\\>この後、（損傷した）青鬼に追われる。","","\\> Tamao joins Keizo\n\\> After this, you will be chased by a (damaged) blue demon."],["-----------------------------------\n１F玄関専用","","-----------------------------------\n1F entrance only"],["SuspendEvent 青","","SuspendEvent Blue"],["\\n<珠緒>経蔵、\\C[1]出口は↓の方！！","","\\n<珠緒> Kyozo, \\C[1] exit is below! !"],["\\n<珠緒>サダカヤ鬼、\\C[1]→の方で……","","\\n<珠緒> Sadakaya Oni, \\C[1] →..."],["\\n<珠緒>サダカヤ鬼、\\C[1]←の方で……","","\\n<珠緒> Sadakaya Oni, \\C[1]←..."],["\\n<珠緒>サダカヤ鬼、\\C[1]まっすぐ↓の方にいる。","","\\n<珠緒> Sadakaya Oni, \\C[1] Straight down ↓."],["\\n<珠緒>サダカヤ鬼、\\C[1]まっすぐ↑の方にいる。","","\\n<珠緒> Sadakaya Oni, \\C[1] Straight up ↑."],["---------------------------------------","","---------------------------------------"],["\\n<珠緒>\\C[1]↓の方にいるね。","","It's at \\n<珠緒>\\C[1]↓."],["\\n<珠緒>\\C[1]↑の方にいるね。","","It's at \\n<珠緒>\\C[1]↑."],["\\n<珠緒>\\C[1]まっすぐの方\\C[0]にいるね。","","\\n<珠緒>\\C[1]The straight one is at \\C[0]."],["ResumeEvent 青","","ResumeEvent Blue"]],"context":[["Map037/note"],["Map037/events/1/name"],["Map037/events/1/pages/0/list/1/Plugin Command"],["Map037/events/1/pages/0/list/3/Plugin Command"],["Map037/events/1/pages/0/list/4/Plugin Command"],["Map037/events/1/pages/0/list/6/Plugin Comma