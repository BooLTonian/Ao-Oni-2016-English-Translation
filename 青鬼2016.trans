アタシ、設定したっけ……？？":47,"---------------------------------------------\n青鬼出ないときはメッセージを下に出す":48,"\\n<\\I[\\V[86]] \\C[24]４号>さっきの青鬼の現れかたは想定外だったなあ……\\.\\.\nなんでだろう？？":49,"読込み用鬼２":50,"EV019":51},"extension":"json","dataType":"map","filename":"Map011","basename":"Map011.json","path":"data/Map011.json","relPath":"data/Map011.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":52,"length":52,"percent":100},"cellInfo":[]},"data/Map012.json":{"data":[["青","","blue"],["入り口","","entrance"],["EV003","","EV003"],["EV004","","EV004"],["EV005","","EV005"],["\\n<\\N[2]>地下室の鍵を手に入れた","","\\n<\\N[2]>I found the item, \"Basement Key\"."],["青ルート補正＋α","","Blue route correction +α"],["DiscardPicture tetugousi","","DiscardPicture tetugousi"],["DiscardPicture te","","DiscardPicture te"],["DiscardPicture ao_up","","DiscardPicture ao_up"],["DiscardPicture ao_up_mika","","DiscardPicture ao_up_mika"],["DiscardPicture ao_up_takesi","","DiscardPicture ao_up_takesi"],["DiscardPicture ao_up_takurou","","DiscardPicture ao_up_takurou"],["青２","","blue 2"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"]],"context":[["Map012/events/1/name"],["Map012/events/2/name"],["Map012/events/3/name"],["Map012/events/4/name"],["Map012/events/5/name"],["Map012/events/5/pages/1/list/1/message/hasPicture/bottom"],["Map012/events/6/name"],["Map012/events/6/pages/2/list/117/Plugin Command"],["Map012/events/6/pages/2/list/118/Plugin Command"],["Map012/events/6/pages/2/list/119/Plugin Command"],["Map012/events/6/pages/2/list/120/Plugin Command"],["Map012/events/6/pages/2/list/121/Plugin Command"],["Map012/events/6/pages/2/list/122/Plugin Command"],["Map012/events/7/name"],["Map012/events/8/name"],["Map012/events/8/pages/0/list/0/comment"],["Map012/events/8/pages/0/list/7/comment"]],"tags":[null,null,null,null,null,null,null,["red"],["red"],["red"],["red"],["red"],["red"],null,null,["blue"],["blue"]],"parameters":[null,null,null,null,null,[{"headerIndex":1,"headerParam":["normal",0,0,2]}],null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}]],"indexIds":{"青":0,"入り口":1,"EV003":2,"EV004":3,"EV005":4,"\\n<\\N[2]>地下室の鍵を手に入れた":5,"青ルート補正＋α":6,"DiscardPicture tetugousi":7,"DiscardPicture te":8,"DiscardPicture ao_up":9,"DiscardPicture ao_up_mika":10,"DiscardPicture ao_up_takesi":11,"DiscardPicture ao_up_takurou":12,"青２":13,"青位置設定":14,"--------------------\n■デバッグモード":15,"--------------------":16},"extension":"json","dataType":"map","filename":"Map012","basename":"Map012.json","path":"data/Map012.json","relPath":"data/Map012.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":17,"length":17,"percent":100},"cellInfo":[]},"data/Map013.json":{"data":[["青","","blue"],["EV002","","EV002"],["DiscardPicture kabe_chizu","","DiscardPicture kabe_chizu"],["EV003","","EV003"],["たけしＣ","","Takeshi C"],["----------------------------\n■キルシーンの\n　画像読込みを兼ねます","","----------------------------\n■Kill scene\nAlso serves as image loading"],["\\n<\\N[2]>たけし！","","\\n<\\N[2]> Takeshi!"],["\\n<たけし>おいやめろ！\nオレの上にメッセージウィンドウを\n出すんじゃねえ！","","\\n<Takeshi>Not cool, man!\nDon't put a message box on top of me!\nNo, don't get rid of it now!"],["--------------------\n■たけし、ハゲにされ、ポイされる","","--------------------\n■Takeshi is made bald and rejected"],["--------------------","","--------------------"],["\n新演出。\nたけし、錯乱後にショック死\n-----------------------------------","","\nNew production.\nTakeshi dies of shock after becoming confused\n-----------------------------------"],["\\n<\\N[2]>何てこった！\nたけしが（ショックで）殺されちゃった！","","\\n<\\N[2]>Oh my god, they killed Takeshi!\nYou bastards!"],["\\n<\\N[2]>うわー！","","\\n<\\N[2]>Wow!"],["ちょ、ちょっと待ってくれ","","Hey, wait a minute."],["\\n<\\N[2]>！","","\\n<\\N[2]>!"],["\\n<たけし>僕だ\nたけしだよ","","\\n<Takeshi?>It's me,\nTakeshi."],["\\n<\\N[2]>……たけし？","","\\n<\\N[2]>...Takeshi?"],["\\n<たけし>この化け物、最後の一人とは\n会話をしてみたかったらしい","","\\n<Takeshi?>Who is this monster, the last one?\nIt seems like he wanted to have a conversation"],["\\n<たけし>それよりこいつから\n聞きたいことがあるそうだ","","\\n<Takeshi?> More from this guy.\nIt seems like there's something you want to ask me."],["\\n<\\C[5]化け物>\\C[5]キミ達は何なんだ\nなぜ現地の生物なんだ？\n誰に頼まれた？","","\\n<\\C[5]化け物>\\C[5]What are you guys?\nWhy local creatures?\nWho asked you?"],["\\n<\\C[5]化け物>\\C[5]キミ達には何にも迷惑かけてなかったのに\nとうとう僕一人になってしまった……","","\\n<\\C[5]化け物>\\C[5]I didn't cause any trouble to you guys.\nI was finally alone..."],["\\n<\\N[2]>…………","","\\n<\\N[2]>…………"],["\\n<\\C[5]化け物>\\C[5]何を言っても無視か","","\\n<\\C[5]化け物>\\C[5] No matter what I say, it will be ignored"],["\\n<\\C[5]化け物>\\C[5]それじゃバイバイだ","","\\n<\\C[5]化け物>\\C[5] Bye then."],["---------------------\n■最後の青鬼出現","","---------------------\n■The last blue demon appears"],["階段パディング","","stair padding"],["EV006","","EV006"],["EV007","","EV007"],["EV008","","EV008"],["Ｈ地図イベント","","H map event"],["\\n<\\I[\\V[86]] \\C[24]４号>地～図はどこへ消～えたっ、\\.\\.と。\nま、コミカル編には必要ないからだろうけど……","","\\n<\\I[\\V[86]] \\C[24]Unit 4> So, where did the map go?\\.\\.\nI guess it's not really necessary for the comedy mode..."],["---------------------------------------------\n青鬼出ないときはメッセージを下に出す","","---------------------------------------------\nIf Blue Demon does not appear, post a message below."],["\\n<\\I[\\V[86]] \\C[24]４号>やれやれ。何か調べてるときだと、\nつい「出る」ってことを忘れるねえ……","","\\n<\\I[\\V[86]] \\C[24]Unit 4>Good grief. When I'm reading about something on the internet,\nI tend to forget that I actually have to, \"touch grass\"..."],["２階１号イベントの先読みにも使用","","Also used to read in advance of the 2nd floor No. 1 event"],["EV010","","EV010"],["EV011","","EV011"],["\\n<\\N[2]>開かない","","\\n<\\N[2]>It won't open."],["開かない","","won't open"],["\\n<\\I[\\V[86]] \\C[24]４号>本編のマスコットボーイ（？）\nたけし君の控え室……\\!\nもとい、控えクローゼットのある部屋だね。","","\\n<\\I[\\V[86]] \\C[24]Unit 4>This is the room with the dresser- or rather,\nthe closet, for Mr.Takeshi...\\!\nThe main story's... Mascot boy?"],["EV012","","EV012"],["\\n<\\N[2]>子供部屋の鍵を使った","","\\n<\\N[2]>Used the \"Kid's Bedroom Key\"."],["\\n<\\N[2]>鍵が掛かっている","","\\n<\\N[2]>The door is locked."],["\\n<\\I[\\V[86]] \\C[24]４号>本編じゃヒロインの……\\.\\.\n美香ちゃんの部屋だったかな？","","\\n<\\I[\\V[86]] \\C[24]Unit 4>In the main story, this was the heroine's room...\\.\\.\nMs.Mika, was it?"],["EV013","","EV013"],["\\n<\\I[\\V[86]] \\C[24]４号>たしか、血（？）のついたグランドピアノが\nぽつんとある部屋。\nさすがのアタシも弾く気にはなれないわ……","","\\n<\\I[\\V[86]] \\C[24]Unit 4>If I remember correctly, there was a room with nothing but a\na grand piano, with blood- or something similar looking on it.\nEven I wouldn't feel like playing that..."],["青鬼_c","","Blue demon_c"],["先読み用","","For read ahead"],["たけしＣの身体・ハゲ１号","","Takeshi C's body/bald number 1"],["画像の先読み用ページ","","Image prefetch page"],["既存ページ","","Existing page"],["\\n<\\I[\\V[83]] \\C[6]１号>４号ちゃ…………","","\\n<\\I[\\V[83]] \\C[6]Unit 1>Ms. Unit 4..."],["\\n<\\I[\\V[86]] \\C[24]４号>あとで牛丼おごったげるから！！","","\\n<\\I[\\V[86]] \\C[24]Unit 4>I'll treat you to a bowl of beef ramen later!!"],["ねずみ左","","mouse left"],["ねずみ右","","mouse right"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["-------------------------------------\n=110\nハッカドール隠し？イベント用\n-------------------------------------","","-------------------------------------\n=110\nHidden hacka doll? For events\n-------------------------------------"],["--------------------------------","","--------------------------------"],["青ルート補正","","blue route correction"],["ランダム青出現設定","","Random blue appearance setting"],["Ｃ先読み１・Ｈ青手","","C look-ahead 1 H green hand"],["画像の先読み用イベントです。","","This is an event for prefetching images."],["画像の先読みもしています","","We also look ahead at images."],["Ｃ先読み２・１号髪","","C look-ahead 2nd and 1st hair"],["イベント１号","","Event No. 1"],["----------------------------\n■画像読込みを兼ねます","","----------------------------\n■Also serves as image loading"],["---------------------------------\n未使用イベントにも\n画像読み込みを担当させる","","---------------------------------\nAlso for unused events\nResponsible for image loading"],["-----------------------------------------","","-----------------------------------------"],["\\n<\\I[\\V[86]] \\C[24]４号>あ、\\.１号！　\\.\\.\\.実はさ……","","\\n<\\I[\\V[86]] \\C[24]Unit 4>Ah, \\.Unit 1!\\.\\.\\. Actually..."],["\\n<\\I[\\V[83]] \\C[6]１号>や、やめてくださいっ！\\.\\.\nわたしの上にメッセージウィンドウを出さないでくださいっ！！","","\\n<\\I[\\V[83]] \\C[6]１号>P-Please stop!\\.\\.\nPlease don't open a message box over me!!"],["--------------------\n■１号ハゲにされる","","--------------------\n■ Become the first bald person"],["------------------------------------\n髪のまんなか、ずれた後落下","","------------------------------------\nIn the middle of the hair, it shifts and falls off."],["--------------------\n１号、落ちた自分の髪に\nバナナの皮よろしく転ぶ","","--------------------\nNo. 1, my fallen hair\nFall like a banana peel"],["---------------------------------------\n青鬼がおもむろに髪を拾っていく","","---------------------------------------\nAo Oni slowly picks up hair."],["--------------------\n髪（チーズ？）はどこへ消えた？\nねずみが探しつつ退場","","--------------------\nWhere did the hair (cheese?) go?\nThe mouse leaves while looking for something."],["\\n<\\I[\\V[83]] \\C[6]１号>びえぇ～！！　\\.\\.もうお嫁に行けないです～～！！","","\\n<\\I[\\V[83]] \\C[6]Unit 1>Waaah~!!\\.\\. I can't get married anymore~~!!"],["\\n<\\I[\\V[86]] \\C[24]４号>（しまった。\\.\\.そういや青鬼の出現フラグみたいなもんだった……）","","\\n<\\I[\\V[86]] \\C[24]Unit 4>(Damn.\\.\\. It seems that was basically a trigger for the Ao Oni...)"],["\\n<\\I[\\V[86]] \\C[24]４号>まあ、\\.\\.その……。\\.\\.青鬼ちゃんさ、\nその髪食べないで、\\.\\.\\.１号に返してあげて……","","\\n<\\I[\\V[86]] \\C[24]４号> Well, um...\\.\\. Hey, Ms. Ao Oni,\\.\\. don't eat that hair.\n\\.\\.\\.Give it back to Unit 1..."],["\\n<\\I[62] \\C[5]青鬼>\\C[5]……………………","","\\n<\\I[62] \\C[5]Ao Oni>\\C[5]........."],["\\n<\\I[\\V[86]] \\C[24]４号>！？　\\.\\.ここに来る前に……。\\.\\.\nアタシだけは追っても襲わないように、\nプログラムしておいたはずなのに！？","","\\n<\\I[\\V[86]] \\C[24]Unit 4>!?\\.\\. Before coming here...\\.\\.\nI was certain I'd programmed it so that even if it chased me,\nit wouldn't attack!"],["\\n<\\I[62] \\C[5]青鬼>\\C[5]君はなぜ、僕を髪しか食いたくなくなるような身にした？\\.\\.\nこの姿は何なんだ？　食べた覚えのないやつだ。\\.\\.\n誰に頼まれた？","","\\n<\\I[62] \\C[5]Ao Oni>\\C[5]Why did you turn me into a creature that craves nothing but hair?\\.\\.\nWhat is this form? It's not one I recall ever eating.\\.\\.\nWho put you up to this?"],["\\n<\\I[\\V[86]] \\C[24]４号>え？　いや〜、そろそろ肝試しの季節になるからさぁ、\nいい感じにここをお化け屋敷にしてね、\nいい感じにみんなに楽しんでもらおうと思ってさ。","","\\n<\\I[\\V[86]] \\C[24]Unit 4>Eh? Well~, spooky season is coming up,\nso I thought I'd turn this place into a haunted house,\nand give everyone a good time."],["\\n<\\I[\\V[86]] \\C[24]４号>ほかのみんなにはナイショで、\nアタシの知ってるコワモテの人物に君を似せてみたんだけど。","","\\n<\\I[\\V[86]] \\C[24]Unit 4>Don't tell anybody, but I tried\nto make you look like a scary person I know."],["\\n<\\I[\\V[86]] \\C[24]４号>元データのアクション通り、\nリアルに首を飛ばされるのはちょっとね……。\nマスターたちを招きようがないし、アタシたちも修復が面倒だし。","","\\n<\\I[\\V[86]] \\C[24]Unit 4>Having my head actually blown off, like in the source data,\nwould be a bit much... There'd be no way to summon the masters,\nand it'd be a hassle to repair us, too.."],["\\n<\\I[\\V[86]] \\C[24]４号>髪が飛ぶならまだシャレですむかと思ったケド……\\!\nみんなの反応を見るとアトラクションとしては、\nまだちょっと過激すぎたかな～？　\\.\\.って反省して……","","\\n<\\I[\\V[86]] \\C[24]Unit 4>I thought it would be bit of harmless fun if people's hair got\nblown around...\\! But looking at everyone's reactions, I'm\nreconsidering whether it was too extreme for an attraction~..."],["\\n<\\I[\\V[83]] \\C[6]１号>ゼロ姉じゃなくて、本物の青鬼！？\\!\nすべては４号ちゃんの……\\.\\.シワザだったんですかっ！？","","\\n<\\I[\\V[83]] \\C[6]Unit 1>It's not big sis Zero- It's the real Ao Oni!?\\!\nWas this all...\\.\\. Ms. Unit 4's doing!?"],["\\n<\\I[62] \\C[5]青鬼>\\C[5]あくまでこちらの都合を無視か。","","\\n<\\I[62] \\C[5]Ao Oni>\\C[5]So you're just ignoring me?"],["\\n<\\I[63] \\C[5]青鬼>\\C[5]それじゃバイバイだ。","","\\n<\\I[63] \\C[5]Ao Oni>\\C[5]Bye bye then."],["\\n<\\I[\\V[86]] \\C[24]４号>髪の色が１号たちの色に変わった！？","","\\n<\\I[\\V[86]] \\C[24]Unit 4>Their hair color has changed to match Unit 1, and the others."]],"context":[["Map013/events/1/name"],["Map013/events/2/name"],["Map013/events/2/pages/0/list/0/Plugin Command","Map013/events/3/pages/0/list/0/Plugin Command","Map013/events/7/pages/0/list/0/Plugin Command","Map013/events/8/pages/0/list/0/Plugin Command"],["Map013/events/3/name"],["Map013/events/4/name"],["Map013/events/4/pages/0/list/0/comment"],["Map013/events/4/pages/1/list/4/message/hasPicture/top"],["Map013/events/4/pages/1/list/8/message/hasPicture/top"],["Map013/events/4/pages/1/list/12/comment"],["Map013/events/4/pages/1/list/32/comment","Map013/events/4/pages/1/list/62/comment","Map013/events/18/pages/0/list/7/comment","Map013/events/23/pages/1/list/222/comment"],["Map013/events/4/pages/1/list/33/comment"],["Map013/events/4/pages/1/list/64/message/hasPicture/bottom"],["Map013/events/4/pages/2/list/1/message/hasPicture/bottom"],["Map013/events/4/pages/2/list/21/message/hasPicture/top"],["Map013/events/4/pages/2/list/25/message/hasPicture/top"],["Map013/events/4/pages/2/list/32/message/hasPicture/top"],["Map013/events/4/pages/2/list/36/message/hasPicture/top"],["Map013/events/4/pages/2/list/38/message/hasPicture/top"],["Map013/events/4/pages/2/list/41/message/hasPicture/top"],["Map013/events/4/pages/2/list/47/message/hasPicture/top"],["Map013/events/4/pages/2/list/51/message/hasPicture/top"],["Map013/events/4/pages/2/list/54/message/hasPicture/top"],["Map013/events/4/pages/2/list/56/message/hasPicture/top"],["Map013/events/4/pages/2/list/60/message/hasPicture/top"],["Map013/events/4/pages/2/list/62/comment","Map013/events/23/pages/1/list/359/comment"],["Map013/events/5/name"],["Map013/events/6/name"],["Map013/events/7/name"],["Map013/events/8/name"],["Map013/events/9/name"],["Map013/events/9/pages/0/list/6/message/noPicture/top","Map013/events/9/pages/0/list/33/message/noPicture/bottom"],["Map013/events/9/pag