,null,null,null,null,[{"headerIndex":0,"headerParam":["N2",0,0,0]}]],"indexIds":{"押入れ左":0,"押し入れの中には\nふとんが乱雑にたたまれて入っていた。":1,"\\n<珠緒>ふとんから俊雄の気配がする。\\!\n……あわてて片付けたような感じ。":2,"\\n<経蔵>ふっ。乱闘の前に片付けかよ。\\!\n……あいつも生前はしつけがよかったのかもな。":3,"押入れ右":4,"EV003":5,"EV004":6,"EV005":7,"EV006":8,"EV007":9,"EV008":10,"EV009":11,"案内矢印":12,"青":13,"青位置設定":14,"--------------------\n■デバッグモード":15,"--------------------":16,"自動イベント":17,"浴室から引き継ぎ\n------------------------------------\nお互いに情報交換しあった。":18,"\\n<経蔵>……目の見えないお前の脳裏にわざわざ念写で\n幻を見せて放心させるとはな。":19,"\\n<珠緒>貞子に……\\.\\.呪われたと思う……。\\!\nビデオを見たのと同じで……。":20,"\\n<\\N[2]>（洗濯機の排水溝に大量の髪の毛が詰まっていたのは\n　なぜだったのでしょうか……）":21,"\\n<経蔵>いつから貞子のやつ、\nビデオを見たことと関係なく自分から直接呪いを\nかけるようになった……？":22,"\\n<\\N[2]>貞子の肌は……青かったでしょうか？":23,"\\n<経蔵>……\\N[2]、お前もその線を疑うか。\\!\nああ。青鬼と同じ色の肌だった。\\!\nそのときの貞子はお前の目に見えていなかったっけな。":24,"\\n<\\N[2]>青鬼と接触したことで、\nほかの化け物たちの性質になんらかの影響があった\n可能性を考えています。":25,"\\n<経蔵>ああ。俊雄もそれで\nパワーアップしてたようだしな……。":26,"\\n<珠緒>経蔵のせいだからね……。\\!\nぐすっ……。":27,"\\n<経蔵>……ま。命までとる発想が\nそのときの貞子になくてよかった。":28,"\\n<珠緒>こんなフォロー、最悪……。":29,"\\n<経蔵>フォローはお互い様。\\!\n最悪というなら俺がこんど何かしくじったとき、\n積年の不満でも込めてフォローしてくれりゃいいんだよ。":30,"\\n<\\N[2]>……化け物たちは協力関係にあるのでしょうか？":31,"\\n<経蔵>いや。スキのできた獲物を\nかわるがわる狙った、と考える方が自然だろう。\\!\nお互い協力する気もないくせに、とんだ連係プレーだぜ。":32,"\\n<経蔵>くそったれが……！":33,"その言葉はどちらかというと、\n経蔵さん自身に向けられていたように感じられた……":34,"----------------------------------\nその時、館の電話が鳴った。\n経蔵が一人で取りに行くことに。":35,"AltBgs play Phone 0 50 60":36,"\\n<経蔵>……貞子に\"礼\"を言ってくる。":37,"-------------------------------------":38,"珠緒（介抱中）グラ":39,"洗濯機・電話音":40,"AltBgs vol 0 0 1":41,"AltBgs vol 0 50 1":42,"珠緒（介抱中）１":43,"珠緒（介抱中）２":44,"珠緒（介抱中）３":45,"ひろし":46,"\\n<\\N[2]>珠緒さんのことは私が見ています。":47},"extension":"json","dataType":"map","filename":"Map091","basename":"Map091.json","path":"data/Map091.json","relPath":"data/Map091.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":48,"length":48,"percent":100},"cellInfo":[]},"data/Map092.json":{"data":[["押入れ左","","closet left"],["EV002","","EV002"],["押入れ右","","closet right"],["EV004","","EV004"],["EV005","","EV005"],["EV006","","EV006"],["\n開かない。","","\nIt won't open."],["\\n<経蔵>……電話、いったん切れたか？","","\\n<経蔵>...Did the phone hang up?"],["EV007","","EV007"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["電話音","","phone tone"],["AltBgs vol 0 40 1","","AltBgs vol 0 40 1"]],"context":[["Map092/events/1/name"],["Map092/events/2/name"],["Map092/events/3/name"],["Map092/events/4/name"],["Map092/events/5/name"],["Map092/events/6/name"],["Map092/events/6/pages/0/list/2/message/noPicture/top"],["Map092/events/6/pages/0/list/13/message/hasPicture/top"],["Map092/events/7/name"],["Map092/events/8/name"],["Map092/events/9/name"],["Map092/events/9/pages/0/list/0/comment"],["Map092/events/9/pages/0/list/7/comment"],["Map092/events/10/name"],["Map092/events/10/pages/0/list/1/Plugin Command"]],"tags":[null,null,null,null,null,null,null,null,null,null,null,["blue"],["blue"],null,["red"]],"parameters":[null,null,null,null,null,null,[{"headerIndex":2,"headerParam":["",0,1,0]}],[{"headerIndex":13,"headerParam":["spiritualists",0,0,0]}],null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}]],"indexIds":{"押入れ左":0,"EV002":1,"押入れ右":2,"EV004":3,"EV005":4,"EV006":5,"\n開かない。":6,"\\n<経蔵>……電話、いったん切れたか？":7,"EV007":8,"青":9,"青位置設定":10,"--------------------\n■デバッグモード":11,"--------------------":12,"電話音":13,"AltBgs vol 0 40 1":14},"extension":"json","dataType":"map","filename":"Map092","basename":"Map092.json","path":"data/Map092.json","relPath":"data/Map092.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":15,"length":15,"percent":100},"cellInfo":[]},"data/Map093.json":{"data":[["本棚左","","Bookshelf left"],["本棚右","","Bookshelf right"],["EV003","","EV003"],["EV004","","EV004"],["EV005","","EV005"],["------------------------------------\n先に青いノート入手時は、\nこのイベントが起きない","","------------------------------------\nWhen you get the blue notebook first,\nthis event does not occur"],["EV006","","EV006"],["------------------------------\n貞子の謎解きのため、\n初回は格子戸を強制閉鎖","","------------------------------\nTo solve Sadako's mystery,\nThe first time, the lattice door was forcibly closed."],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["青鬼の館・元主人","","Blue Oni House/Former Master"],["EV010","","EV010"],["わずかに開いた机の引き出しから\n青いノートを手に入れた。","","From the slightly open desk drawer\nI got a blue notebook."],["電話音","","phone tone"],["AltBgs vol 0 0 0","","AltBgs vol 0 0 0"]],"context":[["Map093/events/1/name"],["Map093/events/2/name"],["Map093/events/3/name"],["Map093/events/4/name"],["Map093/events/5/name"],["Map093/events/5/pages/0/list/2/comment"],["Map093/events/6/name"],["Map093/events/6/pages/1/list/2/comment"],["Map093/events/7/name"],["Map093/events/8/name"],["Map093/events/8/pages/0/list/0/comment"],["Map093/events/8/pages/0/list/7/comment"],["Map093/events/9/name"],["Map093/events/10/name"],["Map093/events/10/pages/0/list/3/message/noPicture/bottom"],["Map093/events/11/name"],["Map093/events/11/pages/0/list/1/Plugin Command"]],"tags":[null,null,null,null,null,["blue"],null,["blue"],null,null,["blue"],["blue"],null,null,null,null,["red"]],"parameters":[null,null,null,null,null,[{"headerIndex":2,"headerParam":["------------------------------------"]}],null,[{"headerIndex":2,"headerParam":["------------------------------"]}],null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}],null,null,[{"headerIndex":3,"headerParam":["",0,1,2]}]],"indexIds":{"本棚左":0,"本棚右":1,"EV003":2,"EV004":3,"EV005":4,"------------------------------------\n先に青いノート入手時は、\nこのイベントが起きない":5,"EV006":6,"------------------------------\n貞子の謎解きのため、\n初回は格子戸を強制閉鎖":7,"青":8,"青位置設定":9,"--------------------\n■デバッグモード":10,"--------------------":11,"青鬼の館・元主人":12,"EV010":13,"わずかに開いた机の引き出しから\n青いノートを手に入れた。":14,"電話音":15,"AltBgs vol 0 0 0":16},"extension":"json","dataType":"map","filename":"Map093","basename":"Map093.json","path":"data/Map093.json","relPath":"data/Map093.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":17,"length":17,"percent":100},"cellInfo":[]},"data/Map094.json":{"data":[["EV001","","EV001"],["\\n<経蔵>バケモンが近くに来るまではここにいてくれよ？","","\\n<経蔵> Please stay here until the monster comes nearby."],["青","","blue"],["EV003","","EV003"],["----------------------------------------","","----------------------------------------"],["扉はかたく閉ざされている。\\!かわりに先ほどはなかった、\nタッチディスプレイのついた電子ロックが\n新たに取り付けられている。","","The door is firmly closed. Instead of \\!, it wasn't there before,\nElectronic lock with touch display\nNewly installed."],["\\n<経蔵>なんだこりゃあ……？？\\!\nそれも貞子の気配が２つ……。\n片方は人間らしい感じがするな。","","\\n<経蔵> What is this...? ? \\!\nThere are also two signs of Sadako...\nOne feels human-like."],["\\n<経蔵>さっき屋敷の２階で話したやつと同じ気配だな……。","","\\n<経蔵> It looks like the one I talked about on the second floor of the mansion earlier..."],["\\n<経蔵>バケモンの方のも妙にしおらしい気配がするが……。","","\\n<経蔵>The monster also seems oddly similar..."],["タッチディスプレイのついた電子ロックが\n扉に取り付けられている。","","Electronic lock with touch display\nattached to the door."],["\\n<経蔵>……\\C[1]\\N[2]がいるときに\\C[0]するか。\\!\nあいつはこういうの得意そうだからな。","","\\n<経蔵>...Do you want to do \\C[0] when \\C[1]\\N[2] is present? \\!\nHe seems to be good at this kind of thing."],["---------------------------------------------\nひろしがいるときは続行","","---------------------------------------------\nContinue when Hiroshi is present"],["\\n<ディスプレイ>\n⑤：roop→????","","\\n<ディスプレイ>\n⑤：roop→????"],["--------------------------------","","--------------------------------"],["\\n<ディスプレイ>慈悲はすぐに消える。\n優しさはいつも蜃気楼。\nアテにならない。家族のものでさえ……。","","\\n<ディスプレイ> Mercy will soon disappear.\nKindness is always a mirage.\nDon't get angry. Even family things..."],["\\n<ディスプレイ>信じられるのは憎しみだけ。\\!\nひとたび憎しみを抱いた人間が明日に慈悲を取り戻した、\nなどという話を聞いたことがない。","","\\n<ディスプレイ> The only thing you can believe in is hatred. \\!\nA person who once harbored hatred regained compassion tomorrow.\nI have never heard of such a thing."],["\\n<ディスプレイ>私の“良識”は、この新たな力で憎しみを\nこんな形にすることを勧めてきたが、\\!\n何になるというのだろう……。","","\\n<ディスプレイ> My “common sense” is using this new power to destroy hatred.\nI was advised to make it like this, but \\!\nI wonder what will happen..."],["\\n<珠緒>青鬼には呪いだけじゃない\n不思議な力があるみたいだね。","","\\n<珠緒> Ao Oni has more than just a curse.\nIt seems like it has some mysterious power."],["\\n<経蔵>『言うに言えない悩みを何かの仕掛けにして具現化する』\\.\\.\nだったりしてな。","","\\n<経蔵> ``Make your unspeakable worries into some kind of device and materialize them.'' \\.\\.\nThat's what happened."],["VerticalNumberInput on","","VerticalNumberInput on"],["\\n<ディスプレイ>\n④：spiral→????","","\\n<ディスプレイ>\n④：spiral→????"],["VerticalNumberInput off","","VerticalNumberInput off"],["\\n<ディスプレイ>両親を誹謗した人々は、誹謗の対象が死してなお、\n矛をおさめることがなかった。","","\\n<ディスプレイ>The people who slandered their parents, even after the target of their slander is dead,\nI never laid down my spear."],["\\n<ディスプレイ>矛を向けたまま、あるいは刺し貫いたまま、\n何事もなかったようにどこかへ去ってしまった。","","\\n<ディスプレイ>With the spear pointing or piercing,\nHe disappeared somewhere as if nothing had happened."],["\\n<ディスプレイ>人は結局、悪気（わるぎ）しか信じない。\\!\n私も、悪気しか信じられなくなってしまった。","","\\n<ディスプレイ>In the end, people only believe in evil spirits. \\!\nI, too, can no longer believe in anything but evil spirits."],["\\n<経蔵>貞子、伽椰子よりめんどくさそうだな……。\\!\n直接の敵が亭主のような個人でなく、\n一般大衆といった“世間”だからな……。","","\\n<経蔵> Sadako seems more troublesome than Kayako... \\!\nThe direct enemy is not an individual like the husband,\nIt's the \"society\" of the general public..."],["\\n<ディスプレイ>\n③：ring→Y?V?S?Q?→????","","\\n<ディスプレイ>\n③：ring→Y?V?S?Q?→????"],["\\n<ディスプレイ>死んだことにしてまで、\nなぜ母は弟と消えてしまったのだろうか。\\!\n\\C[7]いったい何を考えているんだ。","","\\n<ディスプレイ>Even if I pretend to be dead,\nWhy did my mother disappear with my younger brother? \\!\n\\C[7] What on earth are you thinking?"],["\\n<ディスプレイ>母も弟も素直に愛することのできたあの頃に……\\!\n無理だ……\\!ああああああ゛あ゛あ゛あ゛あ゛あ゛……。","","\\n<ディスプレイ>In those days when I was able to love my mother and younger brother honestly...\\!\nIt’s impossible… \\!aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa..."],["\\n<ディスプレイ>彼女のクセが感染しそうだ……。","","\\n<ディスプレイ> Her quirks seem to be infected..."],["\\n<\\N[2]>敵対する立場の私たちの目につくところに、\nなぜ内情を吐露するのでしょうか……？","","\\n<\\N[2]>We, who are in a hostile position, can see it,\nWhy do you reveal your inner feelings...?"],["\\n<経蔵>ふっ。\\.\\.あの貞子も基本 “かまってちゃん”、\n“わかってちゃん” なのは変わらないのかもな？","","\\n<経蔵> Huh. \\.\\.That Sadako is also basically “Kamatte-chan”,\nMaybe the fact that “I understand” hasn’t changed?"],["\\n<珠緒>そのための呪い、って一面もあるからね……。\\!\n自覚あるのかな……\\.\\.そこんとこ。","","\\n<珠緒>There's also a curse for that... \\!\nI wonder if he's aware of it... \\.\\. That's about it."],["\\n<経蔵>これは、あいつなりの “賭け” なのかもな……。\\.\\.\n心を開くかどうかの、\\.\\.な。","","\\n<経蔵>Maybe this is his own \"bet\"... \\.\\.\nWhether you open up or not, \\.\\.."],["\\n<ディスプレイ>\n\"Happy \\C[10]Virus\\C[0]day To You\"","","\\n<ディスプレイ>\n\"Happy \\C[10]Virus\\C[0]day To You\""],["\\n<ディスプレイ>私の\\C[7]情報（すべて）\\C[0]を世界中に\\C[7]転写\\C[0]しない限り、\n私の居場所はないのではないだろうか……。","","\\n<ディスプレイ> My \\C[7] information (all) \\C[0] \\C[7] to the world unless \\C[0]\nI guess there is no place for me..."],["\\n<ディスプレイ>\\C[7]選ばれた人間は、捨てられた人間の怨念を\n引き受けなければならない……。","","\\n<ディスプレイ>\\C[7]The chosen human will bear the grudge of the abandoned human.\nI have to accept it...."],["\\n<珠緒>ここ、貞子の気配に混じって\n得体の知れない『何か』を感じる。","","\\n<珠緒> Here, mixed with Sadako's presence\nI feel something mysterious."],["\\n<経蔵>ああ。貞子自身も強烈な怨念の持ち主だが、\\!\n貞子を貞子たらしめる黒幕のニオイがするな。","","\\n<経蔵> Oh. Sadako herself has a strong grudge, but \\!\nI can smell the mastermind behind Sadako being Sadako."],["\\n<\\N[2]>転写とくればＤＮＡを思い起こしますが……。","","\\n<\\N[2]>When I think of transcription, I think of DNA..."],["\\n<ディスプレイ>\n\"Happy \\C[10]Birthyear\\C[0] To You\"","","\\n<ディスプレイ>\n\"Happy \\C[10]Birthyear\\C[0] To You\""],["\\n<ディスプレイ>この屋敷で、彼女と獲物を奪い合うことになった。\\!\nしかし、彼女の背後にいる意志団は私のそれと似た雰囲気だ……。\nどういうことだろう？","","\\n<ディスプレイ>In this mansion, I decided to compete with her for prey. \\!\nHowever, the will group behind her has a similar atmosphere to mine...\nWhat does that mean?"],["\\n<ディスプレイ>青鬼と呼ばれた意思団は、\nこちらが手出ししない限り攻撃はしてこないようだ。","","\\n<ディスプレイ>The will group called the Blue Demon,\nIt doesn't seem like they will attack unless I intervene."],["\\n<ディスプレイ>しかし、いまひとつ考えも行動も読めない。\n今後の気がかりだ。","","\\n<ディスプレイ>However, I can't even read his thoughts or actions.\nI'm concerned about the future."],["\\n<珠緒>……なんていうか、貞子や伽椰子を\nメインボーカルにたとえると、とんでもない数の\nバックコーラスがいる感じがする。","","\\n<珠緒>...I mean, Sadako and Kayako...\nComparing it to a main vocalist, there are an incredible number of vocalists.\nIt feels like there's a backing chorus."],["\\n<経蔵>意志団……。\\.\\.\n貞子や伽椰子の後援会みたいな霊団か？","","\\n<経蔵> Will Group... \\.\\.\nIs it a spiritual group like Sadako and Kayako's support group?"],["\\n<経蔵>そんな後ろ盾がいるなら、\nどうりで尋常じゃなく強いはずだ。","","\\n<経蔵> If you have that kind of backing,\nNo wonder it's unusually strong."],["\\n<ディスプレイ>\n\"Dub H->V\"","","\\n<ディスプレイ>\n\"Dub H->V\""],["EV004","","EV004"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["EV006","","EV006"],["自動イベント","","automatic event"],["----------------------------------------------------\nあとは青鬼をここにおびきよせるだけ、という話に。\n珠緒が青鬼が和室のふすまに隠れていると霊視。\nおびきよせることになる。\n----------------------------------------------------","","----------------------------------------------------\nThe only thing left to do is lure the blue demon here.\nTamao has a spiritual vision that the blue demon is hiding in the sliding door of the Japanese-style room.\nIt will lure them away.\n----------------------------------------------------"],["\\n<珠緒>おそい。","","\\n<珠緒> You're late."],["\\n<経蔵>道草に当たって死んだんじゃねえかって\n心配してたトコだったんだぜ？","","\\n<経蔵> I think he probably died after hitting Michikusa.\nThat's what you were worried about, right?"],["ビデオデッキを設置した。","","A video deck was installed."],["\\n<\\N[2]>動作はいいようです。\nこれならそちらの“呪いのビデオ”というものも\n再生できるでしょう。","","\\n<\\N[2]> It seems to work fine.\nIf this is your “cursed video”\nYou can play it."],["\\n<経蔵>牢の中にコンセントがあって助かったぜ。","","\\n<経蔵> There was an outlet inside the cell, which was a relief."],["\\n<\\N[2]>テストに持ってきたテープですが、\n映っているのは、この屋敷の家族でしょうか……？","","\\n<\\N[2]>This is the tape I brought to the test.\nIs it the family of this mansion that is reflected...?"],["\\n<経蔵>今となっちゃ、\\.\\.どうでもいいもんだけどな……。","","\\n<経蔵>Now, \\.\\.I don't care..."],["\\n<\\N[2]>そのビデオテープに宿るという\n貞子（さだこ）なる化け物の力で、\nこの屋敷の化け物を退治するとのことですが……","","\\n<\\N[2]>It is said that it resides in that videotape.\nWith the power of a monster named Sadako,\nIt is said that they will exterminate the monsters in this mansion..."],["\\n<経蔵>霊的なことを基本信じていない\nお前にしちゃ不安だろうが、やるしかない。","","\\n<経蔵> I basically don't believe in spiritual things.\nI know it's a little scary for you, but I have no choice but to do it."],["\\n<経蔵>バケモンにはバケモンをぶつけんだよ。\\!\nあと、お前がデッキといっしょに持ってきたノートも\nそこに立てて置いといてくれ。","","\\n<経蔵> I hit a monster with a monster. \\!\nAlso, the notebook you brought with the deck.\nLeave it standing there."],["\\n<\\N[2]>持ってきた覚えはないのですが、\nいつのまにか小脇に……","","\\n<\\N[2]> I don't remember bringing it.\nBefore you know it, it's under your arm..."],["\\n<珠緒>完全に狙われてるね。伽椰子に。","","\\n<珠緒> You're definitely being targeted. At Kayako."],["\\n<経蔵>そのノートは伽椰子の身体のようなものだ。\n実物を見るのは初めてだがな。","","\\n<経蔵> That notebook is like Kayako's body.\nThis is my first time seeing the real thing."],["\\n<経蔵>うまくすりゃ、\n伽椰子にも貞子の呪いがかかるだろう。\nそうすりゃ二兎を得られるってもんだがな。","","\\n<経蔵>If things go well,\nKayako will also be cursed by Sadako.\nIf I did that, I could get two rabbits."],["\\n<珠緒>まだだね。\\.\\.\n屋敷の化け物の気配は。\\.\\.ぼんやりしてる。","","\\n<珠緒> Not yet. \\.\\.\nAny signs of monsters in the mansion? \\.\\. I'm feeling absent-minded."],["\\n<経蔵>ここのバケモンは気まぐれだな。\nだから命びろいもしやすいってトコだが。\\!\n\\N[2]、その普通の\\C[1]ビデオでも見ながら待機\\C[0]してろ。","","\\n<経蔵>The monsters here are so fickle.\nThat's why it's easy to lose your life. \\!\n\\N[2], wait \\C[0] while watching that normal \\C[1] video."],["例の鉄格子アニメ始まる","","The classic iron grid anime begins."],["例の鉄格子アニメ","","example iron grid animation"],["DiscardPicture tetugousi","","DiscardPicture tetugousi"],["DiscardPicture te","","DiscardPicture te"],["DiscardPicture ao_up","","DiscardPicture ao_up"],["DiscardPicture ao_up_mika","","DiscardPicture ao_up_mika"],["DiscardPicture ao_up_takesi","","DiscardPicture ao_up_takesi"],["DiscardPicture ao_up_takurou","","DiscardPicture ao_up_takurou"],["------------------------------------","","------------------------------------"],["\\n<経蔵>デケェなおい！！","","\\n<経蔵> So big! !"],["\\n<珠緒>経蔵、ビデオ！！","","\\n<珠緒> Kyozo, video! !"],["\\n<経蔵>わかってんだよ！！","","\\n<経蔵> I know! !"],["\\n<経蔵>さあ、鬼さんこちら！\n呪いの上映会、伽椰子と楽しんでいってくれよな！","","\\n<経蔵> Come on, demon here!\nEnjoy the cursed screening with Kayako!"],["\\n<\\N[2]>（“鬼”……）","","\\n<\\N[2]> (“Oni”…)"],["いったん呪いのビデオ部屋へ","","Go to the cursed video room"],["呪いのビデオ部屋からの続き。\n青鬼がビデオを観ている。","","A continuation of the cursed video room.\nAo Oni is watching a video."],["何かが引っかかっているのか、動かない！","","It doesn't move, probably because something is stuck on it!"],["\\n<経蔵>くそっ、俺の出番かよ！？","","\\n<経蔵> Damn it, it's my turn! ?"],["------------------------------------\nあわやというところで電話が鳴る\n電話役はテレビ（笑）","","------------------------------------\nThe phone rings in the middle of nowhere\nTV plays the role of telephone (lol)"],["\nそのとき、遠くから電話の音が響いた。","","\nAt that moment, the sound of a telephone rang from far away."],["(4,15)の3ページ目に引き継ぎ","","Transferred to 3rd page of (4,15)"],["玄関ホール(4,15)から引き継ぎ\n\nお互いの無事を確かめるひろしと経蔵。\n一行は２Ｆ左下寝室へ","","Take over from entrance hall (4,15)\n\nHiroshi and Keizo make sure each other is okay.\nThe group goes to the lower left bedroom on the 2nd floor."],["\\n<経蔵>青鬼のやつ、\nまさか俺たちよりも電話の方を選ぶとはな。\\!\n家の人間としての条件反射でも持ってんのか……？","","\\n<経蔵> Blue demon guy,\nI never thought he would choose the phone over us. \\!\nDo you also have a conditioned reflex as a family member...?"],["\\n<\\N[2]>“青鬼”……？","","\\n<\\N[2]> “Blue Demon”…?"],["\\n<経蔵>屋敷のバケモンのことだよ。\nいいかげん呼び名が欲しかったところだ。","","\\n<経蔵> I'm talking about the monster in the mansion.\nI just wanted a nickname."],["\\n<経蔵>お前ついさっき、\n“青い鬼”ってつぶやいてただろ。それで決まり。","","\\n<経蔵>You just said,\nYou were tweeting “Blue Demon”. That's it."],["\\n<\\N[2]>経蔵さんが、あの化け物のことを\n“鬼”と呼んでいたので……。","","\\n<\\N[2]> Mr. Keizo told me about that monster.\nI used to call him \"demon\"..."],["\\n<\\N[2]>わかりました。\n今後、屋敷の化け物のことを“青鬼”と呼びましょう。","","\\n<\\N[2]> Understood.\nFrom now on, let's call the monster in the mansion \"Blue Demon.\""],["\\n<珠緒>青鬼、ビデオは一通り見たと思うけど、\n屋敷の外でうろついてるみたい。\\!\nまだ出れないよ。","","\\n<珠緒>Ao Oni, I think you've seen the entire video.\nLooks like he's wandering around outside the mansion. \\!\nI can't go out yet."],["\\n<経蔵>そうか。\\.\\.うまいとこバケモンどうし、\n潰しあってくれるのを見届けられるといいけどな……","","\\n<経蔵>I see. \\.\\. Good cousins and monsters,\nI hope I can see them crushing each other..."],["\\n<珠緒>とりあえず休みたい。","","\\n<珠緒>I just want to take a break."],["\\n<\\N[2]>では、安全のため、もうしばらくここで。","","At \\n<\\N[2]>, just to be safe, I'll stay here for a while."],["\\n<珠緒>パス。\\.\\.ふとんのあるとこで。","","\\n<珠緒> path. \\.\\.Where the futon is."],["\\n<経蔵>じゃあ、途中にあった和室はどうだ？\nあそこならすぐ玄関から出られそうだけどな。","","\\n<経蔵>Then, how about the Japanese-style room along the way?\nI guess I could just walk out the front door over there."],["\\n<\\N[2]>あちらはなぜか押し入れがからっぽで、\nふとんがありません。\\!\n２階の部屋から持ってきましょうか？","","\\n<\\N[2]>For some reason, the closet over there is empty.\nThere is no futon. \\!\nShall I bring it from the room on the second floor?"],["ふとんは、私が目覚めた\\C[1]２階↓、←の寝室\\C[0]に\nあったはず……","","The futon is in the bedroom \\C[0] on the 2nd floor ↓ and ← where I woke up.\nIt should have been..."],["\\n<経蔵>そうするか。\n珠緒、大事をとっていっしょに動くぞ。","","\\n<経蔵> Would you like to do that?\nTamao, let's take care and move together."],["\\n<経蔵>念のため、呪いのビデオと伽椰子のノートも持ってくか。\n何か使えるかもしれない。","","\\n<経蔵>Just in case, I'll also bring the cursed video and Kayako's notebook.\nI might be able to use something."],["\\n<珠緒>（呪いの品が２つも手もとにくるなんて……）","","\\n<珠緒> (Two cursed items come to hand...)"],["\\n<経蔵>さっさとこないと死ぬぞ？","","\\n<経蔵> If you don't come quickly, you'll die!"],["座敷牢テレビ","","Zashiki Gyou TV"],["----------------------------------\nテレビを調べると先に進む","","----------------------------------\nExamine the TV to proceed."],["\\n<\\N[2]>（待つしかありませんか……）","","\\n<\\N[2]> (I have no choice but to wait...)"],["　待機する","","Wait"],["　２人と雑談する　","","Chat with two people"],["\\n<珠緒>経蔵。\\.\\.近くに気味の悪い気配を感じる。\n\\C[1]ここにくる途中のどこか、\\C[0]だと思う。","","\\n<珠緒>Kyozo. I feel a strange presence near \\.\\..\n\\C[1] I think it's \\C[0] somewhere on the way here."],["\\n<経蔵>伽椰子か？","","\\n<経蔵> Kayako?"],["\\n<珠緒>ちがう。\\.\\.\n……でも、伽椰子にひけをとらない力を感じる。","","\\n<珠緒> Different. \\.\\.\n...But I feel that it has a power that rivals Kayako."],["\\n<経蔵>この屋敷の主か。","","\\n<経蔵> Are you the owner of this mansion?"],["\\n<\\N[2]>では作戦通り、\n屋敷の化け物をここに案内してきます。","","At \\n<\\N[2]>, as planned,\nI'll show you the monsters in the mansion here."],["\\n<経蔵>おい貞子。\\.\\.出番だぞ。\\.\\.しっかり相手してやれよ？","","\\n<経蔵>Hey, Sadako. It's \\.\\.'s turn. \\.\\. Do a good job with your opponent, okay?"],["------------------------------------------","","------------------------------------------"],["\\n<経蔵>勝手にテレビがついているあたり、\nバケモン屋敷らしいな。","","\\n<経蔵> The TV turns on automatically,\nLooks like a monster mansion."],["\\n<\\N[2]>経蔵さん。呪いのビデオをお借りします。\nデッキの内蔵ハードディスクから、このビデオに\nダビングしてみますね。","","\\n<\\N[2]> Mr. Keizo. I'd like to borrow a cursed video.\nThis video is saved from the deck's internal hard disk.\nI'll try dubbing it."],["\\n<\\N[2]>電子ロックの \\>\"Dub H->V\"\\< という\nメッセージはおそらく\n\\>\"Dubbing HDD->VIDEO\"\\<という意味でしょう。","","\\n<\\N[2]> Electronic lock \\>\"Dub H->V\"\\<\nThe message is probably\n\\>\"Dubbing HDD->VIDEO\" \\< probably means."],["\\n<経蔵>何が上書きされるんだ……？","","\\n<経蔵> What will be overwritten...?"],["画面には何も映らない。\\!\nしかし、なぜだか見ているだけで安心感を覚える。","","Nothing appears on the screen. \\!\nBut for some reason, just looking at it makes me feel safe."],["CastCommonEventName 座敷牢テレビ 身震い","","CastCommonEventName Zashiki Gyou TV Shiver"],["\\n<珠緒>貞子の気配が乱れてきた。\\.\\.\n混乱してる。","","\\n<珠緒> Sadako's presence has become disturbed. \\.\\.\nI'm confused."],["\\n<経蔵>どういうことだ……？","","\\n<経蔵> What do you mean...?"],["-------------------------------------------","","-------------------------------------------"],["\\n<珠緒>この本棚の中身、\nいまのビデオデッキと同じ気配がする！\\!\nほんのり温かい感じ……","","\\n<珠緒>The contents of this bookshelf,\nIt looks just like today's VCR! \\!\nFeeling slightly warm..."],["\\n<経蔵>デッキのハードディスクを\n（霊的に）細工したのはお前らか。\\!\n悪者じゃなさそうなのは結構だが。","","\\n<経蔵> Deck hard disk\n(Spiritually) Are you the ones who manipulated it? \\!\nIt's fine that he doesn't seem like a bad guy."],["\\n<\\N[2]>……本棚に身をやつしている人たち、でしょうか。\\!\nどんな方々で、何とおっしゃっていますか？","","\\n<\\N[2]>...The people hiding on the bookshelf? \\!\nWho are they and what do they say?"],["\\n<珠緒>貞子や伽椰子も含めて、同じように呪っている\n人たちにとっての……大切な人の集まりみたい。","","\\n<珠緒> Sadako and Kayako are also cursed in the same way.\nFor people... it's like a gathering of important people."],["\\n<\\N[2]>……！？","","\\n<\\N[2]>...! ?"],["\\n<経蔵>大切といっても、命を奪われて魂を\n箱の中に“大切に”しまわれた感じらしい。\\!\nたまったもんじゃねえな。","","\\n<経蔵>Even though it's important, my life is taken away and my soul is lost.\nIt seems like it was kept “treasured” in the box. \\!\nIt's not something I've accumulated."],["\\n<珠緒>今まで縛られて動けなかったのが、\n青鬼の屋敷の空間と合わさってから、\nなぜか身体を動かせるようになったんだって。","","\\n<珠緒>Up until now, I was tied up and couldn't move.\nAfter combining with the space of Ao Oni's mansion,\nFor some reason, I was able to move my body."],["\\n<珠緒>本棚はとりあえず……\\.\\.仮の姿みたい。","","\\n<珠緒>The bookshelf seems to be temporary...\\.\\.."],["\\n<経蔵>監禁つながりで、ここと合わさったのかもな。","","\\n<経蔵> It may have been combined with this due to the confinement connection."],["\\n<珠緒>「今は軟禁に近い状態までよくなってる」、\nだって。","","\\n<珠緒> “The situation has improved to the point where it’s almost like being under house arrest.”\nBecause."],["\\n<経蔵>怨霊どもの一部は、こいつらのもとへ\nかわるがわる暖を取るかのように来ているそうだ。","","\\n<経蔵> Some of the vengeful spirits will go to these guys.\nIt seems that they are coming here one after another to keep warm."],["\\n<\\N[2]>……まるでストーブか暖炉ですね。","","\\n<\\N[2]>...It's like a stove or fireplace."],["\\n<経蔵>貞子や伽椰子も、\nときどき来ているとのことだ。","","\\n<経蔵> Sadako and Kayako too,\nIt is said that he comes from time to time."],["ふと、目を閉じた。\\!\n貞子らしき女性が人の輪（リング）の中心で\n立ちすくんでいる様子が浮かんだ。","","Suddenly, I closed my eyes. \\!\nA woman who looks like Sadako is at the center of a ring of people.\nI could see him standing there frozen."],["しかし、周囲の人たちは距離をとりつつも、\n温かく彼女のことを待っているように見受けられた。","","However, while the people around them kept their distance,\nHe seemed to be waiting warmly for her."],["\\n<珠緒>貞子のそばに誰か来た。\\!\n……遺品にちょっと残ってたこの気配はたしか、","","\\n<珠緒> Someone came near Sadako. \\!\n...I'm sure there was a little bit of this feeling left in the belongings,"],["\\n<珠緒>遠山……\\.\\.博（ひろし）","","\\n<珠緒> Toyama...\\.\\. Hiroshi"],["\\n<経蔵>貞子の彼氏か。\\!\n……ふっ、\\.\\.縁だな。","","\\n<経蔵> Sadako's boyfriend? \\!\n...Phew, it's related to \\.\\.."],["\\n<経蔵>……何を話したかよく聞こえなかったが、\n気配の変化からして、\nバケモンのハートにいくらか届いたみたいだな。","","\\n<経蔵>...I couldn't quite hear what you said, but\nFrom the change in mood,\nLooks like some of it has reached the heart of the monster."],["\\n<経蔵>ふっ。\\.\\.貞子にとっては圧倒的な思いやりの方が\n逆にこたえるみたいだな？","","\\n<経蔵> Huh. \\.\\. For Sadako, overwhelming compassion is better.\nIt seems like the answer is the opposite?"],["\\n<経蔵>なるほど……。\\.\\.\nあえて癒やすことで呪う気を削ぐことができるのか。","","\\n<経蔵> I see... \\.\\.\nIs it possible to reduce the desire to curse by daring to heal?"],["\\n<珠緒>ダビングが終わった。\\!\nたしかに、貞子の気配が若干変わってるね……。\nもう１回ダビングしてみる？","","\\n<珠緒> Dubbing has finished. \\!\nIt's true that Sadako's attitude has changed slightly...\nShall we try dubbing again?"],["\\n<経蔵>いや、やめておこう。\\.\\.\nこれ以上は、これまでの世間への不信感との\nせめぎあいで、貞子が発狂しかねない。","","\\n<経蔵> No, let's stop. \\.\\.\nAny more than this is due to the previous distrust of the world.\nThe conflict could drive Sadako crazy."],["\\n<経蔵>世間から受けた傷は\n世間でないと回復は難しい。","","\\n<経蔵>The wounds I received from the world\nRecovery is difficult without the world."],["\\n<経蔵>貞子、世間のフロにゆっくりつかりな……。\\.\\.\n沙汰はそれからだ。","","\\n<経蔵> Sadako, take your time with the world... \\.\\.\nThat's what happened after that."],["\\n<経蔵>怨霊どもが自分の慰めのためにとっておいた\n親切な人間たちが、\nひとつの世間になるまでになっていたか。","","\\n<経蔵>The vengeful spirits kept it for their own comfort.\nkind people,\nHas it reached the point where it has become one world?"],["\\n<経蔵>それに「よしよし」されるとは、\n貞子も因果なやつだな。","","\\n<経蔵> And it's ``Yoshiyoshi'',\nSadako is also a causal person."],["\\n<珠緒>貞子を「よしよし」してもらえるよう\n働きかけたのは遠山だってね？","","\\n<珠緒>I want Sadako to be “good”\nToyama was the one who worked on it, right?"],["\\n<経蔵>ああ。自由がきくようになってから\nここの連中に頭下げまくっていたそうだ。\\!\n今回のＭＶＰだな。","","\\n<経蔵> Oh. After I became free\nIt seems like he was bowing down to the guys here. \\!\nThis time's MVP."],["経蔵","","Sutra"],["\\n<経蔵>ホントは屋敷の脱出経験者のお前に任せて\n俺らは表にバックレたいんだがな。\\!\n表に仕掛けたもののチェックもあるしな。","","\\n<経蔵> I'll leave the truth to you, who has experience in escaping from mansions.\nWe want to be back on the table. \\!\nThere's also a check on what's set up on the table."],["\\n<\\N[2]>表で待機頂くこと自体は構わないのですが、\n屋敷の化け物がお二人を狙ってしまうと\n作戦が混乱しかねませんしね。","","I don't mind waiting on the \\n<\\N[2]> table, but\nWhat happens when a monster in the mansion targets the two of you?\nIt could confuse the strategy."],["\\n<経蔵>肉をチラせて骨を断つ。\\.\\.\nその肉は一箇所にまとめてでないと、ってか。","","\\n<経蔵> Flash the flesh and cut the bones. \\.\\.\nAll that meat has to be gathered in one place."],["\\n<経蔵>あ～あ、\\.\\.っと。","","\\n<経蔵> Ah, \\.\\.."],["\\n<\\N[2]>残念ながら、\n確実にビデオを屋敷の化け物に見せる、\nそれ以上の策は思いつきません……。","","\\n<\\N[2]> Unfortunately,\nReliably shows the video to the monster in the mansion,\nI can't think of any other solution..."],["\\n<経蔵>ま、\\.\\.退治できりゃいいんだよ。","","\\n<経蔵> Well, I just need to be able to get rid of \\.\\.."],["\\n<経蔵>この屋敷で一番の安全地帯を利用する案を\n教えてくれたんだ。\\.\\.それだけで感謝してるぜ？","","\\n<経蔵>I have a plan to use the safest area in this mansion.\nHe told me. \\.\\. That's all I'm grateful for, right?"],["\\n<経蔵>はやく屋敷のバケモンを迎えに行ってやれよ。\nお前にとっちゃ顔なじみだろ？","","\\n<経蔵> Hurry up and pick up the monster from the mansion.\nLooks very familiar to you, doesn't it?"],["珠緒","","Tamao"],["\\n<経蔵>珠緒、走って逃げる必要があるときは\n背中を貸すからな。\\.\\.\nヘタに遠慮すんじゃねえぞ？","","\\n<経蔵> Tamao, when you need to run away\nI'll lend you my back. \\.\\.\nDon't be shy, okay?"],["\\n<珠緒>無利息なら考える。","","\\n<珠緒> I'll think about it if there's no interest."],["\\n<珠緒>あと、利息つけるなら、こいつにつけといて。","","\\n<珠緒>Also, if you want to earn interest, give it to this guy."],["\\n<珠緒>走って逃げなきゃいけないことになったら\nガイド失格だから。","","\\n<珠緒> If you have to run away\nBecause I'm disqualified as a guide."],["\\n<\\N[2]>目に見えないときの屋敷の化け物を\n察知できるという珠緒さんのご協力があれば、\nそのぶん、よりお力になれるかもしれません。  ","","\\n<\\N[2]>The monster in the mansion when invisible\nWith the cooperation of Tamao who can detect it,\nMaybe I can help you even more.  "],["\\n<\\N[2]>まさに今がそのときだと思われますが、\nいかがでしょう。","","\\n<\\N[2]>It seems like now is the time,\nWhat do you think?"],["\\n<珠緒>……………………。","","\\n<珠緒>……………………."],["\\n<経蔵>ふっ。珠緒から１本とったか。","","\\n<経蔵> Huh. Did you take one from Tamao?"],["-----------------------------------------\n珠緒だけツンデレ？なぶん、セリフが\n１段階多い","","-----------------------------------------\nIs Tamao the only tsundere? Nabun, the lines are\n1 step more"],["\\n<珠緒>あんた、キライ…………。","","\\n<珠緒> I hate you……."],["\\n<経蔵>\\N[2]、悪く思わないでくれ。\n珠緒は人見知りでな。","","\\n<経蔵>\\N[2], don't feel bad.\nTamao is shy."],["\\n<経蔵>なじみのない人間には毒づくのが\n流儀（クセ）みたいなもんなんだ。","","\\n<経蔵>It's poisonous to unfamiliar people.\nIt's like a habit."],["\\n<珠緒>経蔵、人のこと…………。","","\\n<珠緒>Kyozo, people…………."],["\\n<経蔵>早く俺を見習って、ＴＰＯを見極めて\n毒づけるようになってくれよ？","","\\n<経蔵> Hurry up and follow me and find out the TPO.\nPlease start poisoning me?"],["\\n<珠緒>経蔵もキライ…………！","","\\n<珠緒> I hate Kyozo too…!"],["\\n<珠緒>みんな、キライ…………！","","\\n<珠緒> Everyone, I hate you…!"],["\\n<珠緒>化け物を迎えに行く必要あるの？\nどのみち、あたしたちを探してるだろうし。","","\\n<珠緒> Do I need to pick up a monster?\nThey're probably looking for us anyway."],["\\n<\\N[2]>相手をこちらのペースに乗せることが大事ですので。\\.\\.\nご索敵、感謝します。","","\\n<\\N[2]>It's important to let your opponent match your pace. \\.\\.\nThank you for your help."],["俊雄","","Toshio"],["青２","","blue 2"],["伽椰子ノート","","Kayako Note"],["\\n<珠緒>そのノートには呪いのビデオと\n同じような力があるね。\\!読んだら呪われて死ぬ。","","\\n<珠緒>There's a cursed video on that note.\nIt has similar power. If you read \\!, you will be cursed and die."],["\\n<\\N[2]>つまり、デス・ノートということですか。 ","","\\n<\\N[2]> So you mean Death Note? "],["\\n<経蔵>まあ。\\.\\.入れば呪われて死ぬ、\nこのデス・ハウスの中にいる人間にとっては\n今さら、\\.\\.だけどな。","","\\n<経蔵> Well. If you enter \\.\\., you will be cursed and die.\nFor the humans inside this death house\nNow, it's \\.\\.."],["\\n<経蔵>いまは屋敷のバケモンに\nこのデス・ムービーを見せて\nこのデス・ゲームを制することにだけ専念しとけ。","","\\n<経蔵>Now I'm the monster in the mansion\nshow me this death movie\nJust concentrate on winning this death game."],["\\n<経蔵>それでじゅうぶんだ。\\!\nあんまり気にして伽椰子に\n“その気がある”なんて誤解させんじゃねえぞ？","","\\n<経蔵> That's enough. \\!\nDon't worry too much about it and go to Kayako\nDon't let it mislead you into thinking that you're interested, okay?"],["\\n<\\N[2]>未知の常識を持つ存在として興味はありますが……","","\\n<\\N[2]>As someone with unknown common sense, I am interested..."],["\\n<経蔵>お前が“その気”かよ……","","\\n<経蔵> Are you “in the mood”..."],["\\n<\\N[2]>ときおりページを埋め尽くす\n“こども”、\\.\\.“こばやしくん”、\\.\\.“ほしい”。\\!\n巻末の渦巻きの描画……","","\\n<\\N[2]> Occasionally fills the page\n“Children”, \\.\\. “Kobayashi-kun”, \\.\\. “I want”. \\!\nDrawing the spiral at the end of the book..."],["\\n<珠緒>意味なんてないと思うよ？\n本人でもよく分かってないかも。","","\\n<珠緒> I don't think it means anything, right?\nMaybe even he himself doesn't understand it."],["\\n<経蔵>……伽椰子を抑えられそうなヒントがあったら\n教えてくれや。","","\\n<経蔵>...If you have any hints that might help you suppress Kayako.\nPlease tell me."],["\\n<経蔵>……手立ては多い方が助かる。","","\\n<経蔵>...The more ways you can help, the better."],["\\n<経蔵>屋敷のバケモンと伽椰子を\nダブルプレーで討ち取れれば御の字だがな……。","","\\n<経蔵>The mansion's monster and Kayako\nIt would be great if we could defeat them with a double play..."],["電話音","","phone tone"],["AltBgs vol 0 0 0","","AltBgs vol 0 0 0"],["遠山棚","","Toyama shelf"],["\\n<経蔵>そうか……。\\.\\.\n遠山、あんたはここで貞子をフォローするつもりか。\n善意の方も、バケモンの方も。","","\\n<経蔵> I see... \\.\\.\nToyama, are you planning to follow Sadako here?\nBoth those with good intentions and those who are monsters."],["\\n<経蔵>いつか、\n世の中を呪う気をなくしてくれるように……\\.\\.か。","","\\n<経蔵>Someday,\nTo stop me from cursing the world...\\.\\.?"],["\\n<経蔵>俺たちはこっちの「ひろし」と、\nこれからバケモン退治の仕上げに向かう。","","\\n<経蔵> We are \"Hiroshi\" here,\nNow I'm going to finish off the monster extermination."],["\\n<経蔵>動きがとれるようになったのなら、\n善意の意地を見せて呪いの内側から働きかけてくれ。\n俺たちだけじゃ解決は困難だ。","","\\n<経蔵>If you can move,\nShow me your good intentions and work from within the curse.\nIt's difficult for us to solve this problem alone."],["\\n<経蔵>それから遠山、俺の調べだと善意の方の貞子は、\n生きてるやつのケガも、死んだやつのケガの苦しみも\n治癒できる力があると聞いている。","","\\n<経蔵>And Toyama, from what I know, Sadako is a person with good intentions.\nThe pain of the injuries of the living and the injuries of the dead.\nI heard that it has the power to heal."],["\\n<経蔵>ケガをしてる怨霊を片っ端から治療してもらえ。\nそれでおさまる奴も多いかもしれない。","","\\n<経蔵> Please treat all the injured ghosts.\nMany people may be satisfied with that."],["\\n<経蔵>引き続き音頭をとって、ここの連中を\n働かせてくれ。","","\\n<経蔵>Please continue to lead the charge, these people.\nLet me work."],["\\n<経蔵>怨霊どもが落ち着いてきたら、\nここから自力で脱出する糸口も見えてくるだろう。\\!\n……頼むな。","","\\n<経蔵> Once the vengeful spirits have calmed down,\nYou'll probably find a way to escape from here on your own. \\!\n...Don't ask."],["\\n<経蔵>思わぬところで、いいアテができたな。\\!\n……長い目でみる必要があるが。","","\\n<経蔵>We had a great meal in an unexpected place. \\!\n...We need to take a long-term view."],["\\n<珠緒>あたしたちにも「黒幕」ができた感じ？\\!\n……頼れるかは別だけど。","","\\n<珠緒> Do you feel like we have a “mastermind” too? \\!\n...Whether I can rely on you or not is another matter."],["\\n<\\N[2]>……「白幕」\\.\\.という表現はどうでしょうか。\\.\\.\n悪事をはたらくわけではないのですから。","","\\n<\\N[2]>...How about the expression \"white curtain\" \\.\\.? \\.\\.\nIt's not like they're doing anything bad."],["\\n<経蔵>ふっ。\\.\\.ちがいないな！","","\\n<経蔵> Huh. \\.\\. It must be true!"],["小林棚","","Kobayashi shelf"],["\\n<経蔵>伽椰子の片想い相手……\\.\\.小林俊介の魂か。\\!\nこんなところにいやがったか。\\!","","\\n<経蔵> Kayako's unrequited love... \\.\\. Is it Shunsuke Kobayashi's soul? \\!\nAre you tired of being in a place like this? \\!"],["\\n<経蔵>しょぼくれてんじゃねえよ。\\.\\.釈放の時間だぞ？\nとっととこの鏡に移れ。","","\\n<経蔵> Don't be shy. \\.\\. It's time to release you?\nQuickly move to this mirror."],["この本棚には伽椰子の片想い相手である\n小林という男の魂がいるらしい。","","On this bookshelf is Kayako's unrequited love partner.\nIt seems that there is a soul of a man named Kobayashi."],["\\n<経蔵>小林、伽椰子は若干だが落ち着いた。\n今ならお前があいつに血眼で追いすがられるほどでは\nないかもしれない。","","\\n<経蔵> Kobayashi and Kayako have calmed down a little.\nNow that you're being chased by him with all your might\nMaybe not."],["小林の魂が経蔵さんの鏡に回収されたようだ。","","It seems that Kobayashi's soul was recovered in Keizo's mirror."],["\\n<経蔵>……\\C[1]伽椰子を何とかしてほしい？\n\\C[0]怖くて出られない？　\\!\nったく、\\.\\.めんどくせえなあ……。","","\\n<経蔵>...\\C[1] Do you want Kayako to do something?\n\\C[0] Are you too scared to come out? \\!\n\\.\\. is so troublesome..."],["\\n<経蔵>しかし、伽椰子はこいつのどこに惚れたんだ？\\.\\.\n\\N[2]に似てインテリ系なのは確かだが。\\!\nすっかり縮みあがって、いいところがまるで見えない。","","\\n<経蔵> But what did Kayako fall in love with about this guy? \\.\\.\nIt is true that she is an intellectual like \\N[2]. \\!\nI've shrunk so much that I can't see anything good about it."],["\\n<珠緒>伽椰子にとっては恋自体が\n何かの呪いじゃないの？","","\\n<珠緒>For Kayako, love itself is\nIsn't it some kind of curse?"],["\\n<珠緒>これじゃ\\N[2]の方がましに見える。\\!\n……最悪の下の最悪とか、\\.\\.最悪。","","\\n<珠緒>This looks better than \\N[2]. \\!\n...The worst of the worst, \\.\\. the worst."],["\\n<経蔵>ふっ。\\.\\.お前はその『最悪色』の色眼鏡が呪いだな。\\!\n外せ。\\.\\.ときどきでいいから。","","\\n<経蔵> Huh. \\.\\. You're cursed by those ``worst-colored'' colored glasses. \\!\nTake it off. \\.\\. Sometimes it's fine."],["\\n<経蔵>すまないが、いまはあんたたちを\n連れ出すことはできない。","","\\n<経蔵>I'm sorry, but I'm leaving you guys alone for now.\nI can't take you out."],["\\n<経蔵>一度に連れ出すと、あんたたちを慕う\n怨霊どもが発狂しかねないからだ。","","\\n<経蔵> If you take me out all at once, I'll adore you.\nBecause the vengeful spirits might go crazy."],["\\n<経蔵>そのかわり、少し自由を得たぶん、\n善意の意地を見せて怨霊どもの気持ちを\n鎮めてやってくれよ。","","\\n<経蔵>In return, maybe I'll get a little more freedom.\nShow your good will and the feelings of vengeful spirits\nPlease calm me down."],["\\n<経蔵>怨念が落ち着いてきたぶんだけ、\n成仏の手配をしてやれると思う。","","\\n<経蔵>Maybe the grudge has calmed down,\nI think I can make arrangements for him to become a Buddha."],["ひろし","","Hiroshi"]],"context":[["Map094/events/1/name"],["Map094/events/1/pages/0/list/1/message/hasPicture/top"],["Map094/events/2/name"],["Map094/events/3/name"],["Map094/events/3/pages/2/list/4/comment","Map094/events/7/pages/5/list/127/comment"],["Map094/events/3/pages/2/list/7/message/noPicture/top"],["Map094/events/3/pages/2/list/11/message/hasPicture/top"],["Map094/events/3/pages/2/list/16/message/hasPicture/top"],["Map094/events/3/pages/2/list/20/message/hasPicture/top"],["Map094/events/3/pages/2/list/25/message/noPicture/top"],["Map094/events/3/pages/2/list/33/message/hasPicture/top"],["Map094/events/3/pages/2/list/39/comment"],["Map094/events/3/pages/2/list/44/message/noPicture/middle"],["Map094/events/3/pages/2/list/51/comment","Map094/events/3/pages/2/list/90/comment","Map094/events/3/pages/2/list/122/comment","Map094/events/3/pages/2/list/162/comment","Map094/events/3/pages/2/list/195/comment"],["Map094/events/3/pages/2/list/53/message/noPicture/middle"],["Map094/events/3/pages/2/list/57/message/noPicture/middle"],["Map094/events/3/pages/2/list/61/message/noPicture/middle"],["Map094/events/3/pages/2/list/65/message/hasPicture/top"],["Map094/events/3/pages/2/list/68/mes