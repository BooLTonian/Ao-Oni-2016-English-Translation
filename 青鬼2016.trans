"Enemies/4/name"]],"tags":[],"parameters":[],"indexIds":{"Bat":0,"Slime":1,"Orc":2,"Minotaur":3},"extension":"json","dataType":"enemies","filename":"Enemies","basename":"Enemies.json","path":"data/Enemies.json","relPath":"data/Enemies.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":0,"length":4,"percent":0},"cellInfo":[],"cacheResetOnChange":{}},"data/Items.json":{"data":[["図書室の鍵","library key"],["１階の図書室の鍵","Key to the library on the first floor"],["寝室の鍵","bedroom key"],["３階の寝室の鍵","3rd floor bedroom key"],["子供部屋の鍵","children's room key"],["２階の子供部屋の鍵","Key to the children's room on the second floor"],["＋ドライバー","+ screwdriver"],["浴室で見つけた","I found it in the bathroom"],["地下室の鍵","basement key"],["１階から地下室へと通じる扉の鍵","Key to the door leading from the first floor to the basement"],["皿の破片","fragment of plate"],["割れた皿の破片","broken plate fragments"],["ドアノブ","door knob"],["屋根裏部屋で見つけた","found in the attic"],["ライターオイル","lighter oil"],["ライターオイルの缶","can of lighter oil"],["洗剤","detergent"],["液体洗剤","liquid detergent"],["ハンカチ","handkerchief"],["たけしのものらしい","Looks like Takeshi's"],["洗剤をしみこませたもの","something soaked in detergent"],["ライター","lighter"],["オイル式のライター","oil type lighter"],["＋ドライバーの芯","+Driver core"],["－ドライバーの芯","-Driver core"],["－ドライバー","-Driver"],["地下牢の鍵","dungeon key"],["別館の鍵","annex key"],["地下から別館へ続く扉の鍵","The key to the door leading from the basement to the annex"],["屋根裏部屋の鍵","attic key"],["３階の屋根裏部屋の鍵","Key to the attic on the third floor"],["玄関の鍵","door key"],["別館地下室の鍵","Annex basement key"],["絵本","picture book"],["別館地下で見つけた","I found it in the basement of the annex."],["しおり","bookmark"],["絵本にはさまれていたしおり","A bookmark stuck in a picture book"],["酢","vinegar"],["料理用の酢","cooking vinegar"],["円盤","disk"],["金属の棒","metal rod"],["赤い鍵","red key"],["錆びて赤くなった鍵","Rusted and red key"],["格子戸の鍵","lattice door key"],["別館地下の格子戸の鍵","Key to the lattice door in the basement of the annex"],["人形","doll"],["片目の赤い人形","one-eyed red doll"],["人形の頭","doll head"],["青い石と赤い石がはめこまれている","Inlaid with blue and red stones"],["赤い石","red stone"],["青い石","blue stone"],["電球","light bulb"],["隠し扉の鍵","secret door key"],["別館地下の隠し扉の鍵","Secret door key in the basement of the annex"],["裏口の鍵","back door key"],["別館の裏口の鍵","Annex back door key"],["書斎の鍵","study key"],["２階の書斎の鍵","Key to the study on the second floor"],["棒","stick"],["長い棒。先端がカギ状にでこぼこしている。\n","long stick. The tip is uneven like a hook."],["サイコロ","dice"],["ただのサイコロ","just a dice"],["縄ばしご","rope ladder"],["青いピース１","blue piece 1"],["青いピース","blue piece"],["青いピース２","blue piece 2"],["青いピース３","blue piece 3"],["月のタリスマン","moon talisman"],["美香を化け物から守ってくれそうだ","It seems like it will protect Mika from monsters."],["星のタリスマン","star talisman"],["たけしを守ってくれそうだ","It seems like he will protect Takeshi."],["太陽のタリスマン","talisman of the sun"],["卓郎を守ってくれそうだ","It seems like he will protect Takuro."],["紙切れ","piece of paper"],["ところどころ穴のあいた紙切れ","A piece of paper with holes here and there"],["タリスマンの書","book of talismans"],["タリスマンについて書かれた書物","Books written about talismans"],["暗号メモ","crypto memo"],["日記部屋で見つけた暗号の紙\n裏に『星に願いましては～』と記されている","Code paper found in the diary room\nOn the back is written ``When you wish upon a star...''"],["謎の通路の鍵","key to the mysterious passage"],["バスタブ部屋で見つけた鍵","The key found in the bathtub room"],["緑の鍵","green key"],["タリスマンとおぼしきものに、鍵がついたもの\n緑色の光を帯びている","Something that looks like a talisman and has a key attached to it.\nhas a green light"],["座金","washer"],["タリスマンに使われている座金とよく似ている\n底に小さな字で『道具（きぼう）の器』と記されている","It is very similar to the washer used in talismans.\nOn the bottom is written in small letters the words ``tool vessel.''"],["ＩＣカード","IC card"],["写真が貼られたＩＣカード。写真にはこの館を背景にして\n２人の子供と、その両親らしき男女の姿がある","An IC card with a photo attached. The photo has this building in the background.\nThere are two children and a man and woman who appear to be their parents."],["青い手帳","blue notebook"],["端的なことが雑多に書き記されている。","The simplest things are written down miscellaneous."],["古びた金属棒","old metal rod"],["かなり年季が入っていそうな金属棒","A metal rod that seems to be quite old."],["写真","photo"],["ＩＣカードにくっついていたもの","What was attached to the IC card"],["青いノート","blue notebook"],["雑多なことが書き記されている。","Miscellaneous things are written down."],["伽椰子のノート","Kayako's notebook"],["小林という男の観察記録が主な内容。","The main content is the observation record of a man named Kobayashi."],["メモ","memo"],["何かのヒントらしい走り書きが、裏に記されている。","There is a scribble on the back that seems to be a hint of something."],["正解は\n⑤＝roop->4007\n④＝Spiral->8888\n③＝ring→Y3V4S5Q1→3451\n②＝VIRTH->15 17 4 18 5 ->15174185\n①＝1966\n\n\n\n","The correct answer is\n⑤＝roop->4007\n④＝Spiral->8888\n③＝ring→Y3V4S5Q1→3451\n②＝VIRTH->15 17 4 18 5 ->15174185\n①＝1966"],["呪いのビデオ","cursed video"],["見ると数日後に死ぬと言われている","It is said that if you look at it, you will die in a few days."],["ビデオデッキ一式","A set of video decks"],["経蔵が持ち込んだビデオデッキ。\nテスト再生用のビデオテープもセットにしたもの。","A video deck brought by Keizo.\nThis set also includes a videotape for test playback."],["サダカヤノート","Sadakaya Note"],["貞子と伽椰子、それぞれの思いが記されている。\n見た目は伽椰子のノートと似ている。","Sadako and Kayako's thoughts are recorded.\nIt looks similar to Kayako's notebook."],["謎の部屋で入手したもの。緑色の光を帯びている","Obtained in a mysterious room. has a green light"],["サダカヤ用","For Sadakaya"],[null,null,null,null,null]],"context":[["Items/1/name"],["Items/1/description"],["Items/2/name"],["Items/2/description"],["Items/3/name"],["Items/3/description"],["Items/4/name"],["Items/4/description"],["Items/5/name","Items/20/name","Items/36/name","Items/36/description"],["Items/5/description"],["Items/6/name"],["Items/6/description"],["Items/7/name"],["Items/7/description"],["Items/8/name"],["Items/8/description"],["Items/9/name"],["Items/9/description"],["Items/10/name","Items/11/name"],["Items/10/description"],["Items/11/description"],["Items/12/name"],["Items/12/description"],["Items/13/name","Items/13/description"],["Items/14/name","Items/14/description"],["Items/15/name","Items/15/description"],["Items/16/name",