derParam":["既存ページ"]}],[{"headerIndex":3,"headerParam":["",0,0,2]},{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",1,0,2]},{"headerIndex":6,"headerParam":["",1,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":22,"headerParam":["-------------------------------------"]}],[{"headerIndex":33,"headerParam":["--------------------------------"]}],null,null,null,[{"headerIndex":0,"headerParam":["画像の先読み用イベントです。"]},{"headerIndex":0,"headerParam":["画像の先読み用イベントです。"]}],[{"headerIndex":0,"headerParam":["画像の先読みもしています"]},{"headerIndex":0,"headerParam":["画像の先読みもしています"]}],null,null,[{"headerIndex":0,"headerParam":["----------------------------"]}],[{"headerIndex":0,"headerParam":["---------------------------------"]}],[{"headerIndex":23,"headerParam":["-----------------------------------------"]}],[{"headerIndex":45,"headerParam":["",1,0,0]}],[{"headerIndex":50,"headerParam":["",0,0,0]}],[{"headerIndex":53,"headerParam":["--------------------"]}],[{"headerIndex":88,"headerParam":["------------------------------------"]}],[{"headerIndex":117,"headerParam":["--------------------"]}],[{"headerIndex":151,"headerParam":["---------------------------------------"]}],[{"headerIndex":187,"headerParam":["--------------------"]}],[{"headerIndex":241,"headerParam":["",0,0,2]}],[{"headerIndex":244,"headerParam":["",1,0,2]}],[{"headerIndex":255,"headerParam":["",1,0,2]}],[{"headerIndex":265,"headerParam":["",2,0,2]}],[{"headerIndex":277,"headerParam":["",1,0,2]}],[{"headerIndex":287,"headerParam":["",2,0,2]}],[{"headerIndex":292,"headerParam":["",1,0,2]}],[{"headerIndex":296,"headerParam":["",1,0,2]}],[{"headerIndex":306,"headerParam":["",1,0,2]}],[{"headerIndex":316,"headerParam":["",1,0,2]}],[{"headerIndex":332,"headerParam":["",0,0,2]}],[{"headerIndex":340,"headerParam":["",2,0,2]}],[{"headerIndex":353,"headerParam":["",2,0,2]}],[{"headerIndex":357,"headerParam":["",1,0,2]}]],"indexIds":{"青":0,"EV002":1,"DiscardPicture kabe_chizu":2,"EV003":3,"たけしＣ":4,"----------------------------\n■キルシーンの\n　画像読込みを兼ねます":5,"\\n<\\N[2]>たけし！":6,"\\n<たけし>おいやめろ！\nオレの上にメッセージウィンドウを\n出すんじゃねえ！":7,"--------------------\n■たけし、ハゲにされ、ポイされる":8,"--------------------":9,"\n新演出。\nたけし、錯乱後にショック死\n-----------------------------------":10,"\\n<\\N[2]>何てこった！\nたけしが（ショックで）殺されちゃった！":11,"\\n<\\N[2]>うわー！":12,"ちょ、ちょっと待ってくれ":13,"\\n<\\N[2]>！":14,"\\n<たけし>僕だ\nたけしだよ":15,"\\n<\\N[2]>……たけし？":16,"\\n<たけし>この化け物、最後の一人とは\n会話をしてみたかったらしい":17,"\\n<たけし>それよりこいつから\n聞きたいことがあるそうだ":18,"\\n<\\C[5]化け物>\\C[5]キミ達は何なんだ\nなぜ現地の生物なんだ？\n誰に頼まれた？":19,"\\n<\\C[5]化け物>\\C[5]キミ達には何にも迷惑かけてなかったのに\nとうとう僕一人になってしまった……":20,"\\n<\\N[2]>…………":21,"\\n<\\C[5]化け物>\\C[5]何を言っても無視か":22,"\\n<\\C[5]化け物>\\C[5]それじゃバイバイだ":23,"---------------------\n■最後の青鬼出現":24,"階段パディング":25,"EV006":26,"EV007":27,"EV008":28,"Ｈ地図イベント":29,"\\n<\\I[\\V[86]] \\C[24]４号>地～図はどこへ消～えたっ、\\.\\.と。\nま、コミカル編には必要ないからだろうけど……":30,"---------------------------------------------\n青鬼出ないときはメッセージを下に出す":31,"\\n<\\I[\\V[86]] \\C[24]４号>やれやれ。何か調べてるときだと、\nつい「出る」ってことを忘れるねえ……":32,"２階１号イベントの先読みにも使用":33,"EV010":34,"EV011":35,"\\n<\\N[2]>開かない":36,"開かない":37,"\\n<\\I[\\V[86]] \\C[24]４号>本編のマスコットボーイ（？）\nたけし君の控え室……\\!\nもとい、控えクローゼットのある部屋だね。":38,"EV012":39,"\\n<\\N[2]>子供部屋の鍵を使った":40,"\\n<\\N[2]>鍵が掛かっている":41,"\\n<\\I[\\V[86]] \\C[24]４号>本編じゃヒロインの……\\.\\.\n美香ちゃんの部屋だったかな？":42,"EV013":43,"\\n<\\I[\\V[86]] \\C[24]４号>たしか、血（？）のついたグランドピアノが\nぽつんとある部屋。\nさすがのアタシも弾く気にはなれないわ……":44,"青鬼_c":45,"先読み用":46,"たけしＣの身体・ハゲ１号":47,"画像の先読み用ページ":48,"既存ページ":49,"\\n<\\I[\\V[83]] \\C[6]１号>４号ちゃ…………":50,"\\n<\\I[\\V[86]] \\C[24]４号>あとで牛丼おごったげるから！！":51,"ねずみ左":52,"ねずみ右":53,"青位置設定":54,"--------------------\n■デバッグモード":55,"-------------------------------------\n=110\nハッカドール隠し？イベント用\n-------------------------------------":56,"--------------------------------":57,"青ルート補正":58,"ランダム青出現設定":59,"Ｃ先読み１・Ｈ青手":60,"画像の先読み用イベントです。":61,"画像の先読みもしています":62,"Ｃ先読み２・１号髪":63,"イベント１号":64,"----------------------------\n■画像読込みを兼ねます":65,"---------------------------------\n未使用イベントにも\n画像読み込みを担当させる":66,"-----------------------------------------":67,"\\n<\\I[\\V[86]] \\C[24]４号>あ、\\.１号！　\\.\\.\\.実はさ……":68,"\\n<\\I[\\V[83]] \\C[6]１号>や、やめてくださいっ！\\.\\.\nわたしの上にメッセージウィンドウを出さないでくださいっ！！":69,"--------------------\n■１号ハゲにされる":70,"------------------------------------\n髪のまんなか、ずれた後落下":71,"--------------------\n１号、落ちた自分の髪に\nバナナの皮よろしく転ぶ":72,"---------------------------------------\n青鬼がおもむろに髪を拾っていく":73,"--------------------\n髪（チーズ？）はどこへ消えた？\nねずみが探しつつ退場":74,"\\n<\\I[\\V[83]] \\C[6]１号>びえぇ～！！　\\.\\.もうお嫁に行けないです～～！！":75,"\\n<\\I[\\V[86]] \\C[24]４号>（しまった。\\.\\.そういや青鬼の出現フラグみたいなもんだった……）":76,"\\n<\\I[\\V[86]] \\C[24]４号>まあ、\\.\\.その……。\\.\\.青鬼ちゃんさ、\nその髪食べないで、\\.\\.\\.１号に返してあげて……":77,"\\n<\\I[62] \\C[5]青鬼>\\C[5]……………………":78,"\\n<\\I[\\V[86]] \\C[24]４号>！？　\\.\\.ここに来る前に……。\\.\\.\nアタシだけは追っても襲わないように、\nプログラムしておいたはずなのに！？":79,"\\n<\\I[62] \\C[5]青鬼>\\C[5]君はなぜ、僕を髪しか食いたくなくなるような身にした？\\.\\.\nこの姿は何なんだ？　食べた覚えのないやつだ。\\.\\.\n誰に頼まれた？":80,"\\n<\\I[\\V[86]] \\C[24]４号>え？　いや〜、そろそろ肝試しの季節になるからさぁ、\nいい感じにここをお化け屋敷にしてね、\nいい感じにみんなに楽しんでもらおうと思ってさ。":81,"\\n<\\I[\\V[86]] \\C[24]４号>ほかのみんなにはナイショで、\nアタシの知ってるコワモテの人物に君を似せてみたんだけど。":82,"\\n<\\I[\\V[86]] \\C[24]４号>元データのアクション通り、\nリアルに首を飛ばされるのはちょっとね……。\nマスターたちを招きようがないし、アタシたちも修復が面倒だし。":83,"\\n<\\I[\\V[86]] \\C[24]４号>髪が飛ぶならまだシャレですむかと思ったケド……\\!\nみんなの反応を見るとアトラクションとしては、\nまだちょっと過激すぎたかな～？　\\.\\.って反省して……":84,"\\n<\\I[\\V[83]] \\C[6]１号>ゼロ姉じゃなくて、本物の青鬼！？\\!\nすべては４号ちゃんの……\\.\\.シワザだったんですかっ！？":85,"\\n<\\I[62] \\C[5]青鬼>\\C[5]あくまでこちらの都合を無視か。":86,"\\n<\\I[63] \\C[5]青鬼>\\C[5]それじゃバイバイだ。":87,"\\n<\\I[\\V[86]] \\C[24]４号>髪の色が１号たちの色に変わった！？":88},"extension":"json","dataType":"map","filename":"Map013","basename":"Map013.json","path":"data/Map013.json","relPath":"data/Map013.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":89,"length":89,"percent":100},"cellInfo":[]},"data/Map014.json":{"data":[["青","","blue"],["EV002","","EV002"],["EV003","","EV003"],["\\n<\\N[2]>別館の鍵を使った","","\\n<\\N[2]>Used the Annex Key."],["DiscardTilesets 2","","DiscardTilesets 2"],["\\n<\\N[2]>鍵が掛かっている","","\\n<\\N[2]>The door is locked."],["EV004","","EV004"],["EV005","","EV005"],["----------------------\n■落下アニメーション","","----------------------\n■Falling animation"],["----------------------","","----------------------"],["DiscardCharacter !$zou","","DiscardCharacter !$zou"],["DiscardCharacter !$zou_rakka","","DiscardCharacter !$zou_rakka"],["EV006","","EV006"],["画像の先読み用です","","This is for pre-reading images."],["EV007","","EV007"],["EV008","","EV008"],["\\n<\\N[2]>青い石を手に入れた","","\\n<\\N[2]>I found the item, \"Blue Stone\"."],["DiscardCharacter !$zou_wareta_hikaru","","DiscardCharacter !$zou_wareta_hikaru"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["ランダム青出現設定","","Random blue appearance setting"]],"context":[["Map014/events/1/name"],["Map014/events/2/name"],["Map014/events/3/name"],["Map014/events/3/pages/0/list/1/message/hasPicture/bottom"],["Map014/events/3/pages/0/list/8/Plugin Command","Map014/events/3/pages/1/list/0/Plugin Command"],["Map014/events/3/pages/0/list/13/message/hasPicture/bottom"],["Map014/events/4/name"],["Map014/events/5/name"],["Map014/events/5/pages/0/list/0/comment"],["Map014/events/5/pages/0/list/14/comment"],["Map014/events/5/pages/0/list/15/Plugin Command"],["Map014/events/5/pages/0/list/16/Plugin Command"],["Map014/events/6/name"],["Map014/events/6/pages/0/list/0/comment","Map014/events/7/pages/0/list/0/comment"],["Map014/events/7/name"],["Map014/events/8/name"],["Map014/events/8/pages/0/list/4/message/hasPicture/bottom"],["Map014/events/8/pages/0/list/7/Plugin Command"],["Map014/events/9/name"],["Map014/events/9/pages/0/list/0/comment"],["Map014/events/9/pages/0/list/7/comment"],["Map014/events/10/name"]],"tags":[null,null,null,null,["red"],null,null,null,["blue"],["blue"],["red"],["red"],null,["blue"],null,null,null,["red"],null,["blue"],["blue"]],"parameter