N[2]>鍵を開けた":3,"DiscardPicture sai_pic1":4,"DiscardPicture sai_pic2":5,"DiscardPicture sai_pic3":6,"EV004":7,"EV005":8,"青":9,"青位置設定":10,"--------------------\n■デバッグモード":11,"--------------------":12,"ランダム青出現設定":13},"extension":"json","dataType":"map","filename":"Map057","basename":"Map057.json","path":"data/Map057.json","relPath":"data/Map057.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":14,"length":14,"percent":100},"cellInfo":[]},"data/Map058.json":{"data":[["青","","blue"],["EV002","","EV002"],["DiscardPicture kamikire2","","DiscardPicture kamikire2"],["DiscardParallax saidan_puzzle","","DiscardParallax saidan_puzzle"],["DiscardCharacter !$saidan_card","","DiscardCharacter !$saidan_card"],["DiscardCharacter !$circle_s","","DiscardCharacter !$circle_s"],["EV003","","EV003"],["\\n<\\N[2]>椅子の下にボタンがある","","\\n<\\N[2]>There is a button underneath the pew."],["\\n<\\N[2]>ボタンを押す","","\\n<\\N[2]>Press the button?"],["はい","","Yes"],["いいえ","","No"],["EV004","","EV004"],["EV005","","EV005"],["EV006","","EV006"],["EV007","","EV007"],["EV008","","EV008"],["\\n<\\N[2]>棒を手に入れた","","\\n<\\N[2]>I found the item, \"Offertory Stick\"."],["DiscardCharacter !$bou","","DiscardCharacter !$bou"],["EV009","","EV009"],["EV010","","EV010"],["EV011","","EV011"],["EV012","","EV012"],["EV013","","EV013"],["EV014","","EV014"],["階段左","","Stairs left"],["\\n<美香>ねえ、階段の壁ぎわにある\n小さな穴、なんだろう？","","\\n<美香> Hey, it's next to the wall of the stairs.\nWhat is that little hole?"],["\\n<\\N[2]>ただのくぼみでは？","","\\n<\\N[2]> Is it just a hollow?"],["\\n<美香>くぼみにしては深そうだったから、\nなんとなく気になって……","","\\n<美香>It seemed deep for a hollow, so\nI'm kind of curious..."],["\\n<\\N[2]>……なるほど。\n目がいいですね、美香さん。\\!\n……しかし、何の穴でしょう？","","\\n<\\N[2]>...I see.\nYou have nice eyes, Mika-san. \\!\n...But what kind of hole is it?"],["\\n<卓郎>棒でも突っこんでみるか？","","\\n<卓郎>Would you like to try poking it with a stick?"],["\\n<たけし>出口は開いたんだろ？\\!\n気になるかもしれないけどさ、それよりも\nここからさっさと出ようぜ。\\!\nな？\\.\\.　\\N[2]。","","\\n<たけし> The exit is open, right? \\!\nIt might bother you, but more than that\nLet's get out of here quickly. \\!\nWhat? \\.\\.　\\N[2]."],["\\n<\\N[2]>………………………………。","","\\n<\\N[2]>………………………………."],["EV016","","EV016"],["祭壇と鍵穴","","altar and keyhole"],["-------------------------------------------\n美香を連れて裏口から全員生還しようと\nしたときも、別エンドに誘導可能な演出でもあり。","","-------------------------------------------\nI took Mika and tried to get everyone out alive through the back door.\nEven when it does, it is also a production that can lead you to a different ending."],["EV018","","EV018"],["EV019","","EV019"],["EV020","","EV020"],["祭壇移動後","","After moving the altar"],["\\n<\\N[2]>台に現れた円に触れても\n何も起こらないようですね……。\\!\nほかに何か必要なものがあるのでしょうか……？","","Even if you touch the circle that appeared at \\n<\\N[2]>\nIt seems like nothing is happening... \\!\nIs there anything else I need...?"],["EV022","","EV022"],["EV023","","EV023"],["EV024","","EV024"],["DiscardTilesets 4","","DiscardTilesets 4"],["青ルート補正","","blue route correction"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["ランダム青出現設定","","Random blue appearance setting"],["燭台移動前","","Before moving the candlestick"],["\\n<\\N[2]>燭台を移した","","\\n<\\N[2]> candlestick moved"],["燭台移動後","","After moving the candlestick"],["祭壇で青鬼出現","","A blue demon appears at the altar"],["\\n<卓郎>たけし、まさかお前が見張りを\n自分から買って出るとはな。\\!\nおかげで命びろいしたぜ。","","\\n<卓郎>Takeshi, I didn't expect you to be the one keeping watch.\nI can't believe I'm going to buy it myself. \\!\nThanks to you, my life was saved."],["\\n<たけし>ああ。\\.\\.妙に胸騒ぎがして……。\\!\nこの星形のお守りと、何より\n\\N[2]が落ち着かせてくれた\nおかげだと思う。","","\\n<たけし> Oh. \\.\\. I feel strangely uneasy... \\!\nThis star-shaped amulet and above all\n\\N[2] calmed me down.\nI think it's thanks to you."],["\\n<美香>三日月の形のお守りの力もあるかも。\\!\nあの化け物、私がベッドの下に隠れているあいだに\n何回か部屋に来たけど……","","\\n<美香>There may also be the power of a crescent moon-shaped amulet. \\!\nThat monster while I was hiding under the bed\nI came to your room a few times..."],["\\n<美香>あまり調べようともしないで、\n部屋から出て行ったわ。","","\\n<美香> Don't even try to find out too much.\nI left the room."],["\\n<\\N[2]>そうですか……","","\\n<\\N[2]>I see..."],["祭壇パズル解いた直後","","Immediately after solving the altar puzzle"],["\\n<\\N[2]>像の眼が青く光っている。","","\\n<\\N[2]> The eyes of the image are glowing blue."],["\\n<\\N[2]>なるほど。像の足元をよく見ると、\n細かい傷に混じって、タッチのマークがうっすらと\n彫ってあります。","","\\n<\\N[2]>I see. If you look closely at the feet of the statue,\nThere are faint touch marks mixed in with the small scratches.\nIt is carved."],["\\n<\\N[2]>青い手帳のヒントの通り、\n『家族』を神に『すがらせた』","","\\n<\\N[2]>As per the hint in the blue notebook,\nI made my “family” cling to God."],["\\n<\\N[2]>像の眼が緑に光ると、\n装飾の一部が浮いて外れた。","","\\n<\\N[2]> When the eyes of the image glow green,\nPart of the decoration came off."],["\\n<\\N[2]>これは……。\\.\\.\nタリスマンに使われている座金と構造がよく似ていますね。\\!\nいったいどういうことでしょう……？","","\\n<\\N[2]>This is... \\.\\.\nThe structure is very similar to the washer used in Talisman. \\!\nWhat on earth does that mean...?"],["\\n<\\N[2]>座金を手に入れた。","","\\n<\\N[2]> Got the washer."],["EV032","","EV032"],["前バージョンとの互換性維持のためのルーチン。\n（前バージョンでは棒は一度使うとなくなっていた）","","Routines for compatibility with previous versions.\n(In the previous version, the stick disappeared after being used once)"]],"context":[["Map058/events/1/name"],["Map058/events/2/name"],["Map058/events/2/pages/0/list/0/Plugin Command","Map058/events/24/pages/1/list/0/Plugin Command"],["Map058/events/2/pages/0/list/1/Plugin Command","Map058/events/24/pages/1/list/1/Plugin Command"],["Map058/events/2/pages/0/list/2/Plugin Command","Map058/events/24/pages/1/list/2/Plugin Command"],["Map058/events/2/pages/0/list/3/Plugin Command","Map058/events/24/pages/1/list/3/Plugin Command"],["Map058/events/3/name"],["Map058/events/3/pages/0/list/2/message/hasPicture/bottom","Map058/events/4/pages/0/list/2/message/hasPicture/bottom","Map058/