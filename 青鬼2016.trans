ame"],["Map112/events/10/pages/0/list/0/comment"],["Map112/events/11/name"],["Map112/events/12/name"],["Map112/events/13/name"],["Map112/events/14/name"],["Map112/events/14/pages/0/list/6/message/noPicture/top"],["Map112/events/14/pages/0/list/23/message/noPicture/top"],["Map112/events/14/pages/0/list/40/message/noPicture/bottom"],["Map112/events/15/name"],["Map112/events/16/name"],["Map112/events/17/name"]],"tags":[null,["red"],["red"],["red"],null,null,null,null,["red"],null,["red"],null,["red"],null,["blue"],null,null,null,null,null,null,["blue"],["blue"],["blue"],null,["blue"],null,null,null,null,null,["blue"],null,null,null,null,null,null,null,null,null,null,null,null,["blue"],["blue"],["red"],null,null,null,null,null,null,null,["blue"],null,null,null,null,null,["blue"],["red"],["red"],null,["blue"]],"parameters":[null,null,null,null,[{"headerIndex":3,"headerParam":["",0,1,0]},{"headerIndex":3,"headerParam":["",0,1,0]},{"headerIndex":5,"headerParam":["",0,1,2]},{"headerIndex":5,"headerParam":["",0,1,2]}],[{"headerIndex":8,"headerParam":["spiritualists",1,0,0]},{"headerIndex":8,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":11,"headerParam":["N2",0,0,0]},{"headerIndex":11,"headerParam":["N2",0,0,0]}],[{"headerIndex":15,"headerParam":["spiritualists",1,0,0]},{"headerIndex":15,"headerParam":["spiritualists",1,0,0]}],null,[{"headerIndex":21,"headerParam":["spiritualists",0,0,0]},{"headerIndex":21,"headerParam":["spiritualists",0,0,0]}],null,null,null,null,[{"headerIndex":0,"headerParam":["---------------------------------"]},{"headerIndex":9,"headerParam":["---------------------------------"]},{"headerIndex":19,"headerParam":["---------------------------------"]},{"headerIndex":0,"headerParam":["---------------------------------"]},{"headerIndex":9,"headerParam":["---------------------------------"]},{"headerIndex":20,"headerParam":["---------------------------------"]}],[{"headerIndex":11,"headerParam":["spiritualists",0,0,2]},{"headerIndex":11,"headerParam":["spiritualists",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}],[{"headerIndex":15,"headerParam":["--------------------------------------------"]}],null,[{"headerIndex":11,"headerParam":["------------------------------------------"]}],[{"headerIndex":13,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":17,"headerParam":["N2",0,0,2]}],[{"headerIndex":24,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":29,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":34,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":50,"headerParam":["---------------------------------------"]}],[{"headerIndex":69,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":72,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":74,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":77,"headerParam":["N2",0,0,2]}],[{"headerIndex":87,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":100,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":142,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":144,"headerParam":["N2",0,0,0]}],[{"headerIndex":146,"headerParam":["spiritualists",0,0,0]}],null,null,[{"headerIndex":12,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":15,"headerParam":["------------------------------------"]}],[{"headerIndex":26,"headerParam":["----------------------------------------"]},{"headerIndex":130,"headerParam":["----------------------------------------"]},{"headerIndex":133,"headerParam":["----------------------------------------"]}],null,[{"headerIndex":25,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":27,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":41,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":44,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":47,"headerParam":["N2",0,0,2]}],[{"headerIndex":53,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":55,"headerParam":["",0,2,0]}],[{"headerIndex":64,"headerParam":["--------------------------------------------------"]}],[{"headerIndex":70,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":72,"headerParam":["N2",0,0,2]}],[{"headerIndex":76,"headerParam":["N2",0,0,2]}],[{"headerIndex":82,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":88,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":123,"headerParam":["----------------------------------------------"]}],null,null,null,[{"headerIndex":0,"headerParam":["------------------------------------------"]}],null,null,null,null,[{"headerIndex":6,"headerParam":["",0,1,0]}],[{"headerIndex":23,"headerParam":["",0,1,0]}],[{"headerIndex":40,"headerParam":["",0,1,2]}]],"indexIds":{"和室←出口":0,"AooniKayakoHouseProcess preload":1,"AooniKayakoHouseProcess hide 6":2,"SuspendEvent 巨人鬼":3,"\n開かない。":4,"\\n<珠緒>経蔵、こっちはだめ。たぶんとなりも……。\\.\\.\n玄関と同じぐらいの力で閉じられてる。":5,"\\n<\\N[2]>\\C[1]↑の障子から\\C[0]はどうでしょう。\\!\nお二人に再会する前に確かめましたが、\n閉じられてもカギ自体がないので開けやすいかも……":6,"\\n<珠緒>先に言ってよ！！":7,"SetSelfSwitch on 2 A":8,"\\n<経蔵>３人で力を合わせれば、\n\\C[1]↑の障子なら開けられる\\C[0]かもな。試そう。":9,"ResumeEvent 巨人鬼":10,"和室→出口":11,"SetSelfSwitch on 1 A":12,"和室↑出口１":13,"---------------------------------":14,"\\n<経蔵>珠緒、\\N[2]。俺が術を戸にかけたら\n一気に開け！":15,"和室↑出口２":16,"EV005":17,"EV006":18,"青":19,"青位置設定":20,"--------------------\n■デバッグモード":21,"--------------------":22,"--------------------------------------------":23,"自動イベント・ひろし":24,"------------------------------------------\nひろしと合流":25,"\\n<経蔵>貞子たちが来なければ、伽椰子は今ごろ\n珠緒とお前を手にかけていただろうな。\\!\n目を離して悪かった。":26,"\\n<\\N[2]>すみません。\\.\\.珠緒さんを見守っていた\nはずだったのですが、一寸眠ってしまったようです。\\!\n目を開けたら、この和室にいて……":27,"\\n<珠緒>ほんっと、使えないガイド！":28,"\\n<経蔵>ははっ、俺が謝っても珠緒節は健在か。\\!\nでもあんまり朗々としてると、また……":29,"\\n<珠緒>こんどは『ナマハゲが来るぞ』とか言う？":30,"---------------------------------------\nナマハゲ風の\nサダカヤ鬼（青鬼ベースタイプ）登場":31,"\\n<経蔵>その髪……\\.\\.\nそんなに空気読みてえのかよ……。":32,"\\n<珠緒>……『鬼寄せの経蔵』って呼ぶね。\\.\\.こんどから。":33,"\\n<経蔵>お前に返す。":34,"\\n<\\N[2]>伽椰子の髪の特徴とよく似ています。\nナマハゲ風なのは確かですね。":35,"\\n<珠緒>経蔵、青鬼の眼が！！":36,"\\n<経蔵>\\N[2]、あいつの眼を見るな！！":37,"\\n<経蔵>くっ、\\.\\.直接見なくても一瞬の金縛りかよ！？":38,"\\n<\\N[2]>……？？":39,"\\n<経蔵>これは……\\.\\.貞子の能力だ。\\!\n最悪は心臓麻痺にされて殺される。\\!\nただ、まだ青鬼が使いこなせてなさそうなのが救いだ。":40,"体勢を整える（セーブ）":41,"すぐ逃げる":42,"\\n<経蔵>金縛りにされてもいいよう、\nできるだけ距離をとって逃げるぞ！！":43,"------------------------------------\n■青鬼から逃げる\n青ID->青出現->進行値":44,"----------------------------------------":45,"AooniMoveSet 3.3 0 7":46,"\\n<経蔵>またどっちも開かない……？？":47,"\\n<珠緒>……くる！！":48,"\\n<珠緒>……貞子、伽椰子、\\.\\.……青鬼の気配！！":49,"\\n<経蔵>予想し直してはいたが、\n本当に３人で合体してきたか！":50,"\\n<\\N[2]>全体的に筋肉質になっていますね。\n青鬼の影響が色濃く出たせいでしょうか。\\!\n女子レスリング軽量級の選手のようです。":51,"\\n<経蔵>ありがたくねえ美マッチョだぜ！":52,"\\^":53,"--------------------------------------------------":54,"\\n<経蔵>マジかよ……！！":55,"\\n<\\N[2]>……\\.\\.経蔵さん、\n\\C[1]大きい方の鬼が来たら、\nドアにぶつけてみませんか？\\!":56,"\\n<\\N[2]>あの質量です。\\.\\.うまくすると\nドアを壊してくれるかもしれません。":57,"\\n<経蔵>文字通りバケモンをぶつけるってか。":58,"\\n<経蔵>ふっ、\\.\\.いいな！  \\.\\.うまく誘導しようぜ！":59,"----------------------------------------------":60,"AooniMoveSet 2 8 7":61,"SetStandBy 巨人鬼 reach reach 2+":62,"青鬼邸の猫":63,"------------------------------------------\nフワッティーといっしょに出てきた猫。\n今回はマーと知り合いになった。":64,"珠緒":65,"青ＥＶ":66,"巨人鬼":67,"巨人鬼接触判定":68,"\n台所へのドアが開いた！！":69,"\n廊下へのドアが開いた！！":70,"\n↑側の出入り口が開いた！！":71,"巨人鬼初期化":72,"EV016":73,"EV017":74},"extension":"json","dataType":"map","filename":"Map112","basename":"Map112.json","path":"data/Map112.json","relPath":"data/Map112.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":75,"length":75,"percent":100},"cellInfo":[]},"data/Map113.json":{"data":[["EV001","","EV001"],["\\n<経蔵>外から見た限りだが、\n伽椰子の家の２階はそう広くない。\\!\n\\C[1]ここを調べてから１階側を調べよう。","","\\n<経蔵>As far as I can see from the outside,\nThe second floor of Kayako's house is not very spacious. \\!\n\\C[1] Let's check here and then check the first floor."],["OuterSelfSwitch on 2 A","","OuterSelfSwitch on 2 A"],["AooniKayakoHouseProcess preload","","AooniKayakoHouseProcess preload"],["OuterSelfSwitch off 2 A","","OuterSelfSwitch off 2 A"],["EV002","","EV002"],["OuterSelfSwitch on 1 A","","OuterSelfSwitch on 1 A"],["OuterSelfSwitch off 1 A","","OuterSelfSwitch off 1 A"],["パディング","","padding"],["血のり","","blood glue"],["寝室開く","","open bedroom"],["AooniKayakoHouseProcess hide 2","","AooniKayakoHouseProcess hide 2"],["AooniKayakoHouseProcess appear 3","","AooniKayakoHouseProcess appear 3"],["寝室開く２","","open bedroom 2"],["寝室閉じる１","","Close the bedroom 1"],["AooniKayakoHouseProcess appear 2","","AooniKayakoHouseProcess appear 2"],["AooniKayakoHouseProcess hide 3","","AooniKayakoHouseProcess hide 3"],["寝室閉じる２","","Close the bedroom 2"],["俊雄部屋開く","","Toshio's room opens"],["俊雄部屋閉じる","","Toshio room close"],["物置開く","","open storeroom"],["AooniKayakoHouseProcess hide 1","","AooniKayakoHouseProcess hide 1"],["---------------------------------------\n珠緒が伽椰子邸１Ｆへ","","---------------------------------------\nTamao goes to Kayako residence 1F."],["\\n<経蔵>ついさっきまで\nここに珠緒の気配があったような感じが\nしたんだが……","","\\n<経蔵>Until recently\nI feel like there's a presence of Tamao here.\nI did..."],["---------------------------------------------","","---------------------------------------------"],["AooniKayakoHouseProcess appear 1","","AooniKayakoHouseProcess appear 1"],["\\n<経蔵>あいつ、急に引き返して\nなんのつもりだ……？\\!\nまあいい、さっさとここを出よう。","","\\n<経蔵> He suddenly turned back.\nWhat do you mean...? \\!\nAlright, let's get out of here."],["ところが、玄関のドアの先に\n青鬼が待ち構えていたことがわかった。","","However, at the front door\nIt turned out that the Blue Demon was waiting for me."],["お互い話し合いのうえ、\n床に記されているらしい矢印の指示通り、\n伽椰子邸２階を調査することになった。","","After mutual discussion,\nAs instructed by the arrow that seems to be written on the floor,\nIt was decided to investigate the second floor of Kayako's residence."],["\\n<\\N[2]>青鬼は私たちをここへ誘導するのが\n目的だったのでは。\\!\nなんとなくですが、ほかに理由も……","","\\n<\\N[2]>Ao Oni is leading us here.\nMaybe that was the purpose. \\!\nFor some reason, there are other reasons too..."],["\\n<経蔵>どうだろうな？\\.\\.\nあいつの考えは読みようがない。","","What about \\n<経蔵>? \\.\\.\nI can't read his thoughts."],["\\n<経蔵>お前の言う通りだとしたら、\nここでどうして欲しいってんだろうな？\\.\\.\n……ったく。","","\\n<経蔵>If what you say is true,\nWhat do you want here? \\.\\.\n...A lot."],["物置閉じる","","Close the storeroom"],["\\n<経蔵>こっちはもう\nさすがに危険すぎるだろうな。","","\\n<経蔵> This is already\nIt would probably be too dangerous."],["天井裏へ","","to the attic"],["----------------------------------\nここから本棚をハシゴがわりにして登る","","----------------------------------\nFrom here, use the bookshelf as a ladder and climb up."],["\\n<\\N[2]>天井に穴があいていますね。\nこの本棚をハシゴがわりにして、上に行けそうですが……","","\\n<\\N[2]> There's a hole in the ceiling.\nI think I can use this bookshelf as a ladder to get to the top..."],["\\n<珠緒>この上、ここより伽椰子の気配が濃いね……。\n本人がいる感じじゃなさそうだけど。","","\\n<珠緒>Besides, there's a stronger presence of Kayako than here...\nIt doesn't seem like he's there though."],["\\n<経蔵>伽椰子の家の図面通りだと、\nこの上はちょうどあいつが殺されて投げ込まれた\n屋根裏にあたるからな。","","\\n<経蔵> According to the drawing of Kayako's house,\nThis guy was just killed and thrown in.\nBecause it's in the attic."],["\\n<珠緒>……………………。","","\\n<珠緒>……………………."],["\\n<経蔵>ここから出られない以上、\n進展がありそうなのはここだけだ。","","\\n<経蔵> Since I can't get out of here,\nThis is the only place where progress is likely to be made."],["\\n<経蔵>引き返せないなら、\n前だと思う方に進むしかない。","","\\n<経蔵>If you can't turn back,\nI have no choice but to move forward in the direction I think is ahead."],["\\n<珠緒>\\N[2]、先に行って。\nあたしはあんたが触れたところの気配を\n手がかりにして登るから。","","\\n<珠緒>\\N[2], go ahead.\nI feel the presence of where you touch\nI'll use it as a guide and climb up."],["\\n<\\N[2]>なるほど……。\nでは、上で何かお手伝いを","","\\n<\\N[2]> I see...\nSo, can you help me with something above?"],["\\n<経蔵>\\N[2]、心配はいらない。\nそこんとこ、珠緒はタフだ。","","\\n<経蔵>\\N[2], don't worry.\nTamao is tough there."],["\\n<経蔵>万一、足をすべらせたら\n俺がお姫様抱っこでフォローすればいいしな。","","\\n<経蔵>If your foot slips,\nI should just follow her while holding the princess."],["\\n<珠緒>経蔵、キモい。","","\\n<珠緒>Kyozo is disgusting."],["\\n<経蔵>\\N[2]、長居は無用だ。\n\\C[1]玄関\\C[0]から表に出て最後の仕上げをやるぞ。","","\\n<経蔵>\\N[2], there's no need to stay long.\n\\C[1] I'll go out through the entrance \\C[0] and do the final touches."],["貞子","","Sadako"],["伽椰子","","Kayako"],["珠緒","","Tamao"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["EV019","","EV019"],["EV020","","EV020"],["EV021","","EV021"],["伽椰子邸初ＥＶ","","Kayako House's first EV"],["\\n<経蔵>この気配は……。","","\\n<経蔵> This sign is..."],["\\n<\\N[2]>（以前来たときと構造が違う……！？）","","\\n<\\N[2]> (The structure is different from when I came before...!?)"],["\\n<経蔵>この間取り……！！","","\\n<経蔵>This floor plan...! !"],["\\n<経蔵>……\\N[2]、もう１度階段を降りてみるぞ。","","\\n<経蔵>...\\N[2], I'll try going down the stairs again."],["\\n<経蔵>なるほど……さっきの場所に出た。","","\\n<経蔵> I see...I came to the same place earlier."],["\\n<経蔵>どうやら階段を下りるたびに\n青鬼の屋敷の２階と伽椰子の家の１階に、\n交互に出られるみたいだな。","","\\n<経蔵> Apparently every time I go down the stairs\nOn the second floor of Ao Oni's mansion and the first floor of Kayako's house.\nLooks like they can take turns."],["\\n<\\N[2]>“伽椰子の家”というのは？","","\\n<\\N[2]> What is “Kayako House”?"],["\\n<経蔵>『入れば伽椰子に呪われて死ぬ家』だ。","","\\n<経蔵> ``A house where if you enter, you will be cursed by the Kaya palm and die''."],["\\n<経蔵>俺たちが下見に行ったときは呪われないよう、\n玄関のドアを開けて表から１階の間取りと気配を\n確かめただけにとどめたが。","","\\n<経蔵>When we go for a preliminary inspection, so that we don't get cursed,\nOpen the front door and see the floor plan and atmosphere of the first floor from the front.\nI just wanted to confirm."],["\\n<経蔵>伽椰子のやつ、ここに移り住んだだけでなく、\n元いた家の間取りまで、この屋敷の素材を使って\n再現しているようだ。","","\\n<経蔵>The guy from Kayako not only moved here,\nEven the floor plan of the original house was created using materials from this mansion.\nIt seems to be reproducing."],["\\n<\\N[2]>よほど元の家に未練があったのでしょうか……。","","\\n<\\N[2]> Did he have any regrets about his former home?"],["\\n<経蔵>まずはこの上、\n\\C[1]伽椰子の家の２階から探すぞ。","","\\n<経蔵>First of all, above this,\n\\C[1] Let's search from the second floor of Kayako's house."],["--------------------------------------\n終盤になったら階段先を青鬼邸にする","","--------------------------------------\nAt the end of the game, turn the stairs into Ao Oni's mansion."],["青ルート補正","","blue route correction"],["俊雄の趣味？","","Toshio's hobby?"],["----------------------------------------------","","----------------------------------------------"],["引き出しの中に\n青鬼と似た色の携帯型ゲーム機が入っている。\n\n","","in the drawer\nIt contains a portable game console with a similar color to Ao Oni."],["ゲーム機には『ＲＰＧツクールフェス』という\nカートリッジが差してある。","","The game console is called ``RPG Maker Fes''.\nA cartridge is inserted."],["\\n<経蔵>この気配は……\\.\\.俊雄のものが２種類。\\!\nいつものやつと、\n普通の子供の霊のような感じのものがあるな。","","\\n<経蔵>There are two types of these signs...\\.\\.Toshio's. \\!\nWith the usual one,\nIt looks like the spirit of a normal child."],["------------------------------------------\nここに来るのは\n経蔵＋ひろし、経蔵＋珠緒、全員の３パターン","","------------------------------------------\ncome here\nKeizo + Hiroshi, Keizo + Tamao, 3 patterns for everyone"],["\\n<\\N[2]>このソフトで制作したゲームは\n配信できるそうです。","","\\n<\\N[2]>Games created with this software\nApparently it can be distributed."],["\\n<珠緒>ゲームの配信……\\.\\.新しい呪い方だね。","","\\n<珠緒>Game distribution...\\.\\.It's a new way to curse."],["\\n<\\N[2]>そこまで言わなくても……。\\.\\.\n単純にゲームを制作してみたいだけでは？","","\\n<\\N[2]> You don't have to say that much... \\.\\.\nDon't you just want to create a game?"],["\\n<経蔵>ふっ。\\.\\.知らない、てのは優しいな。\\!\nそろそろ俺らも発想の清めどき、\\.\\.かもな？","","\\n<経蔵> Huh. \\.\\. I don't know, you're so kind. \\!\nMaybe it's time for us to purify our ideas, \\.\\.?"],["\\n<珠緒>ガラじゃないクセに……。","","\\n<珠緒> I have a habit of not being a gala..."],["\\n<珠緒>ゲーム機をよく使ってるのは、\n化け物じゃない方の俊雄みたいだね。","","\\n<珠緒>I often use game consoles.\nIt's like Toshio who isn't a monster."],["\\n<珠緒>……化け物の方も、となりで興味深そうに\nのぞき込んでる様子が見えてくる……","","\\n<珠緒>...The monster next door also looks interesting.\nI can see you looking into it..."],["\\n<経蔵>ガラじゃなさそうに見えたが、\n普通にゲームするんだな。","","\\n<経蔵>It didn't look like it was a gala, but\nI'll just play the game normally."],["\\n<\\N[2]>このソフトを使っている友人がいますので……。","","\\n<\\N[2]>I have a friend who uses this software..."],["表俊雄","","Toshio Omote"],["EV026","","EV026"],["引き出しの中にノートが入っている。\\!\nゲームのアイデアをまとめているもののようだ。","","There's a notebook in the drawer. \\!\nIt seems to be a compilation of game ideas."],["\\n<経蔵>この気配は……\\.\\.俊雄のノートか。\nだけど、普通の子供の霊のような感じだな。","","\\n<経蔵>Is this presence...\\.\\. Toshio's notebook?\nBut it feels like a normal child's spirit."],["\\n<経蔵>俊雄お前も、\n普通にゲーム楽しむんだな……。\\!\nそれも作る方かよ。","","\\n<経蔵> Toshio, you too.\nJust enjoy the game... \\!\nAre you the one who makes that too?"],["\\n<珠緒>ノートの内容はわからないけど、\nノートの気配はざっと９：１ぐらいで\n普通の俊雄、化け物の俊雄だね。","","\\n<珠緒> I don't know the contents of the note, but\nThe note sign is roughly 9:1.\nOrdinary Toshio, monster Toshio."],["\\n<珠緒>ノートの中身がそのまま実現すると、\nその１割ぶん、何かの呪いにかかるかもね？","","If the contents of the \\n<珠緒> note are realized as they are,\nMaybe 10% of that will be affected by some kind of curse?"],["俊雄","","Toshio"],["EV028","","EV028"],["本棚にスケッチブックがある。\\!\n絵の半分ぐらいは黒い猫をモチーフにしたものだ。","","There is a sketchbook on the bookshelf. \\!\nAbout half of the paintings feature black cats as a motif."],["\\n<経蔵>絵の気配は……\\.\\.俊雄のものだな。\\!\nいつものやつと、\n普通の子供の霊のような感じのものと、２種類。","","\\n<経蔵>The picture looks like...\\.\\. Toshio's. \\!\nWith the usual one,\nThere are two types: one that looks like a normal child's spirit, and the other."],["\\n<\\N[2]>絵柄が２系統ありますね。\\!\n片方は普通の子供の絵ですが、もう片方は……\\!\n何か鬼気迫る雰囲気を感じます。","","There are two types of \\n<\\N[2]> patterns. \\!\nOne is a normal child's drawing, but the other...\\!\nI feel like there's something creepy about it."],["\\n<珠緒>絵は直接見えないけど、化け物の方の絵から……\n俊雄を先頭にして、たくさんの子供の無念が\nにじみ出てくる。\\!なんでだろう？","","\\n<珠緒> I can't see the picture directly, but from the monster's picture...\nWith Toshio in the lead, many children's regrets\nIt oozes out. \\! I wonder why?"],["\\n<経蔵>俊雄に黒幕でもいるのかよ……？","","\\n<経蔵> Is there a mastermind behind Toshio...?"]],"context":[["Map113/events/1/name"],["Map113/events/1/pages/0/list/1/message/hasPicture/top","Map113/events/2/pages/0/list/1/message/hasPicture/top"],["Map113/events/1/pages/0/list/12/Plugin Command","Map113/events/22/pages/2/list/3/Plugin Command"],["Map113/events/1/pages/0/list/13/Plugin Command","Map113/events/2/pages/0/list/13/Plugin Command"],["Map113/events/1/pages/1/list/4/Plugin Command"],["Map113/events/2/name"],["Map113/events/2/pages/0/list/12/Plugin Command","Map113/events/22/pages/2/list/2/Plugin Command"],["Map113/events/2/pages/1/list/4/Plugin Command"],["Map113/events/3/name"],["Map113/events/4/name"],["Map113/events/5/name"],["Map113/events/5/pages/0/list/1/Plugin Command","Map113/events/6/pages/0/list/1/Plugin Command","Map113/events/11/pages/0/list/36/Plugin Command","Map113/events/12/pages/0/list/2/Plugin Command"],["Map113/events/5/pages/0/list/2/Plugin Command","Map113/events/6/pages/0/list/2/Plugin Command","Map113/events/10/pages/0/list/1/Plugin Command"],["Map113/events/6/name"],["Map113/events/7/name"],["Map113/events/7/pages/0/list/1/Plugin Command","Map113/events/8/pages/0/list/1/Plugin Command","Map113/events/11/pages/0/list/2/Plugin Command","Map113/events/11/pages/0/list/71/Plugin Command"],["Map113/events/7/pages/0/list/2/Plugin Command","Map113/events/8/pages/0/list/2/Plugin Command","Map113/events/9/pages/0/list/1/Plugin Command","Map113/events/11/pages/0/list/35/Plugin Command"],["Map113/events/8/name"],["Map113/events/9/name"],["Map113/events/10/name"],["Map113/events/11/name"],["Map113/events/11/pages/0/list/1/Plugin Command"],["Map113/events/11/pages/0/list/5/comment"],["Map113/events/11/pages/0/list/23/message/hasPicture/top"],["Map113/events/11/pages/0/list/29/comment"],["Map113/events/11/pages/0/list/37/Plugin Command","Map113/events/12/pages/0/list/1/Plugin Command"],["Map113/events/11/pages/0/list/66/message/hasPicture/top"],["Map113/events/11/pages/0/list/72/message/hasPicture/middle"],["Map113/events/11/pages/0/list/75/message/hasPicture/middle"],["Map113/events/11/pages/0/list/81/message/hasPicture/top"],["Map113/ev