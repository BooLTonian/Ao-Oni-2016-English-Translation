0,"headerParam":["------------------------------"]}],[{"headerIndex":7,"headerParam":["spiritualists",0,0,2]}],null,null,null,null,null,[{"headerIndex":6,"headerParam":["",0,1,0]},{"headerIndex":6,"headerParam":["",0,1,0]}],[{"headerIndex":11,"headerParam":["spiritualists",0,0,0]},{"headerIndex":11,"headerParam":["spiritualists",0,0,0]}],null,null,null,null,null,[{"headerIndex":2,"headerParam":["N2",0,0,2]}],[{"headerIndex":43,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":49,"headerParam":["--------------------------------"]}],[{"headerIndex":108,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":129,"headerParam":["N2",0,1,2]}],[{"headerIndex":136,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":141,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":144,"headerParam":["N2",0,0,2]}],[{"headerIndex":148,"headerParam":["spiritualists",0,0,2]}],null,null,[{"headerIndex":21,"headerParam":["----------------------------------"]}],[{"headerIndex":28,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":33,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":59,"headerParam":["spiritualists",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["---------------------------------------------"]}]],"indexIds":{"EV001":0,"納戸のドア":1,"EV003":2,"-------------------------------------------":3,"InputConfuse def":4,"\n開かない。":5,"---------------------------------":6,"リビングのドア":7,"EV005":8,"EV006":9,"-----------------------------------------":10,"EV007":11,"EV008":12,"\\n<経蔵>……もう少し、ここを調べるか。":13,"-------------------------------------":14,"InputConfuse def ":15,"AooniKayakoHouseProcess preload":16,"DiscardTilesets 6":17,"EV009":18,"１Ｆ自動ＥＶ":19,"\\n<珠緒>経蔵、\\N[2]の気配がする！":20,"\\n<経蔵>あれは……\\.\\.\\C[1]和室の方\\C[0]だな。よし！":21,"\\n<珠緒>あと……かすかだけど、伽椰子の気配がする。\\!\nいつもより殺気がないような……。":22,"\\n<経蔵>青鬼や貞子と戦ってスキでもできたか。\\!\nなら、\\N[2]を連れ出しやすい。\\.\\.今のうちだな。":23,"\\n<経蔵>（あるいは……）":24,"物置カバー開く":25,"AooniKayakoHouseProcess hide 7":26,"物置カバー閉じる":27,"AooniKayakoHouseProcess appear 7":28,"リビングカバー開く":29,"AooniKayakoHouseProcess hide 5":30,"\\n<経蔵>俊雄の友達か！！":31,"\\n<経蔵>……とりあえず、向こうから襲ってくる\n様子はなさそうだな。":32,"リビングカバー閉じる":33,"AooniKayakoHouseProcess appear 5":34,"ダイニングカバー開く":35,"AooniKayakoHouseProcess hide 6":36,"ダイニングカバー閉じる":37,"---------------------------------\n部屋から出ると伽椰子がついてくる":38,"AooniKayakoHouseProcess appear 6":39,"浴室カバー開く・伽椰子":40,"AooniKayakoHouseProcess hide 8":41,"AooniKayakoHouseProcess appear 9":42,"\\n<経蔵>伽椰子か。\\!\nこうして対面するのは初めてだな。":43,"\\n<経蔵>……珠緒はどこだ。\\!\n俊雄が連れ去ったんだから、\n親のお前なら知っているはずだ。":44,"\\n<経蔵>伽椰子か。\\!\nこうして対面するのは初めてだな。\\!\n……たったいまの思いつきだが、取引がある。":45,"\\n<経蔵>珠緒がまだ生きているなら、返してくれ。\\!\n無事に返してくれたら、俺の法術でお前らの身体のケガを\n治してやる。":46,"\\n<経蔵>正確には、霊的な手術で\n『まだケガをしているという思い込み』を除去する、\nといったところだ。":47,"\\n<経蔵>もう生身の身体のケガじゃねえから、\nケガをしたときの思い出の生々しさを取り除けば、\n少しは楽に過ごせるはずだ。":48,"\\n<経蔵>そうそう、レンジでやられたときのそいつのケガを\n手始めに治しておいた。":49,"\\n<経蔵>（ケガの苦しみがなくなれば、呪う気も少しは失せて、\nやりやすくなるかもしれない）":50,"\\n<経蔵>（間に合っていれば珠緒も助かるかも……）":51,"\\n<経蔵>こっちもさんざんお前らを敵視しておいて何だが、\n悪い話じゃねえはずだ。\\!\nどうだ、\\.\\.乗ってみる気は……":52,"-----------------------------------\n洗濯機開いていないとき、\n伽椰子が開ける":53,"AooniKayakoHouseProcess appear 8":54,"---------------------------------------------":55,"\\n<\\N[2]>珠緒さんの行方についてですが……。\\!\n勘でしかありませんが、\nいまの彼女の行動から考えて、もしかすると……":56,"\\n<経蔵>なるほど。脱出経験者のカンは違うな。":57,"\\n<経蔵>さっそく、\\C[1]青鬼の屋敷の方に戻って\\C[0]探してみるか。":58,"浴室カバー閉じる":59,"AooniKayakoHouseProcess hide 9":60,"脱衣場カバー開く":61,"---------------------------------\nお化けをここで追い払う":62,"\\n<\\N[2]>ふり向くと、いなくなる。\\!\n化け物たちは子供の遊びが趣味なのでしょうか。\nええと……":63,"\\n<\\N[2]>『だるまさんがころんだ』":64,"\\n<経蔵>ふっ。真顔で言うか。\\!\n……バケモン屋敷でお前が生き延びた理由が分かったぜ。":65,"\\n<\\N[2]>…………？":66,"脱衣場カバー閉じる":67,"---------------------------------\n貞子がついてくる処理":68,"OuterSelfSwitch on 52 B":69,"OuterSelfSwitch off 52 B":70,"トイレカバー開く":71,"AooniKayakoHouseProcess hide 10 1":72,"AooniKayakoHouseProcess appear 11":73,"トイレカバー閉じる":74,"AooniKayakoHouseProcess appear 10":75,"AooniKayakoHouseProcess hide 11":76,"洗面室カバー開く・ほか":77,"--------------------------------------------\n俊雄に続き、伽椰子を治療する":78,"\\n<経蔵>お色直しか。\\!もっと“治して”やるぜ？":79,"\\n<経蔵>術が効いていれば、見た目のケガはもう、\n単なる特殊メイクになっているはずだ。\\!\nいつでも落とせばいい。\\.\\.自分の意志でな。":80,"\\n<経蔵>成仏に応じるなら早めにしてくれ。\\!\n……でないと、ほかのバケモンどもごと、お前らを\nある方法で封印しないといけなくなる。":81,"\\n<経蔵>なんだ俊雄。さっき治してやった傷口が\n開きかけてるじゃねえか。":82,"\\n<珠緒>……俊雄を傷つけたのは、貞子でも青鬼でもないね。\\!\nあんたたちの内側からくる『何か』……。\\!\nあんたたち自身が別の呪いに侵されているみたいな……。":83,"\\n<経蔵>お前らが誰かを呪うように、\nお前らも『何か』に呪われてるのかもな。":84,"\\n<経蔵>自分をえぐろうとする感覚に襲われたら、\n全力で「はねつけろ」　\\!……いいな？":85,"\\n<珠緒>……いつもの気配の伽椰子と俊雄じゃなかった。":86,"\\n<経蔵>このまま“癒やすが勝ち”で\n押し切れるといいけどな……。\\!\nまとめて成仏に応じてくれれば御の字なんだが。":87,"\\n<珠緒>たくさんの人を呪い殺しておきながら\n成仏だなんて……":88,"\\n<経蔵>まあな。\\.\\.凶悪犯でもケガをしていたら、\n逮捕の前後にさしずめ治療ぐらいは施すようなものだ。":89,"\\n<経蔵>３大バケモンの１人をなんとかできるなら、\nそれだけでめっけもんだ。":90,"\\n<経蔵>成仏させたあとは俺たちが力を借りている\n仏さんたちに沙汰を任せよう。":91,"----------------------------------------":92,"洗面室カバー閉じる":93,"貞子":94,"伽椰子":95,"俊雄":96,"イベント珠緒":97,"青":98,"青位置設定":99,"--------------------\n■デバッグモード":100,"--------------------":101,"洗濯機仕掛け":102,"------------------------------\nフタ開閉":103,"\\n<経蔵>……貞子の気配が残ってるな。\\!\nこんなところで何をしていた……？":104,"EV040":105,"EV041":106,"EV042":107,"フワッティー（ドア）":108,"伽椰子邸１Ｆ出口左":109,"\n出入り口は固く閉ざされている。":110,"\\n<経蔵>……この先の気配は不安定だな。\n開けない方がいいだろう。":111,"伽椰子邸１Ｆ出口右":112,"フワッティー":113,"俊雄（かけっこ）":114,"俊雄走るイベント":115,"美香鬼":116,"\\n<\\N[2]>美香さ……":117,"\\n<経蔵>\\N[2]、黙って見てろ……。":118,"--------------------------------\n美香鬼がドアを叩く":119,"\\n<経蔵>よし、気配が消えた。もういいだろう。":120,"ドアの裏側には、およそ人の手の大きさではない\n手の跡が残されていた。":121,"\\n<経蔵>姿隠して気配隠さずで俺を\nごまかせると思うなよ？\\.\\.　青鬼……。":122,"\\n<経蔵>ま、本気で襲う気がなかったらしいのが\n救いだったけどな。":123,"\\n<\\N[2]>……………………。":124,"\\n<経蔵>ま、本気で襲う気がなくて助かったぜ。":125,"マー":126,"マーのイベント":127,"----------------------------------":128,"\\n<経蔵>マーか。\\!\n思えば、お前もとんだとばっちりを受けたな、生前。\\!\n生きながらレンジでチン、の刑とか……。":129,"\\n<経蔵>そうだ。死ぬ間際の苦しい思い出を\n法術で取って楽にしてやることができる。\\!\nよしよし、\\.\\.じっとしてろよ……？":130,"\\n<経蔵>俊雄によろしくな。":131,"洗濯機グラ":132,"伽椰子（お色直し）":133,"鬼移動先":134,"---------------------------------------------\n動きが一寸止まらないようにこの記述にしてある":135,"EV055":136,"<high>":137,"EV056":138,"EV057":139,"EV058":140,"EV059":141,"EV060":142,"EV061":143,"EV062":144,"EV063":145,"EV064":146},"extension":"json","dataType":"map","filename":"Map111","basename":"Map111.json","path":"data/Map111.json","relPath":"data/Map111.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":147,"length":147,"percent":100},"cellInfo":[]},"data/Map112.json":{"data":[["和室←出口","","Japanese-style room←Exit"],["AooniKayakoHouseProcess preload","","AooniKayakoHouseProcess preload"],["AooniKayakoHouseProcess hide 6","","AooniKayakoHouseProcess hide 6"],["SuspendEvent 巨人鬼","","SuspendEvent Giant Oni"],["\n開かない。","","\nIt won't open."],["\\n<珠緒>経蔵、こっちはだめ。たぶんとなりも……。\\.\\.\n玄関と同じぐらいの力で閉じられてる。","","\\n<珠緒>Kyozo, this is no good. Maybe next door too... \\.\\.\nIt was closed with the same force as the front door."],["\\n<\\N[2]>\\C[1]↑の障子から\\C[0]はどうでしょう。\\!\nお二人に再会する前に確かめましたが、\n閉じられてもカギ自体がないので開けやすいかも……","","How about \\C[0] from the shoji screen of \\n<\\N[2]>\\C[1]↑? \\!\nI checked before I met you two again,\nEven if it is closed, it may be easier to open it because there is no key itself..."],["\\n<珠緒>先に言ってよ！！","","\\n<珠緒> Tell me first! !"],["SetSelfSwitch on 2 A","","SetSelfSwitch on 2 A"],["\\n<経蔵>３人で力を合わせれば、\n\\C[1]↑の障子なら開けられる\\C[0]かもな。試そう。","","\\n<経蔵>If the three of us join forces,\n\\C[0] might be able to open the shoji with \\C[1]↑. Let's try it."],["ResumeEvent 巨人鬼","","ResumeEvent Giant Oni"],["和室→出口","","Japanese-style room → exit"],["SetSelfSwitch on 1 A","","SetSelfSwitch on 1 A"],["和室↑出口１","","Japanese-style room↑Exit 1"],["---------------------------------","","---------------------------------"],["\\n<経蔵>珠緒、\\N[2]。俺が術を戸にかけたら\n一気に開け！","","\\n<経蔵> Tamao, \\N[2]. If I put the technique on the door\nOpen all at once!"],["和室↑出口２","","Japanese-style room↑Exit 2"],["EV005","","EV005"],["EV006","","EV006"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["--------------------------------------------","","--------------------------------------------"],["自動イベント・ひろし","","Automatic event Hiroshi"],["------------------------------------------\nひろしと合流","","------------------------------------------\nMeet up with Hiroshi"],["\\n<経蔵>貞子たちが来なければ、伽椰子は今ごろ\n珠緒とお前を手にかけていただろうな。\\!\n目を離して悪かった。","","\\n<経蔵>If Sadako and the others don't come, Kayako will be here by now.\nHe would have taken care of Tamao and you. \\!\nI felt bad for taking my eyes off him."],["\\n<\\N[2]>すみません。\\.\\.珠緒さんを見守っていた\nはずだったのですが、一寸眠ってしまったようです。\\!\n目を開けたら、この和室にいて……","","\\n<\\N[2]>I'm sorry. \\.\\.I was watching over Tamao-san.\nI was supposed to, but I think I fell asleep for a moment. \\!\nWhen I opened my eyes, I was in this Japanese-style room..."],["\\n<珠緒>ほんっと、使えないガイド！","","\\n<珠緒>Really, an unusable guide!"],["\\n<経蔵>ははっ、俺が謝っても珠緒節は健在か。\\!\nでもあんまり朗々としてると、また……","","\\n<経蔵> Ha, even if I apologize, Tamaobushi will still be alive. \\!\nBut if you're too cheerful..."],["\\n<珠緒>こんどは『ナマハゲが来るぞ』とか言う？","","\\n<珠緒> Will you say something like ``Namahage is coming''?"],["---------------------------------------\nナマハゲ風の\nサダカヤ鬼（青鬼ベースタイプ）登場","","---------------------------------------\nNamahage style\nSadakaya Oni (Ao Oni base type) appears"],["\\n<経蔵>その髪……\\.\\.\nそんなに空気読みてえのかよ……。","","\\n<経蔵> That hair...\\.\\.\nI wonder if you can read the atmosphere that much..."],["\\n<珠緒>……『鬼寄せの経蔵』って呼ぶね。\\.\\.こんどから。","","\\n<珠緒>...It's called the \"Oniyose no Kyozo\". \\.\\. From now on."],["\\n<経蔵>お前に返す。","","\\n<経蔵>I'll give it back to you."],["\\n<\\N[2]>伽椰子の髪の特徴とよく似ています。\nナマハゲ風なのは確かですね。","","\\n<\\N[2]> It is very similar to Kayako's hair characteristics.\nIt's definitely Namahage style."],["\\n<珠緒>経蔵、青鬼の眼が！！","","\\n<珠緒>Kyozo, blue demon eyes! !"],["\\n<経蔵>\\N[2]、あいつの眼を見るな！！","","\\n<経蔵>\\N[2], don't look into his eyes! !"],["\\n<経蔵>くっ、\\.\\.直接見なくても一瞬の金縛りかよ！？","","\\n<経蔵> Damn, even if you don't see \\.\\. directly, it's a momentary arrest! ?"],["\\n<\\N[2]>……？？","","\\n<\\N[2]>...? ?"],["\\n<経蔵>これは……\\.\\.貞子の能力だ。\\!\n最悪は心臓麻痺にされて殺される。\\!\nただ、まだ青鬼が使いこなせてなさそうなのが救いだ。","","\\n<経蔵>This is...\\.\\. Sadako's ability. \\!\nIn the worst case scenario, he suffers a heart attack and is killed. \\!\nHowever, it's a relief that Ao Oni doesn't seem to be able to master it yet."],["体勢を整える（セーブ）","","Adjust your posture (save)"],["すぐ逃げる","","run away immediately"],["\\n<経蔵>金縛りにされてもいいよう、\nできるだけ距離をとって逃げるぞ！！","","\\n<経蔵>I don't mind being tied down,\nRun as far away as possible! !"],["------------------------------------\n■青鬼から逃げる\n青ID->青出現->進行値","","------------------------------------\n■Escape from the blue demon\nBlue ID->Blue appearance->Progress value"],["----------------------------------------","","----------------------------------------"],["AooniMoveSet 3.3 0 7","","AooniMoveSet 3.3 0 7"],["\\n<経蔵>またどっちも開かない……？？","","\\n<経蔵> Neither opens again...? ?"],["\\n<珠緒>……くる！！","","\\n<珠緒>...It's coming! !"],["\\n<珠緒>……貞子、伽椰子、\\.\\.……青鬼の気配！！","","\\n<珠緒>...Sadako, Kayako, \\.\\....Sign of the blue demon! !"],["\\n<経蔵>予想し直してはいたが、\n本当に３人で合体してきたか！","","\\n<経蔵> I had re-estimated my prediction, but\nDid the three of them really come together?"],["\\n<\\N[2]>全体的に筋肉質になっていますね。\n青鬼の影響が色濃く出たせいでしょうか。\\!\n女子レスリング軽量級の選手のようです。","","\\n<\\N[2]>He's more muscular overall.\nMaybe it's because of the strong influence of Ao Oni. \\!\nShe looks like a lightweight women's wrestler."],["\\n<経蔵>ありがたくねえ美マッチョだぜ！","","\\n<経蔵> Thank you, beautiful macho!"],["\\^","","\\^"],["--------------------------------------------------","","--------------------------------------------------"],["\\n<経蔵>マジかよ……！！","","\\n<経蔵> Seriously...! !"],["\\n<\\N[2]>……\\.\\.経蔵さん、\n\\C[1]大きい方の鬼が来たら、\nドアにぶつけてみませんか？\\!","","\\n<\\N[2]>……\\.\\. Mr. Keizo,\n\\C[1]When the larger demon comes,\nWhy not hit it against the door? \\!"],["\\n<\\N[2]>あの質量です。\\.\\.うまくすると\nドアを壊してくれるかもしれません。","","\\n<\\N[2]> That mass. \\.\\. If it works\nThey might break down the door for you."],["\\n<経蔵>文字通りバケモンをぶつけるってか。","","\\n<経蔵> Literally hitting monsters."],["\\n<経蔵>ふっ、\\.\\.いいな！  \\.\\.うまく誘導しようぜ！","","\\n<経蔵>Huh, \\.\\. Good!  \\.\\.Let's guide them well!"],["----------------------------------------------","","----------------------------------------------"],["AooniMoveSet 2 8 7","","AooniMoveSet 2 8 7"],["SetStandBy 巨人鬼 reach reach 2+","","SetStandBy giant demon reach reach 2+"],["青鬼邸の猫","","Aooni House Cat"],["------------------------------------------\nフワッティーといっしょに出てきた猫。\n今回はマーと知り合いになった。","","------------------------------------------\nThe cat that came out with Fluffy.\nThis time I got to know Ma."],["珠緒","","Tamao"],["青ＥＶ","","Blue EV"],["巨人鬼","","giant demon"],["巨人鬼接触判定","","Giant demon contact detection"],["\n台所へのドアが開いた！！","","\nThe door to the kitchen is open! !"],["\n廊下へのドアが開いた！！","","\nThe door to the hallway is open! !"],["\n↑側の出入り口が開いた！！","","\nThe doorway on the ↑ side has opened! !"],["巨人鬼初期化","","Giant demon initialization"],["EV016","","EV016"],["EV017","","EV017"]],"context":[["Map112/events/1/name"],["Map112/events/1/pages/0/list/3/Plugin Command","Map112/events/2/pages/0/list/3/Plugin Command","Map112/events/3/pages/0/list/3/Plugin Command","Map112/events/3/pages/1/list/22/Plugin Command","Map112/events/4/pages/0/list/3/Plugin Command","Map112/events/4/pages/1/list/23/Plugin Command"],["Map112/events/1/pages/0/list/6/Plugin Command"],["Map112/events/1/pages/1/list/0/Plugin Command","Map112/events/2/pages/1/list/0/Plugin Command","Map112/events/3/pages/1/list/0/Plugin Command","Map112/events/4/pages/1/list/0/Plugin Command","Map112/events/14/pages/0/list/5/Plugin Command","Map112/events/14/pages/0/list/22/Plugin Command","Map112/events/14/pages/0/list/39/Plugin Command"],["Map112/events/1/pages/1/list/3/message/noPicture/top","Map112/events/2/pages/1/list/3/message/noPicture/top","Map112/events/3/pages/1/list/5/message/noPicture/bottom","Map112/events/4/pages/1/list/5/message/noPicture/bottom"],["Map112/events/1/pages/1/list/8/message/hasPicture/top","Map112/events