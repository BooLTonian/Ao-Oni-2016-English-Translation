aderIndex":54,"headerParam":["N2",0,0,0]}],[{"headerIndex":61,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":68,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":77,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":85,"headerParam":["spiritualists",0,0,0]}],null,null,null,[{"headerIndex":2,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":6,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":9,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":12,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":17,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":22,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":25,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":28,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":38,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":41,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":44,"headerParam":["N2",0,0,0]}],[{"headerIndex":48,"headerParam":["spiritualists",0,0,0]}],null,[{"headerIndex":3,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":7,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":13,"headerParam":["N2",0,1,0]}],[{"headerIndex":19,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":25,"headerParam":["N2",0,1,0]}],[{"headerIndex":34,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":39,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":43,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":46,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":49,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":62,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":65,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":68,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":72,"headerParam":["spiritualists",0,0,0]}]],"indexIds":{"EV001":0,"\\n<経蔵>バケモンが近くに来るまではここにいてくれよ？":1,"青":2,"EV003":3,"----------------------------------------":4,"扉はかたく閉ざされている。\\!かわりに先ほどはなかった、\nタッチディスプレイのついた電子ロックが\n新たに取り付けられている。":5,"\\n<経蔵>なんだこりゃあ……？？\\!\nそれも貞子の気配が２つ……。\n片方は人間らしい感じがするな。":6,"\\n<経蔵>さっき屋敷の２階で話したやつと同じ気配だな……。":7,"\\n<経蔵>バケモンの方のも妙にしおらしい気配がするが……。":8,"タッチディスプレイのついた電子ロックが\n扉に取り付けられている。":9,"\\n<経蔵>……\\C[1]\\N[2]がいるときに\\C[0]するか。\\!\nあいつはこういうの得意そうだからな。":10,"---------------------------------------------\nひろしがいるときは続行":11,"\\n<ディスプレイ>\n⑤：roop→????":12,"--------------------------------":13,"\\n<ディスプレイ>慈悲はすぐに消える。\n優しさはいつも蜃気楼。\nアテにならない。家族のものでさえ……。":14,"\\n<ディスプレイ>信じられるのは憎しみだけ。\\!\nひとたび憎しみを抱いた人間が明日に慈悲を取り戻した、\nなどという話を聞いたことがない。":15,"\\n<ディスプレイ>私の“良識”は、この新たな力で憎しみを\nこんな形にすることを勧めてきたが、\\!\n何になるというのだろう……。":16,"\\n<珠緒>青鬼には呪いだけじゃない\n不思議な力があるみたいだね。":17,"\\n<経蔵>『言うに言えない悩みを何かの仕掛けにして具現化する』\\.\\.\nだったりしてな。":18,"VerticalNumberInput on":19,"\\n<ディスプレイ>\n④：spiral→????":20,"VerticalNumberInput off":21,"\\n<ディスプレイ>両親を誹謗した人々は、誹謗の対象が死してなお、\n矛をおさめることがなかった。":22,"\\n<ディスプレイ>矛を向けたまま、あるいは刺し貫いたまま、\n何事もなかったようにどこかへ去ってしまった。":23,"\\n<ディスプレイ>人は結局、悪気（わるぎ）しか信じない。\\!\n私も、悪気しか信じられなくなってしまった。":24,"\\n<経蔵>貞子、伽椰子よりめんどくさそうだな……。\\!\n直接の敵が亭主のような個人でなく、\n一般大衆といった“世間”だからな……。":25,"\\n<ディスプレイ>\n③：ring→Y?V?S?Q?→????":26,"\\n<ディスプレイ>死んだことにしてまで、\nなぜ母は弟と消えてしまったのだろうか。\\!\n\\C[7]いったい何を考えているんだ。":27,"\\n<ディスプレイ>母も弟も素直に愛することのできたあの頃に……\\!\n無理だ……\\!ああああああ゛あ゛あ゛あ゛あ゛あ゛……。":28,"\\n<ディスプレイ>彼女のクセが感染しそうだ……。":29,"\\n<\\N[2]>敵対する立場の私たちの目につくところに、\nなぜ内情を吐露するのでしょうか……？":30,"\\n<経蔵>ふっ。\\.\\.あの貞子も基本 “かまってちゃん”、\n“わかってちゃん” なのは変わらないのかもな？":31,"\\n<珠緒>そのための呪い、って一面もあるからね……。\\!\n自覚あるのかな……\\.\\.そこんとこ。":32,"\\n<経蔵>これは、あいつなりの “賭け” なのかもな……。\\.\\.\n心を開くかどうかの、\\.\\.な。":33,"\\n<ディスプレイ>\n\"Happy \\C[10]Virus\\C[0]day To You\"":34,"\\n<ディスプレイ>私の\\C[7]情報（すべて）\\C[0]を世界中に\\C[7]転写\\C[0]しない限り、\n私の居場所はないのではないだろうか……。":35,"\\n<ディスプレイ>\\C[7]選ばれた人間は、捨てられた人間の怨念を\n引き受けなければならない……。":36,"\\n<珠緒>ここ、貞子の気配に混じって\n得体の知れない『何か』を感じる。":37,"\\n<経蔵>ああ。貞子自身も強烈な怨念の持ち主だが、\\!\n貞子を貞子たらしめる黒幕のニオイがするな。":38,"\\n<\\N[2]>転写とくればＤＮＡを思い起こしますが……。":39,"\\n<ディスプレイ>\n\"Happy \\C[10]Birthyear\\C[0] To You\"":40,"\\n<ディスプレイ>この屋敷で、彼女と獲物を奪い合うことになった。\\!\nしかし、彼女の背後にいる意志団は私のそれと似た雰囲気だ……。\nどういうことだろう？":41,"\\n<ディスプレイ>青鬼と呼ばれた意思団は、\nこちらが手出ししない限り攻撃はしてこないようだ。":42,"\\n<ディスプレイ>しかし、いまひとつ考えも行動も読めない。\n今後の気がかりだ。":43,"\\n<珠緒>……なんていうか、貞子や伽椰子を\nメインボーカルにたとえると、とんでもない数の\nバックコーラスがいる感じがする。":44,"\\n<経蔵>意志団……。\\.\\.\n貞子や伽椰子の後援会みたいな霊団か？":45,"\\n<経蔵>そんな後ろ盾がいるなら、\nどうりで尋常じゃなく強いはずだ。":46,"\\n<ディスプレイ>\n\"Dub H->V\"":47,"EV004":48,"青位置設定":49,"--------------------\n■デバッグモード":50,"--------------------":51,"EV006":52,"自動イベント":53,"----------------------------------------------------\nあとは青鬼をここにおびきよせるだけ、という話に。\n珠緒が青鬼が和室のふすまに隠れていると霊視。\nおびきよせることになる。\n----------------------------------------------------":54,"\\n<珠緒>おそい。":55,"\\n<経蔵>道草に当たって死んだんじゃねえかって\n心配してたトコだったんだぜ？":56,"ビデオデッキを設置した。":57,"\\n<\\N[2]>動作はいいようです。\nこれならそちらの“呪いのビデオ”というものも\n再生できるでしょう。":58,"\\n<経蔵>牢の中にコンセントがあって助かったぜ。":59,"\\n<\\N[2]>テストに持ってきたテープですが、\n映っているのは、この屋敷の家族でしょうか……？":60,"\\n<経蔵>今となっちゃ、\\.\\.どうでもいいもんだけどな……。":61,"\\n<\\N[2]>そのビデオテープに宿るという\n貞子（さだこ）なる化け物の力で、\nこの屋敷の化け物を退治するとのことですが……":62,"\\n<経蔵>霊的なことを基本信じていない\nお前にしちゃ不安だろうが、やるしかない。":63,"\\n<経蔵>バケモンにはバケモンをぶつけんだよ。\\!\nあと、お前がデッキといっしょに持ってきたノートも\nそこに立てて置いといてくれ。":64,"\\n<\\N[2]>持ってきた覚えはないのですが、\nいつのまにか小脇に……":65,"\\n<珠緒>完全に狙われてるね。伽椰子に。":66,"\\n<経蔵>そのノートは伽椰子の身体のようなものだ。\n実物を見るのは初めてだがな。":67,"\\n<経蔵>うまくすりゃ、\n伽椰子にも貞子の呪いがかかるだろう。\nそうすりゃ二兎を得られるってもんだがな。":68,"\\n<珠緒>まだだね。\\.\\.\n屋敷の化け物の気配は。\\.\\.ぼんやりしてる。":69,"\\n<経蔵>ここのバケモンは気まぐれだな。\nだから命びろいもしやすいってトコだが。\\!\n\\N[2]、その普通の\\C[1]ビデオでも見ながら待機\\C[0]してろ。":70,"例の鉄格子アニメ始まる":71,"例の鉄格子アニメ":72,"DiscardPicture tetugousi":73,"DiscardPicture te":74,"DiscardPicture ao_up":75,"DiscardPicture ao_up_mika":76,"DiscardPicture ao_up_takesi":77,"DiscardPicture ao_up_takurou":78,"------------------------------------":79,"\\n<経蔵>デケェなおい！！":80,"\\n<珠緒>経蔵、ビデオ！！":81,"\\n<経蔵>わかってんだよ！！":82,"\\n<経蔵>さあ、鬼さんこちら！\n呪いの上映会、伽椰子と楽しんでいってくれよな！":83,"\\n<\\N[2]>（“鬼”……）":84,"いったん呪いのビデオ部屋へ":85,"呪いのビデオ部屋からの続き。\n青鬼がビデオを観ている。":86,"何かが引っかかっているのか、動かない！":87,"\\n<経蔵>くそっ、俺の出番かよ！？":88,"------------------------------------\nあわやというところで電話が鳴る\n電話役はテレビ（笑）":89,"\nそのとき、遠くから電話の音が響いた。":90,"(4,15)の3ページ目に引き継ぎ":91,"玄関ホール(4,15)から引き継ぎ\n\nお互いの無事を確かめるひろしと経蔵。\n一行は２Ｆ左下寝室へ":92,"\\n<経蔵>青鬼のやつ、\nまさか俺たちよりも電話の方を選ぶとはな。\\!\n家の人間としての条件反射でも持ってんのか……？":93,"\\n<\\N[2]>“青鬼”……？":94,"\\n<経蔵>屋敷のバケモンのことだよ。\nいいかげん呼び名が欲しかったところだ。":95,"\\n<経蔵>お前ついさっき、\n“青い鬼”ってつぶやいてただろ。それで決まり。":96,"\\n<\\N[2]>経蔵さんが、あの化け物のことを\n“鬼”と呼んでいたので……。":97,"\\n<\\N[2]>わかりました。\n今後、屋敷の化け物のことを“青鬼”と呼びましょう。":98,"\\n<珠緒>青鬼、ビデオは一通り見たと思うけど、\n屋敷の外でうろついてるみたい。\\!\nまだ出れないよ。":99,"\\n<経蔵>そうか。\\.\\.うまいとこバケモンどうし、\n潰しあってくれるのを見届けられるといいけどな……":100,"\\n<珠緒>とりあえず休みたい。":101,"\\n<\\N[2]>では、安全のため、もうしばらくここで。":102,"\\n<珠緒>パス。\\.\\.ふとんのあるとこで。":103,"\\n<経蔵>じゃあ、途中にあった和室はどうだ？\nあそこならすぐ玄関から出られそうだけどな。":104,"\\n<\\N[2]>あちらはなぜか押し入れがからっぽで、\nふとんがありません。\\!\n２階の部屋から持ってきましょうか？":105,"ふとんは、私が目覚めた\\C[1]２階↓、←の寝室\\C[0]に\nあったはず……":106,"\\n<経蔵>そうするか。\n珠緒、大事をとっていっしょに動くぞ。":107,"\\n<経蔵>念のため、呪いのビデオと伽椰子のノートも持ってくか。\n何か使えるかもしれない。":108,"\\n<珠緒>（呪いの品が２つも手もとにくるなんて……）":109,"\\n<経蔵>さっさとこないと死ぬぞ？":110,"座敷牢テレビ":111,"----------------------------------\nテレビを調べると先に進む":112,"\\n<\\N[2]>（待つしかありませんか……）":113,"　待機する":114,"　２人と雑談する　":115,"\\n<珠緒>経蔵。\\.\\.近くに気味の悪い気配を感じる。\n\\C[1]ここにくる途中のどこか、\\C[0]だと思う。":116,"\\n<経蔵>伽椰子か？":117,"\\n<珠緒>ちがう。\\.\\.\n……でも、伽椰子にひけをとらない力を感じる。":118,"\\n<経蔵>この屋敷の主か。":119,"\\n<\\N[2]>では作戦通り、\n屋敷の化け物をここに案内してきます。":120,"\\n<経蔵>おい貞子。\\.\\.出番だぞ。\\.\\.しっかり相手してやれよ？":121,"------------------------------------------":122,"\\n<経蔵>勝手にテレビがついているあたり、\nバケモン屋敷らしいな。":123,"\\n<\\N[2]>経蔵さん。呪いのビデオをお借りします。\nデッキの内蔵ハードディスクから、このビデオに\nダビングしてみますね。":124,"\\n<\\N[2]>電子ロックの \\>\"Dub H->V\"\\< という\nメッセージはおそらく\n\\>\"Dubbing HDD->VIDEO\"\\<という意味でしょう。":125,"\\n<経蔵>何が上書きされるんだ……？":126,"画面には何も映らない。\\!\nしかし、なぜだか見ているだけで安心感を覚える。":127,"CastCommonEventName 座敷牢テレビ 身震い":128,"\\n<珠緒>貞子の気配が乱れてきた。\\.\\.\n混乱してる。":129,"\\n<経蔵>どういうことだ……？":130,"-------------------------------------------":131,"\\n<珠緒>この本棚の中身、\nいまのビデオデッキと同じ気配がする！\\!\nほんのり温かい感じ……":132,"\\n<経蔵>デッキのハードディスクを\n（霊的に）細工したのはお前らか。\\!\n悪者じゃなさそうなのは結構だが。":133,"\\n<\\N[2]>……本棚に身をやつしている人たち、でしょうか。\\!\nどんな方々で、何とおっしゃっていますか？":134,"\\n<珠緒>貞子や伽椰子も含めて、同じように呪っている\n人たちにとっての……大切な人の集まりみたい。":135,"\\n<\\N[2]>……！？":136,"\\n<経蔵>大切といっても、命を奪われて魂を\n箱の中に“大切に”しまわれた感じらしい。\\!\nたまったもんじゃねえな。":137,"\\n<珠緒>今まで縛られて動けなかったのが、\n青鬼の屋敷の空間と合わさってから、\nなぜか身体を動かせるようになったんだって。":138,"\\n<珠緒>本棚はとりあえず……\\.\\.仮の姿みたい。":139,"\\n<経蔵>監禁つながりで、ここと合わさったのかもな。":140,"\\n<珠緒>「今は軟禁に近い状態までよくなってる」、\nだって。":141,"\\n<経蔵>怨霊どもの一部は、こいつらのもとへ\nかわるがわる暖を取るかのように来ているそうだ。":142,"\\n<\\N[2]>……まるでストーブか暖炉ですね。":143,"\\n<経蔵>貞子や伽椰子も、\nときどき来ているとのことだ。":144,"ふと、目を閉じた。\\!\n貞子らしき女性が人の輪（リング）の中心で\n立ちすくんでいる様子が浮かんだ。":145,"しかし、周囲の人たちは距離をとりつつも、\n温かく彼女のことを待っているように見受けられた。":146,"\\n<珠緒>貞子のそばに誰か来た。\\!\n……遺品にちょっと残ってたこの気配はたしか、":147,"\\n<珠緒>遠山……\\.\\.博（ひろし）":148,"\\n<経蔵>貞子の彼氏か。\\!\n……ふっ、\\.\\.縁だな。":149,"\\n<経蔵>……何を話したかよく聞こえなかったが、\n気配の変化からして、\nバケモンのハートにいくらか届いたみたいだな。":150,"\\n<経蔵>ふっ。\\.\\.貞子にとっては圧倒的な思いやりの方が\n逆にこたえるみたいだな？":151,"\\n<経蔵>なるほど……。\\.\\.\nあえて癒やすことで呪う気を削ぐことができるのか。":152,"\\n<珠緒>ダビングが終わった。\\!\nたしかに、貞子の気配が若干変わってるね……。\nもう１回ダビングしてみる？":153,"\\n<経蔵>いや、やめておこう。\\.\\.\nこれ以上は、これまでの世間への不信感との\nせめぎあいで、貞子が発狂しかねない。":154,"\\n<経蔵>世間から受けた傷は\n世間でないと回復は難しい。":155,"\\n<経蔵>貞子、世間のフロにゆっくりつかりな……。\\.\\.\n沙汰はそれからだ。":156,"\\n<経蔵>怨霊どもが自分の慰めのためにとっておいた\n親切な人間たちが、\nひとつの世間になるまでになっていたか。":157,"\\n<経蔵>それに「よしよし」されるとは、\n貞子も因果なやつだな。":158,"\\n<珠緒>貞子を「よしよし」してもらえるよう\n働きかけたのは遠山だってね？":159,"\\n<経蔵>ああ。自由がきくようになってから\nここの連中に頭下げまくっていたそうだ。\\!\n今回のＭＶＰだな。":160,"経蔵":161,"\\n<経蔵>ホントは屋敷の脱出経験者のお前に任せて\n俺らは表にバックレたいんだがな。\\!\n表に仕掛けたもののチェックもあるしな。":162,"\\n<\\N[2]>表で待機頂くこと自体は構わないのですが、\n屋敷の化け物がお二人を狙ってしまうと\n作戦が混乱しかねませんしね。":163,"\\n<経蔵>肉をチラせて骨を断つ。\\.\\.\nその肉は一箇所にまとめてでないと、ってか。":164,"\\n<経蔵>あ～あ、\\.\\.っと。":165,"\\n<\\N[2]>残念ながら、\n確実にビデオを屋敷の化け物に見せる、\nそれ以上の策は思いつきません……。":166,"\\n<経蔵>ま、\\.\\.退治できりゃいいんだよ。":167,"\\n<経蔵>この屋敷で一番の安全地帯を利用する案を\n教えてくれたんだ。\\.\\.それだけで感謝してるぜ？":168,"\\n<経蔵>はやく屋敷のバケモンを迎えに行ってやれよ。\nお前にとっちゃ顔なじみだろ？":169,"珠緒":170,"\\n<経蔵>珠緒、走って逃げる必要があるときは\n背中を貸すからな。\\.\\.\nヘタに遠慮すんじゃねえぞ？":171,"\\n<珠緒>無利息なら考える。":172,"\\n<珠緒>あと、利息つけるなら、こいつにつけといて。":173,"\\n<珠緒>走って逃げなきゃいけないことになったら\nガイド失格だから。":174,"\\n<\\N[2]>目に見えないときの屋敷の化け物を\n察知できるという珠緒さんのご協力があれば、\nそのぶん、よりお力になれるかもしれません。  ":175,"\\n<\\N[2]>まさに今がそのときだと思われますが、\nいかがでしょう。":176,"\\n<珠緒>……………………。":177,"\\n<経蔵>ふっ。珠緒から１本とったか。":178,"-----------------------------------------\n珠緒だけツンデレ？なぶん、セリフが\n１段階多い":179,"\\n<珠緒>あんた、キライ…………。":180,"\\n<経蔵>\\N[2]、悪く思わないでくれ。\n珠緒は人見知りでな。":181,"\\n<経蔵>なじみのない人間には毒づくのが\n流儀（クセ）みたいなもんなんだ。":182,"\\n<珠緒>経蔵、人のこと…………。":183,"\\n<経蔵>早く俺を見習って、ＴＰＯを見極めて\n毒づけるようになってくれよ？":184,"\\n<珠緒>経蔵もキライ…………！":185,"\\n<珠緒>みんな、キライ…………！":186,"\\n<珠緒>化け物を迎えに行く必要あるの？\nどのみち、あたしたちを探してるだろうし。":187,"\\n<\\N[2]>相手をこちらのペースに乗せることが大事ですので。\\.\\.\nご索敵、感謝します。":188,"俊雄":189,"青２":190,"伽椰子ノート":191,"\\n<珠緒>そのノートには呪いのビデオと\n同じような力があるね。\\!読んだら呪われて死ぬ。":192,"\\n<\\N[2]>つまり、デス・ノートということですか。 ":193,"\\n<経蔵>まあ。\\.\\.入れば呪われて死ぬ、\nこのデス・ハウスの中にいる人間にとっては\n今さら、\\.\\.だけどな。":194,"\\n<経蔵>いまは屋敷のバケモンに\nこのデス・ムービーを見せて\nこのデス・ゲームを制することにだけ専念しとけ。":195,"\\n<経蔵>それでじゅうぶんだ。\\!\nあんまり気にして伽椰子に\n“その気がある”なんて誤解させんじゃねえぞ？":196,"\\n<\\N[2]>未知の常識を持つ存在として興味はありますが……":197,"\\n<経蔵>お前が“その気”かよ……":198,"\\n<\\N[2]>ときおりページを埋め尽くす\n“こども”、\\.\\.“こばやしくん”、\\.\\.“ほしい”。\\!\n巻末の渦巻きの描画……":199,"\\n<珠緒>意味なんてないと思うよ？\n本人でもよく分かってないかも。":200,"\\n<経蔵>……伽椰子を抑えられそうなヒントがあったら\n教えてくれや。":201,"\\n<経蔵>……手立ては多い方が助かる。":202,"\\n<経蔵>屋敷のバケモンと伽椰子を\nダブルプレーで討ち取れれば御の字だがな……。":203,"電話音":204,"AltBgs vol 0 0 0":205,"遠山棚":206,"\\n<経蔵>そうか……。\\.\\.\n遠山、あんたはここで貞子をフォローするつもりか。\n善意の方も、バケモンの方も。":207,"\\n<経蔵>いつか、\n世の中を呪う気をなくしてくれるように……\\.\\.か。":208,"\\n<経蔵>俺たちはこっちの「ひろし」と、\nこれからバケモン退治の仕上げに向かう。":209,"\\n<経蔵>動きがとれるようになったのなら、\n善意の意地を見せて呪いの内側から働きかけてくれ。\n俺たちだけじゃ解決は困難だ。":210,"\\n<経蔵>それから遠山、俺の調べだと善意の方の貞子は、\n生きてるやつのケガも、死んだやつのケガの苦しみも\n治癒できる力があると聞いている。":211,"\\n<経蔵>ケガをしてる怨霊を片っ端から治療してもらえ。\nそれでおさまる奴も多いかもしれない。":212,"\\n<経蔵>引き続き音頭をとって、ここの連中を\n働かせてくれ。":213,"\\n<経蔵>怨霊どもが落ち着いてきたら、\nここから自力で脱出する糸口も見えてくるだろう。\\!\n……頼むな。":214,"\\n<経蔵>思わぬところで、いいアテができたな。\\!\n……長い目でみる必要があるが。":215,"\\n<珠緒>あたしたちにも「黒幕」ができた感じ？\\!\n……頼れるかは別だけど。":216,"\\n<\\N[2]>……「白幕」\\.\\.という表現はどうでしょうか。\\.\\.\n悪事をはたらくわけではないのですから。":217,"\\n<経蔵>ふっ。\\.\\.ちがいないな！":218,"小林棚":219,"\\n<経蔵>伽椰子の片想い相手……\\.\\.小林俊介の魂か。\\!\nこんなところにいやがったか。\\!":220,"\\n<経蔵>しょぼくれてんじゃねえよ。\\.\\.釈放の時間だぞ？\nとっととこの鏡に移れ。":221,"この本棚には伽椰子の片想い相手である\n小林という男の魂がいるらしい。":222,"\\n<経蔵>小林、伽椰子は若干だが落ち着いた。\n今ならお前があいつに血眼で追いすがられるほどでは\nないかもしれない。":223,"小林の魂が経蔵さんの鏡に回収されたようだ。":224,"\\n<経蔵>……\\C[1]伽椰子を何とかしてほしい？\n\\C[0]怖くて出られない？　\\!\nったく、\\.\\.めんどくせえなあ……。":225,"\\n<経蔵>しかし、伽椰子はこいつのどこに惚れたんだ？\\.\\.\n\\N[2]に似てインテリ系なのは確かだが。\\!\nすっかり縮みあがって、いいところがまるで見えない。":226,"\\n<珠緒>伽椰子にとっては恋自体が\n何かの呪いじゃないの？":227,"\\n<珠緒>これじゃ\\N[2]の方がましに見える。\\!\n……最悪の下の最悪とか、\\.\\.最悪。":228,"\\n<経蔵>ふっ。\\.\\.お前はその『最悪色』の色眼鏡が呪いだな。\\!\n外せ。\\.\\.ときどきでいいから。":229,"\\n<経蔵>すまないが、いまはあんたたちを\n連れ出すことはできない。":230,"\\n<経蔵>一度に連れ出すと、あんたたちを慕う\n怨霊どもが発狂しかねないからだ。":231,"\\n<経蔵>そのかわり、少し自由を得たぶん、\n善意の意地を見せて怨霊どもの気持ちを\n鎮めてやってくれよ。":232,"\\n<経蔵>怨念が落ち着いてきたぶんだけ、\n成仏の手配をしてやれると思う。":233,"ひろし":234},"extension":"json","dataType":"map","filename":"Map094","basename":"Map094.json","path":"data/Map094.json","relPath":"data/Map094.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":235,"length":235,"percent":100},"cellInfo":[]},"data/Map095.json":{"data":[["EV001","","EV001"],["EV002","","EV002"],["EV003","","EV003"],["EV004","","EV004"],["EV005","","EV005"],["EV006","","EV006"],["EV007","","EV007"],["EV008","","EV008"],["EV009","","EV009"],["------------------------------------------\nセルフＢは、ひろしと会話済フラグ","","------------------------------------------\nSelf B has a conversation flag with Hiroshi"],["\\n<\\N[2]>この先は地下室を経て井戸の底につながっています。\\!\n以前は井戸に縄ばしごがかかっていたのですが、\nこの館の化け物に食いちぎられてしまいました。","","\\n<\\N[2]>This path leads to the bottom of the well via the basement. \\!\nPreviously, there was a rope ladder hanging over the well.\nI was torn to pieces by the monsters in this mansion."],["\\n<珠緒>じゃあ、行っても意味ないね。","","\\n<珠緒>Then there's no point in going."],["\\n<経蔵>井戸の底、というなら\n地下で待ち構えてるかもしれないしな。\\.\\.\\.貞子が。","","\\n<経蔵>The bottom of the well, if you will.\nIt might be waiting for you underground. \\.\\.\\. Sadako."],["\\n<珠緒>うん。なにげに暮らしてそう。","","\\n<珠緒> Yeah. I feel like I'm living a casual life."],["\\n<経蔵>井戸の底、というなら\n地下で待ち構えてるかもな。\\.\\.\\.貞子が。","","\\n<経蔵>The bottom of the well, if you will.\nIt might be waiting for you underground. \\.\\.\\. Sadako."],["\\n<経蔵>この先に井戸があるとはな……。\\!\nつくづくバケモンどうしの縁を感じるな。","","\\n<経蔵> I never thought there would be a well ahead of us... \\!\nI really feel the bond between these monsters."],["--------------------------------------------\nひろしがいないケースは、\n経蔵が珠緒とひろしを探しているとき","","--------------------------------------------\nIn the case where Hiroshi is not present,\nWhen Keizo is looking for Tamao and Hiroshi"],["\\n<珠緒>経蔵、こっちからは\n\\N[2]の気配はしない。","","\\n<珠緒>Kyozo, from here\nThere is no sign of \\N[2]."],["-------------------------------\nひろし１人のとき","","-------------------------------\nWhen Hiroshi is alone"],["\\n<\\N[2]>たけし…………。\\.\\.卓郎…………。\\!\nいまだに実感が充分ではありませんね。\\.\\.\nこの先で２人が命を落とした、\\.\\.ということが……","","\\n<\\N[2]>Takeshi…………. \\.\\. Takuro…………. \\!\nI still don't feel it fully. \\.\\.\nTwo people lost their lives in the future, \\.\\...."],["\\n<\\N[2]>……………………。","","\\n<\\N[2]>……………………."],["EV010","","EV010"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["洗濯機音","","washing machine sound"],["AltBgs vol 0 10 1","","AltBgs vol 0 10 1"],["AltBgs vol 0 20 1","","AltBgs vol 0 20 1"],["AltBgs vol 0 35 1","","AltBgs vol 0 35 1"]],"context":[["Map095/events/1/name"],["Map095/events/2/name"],["Map095/events/3/name"],["Map095/events/4/name"],["Map095/events/5/name"],["Map095/events/6/name"],["Map095/events/7/name"],["Map095/events/8/name"],["Map095/events/9/name"],["Map095/events/9/pages/0/list/4/comment"],["Map095/events/9/pages/0/list/6/message/hasPicture/top"],["Map095/events/9/pages/0/list/11/message/hasPicture/top"],["Map095/events/9/pages/0/list/13/message/hasPicture/top"],["Map095/events/9/pages/0/list/16/message/hasPicture/top"],["Map095/events/9/pages/0/list/20/message/hasPicture/top"],["Map095/events/9/pages/0/list/28/message/hasPicture/top"],["Map095/events/9/pages/0/list/35/comment"],["Map095/events/9/pages/0/list/38/message/hasPicture/top"],["Map095/events/9/pages/0/list/45/comment"],["Map095/events/9/pages/0/list/48/message/hasPicture/top"],["Map095/events/9/pages/0/list/55/message/hasPicture/top"],["Map095/events/10/name"],["Map095/events/11/name"],["Map095/events/12/name"],["Map095/events/12/pages/0/list/0/comment"],["Map095/events/12/pages/0/list/7/comment"],["Map095/events/13/name"],["Map095/events/13/pages/0/list/3/Plugin Command"],["Map095/events/13/pages/0/list/7/Plugin Command"],["Map095/events/13/pages/0/list/10/Plugin Command"]],"tags":[null,null,null,null,null,null,null,null,null,["blue"],null,null,null,null,null,null,["blue"],null,["blue"],null,null,null,null,null,["blue"],["blue"],null,["red"],["red"],["red"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":4,"headerParam":["------------------------------------------"]}],[{"headerIndex":6,"headerParam":["N2",0,0,0]}],[{"headerIndex":11,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":13,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":16,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":20,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":28,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":35,"headerParam":["--------------------------------------------"]}],[{"headerIndex":38,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":45,"headerParam":["-------------------------------"]}],[{"headerIndex":48,"headerParam":["N2",0,0,0]}],[{"headerIndex":55,"headerParam":["N2",0,0,0]}],null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"EV006":5,"EV007":6,"EV008":7,"EV009":8,"------------------------------------------\nセルフＢは、ひろしと会話済フラグ":9,"\\n<\\N[2]>この先は地下室を経て井戸の底につながっています。\\!\n以前は井戸に縄ばしごがかかっていたのですが、\nこの館の化け物に食いちぎられてしまいました。":10,"\\n<珠緒>じゃあ、行っても意味ないね。":11,"\\n<経蔵>井戸の底、というなら\n地下で待ち構えてるかもしれないしな。\\.\\.\