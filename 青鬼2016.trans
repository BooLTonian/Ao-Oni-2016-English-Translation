r !$oikakekko_ball":2,"DiscardCharacter !$modoru":3,"EV002":4,"青":5,"EV004":6,"青位置設定":7,"--------------------\n■デバッグモード":8,"--------------------":9,"EV006":10,"\\n<\\N[2]>暗くてよく見えませんね……":11,"\\n<\\N[2]>特に気になるところはありませんね……":12,"EV007":13,"\\n<\\N[2]>開かない":14,"\\n<\\N[2]>太陽のタリスマンを手に入れた":15,"\\n<\\N[2]>これは卓郎が持っていてください":16,"\\n<卓郎>ありがたく戴いておくぜ":17,"卓郎に化けた青鬼":18,"\\n<卓郎>あいにくだが遠慮する\n大した効果はないだろう":19,"\\n<\\N[2]>そうですか……":20,"EV008":21,"\\n<\\N[2]>謎の通路の鍵を使った":22,"\\n<\\N[2]>鍵がかかっている":23,"EV009":24,"EV010":25,"青２":26,"青ルート補正":27,"DiscardPicture tetugousi":28,"DiscardPicture te":29,"DiscardPicture ao_up":30,"DiscardPicture ao_up_mika":31,"DiscardPicture ao_up_takesi":32,"DiscardPicture ao_up_takurou":33},"extension":"json","dataType":"map","filename":"Map081","basename":"Map081.json","path":"data/Map081.json","relPath":"data/Map081.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":34,"length":34,"percent":100},"cellInfo":[]},"data/Map082.json":{"data":[["EV001","","EV001"],["--------------------\n■キャンセルキーが離されるのを待つ","","--------------------\n■Wait until the cancel key is released"],["--------------------\n■メイン処理（マップ画面に戻る）","","--------------------\n■Main processing (return to map screen)"],["o","","Th"],["hi","","IF"],["na","","MF"],["ku","","RF"],["ko","","LF"],["EV007","","EV007"],["\\n<\\N[2]>後ろで金庫の開く音がした","","\\n<\\N[2]>I heard the sound of a safe opening behind me."],["--------------------\n■元の画面に戻る","","--------------------\n■Return to the original screen"],["DiscardTilesets 16","","DiscardTilesets 16"],["DiscardCharacter !$hirosi_kao","","DiscardCharacter !$hirosi_kao"],["DiscardCharacter !$ohnko","","DiscardCharacter !$ohnko"],["DiscardCharacter !$ohnku","","DiscardCharacter !$ohnku"]],"context":[["Map082/events/1/name"],["Map082/events/1/pages/1/list/0/comment"],["Map082/events/1/pages/1/list/10/comment"],["Map082/events/2/name"],["Map082/events/3/name"],["Map082/events/4/name"],["Map082/events/5/name"],["Map082/events/6/name"],["Map082/events/7/name"],["Map082/events/7/pages/1/list/3/message/hasPicture/bottom"],["Map082/events/7/pages/1/list/6/comment"],["Map082/events/7/pages/1/list/9/Plugin Command"],["Map082/events/7/pages/1/list/10/Plugin Command"],["Map082/events/7/pages/1/list/11/Plugin Command"],["Map082/events/7/pages/1/list/12/Plugin Command"]],"tags":[null,["blue"],["blue"],null,null,null,null,null,null,null,["blue"],["red"],["red"],["red"],["red"]],"parameters":[null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":10,"headerParam":["--------------------"]}],null,null,null,null,null,null,[{"headerIndex":3,"headerParam":["normal",0,0,2]}],[{"headerIndex":6,"headerParam":["--------------------"]}]],"indexIds":{"EV001":0,"--------------------\n■キャンセルキーが離されるのを待つ":1,"--------------------\n■メイン処理（マップ画面に戻る）":2,"o":3,"hi":4,"na":5,"ku":6,"ko":7,"EV007":8,"\\n<\\N[2]>後ろで金庫の開く音がした":9,"--------------------\n■元の画面に戻る":10,"DiscardTilesets 16":11,"DiscardCharacter !$hirosi_kao":12,"DiscardCharacter !$ohnko":13,"DiscardCharacter !$ohnku":14},"extension":"json","dataType":"map","filename":"Map082","basename":"Map082.json","path":"data/Map082.json","relPath":"data/Map082.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":15,"length":15,"percent":100},"cellInfo":[]},"data/Map083.json":{"data":[["卓郎","","Takuro"],["ひろし","","Hiroshi"],["\\n<卓郎>たけし、久々に登校したな。\n一週間、何していたんだ？","","\\n<卓郎> Takeshi, it's been a while since you went to school.\nWhat have you been doing all week?"],["\\n<たけし>怖くて怖くて\n自分の部屋から出られなかったんだ\\!\nあの日のことが今でも忘れられなくて……","","\\n<たけし> I'm scared, I'm scared\nI couldn't leave my room \\!\nI still can't forget that day..."],["\\n<美香>あの日のこと……\n私、夢だったと思っている\\.\\.\nあの化け物、\\.\\.きっと幻だったのよ","","\\n<美香>About that day...\nI think it was a dream \\.\\.\nThat monster, \\.\\. must have been an illusion."],["\\n<たけし>……でも、\\.\\.オレが洋館に行こうなんて\n言い出して行ったのは事実だし……","","\\n<たけし>...But \\.\\. I don't want to go to a Western-style mansion.\nIt's true that I said it..."],["\\n<\\N[2]>私たちが洋館に行ったこと自体\n夢だった……\\.\\.そう思う……\\!\nそう思うことにしましょう","","\\n<\\N[2]>The fact that we went to a Western-style building\nIt was a dream...\\.\\. I think so...\\!\nLet's think so"],["\\n<たけし>……でも、星形のお守りが\n未だに手放せなくて……\\!\nこれが洋館に行った一番の証だろう","","\\n<たけし>...But the star-shaped amulet\nI still can't let go...\\!\nThis is probably the best proof that I went to a Western-style building."],["\\n<卓郎>それもきっと何かの間違いだ……\\.\\.\n俺は太陽の形をしたお守りは\nすぐ川に捨てたぜ……\\.\\.忘れるために","","\\n<卓郎> That must be some kind of mistake... \\.\\.\nI have a sun-shaped amulet\nI threw it in the river right away...\\.\\.To forget"],["\\n<美香>私は三日月の形のお守り、まだ持ってる……\n机の引き出しにしまったままだけど……\\!\nきっと記憶違いよ\n三人ともどこかで拾ったのよ","","\\n<美香>I still have the crescent moon-shaped amulet...\nIt's still in my desk drawer...\\!\nI'm sure I remember it wrong.\nI picked up all three of them somewhere."],["\\n<\\N[2]>……そうです、\\.\\.そうに違いありません……\nそう思いたいですね","","\\n<\\N[2]>... Yes, \\.\\. It must be...\nI would like to think so"],["　　　　そうつぶやいた私だったが……。\\!\n　　　　あの日たったひとつだけ館から持ち帰った写真を、\n　　　　いまだ捨てられずにいた。","","That's what I muttered, but... \\!\n　　　The only photo I brought back from the museum that day.\n　　　　I still couldn't throw it away."],["たけし","","Takeshi"],["美香","","Mika"],["EV005","","EV005"]],"context":[["Map083/events/1/name"],["Map083/events/2/name"],["Map083/events/2/pages/0/list/3/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/6/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/10/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/14/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/17/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/23/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/29/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/36/message/hasPicture/bottom"],["Map083/events/2/pages/0/list/43/message/hasPicture/bottom"],["Map083/events/2/p