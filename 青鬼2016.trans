"cellInfo":[]},"data/Map053.json":{"data":[["EV001","","EV001"],["EV002","","EV002"],["DiscardPicture whiteeye","","DiscardPicture whiteeye"],["DiscardTileset 12","","DiscardTileset 12"],["DiscardCharacter !$puzzle_player","","DiscardCharacter !$puzzle_player"],["DiscardCharacter !$puzzle_parts1","","DiscardCharacter !$puzzle_parts1"],["DiscardCharacter !$puzzle_parts2","","DiscardCharacter !$puzzle_parts2"],["DiscardPicture puzzle_kabe","","DiscardPicture puzzle_kabe"],["DiscardPicture puzzle_p","","DiscardPicture puzzle_p"],["DiscardPicture ningyou_head","","DiscardPicture ningyou_head"],["EV003","","EV003"],["EV004","","EV004"],["EV005","","EV005"],["EV006","","EV006"],["\\n<\\N[2]>人形を手に入れた","","\\n<\\N[2]>I found the item, \"Doll\"."],["EV007","","EV007"],["\\n<\\N[2]>地下室の鍵を手に入れた","","\\n<\\N[2]>I found the item, \"Basement Key\"."],["青","","blue"],["EV009","","EV009"],["EV010","","EV010"],["EV011","","EV011"],["EV012","","EV012"],["たけし首吊り","","Takeshi hanging"],["たけし落ちる","","fall down"],["--------------------\n■首吊りたけしの落ちるアニメーション","","--------------------\n■Animation of hanging Takeshi falling"],["--------------------","","--------------------"],["DiscardCharacter !$takesi_k","","DiscardCharacter !$takesi_k"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["生存たけし","","Survival Takeshi"],["\\n<\\N[2]>たけし！","","\\n<\\N[2]> Takeshi!"],["\\n<たけし>\\N[2]……オレ、怖いよ\nもう絶望に耐えられない\n死にてえんだよ","","\\n<たけし>\\N[2]...I'm scared\nI can't stand despair anymore\nI can't die"],["\\n<\\N[2]>星のタリスマンを差し上げます\nこれを握って一度深呼吸してください","","\\n<\\N[2]> I will give you a star talisman.\nHold this and take a deep breath"],["\\n<たけし>あ……ありがとう\\!\n……スー……\\!ハー……","","\\n<たけし> Ah...Thank you \\!\n... Sue... \\! Ha..."],["\\n<たけし>……なんだろう、落ち着いたぜ……\n早まろうなんて、馬鹿なことを考えていた","","\\n<たけし>... I wonder what it is, I've calmed down...\nI was thinking something stupid like trying to hurry up."],["\\n<\\N[2]>これからは一緒に行動しましょう","","\\n<\\N[2]>Let's act together from now on"],["\\n<たけし>……そうだな","","\\n<たけし>...That's right."],["\\n<\\N[2]>たけしと行動を共にすることにした","","\\n<\\N[2]>I decided to work with Takeshi."],["たけし生存判定","","Takeshi survival judgment"],["--------------------\n■生存判定\n※一度首吊りを見てしまうと、後からアイテムを持ってきても無駄","","--------------------\n■Survival determination\n*Once you see the hanging, there is no point in bringing the item later."],["※別の場所で生存が確定したら、\nここで首吊りを見る、ということはない","","*If survival is confirmed in another location,\nThere's no way you'll see a hanging here."],["--------------------\n■終了処理","","--------------------\n■ Termination processing"]],"context":[["Map053/events/1/name"],["Map053/events/2/name"],["Map053/events/2/pages/0/list/2/Plugin Command"],["Map053/events/2/pages/0/list/3/Plugin Command"],["Map053/events/2/pages/0/list/4/Plugin Command"],["Map053/events/2/pages/0/list/5/Plugin Command"],["Map053/events/2/pages/0/list/6/Plugin Command"],["Map053/events/2/pages/0/list/7/Plugin Command","Map053/events/7/pages/1/list/0/Plugin Command"],["Map053/events/2/pages/0/list/8/Plugin Command","Map053/events/7/pages/1/list/1/Plugin Command"],["Map053/events/2/pages/0/list/9/Plugin Command","Map053/events/7/pages/1/list/2/Plugin Command"],["Map053/events/3/name"],["Map053/events/4/name"],["Map053/events/5/name"],["Map053/events/6/name"],["Map053/events/6/pages/0/list/17/message/hasPicture/bottom"],["Map053/events/7/name"],["Map053/events/7/pages/2/list/4/message/hasPicture/bottom"],["Map053/events/8/name"],["Map053/events/9/name"],["Map053/events/10/name"],["Map053/events/11/name"],["Map053/events/12/name"],["Map053/events/13/name"],["Map053/events/14/name"],["Map053/events/14/pages/1/list/0/comment"],["Map053/events/14/pages/1/list/16/comment","Map053/events/15/pages/0/list/7/comment"],["Map053/events/14/pages/1/list/18/Plugin Command"],["Map053/events/15/name"],["Map053/events/15/pages/0/list/0/comment"],["Map053/events/16/name"],["Map053/events/16/pages/0/list/0/message/hasPicture/bottom"],["Map053/events/16/pages/0