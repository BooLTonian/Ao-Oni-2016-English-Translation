"],null,null,null,["blue"],null,null,null,null,null,null,null,null,null,null,["blue"],null,null,null,null,null,null,null,null,null,null,["blue"],["blue"],null,["blue"],null,null,null,null,null,null,null,null,null,null,["blue"],["blue"],null,null,["blue"]],"parameters":[null,null,null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]},{"headerIndex":5,"headerParam":["--------------------"]}],[{"headerIndex":4,"headerParam":["--------------------"]},{"headerIndex":9,"headerParam":["--------------------"]}],[{"headerIndex":43,"headerParam":["--------------------"]}],[{"headerIndex":48,"headerParam":["--------------------"]}],[{"headerIndex":55,"headerParam":["N2",7,0,1]},{"headerIndex":105,"headerParam":["N2",7,0,1]}],null,null,null,[{"headerIndex":65,"headerParam":["------------------------------------"]}],[{"headerIndex":118,"headerParam":["------------------------------"]}],[{"headerIndex":149,"headerParam":["N2",7,0,0]}],[{"headerIndex":153,"headerParam":["------------------------------"]}],[{"headerIndex":0,"headerParam":["-----------------------------------"]}],[{"headerIndex":48,"headerParam":["--------------------"]}],[{"headerIndex":55,"headerParam":["",7,0,1]}],[{"headerIndex":59,"headerParam":["",7,0,1]}],[{"headerIndex":63,"headerParam":["-----------------------------------------"]}],[{"headerIndex":89,"headerParam":["------------------------------------"]}],[{"headerIndex":1,"headerParam":["-------------------------------------"]}],[{"headerIndex":3,"headerParam":["-------------------------------------"]}],[{"headerIndex":24,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":28,"headerParam":["-------------------------------------"]}],[{"headerIndex":44,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":46,"headerParam":["N2",0,0,2]}],[{"headerIndex":50,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":52,"headerParam":["--------------------------------------"]}],[{"headerIndex":68,"headerParam":["N2",0,1,1]}],[{"headerIndex":73,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":76,"headerParam":["N2",0,0,2]}],[{"headerIndex":81,"headerParam":["N2",0,0,2]}],[{"headerIndex":84,"headerParam":["N2",0,0,2]}],[{"headerIndex":87,"headerParam":["N2",0,0,2]}],[{"headerIndex":91,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":100,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":112,"headerParam":["N2",0,0,2]}],[{"headerIndex":116,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":119,"headerParam":["-------------------------------------"]}],[{"headerIndex":137,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":141,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":146,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":149,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":152,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":160,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":169,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":204,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":208,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":213,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":228,"headerParam":["-------------------------------------"]}],[{"headerIndex":234,"headerParam":["(4,15)を起動"]}],null,[{"headerIndex":0,"headerParam":["画像先読み用です。"]}],null,null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["コモンイベント(いなくなる)より引き継ぎ"]}],[{"headerIndex":5,"headerParam":["----------------------------------------------"]}],[{"headerIndex":23,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":27,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":33,"headerParam":["---------------------------------------------"]},{"headerIndex":93,"headerParam":["---------------------------------------------"]}],[{"headerIndex":43,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":50,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":99,"headerParam":["N2",0,1,1]}]],"indexIds":{"青":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"EV006":5,"入口":6,"EV008":7,"ＯＰ卓郎":8,"ＯＰひろし":9,"ＯＰ美香":10,"ＯＰたけし":11,"ＯＰデモ・サダカヤＥＶ":12,"--------------------\n■ここからプレイ時間計測開始":13,"--------------------\n■鳥が飛んでいくアニメーション":14,"--------------------":15,"--------------------\n■ナレーション、場所移動\n（通常編・コミカル編）":16,"町外れにある無人の館\\!\nそこにはお化けが出るという噂があった":17,"DiscardCharacter !$165-Small07":18,"DiscardCharacter !$166-Small08":19,"DiscardTilesets 3":20,"------------------------------------\n■以下ハッカドール編用ＯＰデモ":21,"------------------------------\nハッカドール一同、\nカメラ目線へ挨拶\n------------------------------":22,"\\n<\\I[\\V[83]] \\C[6]１号>君にシンクロするパーソナルエンタメＡＩ、\nハッカドールに、お化け屋敷の探索も\nおまかせですっ！！":23,"------------------------------\nでも、乗り気でないメンバー\n２名（汗）\n------------------------------":24,"-----------------------------------\n◆サダカヤ編ではピクチャ１５番を\n　暗転用に使用。":25,"--------------------\n■ナレーション、場所移動\n（サダカヤ編）":26,"　　　　住宅街からほんの１５分ほど歩いた山の中にある空き家\\!\n　　　　いつからそこにあるのか、\\!\n　　　　誰が住んでいたのかも分からないその館には、":27,"\n　　　　　　　　　お化けが出るという噂があった。":28,"-----------------------------------------\n伽耶子邸のカバーはＩＤ固定とする。\nなお、１Ｆ部はあと２つ部屋が設定上あるので、\n念のためＩＤを空けておく(12,13,14)\nID:4 は、２Ｆ廊下用。念のため":29,"------------------------------------":30,"-------------------------------------\n経蔵と珠緒が館に入るシーン":31,"-------------------------------------\n経蔵、霊術で解錠":32,"\\n<男>おおい。\\.\\.お前、そこで何ぼさっと突っ立ってんだ。\nとりあえず出てこいよ？":33,"-------------------------------------\nひろし、経蔵に応じて出てくる":34,"\\n<男>ここは肝試しをしていいような場所じゃねえんだぞ？":35,"\\n<\\N[2]>確かにその通りだったと思います。\\.\\.\nですが、２度目は自分の意志ではなくて……":36,"\\n<男>ぁあ？？":37,"--------------------------------------\n俊雄、フワッティー、待機":38,"　　ふいに現れた男性らと事情を交換した。":39,"\\n<男>……一度とはいえ、\nよく、こんなバケモン屋敷で生き延びられたもんだな。":40,"\\n<\\N[2]>私も科学的な力の及ばない化け物への対処で\n苦慮していたところです。\n\n":41,"\\n<\\N[2]>経蔵（けいぞう）さんに\n珠緒（たまお）さん、でしたね。":42,"\\n<\\N[2]>よろしければ化け物退治のお手伝いに、\nここをご案内させて頂ければと思うのですが。":43,"\\n<\\N[2]>前回訪れた際に\n間取りはだいたい把握しておりますので。":44,"\\n<経蔵>それには及ばねえから帰れ。\\!\n……て言いたいところだが、頼もうか。\n\n":45,"\\n<経蔵>この屋敷の呪いの力で、\nまたここにお前が連れ戻されたら同じことだしな。":46,"\\n<\\N[2]>では、案内を務めさせて頂きますが。\\!\n確認ですが、本当に玄関のドアは\nあなたの力で開けることができるのですね？":47,"\\n<経蔵>ああ。さっきもそれで開けた。\\.\\.\n試しに中に入ってみろ。":48,"-------------------------------------\nひろし、再び館の中へ\nカギがかかる":49,"\\n<珠緒>かわいくないオートロックだね。\\.\\.つくづく。":50,"\\n<珠緒>でも経蔵……本当に入るつもり？\\.\\.\n下見に来たときとは……":51,"\\n<経蔵>伽椰子（かやこ）のことだろ？\\!\n俺も強い気配をさっき中から感じた。":52,"\\n<経蔵>なぜあいつがここにいるのかは知らねえが、\n結論を言えば……":53,"\\n<経蔵>俺たちもすでに伽椰子に“呪われている”\\!\nこの屋敷の呪いを通して、だろうがな。":54,"\\n<経蔵>そこで俊雄（伽椰子の息子）と、\nお友だちのバケモンが覗き見してるのが、\nなによりの証明だろう。":55,"\\n<珠緒>うん……":56,"\\n<経蔵>伽椰子がここを自分の家としているなら、\nすでに下見で足を踏み入れていた俺たちのことも\nターゲットとして殺しにかかってくるだろう。":57,"\\n<経蔵>だが幸い、周囲にも準備は済ませてある。\\!\n決着をつけるときが来たんだよ。":58,"\\n<経蔵>それも、ここを含めて３つの呪いといっぺんに、\\.\\.な……":59,"-------------------------------------":60,"(4,15)を起動":61,"EV014":62,"画像先読み用です。":63,"青位置設定":64,"イベント用フワッティー":65,"ＯＰ１号":66,"ＯＰ２号":67,"ＯＰ３号":68,"ＯＰ４号":69,"イベント用俊雄":70,"イベント用経蔵":71,"イベント用珠緒":72,"サダカヤ自動EV":73,"コモンイベント(いなくなる)より引き継ぎ":74,"----------------------------------------------\nおぶっていた珠緒がいなくなっている！\n代わりに俊雄が！\n俊雄は火の玉を消して上の階へ行った。":75,"\\n<経蔵>青鬼のやつ、思ったより芸達者だな。\n輪切りにされた頭で追ってくるとは……":76,"\\n<経蔵>よし、ここらでいいだろう。\n珠緒、降りろ。":77,"---------------------------------------------":78,"\\n<経蔵>……たしかに、逃げるのに必死で自分の背中までは\n気がまわらなかったな。\\!\nそのスキに珠緒と位置を交換……。\\.\\.\\.やるじゃねえか。":79,"\\n<経蔵>珠緒をどこへやった…\\.…\\.…\\.…\\.…\\.\\.…\\.\\.！？":80,"\n俊雄を追いかけて屋敷の２階へ向かった。":81},"extension":"json","dataType":"map","filename":"Map003","basename":"Map003.json","path":"data/Map003.json","relPath":"data/Map003.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":82,"length":82,"percent":100},"cellInfo":[[null,{"t":"HU","v":1},{"v":1}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,