カルモード新演出。\nこのアクションで、コミカル編に登場する本編の\n青鬼たちには会話が可能ということを示唆します。":10,"\\n<\\N[2]>ここにも化け物！？":11,"\\n<\\N[2]>……こちらを殺そうとする\n化け物ばかりではないようですね。\\!\n接触を試みてもいいかもしれません。":12,"---------------------------------\n鍵は自動入手\n（従来の手動入手用ページは出現させただけ）":13,"\\n<\\N[2]>屋根裏部屋の鍵を手に入れた":14,"屋根裏部屋の鍵を手に入れた":15,"\\n<\\I[\\V[86]] \\C[24]４号>そうそう。コレ持っていかないとね。":16,"青位置設定":17,"--------------------\n■デバッグモード":18,"--------------------":19,"青ルート補正":20,"ランダム青出現設定":21,"フワッティーＣ":22,"飛び鬼Ｃ":23,"\\n<\\N[2]>飛び乗って逃げることは\nできないようですね……！":24,"--------------------------------------\n飛び鬼ワープアクション":25,"\\n<\\N[2]>プロペラのないドローン……？\\!\nどんな仕組みなのでしょうか……":26,"\\n<\\N[2]>その『ドローン』でしたか！！":27,"トカゲ鬼小Ｃ":28,"\\n<\\N[2]>単眼爬虫類型ロボットでしょうか。\\!\nこの「カサカサ」という動きは苦手な方も\nおられるかもしれませんね。":29,"\\n<\\N[2]>おっと、転ぶところでした！":30,"Ｃ青転倒イベント":31,"--------------------------------------\nこのモードで不使用の\nハッカドール用変数を拝借":32},"extension":"json","dataType":"map","filename":"Map001","basename":"Map001.json","path":"data/Map001.json","relPath":"data/Map001.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":33,"length":33,"percent":100},"cellInfo":[[null,{"t":"HU","v":1},{"t":"HU","v":1}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[0,2]},"data/Map002.js