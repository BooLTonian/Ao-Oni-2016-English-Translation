---------\n■デバッグモード":15,"--------------------":16},"extension":"json","dataType":"map","filename":"Map084","basename":"Map084.json","path":"data/Map084.json","relPath":"data/Map084.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":17,"length":17,"percent":100},"cellInfo":[]},"data/Map085.json":{"data":[["EV001","","EV001"],["ケビン（ショウ）","","Kevin (Shaw)"],["DiscardPicture cloud","","DiscardPicture cloud"],["中は思ったよりきれいだな","","The inside is more beautiful than I expected."],["お化けが出るって噂があるんだ\\!\nだから近所の人は誰も近寄らない","","There's a rumor that a ghost appears.\\!\nSo no one in the neighborhood approaches."],["薄気味悪いところね……","","It's a creepy place..."],["何だよ怖いのか？\\!\nオバケが","","What is it, are you scared? \\!\nThe ghost"],["-------------------------------\n青鬼がいなくなったので、\nあたりは明るい","","-------------------------------\nSince the blue demon is gone,\nIt's bright around here"],["メグミ","","Megumi"],["リョウタ","","Ryota"],["EV005","","EV005"]],"context":[["Map085/events/1/name"],["Map085/events/2/name"],["Map085/events/2/pages/0/list/0/Plugin Command","Map085/events/2/pages/1/list/0/Plugin Command"],["Map085/events/2/pages/0/list/5/message/noPicture/middle","Map085/events/2/pages/1/list/7/message/noPicture/middle"],["Map085/events/2/pages/0/list/12/message/hasPicture/top","Map085/events/2/pages/1/list/15/message/hasPicture/top"],["Map085/events/2/pages/0/list/23/message/hasPicture/top","Map085/events/2/pages/1/list/26/message/hasPicture/top"],["Map085/events/2/pages/0/list/28/message/hasPicture/top","Map085/events/2/pages/1/list/31/message/hasPicture/top"],["Map085/events/2/pages/1/list/1/comment"],["Map085/events/3/name"],["Map085/events/4/name"],["Map085/events/5/name"]],"tags":[null,null,["red"],null,null,null,null,["blue"]],"parameters":[null,null,null,[{"headerIndex":5,"headerParam":["",0,0,1]},{"headerIndex":7,"headerParam":["",0,0,1]}],[{"headerIndex":12,"headerParam":["others",1,0,0]},{"headerIndex":15,"headerParam":["others",1,0,0]}],[{"headerIndex":23,"headerParam":["others",0,0,0]},{"headerIndex":26,"headerParam":["others",0,0,0]}],[{"headerIndex":28,"headerParam":["others",2,0,0]},{"headerIndex":31,"headerParam":["others",2,0,0]}],[{"headerIndex":1,"headerParam":["-------------------------------"]}]],"indexIds":{"EV001":0,"ケビン（ショウ）":1,"DiscardPicture cloud":2,"中は思ったよりきれいだな":3,"お化けが出るって噂があるんだ\\!\nだから近所の人は誰も近寄らない":4,"薄気味悪いところね……":5,"何だよ怖いのか？\\!\nオバケが":6,"-------------------------------\n青鬼がいなくなったので、\nあたりは明るい":7,"メグミ":8,"リョウタ":9,"EV005":10},"extension":"json","dataType":"map","filename":"Map085","basename":"Map085.json","path":"data/Map085.json","relPath":"data/Map085.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":11,"length":11,"percent":100},"cellInfo":[]},"data/Map086.json":{"data":[["４号の最期？","","The end of No. 4?"],["\\n<\\I[\\V[86]] \\C[24]４号>ゼロ姉（たぶん）の攻撃で、\n結局アタシまでやられちゃったよ……","","\\n<\\I[\\V[86]] \\C[24]４号> Zero-nee (probably) attack,\nIn the end, even I got hit..."],["\\n<\\I[\\V[86]] \\C[24]４号>ジェイルハウスをみんなが楽しめるお化け屋敷にして、\nついでにアタシもいっちょ一儲けしようと思ってたけど……","","\\n<\\I[\\V[86]] \\C[24]４号> We will turn Jail House into a haunted house that everyone can enjoy.\nAt the same time, I was also thinking of making some money..."],["\\n<\\I[\\V[86]] \\C[24]４号>くぅ〜、\\.\\.青鬼があれだけ自我を持ってたなんて！！","","\\n<\\I[\\V[86]] \\C[24]４号> Damn, \\.\\. I can't believe Blue Oni had that much ego! !"],["\\n<\\I[\\V[86]] \\C[24]４号>そうだ！　次は「青鬼＆パンツァー」というタイトルで映画を！","","\\n<\\I[\\V[86]] \\C[24]４号>Yes! Next up is a movie titled \"Ao Oni & Panzer\"!"],["\\n<\\I[\\V[86]] \\C[24]４号>青鬼め、今度こそエンタメの何たるかを……","","\\n<\\I[\\V[86]] \\C[24]４号> Blue demon, what kind of entertainment is this time..."],["\\n<\\I[\\V[86]] \\C[24]４号>もんげ～～～～～！！！！！！","","\\n<\\I[\\V[86]] \\C[24]４号>Monge～～～～～! ! ! ! ! !"],["結局落とし前をつけられた４号が\n「青鬼」の世界の樹海で発見されたのは、\n数日後のことだった……\n","","In the end, No. 4 was given the ochimae\nWhat was discovered in the sea of trees in the world of “Ao Oni” was\nThat was a few days later..."],["命は取りとめた４号だったが、\n青鬼からどんな目に遭わされたのかは、\nメモリーから抜け落ちていた……","","No. 4 survived, but\nWhat kind of things did Ao Oni put you through?\nIt was missing from memory..."],["仲間たちも、発見当時の状況を\n黙して語ることはなかったという……","","My friends also told me about the situation at the time of the discovery.\nHe said he never spoke in silence..."],["--------------------------------\nクレジット\n\n--------------------------------","","--------------------------------\ncredit\n\n--------------------------------"],["\nハッカドール編・クレジット\n\n","","\nHacka Doll Edition/Credit"],["\nシナリオ　　　　…ふうきゅう\nシナリオ監修　　…ハッカドールチーム（DeNA）","","\nScenario...fuukyu\nScenario supervision: Hacka Doll Team (DeNA)"],["\n素材制作　　　　…合同会社イクシール\n素材加工　　　　…ふうきゅう\n新規効果音　　　…効果音ラボ","","\nMaterial production…Ixeal LLC\nMaterial processing...Fukyu\nNew sound effects...Sound Effects Lab"],["寄り道をされる際は、主人公の名前を\n\\C[2]ハッカムテキ\\C[0]（無敵モード）にして\nお楽しみ下さい。","","When taking a detour, please mention the main character's name.\n\\C[2] Hackam text \\C[0] (invincible mode)\nPlease enjoy."],["----------------------","","----------------------"],["AooniAchievement prepare","","AooniAchievement prepare"],["AooniAchievement start","","AooniAchievement start"],["AooniAchievement end","","AooniAchievement end"],["ハゲ４号","","Bald size 4"],["青鬼","","Ao Oni"]],"context":[["Map086/events/1/name"],["Map086/events/1/pages/0/list/21/message/noPicture/bottom"],["Map086/events/1/pages/0/list/31/message/noPicture/bottom"],["Map086/events/1/pages/0/list/41/message/noPicture/bottom"],["Map086/events/1/pages/0/list/50/message/noPicture/top"],["Map086/events/1/pages/0/list/55/message/noPicture/top"],["Map086/events/1/pages/0/list/150/message/hasPicture/bottom"],["Map086/events/1/pages/0/list/155/message/hasPicture/middle"],["Map086/events/1/pages/0/list/160/message/hasPicture/middle"],["Map086/events/1/pages/0/list/164/message/hasPicture/middle"],["Map086/events/1/pages/0/list/169/comment"],["Map086/events/1/pag