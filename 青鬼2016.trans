"blue"],null,["blue"],null,null,null,null,["blue"],["blue"],null,null,null,null,["blue"],null,null,null,null,["blue"],["blue"],null,["blue"],["blue"]],"parameters":[null,[{"headerIndex":2,"headerParam":["-----------------------------"]}],null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}],null,[{"headerIndex":0,"headerParam":["-------------------------------------"]}],[{"headerIndex":9,"headerParam":["------------------------------------"]}],[{"headerIndex":13,"headerParam":["",0,0,0]}],[{"headerIndex":21,"headerParam":["N2",3,0,0]}],[{"headerIndex":23,"headerParam":["N2",1,0,0]}],[{"headerIndex":27,"headerParam":["spiritualists",2,0,0]}],[{"headerIndex":30,"headerParam":["N2",3,0,0]}],[{"headerIndex":43,"headerParam":["N2",0,0,0]}],[{"headerIndex":61,"headerParam":["N2",0,0,0]}],[{"headerIndex":77,"headerParam":["N2",0,0,0]}],[{"headerIndex":81,"headerParam":["N2",0,0,0]}],[{"headerIndex":85,"headerParam":["N2",0,0,2]}],null,null,null,[{"headerIndex":33,"headerParam":["-----------------------------------"]}],null,null,null,null,[{"headerIndex":0,"headerParam":["N2",0,0,0]}],null,null,[{"headerIndex":46,"headerParam":["N2",0,0,0]}],[{"headerIndex":58,"headerParam":["-------------------------------------------"]}],[{"headerIndex":61,"headerParam":["N2",0,0,0]}],[{"headerIndex":2,"headerParam":["------------------------------------"]},{"headerIndex":2,"headerParam":["------------------------------------"]}],[{"headerIndex":7,"headerParam":["",0,1,0]},{"headerIndex":13,"headerParam":["",0,1,0]}],[{"headerIndex":0,"headerParam":["",0,2,0]}],null,null,[{"headerIndex":4,"headerParam":["ふとんを調べるとイベント開始"]}],[{"headerIndex":24,"headerParam":["----------------------------------------"]}],[{"headerIndex":37,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":43,"headerParam":["N2",0,0,0]}],[{"headerIndex":47,"headerParam":["N2",0,0,0]}],[{"headerIndex":59,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":66,"headerParam":["-------------------------------------------"]}],[{"headerIndex":87,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":97,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":102,"headerParam":["N2",0,0,0]}],[{"headerIndex":111,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":117,"headerParam":["----------------------------------------"]}],[{"headerIndex":208,"headerParam":["-----------------------------------------"]}],[{"headerIndex":236,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":254,"headerParam":["-----------------------------------------------"]}],[{"headerIndex":313,"headerParam":["--------------------------------"]},{"headerIndex":429,"headerParam":["--------------------------------"]}],[{"headerIndex":338,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":343,"headerParam":["N2",0,0,0]}],[{"headerIndex":354,"headerParam":["spiritualists",0,0,0]}],[{"headerIndex":364,"headerParam":["spiritualists",1,0,0]}],[{"headerIndex":375,"headerParam":["N2",0,0,0]}],[{"headerIndex":396,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":405,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,1,0]}]],"indexIds":{"EV001":0,"-----------------------------\nOPのみ暗転待機":1,"青":2,"青位置設定":3,"--------------------\n■デバッグモード":4,"--------------------":5,"自動イベント":6,"-------------------------------------\n●画像の準備":7,"------------------------------------\n●ＯＰイベント":8,"　……\\N[2]、\\!\n　……\\N[2]！！":9,"\\n<卓郎>いつまで寝てんだよ。":10,"\\n<美香>こんなお化け屋敷みたいなところで、\nよく熟睡できるわね。\\!\n心臓に鉄の毛でも生えてるの？":11,"\\n<たけし>脳味噌野郎に加えて、\n“スチールウールハート野郎”\\.\\.って、呼んでやろうか？":12,"\\n<卓郎>ははっ。台所でないところも\nピカピカにできそうだな。":13,"\\n<\\N[2]>心配かけましたね。\nそろそろ帰りましょうか。":14,"\\n<\\N[2]>夢……\\.\\.でしたか。":15,"\\n<\\N[2]>私は自分の部屋で眠りについたはずですが、\nここはあの屋敷の一室……。":16,"\\n<\\N[2]>万一、夢でないとするならば……。":17,"\\n<\\N[2]>\\C[1]１階への階段を降りて、\n降りた先の玄関（↓）から表に出る\\C[0]としましょう。\\!\n……出られるといいですが。":18,"DiscardCharacter !$ao_takurou":19,"DiscardCharacter !$ao_mika":20,"DiscardCharacter !$ao_takesi":21,"-----------------------------------":22,"OP卓郎":23,"OP美香":24,"ひろしのベッド":25,"ひろし寝る？":26,"\\n<\\N[2]>もう１度目を閉じれば、\n自分の部屋で目覚めるでしょうか……？":27,"玄関に向かう":28,"２度寝してみる":29,"\\n<\\N[2]>………………………………。":30,"-------------------------------------------\nセルフスイッチＡがオンになるのは\n無敵時のみ":31,"\\n<\\N[2]>いや、いま眠るのは、\n得策ではないかもしれません……。":32,"------------------------------------\nメモを持っているときは何も起こらない":33,"\nマットレスと敷きぶとんの間からメモが見つかった。":34,"\\^":35,"ふとんを持っていく":36,"一呼吸おく":37,"ふとんを調べるとイベント開始":38,"----------------------------------------":39,"\\n<珠緒>ちょっと。\nさっきまであんたが寝てたっぽいやつを使う気？\n気配が残ってるからすぐわかるよ。":40,"\\n<\\N[2]>ほかの部屋のものはどういうわけか、\nベッドに固定されたマットレスしかなくて。":41,"\\n<\\N[2]>すみませんが、脱出に有利な和室に\n持って下ろせそうなものはこれしか……":42,"\\n<経蔵>はい。\\.\\.この状況をわきまえない\nワガママな悪～\\.\\.い子には、\\!こわ～\\.\\.い鬼が……":43,"-------------------------------------------\n青鬼が部屋に入ってくる。":44,"\\n<珠緒>経蔵がそんな話するから！！":45,"\\n<経蔵>どこで空気読んでやがったんだよ……":46,"\\n<\\N[2]>やはり、その気になれば一瞬で近くに\n来れるということですか……！":47,"\\n<経蔵>（サシじゃ貞子や伽椰子同様、勝ち目はねえ……。\\!\nどうする……！？）":48,"----------------------------------------\n部屋のテレビから貞子が現れる。":49,"-----------------------------------------\n貞子は青鬼に迫るも、あっさり青鬼に一飲みにされる。":50,"\\n<経蔵>貞子をひと飲みだと！？":51,"-----------------------------------------------\n青鬼の顔上半分が落ち、残った下半分側から貞子が。\nそのスキに一行は逃走":52,"--------------------------------":53,"\\n<経蔵>…………！！！！":54,"\\n<\\N[2]>経蔵さん！！":55,"\\n<経蔵>おっと、こういうときこそ逃げ時だったな！\n珠緒、背中にこい！":56,"\\n<珠緒>やむを得ないね！？":57,"\\n<\\N[2]>ここに青鬼がいるなら、\\C[1]玄関から！":58,"\\n<経蔵>\\C[1]出られるな！！":59,"\\n<経蔵>\\あばよ！！":60,"\nメモを手に入れた。":61,"イベント伽椰子":62,"経蔵":63,"珠緒":64,"イベント青":65,"青の頭":66,"貞子の出るテレビ":67,"貞子":68,"ラスト消灯":69},"extension":"json","dataType":"map","filename":"Map108","basename":"Map108.json","path":"data/Map108.json","relPath":"data/Map108.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":70,"length":70,"percent":100},"cellInfo":[]},"data/Map109.json":{"data":[["EV001","","EV001"],["SuspendEvent 6","","SuspendEvent 6"],["\n開かない。","","\nIt won't open."],["ResumeEvent 6","","ResumeEvent 6"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["伽椰子の出る暖炉・動作","","Fireplace with Kaya palm tree/motion"],["--------------------------------------\n起動させない条件","","--------------------------------------\nConditions for not starting"],["---------------\n伽椰子が心変わりするフラグが立つと\n起動しない。","","---------------\nWhen the flag goes up that Kayako will change her mind.\nDoes not start."],["---------------\nひろしがいないときも起動しない。","","---------------\nIt won't start even when Hiroshi isn't there."],["--------------------------------------","","--------------------------------------"],["\\n<経蔵>……いま、伽椰子を追い払った。\\!\n暖炉の中に隠れてスキをうかがっていたみたいだ。\\!\nしばらくはここに寄りつかないだろう。","","\\n<経蔵>...I just chased Kayako away. \\!\nIt looks like he was hiding in the fireplace, just waiting to see if he liked it. \\!\nI won't be coming here for a while."],["\\n<経蔵>……\\N[2]、\\.\\.\n\\C[2]お前ひとりで来ていたら襲われていた\\C[0]かもな。","","\\n<経蔵>……\\N[2], \\.\\.\n\\C[2]If you had come alone, you might have been attacked.\\C[0]."],["\\n<\\N[2]>彼女はなぜ退いたのでしょう？\\.\\.\n襲えばこちらを全員仕留められるほど強い\nとのことですが……","","\\n<\\N[2]>Why did she leave? \\.\\.\nIt's strong enough to take down all of us if we attack.\nThat being said..."],["\\n<経蔵>バケモンは猛獣と同じところがある。\n機先を制すれば、\nサシでは勝てない相手でも退かせることは、","","\\n<経蔵>Bemon is similar to beasts.\nIf you take the lead,\nEven if you can't defeat an opponent with a sashi, you can defeat them."],["\\n<経蔵>……できるときもある。","","\\n<経蔵>...Sometimes it's possible."],["\\n<経蔵>向こうが本気を出す前が、勝負なんだ。","","\\n<経蔵>The battle is before the other side gets serious."],["そう語った経蔵さんの額には、\nうっすらと汗がにじんでいた。","","On the forehead of Mr. Keizo who said this,\nHe was covered in sweat."],["----------------------------------------\nひろし一人のとき","","----------------------------------------\nWhen Hiroshi is alone"],["-----------------------------------------\n●追跡開始処理\n　スイッチで伽椰子を動かすページへ。","","-----------------------------------------\n●Tracking start process\nGo to the page where you can move Kayako with a switch."],["----------------------------------------","","----------------------------------------"],["テーブルをすり抜ける処理","","Process of passing through a table"],["イベント伽椰子制御","","Event Kayako control"],["StandTo 7 6 -1","","StandTo 7 6 -1"],["-----------------------------------","","-----------------------------------"],["襲撃伽椰子","","Attack Kayako"],["割り込み貞子","","Sadako interrupts"],["ラスト消灯","","Last lights out"]],"context":[["Map109/events/1/name"],["Map109/events/1/pages/0/list/1/Plugin Command"],["Map109/events/1/pages/0/list/3/message/hasPicture/top"],["Map109/events/1/pages/0/list/6/Plugin Command"],["Map109/events/2/name"],["Map109/events/3/name"],["Map109/events/3/pages/0/list/0/comment"],["Map109/events/3/pages/0/list/7/comment"],["Map109/events/4/name"],["Map109/events/4/pages/0/list/0/comment"],["Map109/events/4/pages/0/list/7/comment","Map109/events/4/pages/0/list/14/comment"],["Map109/events/4/pages/0/list/27/comment"],["Map109/events/4/pages/0/list/32/comment"],["Map109/events/4/pages/0/list/43/message/hasPicture/bottom"],["Map109/events/4/pages/0/list/47/message/hasPicture/bottom"],["Map109/events/4/pages/0/list/50/message/hasPicture/bottom"],["Map109/events/4/pages/0/list/54/message/hasPicture/bottom"],["Map109/events/4/pages/0/list/58/message/hasPicture/bottom"],["Map109/events/4/pages/0/list/63/message/hasPicture/bottom"],["Map109/events/4/pages/0/list/65/message/hasPicture/bottom"],["Map109/events/4/pages/0/list/75/comment"],["Map109/events/4/pages/0/list/120/comment"],["Map109/events/4/pages/1/list/12/comment","Map109/events/4/pages/1/list/53/comment","Map109/events/4/pages/1/list/66/comment","Map109/events/4/pages/1/list/105/comment","Map109/events/4/pages/1/list/113/comment"],["Map109/events/4/pages/1/list/14/comment","Map109/events/4/pages/1/list/68/comment","Map109/events/4/pages/1/list/115/comment"],["Map109/events/5/name"],["Map109/events/5/pages/1/list/4/Plugin Command"],["Map109/events/5/pages/1/list/19/comment"],["Map109/events/6/name"],["Map109/events/7/name"],["Map109/events/8/name"]],"tags":[null,["red"],null,["red"],null,null,["blue"],["blue"],null,["blue"],["blue"],["blue"],["blue"],null,null,null,null,null,null,null,["blue"],["blue"],["blue"],["blue"],null,["red"],["blue"]],"parameters":[null,null,[{"headerIndex":3,"headerParam":["N2",0,1,0]}],null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}],null,[{"headerIndex":0,"headerParam":["--------------------------------------"]}],[{"headerIndex":7,"headerParam":["---------------"]},{"headerIndex":14,"headerParam":["---------------"]}],[{"headerIndex":27,"headerParam":["---------------"]}],[{"headerIndex":32,"headerParam":["--------------------------------------"]}],[{"headerIndex":43,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":47,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":50,"headerParam":["N2",0,0,2]}],[{"headerIndex":54,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":58,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":63,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":65,"headerParam":["N2",0,1,2]}],[{"headerIndex":75,"headerParam":["----------------------------------------"]}],[{"headerIndex":120,"headerParam":["-----------------------------------------"]}],[{"headerIndex":12,"headerParam":["----------------------------------------"]},{"headerIndex":53,"headerParam":["----------------------------------------"]},{"headerIndex":66,"headerParam":["----------------------------------------"]},{"headerIndex":105,"headerParam":["----------------------------------------"]},{"headerIndex":113,"headerParam":["----------------------------------------"]}],[{"headerIndex":14,"headerParam":["テーブルをすり抜ける処理"]},{"headerIndex":68,"headerParam":["テーブルをすり抜ける処理"]},{"headerIndex":115,"headerParam":["テーブルをすり抜ける処理"]}],null,null,[{"headerIndex":19,"headerParam":["-----------------------------------"]}]],"indexIds":{"EV001":0,"SuspendEvent 6":1,"\n開かない。":2,"ResumeEvent 6":3,"青":4,"青位置設定":5,"--------------------\n■デバッグモード":6,"--------------------":7,"伽椰子の出る暖炉・動作":8,"--------------------------------------\n起動させない条件":9,"---------------\n伽椰子が心変わりするフラグが立つと\n起動しない。":10,"---------------\nひろしがいないときも起動しない。":11,"--------------------------------------":12,"\\n<経蔵>……いま、伽椰子を追い払った。\\!\n暖炉の中に隠れてスキをうかがっていたみたいだ。\\!\nしばらくはここに寄りつかないだろう。":13,"\\n<経蔵>……\\N[2]、\\.\\.\n\\C[2]お前ひとりで来ていたら襲われていた\\C[0]かもな。":14,"\\n<\\N[2]>彼女はなぜ退いたのでしょう？\\.\\.\n襲えばこちらを全員仕留められるほど強い\nとのことですが……":15,"\\n<経蔵>バケモンは猛獣と同じところがある。\n機先を制すれば、\nサシでは勝てない相手でも退かせることは、":16,"\\n<経蔵>……できるときもある。":17,"\\n<経蔵>向こうが本気を出す前が、勝負なんだ。":18,"そう語った経蔵さんの額には、\nうっすらと汗がにじんでいた。":19,"----------------------------------------\nひろし一人のとき":20,"-----------------------------------------\n●追跡開始処理\n　スイッチで伽椰子を動かすページへ。":21,"----------------------------------------":22,"テーブルをすり抜ける処理":23,"イベント伽椰子制御":24,"StandTo 7 6 -1":25,"-----------------------------------":26,"襲撃伽椰子":27,"割り込み貞子":28,"ラスト消灯":29},"extension":"json","dataType":"map","filename":"Map109","basename":"Map109.json","path":"data/Map109.json","relPath":"data/Map109.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":30,"length":30,"percent":100},"cellInfo":[]},"data/Map110.json":{"data":[["EV001","","EV001"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["美香の魂","","Mika's soul"],["\\n<経蔵>……お前、\\.\\.こんな所にいつまでもいないで、\n街に出てイケメンの浮遊霊とでもつきあえよ。\\!\nかわいい顔してんだからさ？","","\\n<経蔵>...You, \\.\\., don't stay in a place like this forever.\nGo out into town and meet some handsome floating spirits. \\!\nIs it because you have a cute face?"],["\\n<\\N[2]>何かそこにいるのですか……？","","\\n<\\N[2]> Is there something there...?"],["\\n<珠緒>この屋敷の化け物の犠牲者みたい。","","\\n<珠緒>I feel like I'm a victim of this mansion's monster."],["\\n<経蔵>ここで犠牲になった人間だ。\n\\N[2]、お前の友達だ、って言ってるぞ。","","\\n<経蔵> This is the human sacrifice.\n\\N[2], I'm your friend."],["そう聞いて、この部屋で青い化け物に襲われた、\n友人の美香さんの顔が思い浮かんだ。","","After hearing that, I was attacked by a blue monster in this room.\nThe face of my friend Mika came to mind."],["\\n<経蔵>……そうか。出て行っても、\nふいに屋敷に引き戻されるのか。\\.\\.魂だけになっても……。\\!\n困った呪いだな。","","\\n<経蔵>...I see. Even if I leave,\nWill he be suddenly drawn back to the mansion? \\.\\.Even if it's just the soul... \\!\nIt's a troublesome curse."],["\\n<経蔵>お前の彼氏の親父に頼まれて、\nここへ化け物退治に来てる。しばらく待ってろ。\\!\n首尾よくいったら、成仏の手配をしてやる。","","\\n<経蔵> Your boyfriend's father asked you to\nI'm here to exterminate monsters. Wait a while. \\!\nIf all goes well, I will make arrangements for you to become a Buddha."],["\\n<経蔵>難しそうな顔してんじゃねえよ。\\!\nもし、ほかの犠牲者の霊をみかけたら、\n声をかけておいてくれ。まとめて面倒みてやる。","","\\n<経蔵> Don't look so difficult. \\!\nIf you see the spirits of other victims,\nPlease give me a call. I'll take care of everything."],["\\n<珠緒>それまでに、もう１度死なないようにね？\\!\nこの屋敷の呪い、魂までも狙おうとしてるようだから。","","\\n<珠緒> Don't die again before then, okay? \\!\nIt seems like the curse on this mansion is trying to even target its soul."],["\\n<\\N[2]>（会話の内容をあとで理解したいですね……）","","\\n<\\N[2]> (I would like to understand the content of the conversation later...)"],["経蔵さんの話ぶりから、ここには亡くなった\n美香さんがいると信じることにした。","","From the way Mr. Keizo talks, there are many people who died here.\nI decided to believe that Mika was there."],["つい先日、この屋敷で実際に化け物に襲われるまでは、\n化け物や幽霊の存在を信じていなかった自分が、\n今では酸素や二酸化炭素の存在を信じるように、\n","","Until recently, when I was actually attacked by a monster in this mansion,\nI didn't believe in the existence of monsters and ghosts,\nJust as we now believe in the existence of oxygen and carbon dioxide,"],["その存在を意識している。\\!\n我ながら不思議に思う。","","aware of its existence. \\!\nI find it strange."],["----------  ひろし1人のとき  ----------------","","---------- When Hiroshi is alone ----------------"],["\\n<\\N[2]>ここで本当に美香さんは\nあの青い化け物に殺されたのでしょうか。\\!\n血の跡すらないとは……。","","\\n<\\N[2]> Mika is really here.\nWas he killed by that blue monster? \\!\nThere's not even a trace of blood..."],["\\n<\\N[2]>いまだに実感が……\\.\\.わきませんね……。","","\\n<\\N[2]> I still feel it... \\.\\. I don't understand..."],["---------------------------------\n俊雄が２階に上がって以降、\n卓郎らと避難した扱い","","---------------------------------\nAfter Toshio went up to the second floor,\nTreated as evacuated with Takuro and others"],["ラスト消灯","","Last lights out"]],"context":[["Map110/events/1/name"],["Map110/events/2/name"],["Map110/events/3/name"],["Map110/events/3/pages/0/list/0/comment"],["Map110/events/3/pages/0/list/7/comment"],["Map110/events/4/name"],["Map110/events/4/pages/0/list/5/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/14/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/17/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/21/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/26/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/32/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/36/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/42/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/47/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/53/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/61/message/hasPicture/bottom","Map110/events/4/pages/0/list/93/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/64/message/hasPicture/bottom","Map110/events/4/pages/0/list/96/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/69/message/hasPicture/bottom","Map110/events/4/pages/0/list/101/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/76/comment"],["Map110/events/4/pages/0/list/79/message/hasPicture/bottom"],["Map110/events/4/pages/0/list/85/message/hasPicture/bottom"],["Map110/events/4/pages/1/list/0/comment"],["Map110/events/5/name"]],"tags":[null,null,null,["blue"],["blue"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["blue"],null,null,["blue"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["--------------------"]}],[{"headerIndex":7,"headerParam":["--------------------"]}],null,[{"headerIndex":5,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":14,"headerParam":["N2",0,0,2]}],[{"headerIndex":17,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":21,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":26,"headerParam":["N2",0,1,2]}],[{"headerIndex":32,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":36,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":42,"headerParam":["spiritualists",0,0,2]}],[{"headerIndex":47,"headerParam":["spiritualists",1,0,2]}],[{"headerIndex":53,"headerParam":["N2",0,0,2]}],[{"headerIndex":61,"headerParam":["N2",0,1,2]},{"headerIndex":93,"headerParam":["N2",0,1,2]}],[{"headerIndex":64,"headerParam":["N2",0,1,2]},{"headerIndex":96,"headerParam":["N2",0,1,2]}],[{"headerIndex":69,"headerParam":["N2",0,1,2]},{"headerIndex":101,"headerParam":["N2",0,1,2]}],[{"headerIndex":76,"headerParam":["----------  ひろし1人のとき  ----------------"]}],[{"headerIndex":79,"headerParam":["N2",0,0,2]}],[{"headerIndex":85,"headerParam":["N2",0,0,2]}],[{"headerIndex":0,"headerParam":["---------------------------------"]}]],"indexIds":{"EV001":0,"青":1,"青位置設定":2,"--------------------\n■デバッグモード":3,"--------------------":4,"美香の魂":5,"\\n<経蔵>……お前、\\.\\.こんな所にいつまでもいないで、\n街に出てイケメンの浮遊霊とでもつきあえよ。\\!\nかわいい顔してんだからさ？":6,"\\n<\\N[2]>何かそこにいるのですか……？":7,"\\n<珠緒>この屋敷の化け物の犠牲者みたい。":8,"\\n<経蔵>ここで犠牲になった人間だ。\n\\N[2]、お前の友達だ、って言ってるぞ。":9,"そう聞いて、この部屋で青い化け物に襲われた、\n友人の美香さんの顔が思い浮かんだ。":10,"\\n<経蔵>……そうか。出て行っても、\nふいに屋敷に引き戻されるのか。\\.\\.魂だけになっても……。\\!\n困った呪いだな。":11,"\\n<経蔵>お前の彼氏の親父に頼まれて、\nここへ化け物退治に来てる。しばらく待ってろ。\\!\n首尾よくいったら、成仏の手配をしてやる。":12,"\\n<経蔵>難しそうな顔してんじゃねえよ。\\!\nもし、ほかの犠牲者の霊をみかけたら、\n声をかけておいてくれ。まとめて面倒みてやる。":13,"\\n<珠緒>それまでに、もう１度死なないようにね？\\!\nこの屋敷の呪い、魂までも狙おうとしてるようだから。":14,"\\n<\\N[2]>（会話の内容をあとで理解したいですね……）":15,"経蔵さんの話ぶりから、ここには亡くなった\n美香さんがいると信じることにした。":16,"つい先日、この屋敷で実際に化け物に襲われるまでは、\n化け物や幽霊の存在を信じていなかった自分が、\n今では酸素や二酸化炭素の存在を信じるように、\n":17,"その存在を意識している。\\!\n我ながら不思議に思う。":18,"----------  ひろし1人のとき  ----------------":19,"\\n<\\N[2]>ここで本当に美香さんは\nあの青い化け物に殺されたのでしょうか。\\!\n血の跡すらないとは……。":20,"\\n<\\N[2]>いまだに実感が……\\.\\.わきませんね……。":21,"---------------------------------\n俊雄が２階に上がって以降、\n卓郎らと避難した扱い":22,"ラスト消灯":23},"extension":"json","dataType":"map","filename":"Map110","basename":"Map110.json","path":"data/Map110.json","relPath":"data/Map110.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":24,"length":24,"percent":100},"cellInfo":[]},"data/Map111.json":{"data":[["EV001","","EV001"],["納戸のドア","","closet door"],["EV003","","EV003"],["-------------------------------------------","","-------------------------------------------"],["InputConfuse def","","InputConfuse def"],["\n開かない。","","\nIt won't open."],["---------------------------------","","---------------------------------"],["リビングのドア","","living room door"],["EV005","","EV005"],["EV006","","EV006"],["-----------------------------------------","","-----------------------------------------"],["EV007","","EV007"],["EV008","","EV008"],["\\n<経蔵>……もう少し、ここを調べるか。","","\\n<経蔵>...Let's investigate this a little more."],["-------------------------------------","","-------------------------------------"],["InputConfuse def ","","InputConfuse def "],["AooniKayakoHouseProcess preload","","AooniKayakoHouseProcess preload"],["DiscardTilesets 6","","DiscardTilesets 6"],["EV009","","EV009"],["１Ｆ自動ＥＶ","","1F automatic EV"],["\\n<珠緒>経蔵、\\N[2]の気配がする！","","\\n<珠緒>Kyozo, I feel like \\N[2]!"],["\\n<経蔵>あれは……\\.\\.\\C[1]和室の方\\C[0]だな。よし！","","\\n<経蔵> That's... \\.\\.\\C[1] It's \\C[0] from the Japanese-style room. Okay!"],["\\n<珠緒>あと……かすかだけど、伽椰子の気配がする。\\!\nいつもより殺気がないような……。","","\\n<珠緒>Also...it's faint, but I can feel the presence of Kaya Coconut. \\!\nHe seems less murderous than usual..."],["\\n<経蔵>青鬼や貞子と戦ってスキでもできたか。\\!\nなら、\\N[2]を連れ出しやすい。\\.\\.今のうちだな。","","\\n<経蔵> Were you able to fight Ao Oni and Sadako? \\!\nIn that case, it would be easy to take out \\N[2]. \\.\\. It's time now."],["\\n<経蔵>（あるいは……）","","\\n<経蔵> (or...)"],["物置カバー開く","","open storage cover"],["AooniKayakoHouseProcess hide 7","","AooniKayakoHouseProcess hide 7"],["物置カバー閉じる","","storeroom cover close"],["AooniKayakoHouseProcess appear 7","","AooniKayakoHouseProcess appear 7"],["リビングカバー開く","","open living room cover"],["AooniKayakoHouseProcess hide 5","","AooniKayakoHouseProcess hide 5"],["\\n<経蔵>俊雄の友達か！！","","\\n<経蔵> Are you Toshio's friend? !"],["\\n<経蔵>……とりあえず、向こうから襲ってくる\n様子はなさそうだな。","","\\n<経蔵>...For now, it will attack from the other side.\nIt doesn't seem to be going well."],["リビングカバー閉じる","","living cover close"],["AooniKayakoHouseProcess appear 5","","AooniKayakoHouseProcess appear 5"],["ダイニングカバー開く","","open dining cover"],["AooniKayakoHouseProcess hide 6","","AooniKayakoHouseProcess hide 6"],["ダイニングカバー閉じる","","dining cover close"],["---------------------------------\n部屋から出ると伽椰子がついてくる","","---------------------------------\nWhen you leave the room, Kayako will follow you."],["AooniKayakoHouseProcess appear 6","","AooniKayakoHouseProcess appear 6"],["浴室カバー開く・伽椰子","","Open bathroom cover/Kayako"],["AooniKayakoHouseProcess hide 8","","AooniKayakoHouseProcess hide 8"],["AooniKayakoHouseProcess appear 9","","AooniKayakoHouseProcess appear 9"],["\\n<経蔵>伽椰子か。\\!\nこうして対面するのは初めてだな。","","\\n<経蔵> Kayako? \\!\nThis is the first time we've met like this."],["\\n<経蔵>……珠緒はどこだ。\\!\n俊雄が連れ去ったんだから、\n親のお前なら知っているはずだ。","","\\n<経蔵>...Where is Tamao? \\!\nBecause Toshio took her away,\nAs a parent, you should know."],["\\n<経蔵>伽椰子か。\\!\nこうして対面するのは初めてだな。\\!\n……たったいまの思いつきだが、取引がある。","","\\n<経蔵> Kayako? \\!\nThis is the first time we've met like this. \\!\n...This just occurred to me, but I have a deal to make."],["\\n<経蔵>珠緒がまだ生きているなら、返してくれ。\\!\n無事に返してくれたら、俺の法術でお前らの身体のケガを\n治してやる。","","\\n<経蔵> If Tamao is still alive, please give me back. \\!\nIf you return me safely, I will use my magic to heal your physical injuries.\nI'll heal you."],["\\n<経蔵>正確には、霊的な手術で\n『まだケガをしているという思い込み』を除去する、\nといったところだ。","","\\n<経蔵> To be precise, spiritual surgery\nEliminate the ``belief that you are still injured''\nThat's about it."],["\\n<経蔵>もう生身の身体のケガじゃねえから、\nケガをしたときの思い出の生々しさを取り除けば、\n少しは楽に過ごせるはずだ。","","\\n<経蔵> It's no longer a physical injury,\nIf you remove the vivid memories of your injury,\nIt should be a little easier."],["\\n<経蔵>そうそう、レンジでやられたときのそいつのケガを\n手始めに治しておいた。","","\\n<経蔵> That's right, the injury he got when he got hit in the microwave.\nI fixed it first."],["\\n<経蔵>（ケガの苦しみがなくなれば、呪う気も少しは失せて、\nやりやすくなるかもしれない）","","\\n<経蔵> (Once the pain of my injury is gone, I'll lose some of my desire to curse,\nIt might be easier to do)"],["\\n<経蔵>（間に合っていれば珠緒も助かるかも……）","","\\n<経蔵> (If you arrive in time, Tamao might be saved too...)"],["\\n<経蔵>こっちもさんざんお前らを敵視しておいて何だが、\n悪い話じゃねえはずだ。\\!\nどうだ、\\.\\.乗ってみる気は……","","\\n<経蔵> Why are so many of you treated as enemies?\nIt shouldn't be a bad story. \\!\nWhat do you think, \\.\\., do you want to ride it..."],["-----------------------------------\n洗濯機開いていないとき、\n伽椰子が開ける","","-----------------------------------\nWhen the washing machine is not open,\nKaya palm opens"],["AooniKayakoHouseProcess appear 8","","AooniKayakoHouseProcess appear 8"],["---------------------------------------------","","---------------------------------------------"],["\\n<\\N[2]>珠緒さんの行方についてですが……。\\!\n勘でしかありませんが、\nいまの彼女の行動から考えて、もしかすると……","","\\n<\\N[2]> Regarding Tamao-san's whereabouts... \\!\nIt's just a hunch, but\nConsidering her current behavior, maybe..."],["\\n<経蔵>なるほど。脱出経験者のカンは違うな。","","\\n<経蔵> I see. It's different for someone with experience in escape."],["\\n<経蔵>さっそく、\\C[1]青鬼の屋敷の方に戻って\\C[0]探してみるか。","","\\n<経蔵>Let's go back to \\C[1] Ao Oni's mansion and look for \\C[0]."],["浴室カバー閉じる","","bathroom cover close"],["AooniKayakoHouseProcess hide 9","","AooniKayakoHouseProcess hide 9"],["脱衣場カバー開く","","Open the changing room cover"],["---------------------------------\nお化けをここで追い払う","","---------------------------------\nchase away the ghosts here"],["\\n<\\N[2]>ふり向くと、いなくなる。\\!\n化け物たちは子供の遊びが趣味なのでしょうか。\nええと……","","\\n<\\N[2]>When I turn around, it's gone. \\!\nDo monsters like playing with children?\nyou know……"],["\\n<\\N[2]>『だるまさんがころんだ』","","\\n<\\N[2]> “Daruma-san has fallen”"],["\\n<経蔵>ふっ。真顔で言うか。\\!\n……バケモン屋敷でお前が生き延びた理由が分かったぜ。","","\\n<経蔵> Huh. Do you say it with a straight face? \\!\n...I now know why you survived in the monster mansion."],["\\n<\\N[2]>…………？","","\\n<\\N[2]>…………?"],["脱衣場カバー閉じる","","Close dressing room cover"],["---------------------------------\n貞子がついてくる処理","","---------------------------------\nProcessing that Sadako follows"],["OuterSelfSwitch on 52 B","","OuterSelfSwitch on 52 B"],["OuterSelfSwitch off 52 B","","OuterSelfSwitch off 52 B"],["トイレカバー開く","","open toilet cover"],["AooniKayakoHouseProcess hide 10 1","","AooniKayakoHouseProcess hide 10 1"],["AooniKayakoHouseProcess appear 11","","AooniKayakoHouseProcess appear 11"],["トイレカバー閉じる","","toilet cover close"],["AooniKayakoHouseProcess appear 10","","AooniKayakoHouseProcess appear 10"],["AooniKayakoHouseProcess hide 11","","AooniKayakoHouseProcess hide 11"],["洗面室カバー開く・ほか","","Washroom cover open/etc."],["--------------------------------------------\n俊雄に続き、伽椰子を治療する","","--------------------------------------------\nFollowing Toshio, treat Kayako."],["\\n<経蔵>お色直しか。\\!もっと“治して”やるぜ？","","\\n<経蔵> Should I change my clothes? \\! Let's do more \"healing\"?"],["\\n<経蔵>術が効いていれば、見た目のケガはもう、\n単なる特殊メイクになっているはずだ。\\!\nいつでも落とせばいい。\\.\\.自分の意志でな。","","If the \\n<経蔵> technique is effective, there will be no apparent injury.\nIt should just be special makeup. \\!\nYou can drop it anytime. \\.\\. Of my own free will."],["\\n<経蔵>成仏に応じるなら早めにしてくれ。\\!\n……でないと、ほかのバケモンどもごと、お前らを\nある方法で封印しないといけなくなる。","","\\n<経蔵>If you want to accept Buddhahood, please do so as soon as possible. \\!\n...If not, I'll kill you and all the other monsters.\nIt has to be sealed in a certain way."],["\\n<経蔵>なんだ俊雄。さっき治してやった傷口が\n開きかけてるじゃねえか。","","\\n<経蔵> What is it, Toshio? The wound I just healed\nIt's about to open, isn't it?"],["\\n<珠緒>……俊雄を傷つけたのは、貞子でも青鬼でもないね。\\!\nあんたたちの内側からくる『何か』……。\\!\nあんたたち自身が別の呪いに侵されているみたいな……。","","\\n<珠緒>...It wasn't Sadako or Aooni who hurt Toshio. \\!\n\"Something\" that comes from within you... \\!\nIt seems like you guys are affected by another curse..."],["\\n<経蔵>お前らが誰かを呪うように、\nお前らも『何か』に呪われてるのかもな。","","\\n<経蔵> As if you were cursing someone,\nMaybe you are also cursed by something."],["\\n<経蔵>自分をえぐろうとする感覚に襲われたら、\n全力で「はねつけろ」　\\!……いいな？","","\\n<経蔵>When you feel like someone is trying to dig you out,\n\"Knock it off\" with all your might \\!... Okay?"],["\\n<珠緒>……いつもの気配の伽椰子と俊雄じゃなかった。","","\\n<珠緒>... Kayako and Toshio weren't the usual presence."],["\\n<経蔵>このまま“癒やすが勝ち”で\n押し切れるといいけどな……。\\!\nまとめて成仏に応じてくれれば御の字なんだが。","","\\n<経蔵> As it is, “healing is the victory”\nI hope I can push through... \\!\nIt would be a blessing if all of us agreed to attain Buddhahood."],["\\n<珠緒>たくさんの人を呪い殺しておきながら\n成仏だなんて……","","\\n<珠緒>While cursing and killing many people\nI can't believe I've reached Buddhahood..."],["\\n<経蔵>まあな。\\.\\.凶悪犯でもケガをしていたら、\n逮捕の前後にさしずめ治療ぐらいは施すようなものだ。","","\\n<経蔵> Well. \\.\\.If the thug was injured,\nIt's like giving them some medical treatment before and after their arrest."],["\\n<経蔵>３大バケモンの１人をなんとかできるなら、\nそれだけでめっけもんだ。","","\\n<経蔵>If you can manage one of the three big monsters,\nThat alone is amazing."],["\\n<経蔵>成仏させたあとは俺たちが力を借りている\n仏さんたちに沙汰を任せよう。","","\\n<経蔵>After you achieve Buddhahood, we are borrowing your power.\nLet's leave things to the Buddhas."],["----------------------------------------","","----------------------------------------"],["洗面室カバー閉じる","","washroom cover close"],["貞子","","Sadako"],["伽椰子","","Kayako"],["俊雄","","Toshio"],["イベント珠緒","","Event Tamao"],["青","","blue"],["青位置設定","","blue position setting"],["--------------------\n■デバッグモード","","--------------------\n■Debug mode"],["--------------------","","--------------------"],["洗濯機仕掛け","","washing machine mechanism"],["------------------------------\nフタ開閉","","------------------------------\nLid opening/closing"],["\\n<経蔵>……貞子の気配が残ってるな。\\!\nこんなところで何をしていた……？","","\\n<経蔵>...I still feel Sadako's presence. \\!\nWhat were you doing in a place like this...?"],["EV040","","EV040"],["EV041","","EV041"],["EV042","","EV042"],["フワッティー（ドア）","","Fuwatty (door)"],["伽椰子邸１Ｆ出口左","","Kayako House 1F exit left"],["\n出入り口は固く閉ざされている。","","\nThe entrance/exit is tightly closed."],["\\n<経蔵>……この先の気配は不安定だな。\n開けない方がいいだろう。","","\\n<経蔵>...The future looks unstable.\nIt would be better not to open it."],["伽椰子邸１Ｆ出口右","","Kayako Residence 1F Exit Right"],["フワッティー","","Fuwatty"],["俊雄（かけっこ）","","Toshio (race)"],["俊雄走るイベント","","Toshio running event"],["美香鬼","","Mikaoni"],["\\n<\\N[2]>美香さ……","","\\n<\\N[2]> Mika..."],["\\n<経蔵>\\N[2]、黙って見てろ……。","","\\n<経蔵>\\N[2], shut up and watch..."],["--------------------------------\n美香鬼がドアを叩く","","--------------------------------\nMikaoni knocks on the door"],["\\n<経蔵>よし、気配が消えた。もういいだろう。","","\\n<経蔵>Okay, the presence has disappeared. That's enough."],["ドアの裏側には、およそ人の手の大きさではない\n手の跡が残されていた。","","On the back of the door is a stone about the size of a human hand.\nA hand print was left behind."],["\\n<経蔵>姿隠して気配隠さずで俺を\nごまかせると思うなよ？\\.\\.　青鬼……。","","\\n<経蔵>Hide yourself, don't hide your presence, and look at me\nDon't think I'll cheat, do you? \\.\\. Blue demon..."],["\\n<経蔵>ま、本気で襲う気がなかったらしいのが\n救いだったけどな。","","\\n<経蔵>Well, it seems like he didn't really want to attack.\nIt was a relief though."],["\\n<\\N[2]>……………………。","","\\n<\\N[2]>……………………."],["\\n<経蔵>ま、本気で襲う気がなくて助かったぜ。","","\\n<経蔵> Well, I'm glad I didn't really want to attack you."],["マー","","Mar"],["マーのイベント","","mar's event"],["----------------------------------","","----------------------------------"],["\\n<経蔵>マーか。\\!\n思えば、お前もとんだとばっちりを受けたな、生前。\\!\n生きながらレンジでチン、の刑とか……。","","\\n<経蔵> Mar? \\!\nNow that I think about it, you were just as well received when you were alive. \\!\nPunishment by being microwaved while still alive..."],["\\n<経蔵>そうだ。死ぬ間際の苦しい思い出を\n法術で取って楽にしてやることができる。\\!\nよしよし、\\.\\.じっとしてろよ……？","","\\n<経蔵>That's right. Painful memories just before death\nYou can use legal techniques to make it easier. \\!\nOkay, okay, \\.\\., stay still...?"],["\\n<経蔵>俊雄によろしくな。","","\\n<経蔵> Please say hello to Toshio."],["洗濯機グラ","","washing machine gra"],["伽椰子（お色直し）","","Kayako (color change)"],["鬼移動先","","Demon destination"],["---------------------------------------------\n動きが一寸止まらないようにこの記述にしてある","","---------------------------------------------\nThis description is written so that the movement does not stop for a moment."],["EV055","","EV055"],["<high>","","<high>"],["EV056","","EV056"],["EV057","","EV057"],["EV058","","EV058"],["EV059","","EV059"],["EV060","","EV060"],["EV061","","EV061"],["EV062","","EV062"],["EV063","","EV063"],["EV064","","EV064"]],"context":[["Map111/events/1/name"],["Map111/events/2/name"],["Map111/events/3/name"],["Map111/events/3/pages/0/list/3/comment"],["Map111/events/3/pages/0/list/5/Plugin Command","Map111/events/5/pages/0/list/5/Plugin Command","Map111/events/6/pages/0/list/5/Plugin Command","Map111/events/7/pages/0/list/5/Plugin Command"],["Map111/events/3/pages/0/list/18/message/noPicture/bottom","Map111/events/5/pages/0/list/18/message/noPicture/bottom","Map111/events/6/pages/0/list/20/message/noPicture/bottom","Map111/events/7/pages/0/list/21/message/noPicture/bottom"],["Map111/events/3/pages/0/list/21/comment","Map111/events/5/pages/0/list/3/comment","Map111/events/5/pages/0/list/21/comment","Map111/events/6/pages/0/list/23/comment","Map111/events/7/pages/0/list/11/comment","Map111/events/7/pages/0/list/24/comment"],["Map111/events/4/name"],["Map111/events/5/name"],["Map111/events/6/name"],["Map111/events/6/pages/0/list/3/comment","Map111/events/7/pages/0/list/3/comment","Map111/events/25/pages/1/list/50/comment","Map111/events/27/pages/0/list/22/comment"],["Map111/events/7/name"],["Map111/even